{
 "契约版本": "1.0",
 "id": "real-brands-inventory",
 "名称": "真实品牌盘点（只读）",
 "说明": "**真实数据契约**：走一次账号可见品牌的只读读取（`brands list`），把命令原始返回里的品牌表原样出成交付件。只读、零写、不触发任何采集任务：这一步只查已有的品牌索引，不发起检索、不触发提及分析、不改任何字段。它存在的目的是给「同一工序在两个宿主里跑出同一份交付件」提供一份**带真实数据的**对照产物。",
 "输入": [
  {
   "名称": "返回条数",
   "类型": "int",
   "必填": false,
   "默认": 20,
   "说明": "最多取多少个品牌（样本上限，超上限报错退出，不静默截断）"
  }
 ],
 "前置": [
  {
   "id": "P1",
   "说明": "沙箱目录已就绪（交付件落点）",
   "断言": {
    "类型": "存在",
    "取值": "运行.沙箱目录"
   }
  },
  {
   "id": "P2",
   "说明": "本次运行是样本模式（真实数据契约也必须受样本上限约束）",
   "断言": {
    "类型": "真",
    "取值": "运行.样本模式"
   }
  }
 ],
 "步骤": [
  {
   "id": "S1",
   "说明": "真实读取账号可见的品牌（只读通路，不触发采集）",
   "动作": "调用命令",
   "命令": "brands list",
   "参数": {
    "--limit": "${输入.返回条数}"
   },
   "读": true,
   "写": false
  },
  {
   "id": "S2",
   "说明": "从命令的原始返回里取出品牌表（原样搬运，不改一个字段）",
   "动作": "本地假动作",
   "操作": "取子表",
   "来源步骤": "S1",
   "键": "brands",
   "读": true,
   "写": false
  }
 ],
 "判据": [
  {
   "id": "C1",
   "说明": "命令报告的品牌条数（引擎取自命令真实返回的 count 字段）与从返回里取到的品牌表条数一致",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S1.条目数",
    "期望": "步骤.S2.条目数"
   },
   "必过": true
  },
  {
   "id": "C2",
   "说明": "取出的品牌表非空（命令真实返回的 brands 字段，原样搬运）",
   "断言": {
    "类型": "非空",
    "取值": "步骤.S2.数据"
   },
   "必过": true
  },
  {
   "id": "C3",
   "说明": "品牌表条数不超过本次样本上限",
   "断言": {
    "类型": "条目数不超过",
    "取值": "步骤.S2.数据",
    "阈值": "限额.行数上限.实际"
   },
   "必过": true
  },
  {
   "id": "C4",
   "说明": "取子表之后真实品牌条数与命令报告的条数仍一一对应（不为空且条数相等）",
   "断言": {
    "类型": "条目数等于",
    "取值": "步骤.S2.数据",
    "期望": "步骤.S1.条目数"
   },
   "必过": true
  }
 ],
 "门禁": [
  {
   "id": "样本上限",
   "说明": "超限报错退出，不静默截断（本轮按 `返回条数` 取，默认 20、硬上限 50）"
  },
  {
   "id": "写权限",
   "说明": "写链开不开放由账号对该模块的写权限决定：本契约没有任何写步骤，这道门禁不适用"
  },
  {
   "id": "只读默认",
   "说明": "写动作只能来自声明为写的步骤；本契约两步都是读，写动作台账必须为空"
  },
  {
   "id": "写步骤确认",
   "说明": "写步骤必须 dry-run → --confirm → 执行；本契约无写步骤，无需确认"
  },
  {
   "id": "回读校验",
   "说明": "写执行后必须回读核对；本契约无写，无回读对象"
  }
 ],
 "交付件schema": {
  "名称": "品牌清单",
  "文件名": "品牌清单.json",
  "来源步骤": "S2",
  "列": [
   "id",
   "name",
   "workspaceId",
   "workspaceName"
  ],
  "必填列": [
   "id",
   "name",
   "workspaceId",
   "workspaceName"
  ],
  "行数上限引用": "行数上限"
 },
 "自检": [
  {
   "id": "V1",
   "说明": "计数自洽：声明项数＝实跑项数＝通过＋失败＋跳过",
   "断言": {
    "类型": "计数自洽"
   },
   "必过": true
  },
  {
   "id": "V2",
   "说明": "读链零写：写动作台账必须为空",
   "断言": {
    "类型": "无写发生"
   },
   "必过": true
  },
  {
   "id": "V3",
   "说明": "交付件行数等于命令报告的品牌条数（引擎取自命令真实返回的 count 字段）",
   "断言": {
    "类型": "等于",
    "取值": "交付件.行数",
    "期望": "步骤.S1.条目数"
   },
   "必过": true
  },
  {
   "id": "V4",
   "说明": "交付件逐列校验通过（每一行的品牌编号、品牌名、工作区编号、工作区名都不为空）",
   "断言": {
    "类型": "等于",
    "取值": "交付件.校验",
    "期望": "通过"
   },
   "必过": true
  },
  {
   "id": "V5",
   "说明": "交付件列里确实带着品牌名这一列（列名就是命令返回里的真实键 name）",
   "断言": {
    "类型": "包含",
    "取值": "交付件.列",
    "期望": "name"
   },
   "必过": true
  },
  {
   "id": "V6",
   "说明": "交付件列里确实带着工作区编号这一列（列名就是命令返回里的真实键 workspaceId）",
   "断言": {
    "类型": "包含",
    "取值": "交付件.列",
    "期望": "workspaceId"
   },
   "必过": true
  }
 ],
 "失败模式": [
  {
   "缺陷类": "CLS-67",
   "现象": "同一批数据在步骤、交付件、汇总里各数一遍，数字对不上",
   "对策": "自检.V1"
  },
  {
   "缺陷类": "CLS-65",
   "现象": "拿不到真实数据却照样出件（把空表当成功交出去）",
   "对策": "判据.C2"
  },
  {
   "缺陷类": "CLS-67",
   "现象": "交付件行数与命令报告的条数脱钩（截断后当成功）",
   "对策": "自检.V3"
  },
  {
   "缺陷类": "CLS-65",
   "现象": "列名与真实数据的键对不上（看着有列、其实每行都是空）",
   "对策": "自检.V4"
  }
 ],
 "需要联网": true,
 "限额": {
  "行数上限": {
   "默认": 20,
   "硬上限": 50,
   "适用步骤": "S2",
   "说明": "交付件行数上限（同时是 `brands list --limit` 的取值）"
  }
 },
 "期望": {
  "默认": {
   "结果": "通过",
   "退出码": 0
  }
 }
}
