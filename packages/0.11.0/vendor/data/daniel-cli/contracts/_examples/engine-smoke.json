{
 "契约版本": "1.0",
 "id": "engine-smoke",
 "名称": "引擎冒烟（最小示例契约）",
 "说明": "非业务契约：只为验证契约引擎本身能跑通。两步都是离线动作（一条只读命令 ＋ 一条本地假动作），不发任何采集任务、不碰任何 Daniel 写路由。",
 "输入": [
  {
   "名称": "品牌",
   "类型": "str",
   "必填": false,
   "默认": "3690002",
   "说明": "夹具品牌编号：本契约只用它做断言，不解析、不取数、不发起采集"
  },
  {
   "名称": "期望条目数",
   "类型": "int",
   "必填": false,
   "默认": 6,
   "说明": "本地假动作生成的样本条目数（受限额「行数上限」约束）"
  }
 ],
 "前置": [
  {
   "id": "P1",
   "说明": "契约落点可读、沙箱目录已就绪（跑不出证据就不往下走）",
   "断言": {
    "类型": "存在",
    "取值": "运行.沙箱目录"
   }
  },
  {
   "id": "P2",
   "说明": "默认就是样本模式（v0.1 不实现全量口径）",
   "断言": {
    "类型": "等于",
    "取值": "运行.样本模式",
    "期望": true
   }
  }
 ],
 "步骤": [
  {
   "id": "S1",
   "说明": "跑一条只读命令（离线通路清单：验契约加载器真能调用 CLI 已声明的命令）",
   "动作": "调用命令",
   "命令": "route catalog",
   "参数": {},
   "读": true,
   "写": false
  },
  {
   "id": "S2",
   "说明": "离线生成样本条目（不联网、不取数，用来演练样本上限与交付件出件）",
   "动作": "本地假动作",
   "操作": "生成多条",
   "数量": "${输入.期望条目数}",
   "读": true,
   "写": false
  }
 ],
 "判据": [
  {
   "id": "C1",
   "说明": "只读命令真跑通了（退出码 0）",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S1.退出码",
    "期望": 0
   },
   "必过": true
  },
  {
   "id": "C2",
   "说明": "只读命令确实返回了内容（条目数至少 1 条）",
   "断言": {
    "类型": "大于等于",
    "取值": "步骤.S1.条目数",
    "阈值": 1
   },
   "必过": true
  },
  {
   "id": "C3",
   "说明": "样本条目数等于输入声明的期望值（输入不是装饰，运行期真的生效）",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S2.条目数",
    "期望": "输入.期望条目数"
   },
   "必过": true
  },
  {
   "id": "C4",
   "说明": "本契约不含写步骤（读链默认零写）",
   "断言": {
    "类型": "等于",
    "取值": "契约.含写步骤",
    "期望": false
   },
   "必过": true
  }
 ],
 "门禁": [
  {
   "id": "样本上限",
   "说明": "答案必须落在样本上限内：超限报错退出，不允许静默截断"
  },
  {
   "id": "写权限",
   "说明": "写链开不开放由账号对该模块的写权限决定：写步骤必须能解析出所属模块，当前账号没有该模块的写权限就拦下（退出码 2）；权限具备时写动作也只允许沙箱内的离线假动作"
  },
  {
   "id": "只读默认",
   "说明": "读链默认零写：写动作只能来自契约里声明为写的步骤"
  },
  {
   "id": "写步骤确认",
   "说明": "写步骤必须 dry-run → --confirm → 执行；未确认时不执行任何写"
  },
  {
   "id": "回读校验",
   "说明": "写执行后必须回读核对；被拦下的写必须证明目标不存在"
  }
 ],
 "交付件schema": {
  "名称": "引擎冒烟交付件",
  "文件名": "引擎冒烟交付件.json",
  "来源步骤": "S2",
  "列": [
   "序号",
   "条目",
   "来源"
  ],
  "必填列": [
   "序号",
   "条目"
  ],
  "行数上限引用": "行数上限"
 },
 "自检": [
  {
   "id": "V1",
   "说明": "计数自洽：声明项数＝实跑项数＝通过＋失败＋跳过（五组通用）",
   "断言": {
    "类型": "计数自洽"
   },
   "必过": true
  },
  {
   "id": "V2",
   "说明": "交付件行数等于来源步骤的条目数（同一批东西不许两处数出两个数）",
   "断言": {
    "类型": "等于",
    "取值": "交付件.行数",
    "期望": "步骤.S2.条目数"
   },
   "必过": true
  },
  {
   "id": "V3",
   "说明": "交付件行数不超过样本上限",
   "断言": {
    "类型": "条目数不超过",
    "取值": "交付件.数据",
    "阈值": "限额.行数上限.实际"
   },
   "必过": true
  },
  {
   "id": "V4",
   "说明": "交付件逐列校验通过（必填列不缺）",
   "断言": {
    "类型": "等于",
    "取值": "交付件.校验",
    "期望": "通过"
   },
   "必过": true
  },
  {
   "id": "V5",
   "说明": "全程无任何写发生（读链零写）",
   "断言": {
    "类型": "无写发生"
   },
   "必过": true
  }
 ],
 "失败模式": [
  {
   "缺陷类": "CLS-67",
   "现象": "同一批人在四处各被数一次（交付件、分组表、正文、结论各一个数）",
   "对策": "自检.V1"
  },
  {
   "缺陷类": "CLS-46",
   "现象": "不回读就把失败当成功（旧路由快照报裸 400 也算跑过）",
   "对策": "门禁.回读校验"
  },
  {
   "缺陷类": "CLS-74",
   "现象": "触发采集落到别人的工作区（账号级活跃工作区）",
   "对策": "门禁.写权限"
  },
  {
   "缺陷类": "CLS-76",
   "现象": "字段不全或排序错，交付件对不上来源",
   "对策": "自检.V2"
  }
 ],
 "限额": {
  "行数上限": {
   "默认": 8,
   "硬上限": 10,
   "适用步骤": "S2",
   "说明": "交付件行数上限；`--limit 行数上限=N` 可覆盖，但 N 不得超过硬上限"
  }
 },
 "期望": {
  "默认": {
   "结果": "通过",
   "退出码": 0
  }
 }
}
