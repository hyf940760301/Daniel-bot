{
 "契约版本": "1.0",
 "id": "minimal-skeleton",
 "名称": "最小契约骨架（照着改就能写自己的契约）",
 "说明": "非业务契约：字段最少的合法契约，一步、一条判据、一条自检。新写契约时复制本文件改字段即可。",
 "输入": [],
 "前置": [
  {
   "id": "P1",
   "说明": "沙箱目录已就绪",
   "断言": {
    "类型": "存在",
    "取值": "运行.沙箱目录"
   }
  }
 ],
 "步骤": [
  {
   "id": "S1",
   "说明": "离线生成 3 条样本条目",
   "动作": "本地假动作",
   "操作": "生成多条",
   "数量": 3,
   "读": true,
   "写": false
  }
 ],
 "判据": [
  {
   "id": "C1",
   "说明": "条目数等于 3",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S1.条目数",
    "期望": 3
   },
   "必过": true
  }
 ],
 "门禁": [
  {
   "id": "样本上限",
   "说明": "超限报错退出，不静默截断"
  },
  {
   "id": "写权限",
   "说明": "写链开不开放由账号对该模块的写权限决定：写步骤要声明所属模块，没有该模块的写权限就拦下"
  },
  {
   "id": "只读默认",
   "说明": "写动作只能来自声明为写的步骤"
  },
  {
   "id": "写步骤确认",
   "说明": "写步骤必须 dry-run → --confirm → 执行"
  },
  {
   "id": "回读校验",
   "说明": "写执行后必须回读核对"
  }
 ],
 "交付件schema": {
  "名称": "骨架交付件",
  "文件名": "骨架交付件.json",
  "来源步骤": "S1",
  "列": [
   "序号",
   "条目",
   "来源"
  ],
  "必填列": [
   "序号",
   "条目"
  ],
  "行数上限引用": "行数上限"
 },
 "自检": [
  {
   "id": "V1",
   "说明": "计数自洽：声明项数＝实跑项数＝通过＋失败＋跳过",
   "断言": {
    "类型": "计数自洽"
   },
   "必过": true
  }
 ],
 "失败模式": [
  {
   "缺陷类": "CLS-67",
   "现象": "同一批人在四处各被数一次",
   "对策": "自检.V1"
  }
 ],
 "限额": {
  "行数上限": {
   "默认": 5,
   "硬上限": 8,
   "适用步骤": "S1",
   "说明": "交付件行数上限"
  }
 },
 "期望": {
  "默认": {
   "结果": "通过",
   "退出码": 0
  }
 }
}
