{
 "契约版本": "1.0",
 "id": "engine-smoke-fail",
 "名称": "引擎冒烟·对例（一条判据故意不通过）",
 "说明": "非业务契约：专门用来证明「判据真的会失败，而不是静默通过」。除 C3 的期望值被故意写错（99，实际 6）外，其余与 engine-smoke 同构；跑完应当出现一条 fail、退出码 1，且计数仍然自洽。",
 "输入": [
  {
   "名称": "品牌",
   "类型": "str",
   "必填": false,
   "默认": "3690002",
   "说明": "夹具品牌编号：本契约只用它做断言，不解析、不取数、不发起采集"
  },
  {
   "名称": "期望条目数",
   "类型": "int",
   "必填": false,
   "默认": 6,
   "说明": "本地假动作生成的样本条目数"
  }
 ],
 "前置": [
  {
   "id": "P1",
   "说明": "沙箱目录已就绪",
   "断言": {
    "类型": "存在",
    "取值": "运行.沙箱目录"
   }
  }
 ],
 "步骤": [
  {
   "id": "S1",
   "说明": "跑一条只读命令（离线通路清单）",
   "动作": "调用命令",
   "命令": "route catalog",
   "参数": {},
   "读": true,
   "写": false
  },
  {
   "id": "S2",
   "说明": "离线生成样本条目",
   "动作": "本地假动作",
   "操作": "生成多条",
   "数量": "${输入.期望条目数}",
   "读": true,
   "写": false
  }
 ],
 "判据": [
  {
   "id": "C1",
   "说明": "只读命令真跑通了（退出码 0）——这条应当通过",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S1.退出码",
    "期望": 0
   },
   "必过": true
  },
  {
   "id": "C2",
   "说明": "样本条目数等于输入声明的期望值——这条应当通过",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S2.条目数",
    "期望": "输入.期望条目数"
   },
   "必过": true
  },
  {
   "id": "C3",
   "说明": "对例：期望值被故意写成 99，实际 6——这条必须报 fail（引擎不许静默通过）",
   "断言": {
    "类型": "等于",
    "取值": "步骤.S2.条目数",
    "期望": 99
   },
   "必过": true
  }
 ],
 "门禁": [
  {
   "id": "样本上限",
   "说明": "答案必须落在样本上限内：超限报错退出，不允许静默截断"
  },
  {
   "id": "写权限",
   "说明": "写链开不开放由账号对该模块的写权限决定：写步骤必须能解析出所属模块，当前账号没有该模块的写权限就拦下（退出码 2）；权限具备时写动作也只允许沙箱内的离线假动作"
  },
  {
   "id": "只读默认",
   "说明": "读链默认零写：写动作只能来自契约里声明为写的步骤"
  },
  {
   "id": "写步骤确认",
   "说明": "写步骤必须 dry-run → --confirm → 执行；未确认时不执行任何写"
  },
  {
   "id": "回读校验",
   "说明": "写执行后必须回读核对；被拦下的写必须证明目标不存在"
  }
 ],
 "交付件schema": {
  "名称": "对例交付件",
  "文件名": "对例交付件.json",
  "来源步骤": "S2",
  "列": [
   "序号",
   "条目",
   "来源"
  ],
  "必填列": [
   "序号",
   "条目"
  ],
  "行数上限引用": "行数上限"
 },
 "自检": [
  {
   "id": "V1",
   "说明": "计数自洽：判据失败也要把账记平（声明＝实跑＝通过＋失败＋跳过）",
   "断言": {
    "类型": "计数自洽"
   },
   "必过": true
  },
  {
   "id": "V2",
   "说明": "交付件行数等于来源步骤条目数（判据失败不影响交付件自身的计数口径）",
   "断言": {
    "类型": "等于",
    "取值": "交付件.行数",
    "期望": "步骤.S2.条目数"
   },
   "必过": true
  },
  {
   "id": "V3",
   "说明": "全程无任何写发生（读链零写）",
   "断言": {
    "类型": "无写发生"
   },
   "必过": true
  }
 ],
 "失败模式": [
  {
   "缺陷类": "CLS-67",
   "现象": "同一批人在四处各被数一次",
   "对策": "自检.V1"
  },
  {
   "缺陷类": "CLS-46",
   "现象": "不回读就把失败当成功（对例要证明判据失败会被报出来）",
   "对策": "判据.C3"
  }
 ],
 "限额": {
  "行数上限": {
   "默认": 8,
   "硬上限": 10,
   "适用步骤": "S2",
   "说明": "交付件行数上限"
  }
 },
 "期望": {
  "默认": {
   "结果": "失败",
   "退出码": 1
  }
 }
}
