diff --git a/apps/desktop/tests/daniel-plugin.spec.ts b/apps/desktop/tests/daniel-plugin.spec.ts
new file mode 100644
index 00000000..33d9a6de
--- /dev/null
+++ b/apps/desktop/tests/daniel-plugin.spec.ts
@@ -0,0 +1,156 @@
+/** Embedded Daniel plugin: profile copy, bundle activation, and its five-key configuration. */
+
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { resolveDesktopPaths } from '../src/paths.ts'
+import { DesktopProjectManager } from '../src/project-manager.ts'
+import {
+  activateDanielPlugin,
+  DANIEL_PLUGIN_NAME,
+  embedDanielPlugin,
+  writeDanielAppOverlay,
+  writeDanielProfilePatch,
+} from '../src/daniel-plugin.ts'
+import { runtimeFixture } from './runtime-fixture.ts'
+
+const roots: string[] = []
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-desktop-daniel-'))
+  roots.push(root)
+  return root
+}
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+/** Packaged plugin shape: a manifest declaring a bundle patch, a patch file, and an executable CLI entry. */
+function pluginFixture(root: string): string {
+  const source = join(root, 'resources', 'vendor', DANIEL_PLUGIN_NAME)
+  const entry = join(source, 'vendor', 'data', 'daniel-cli', 'bin', 'daniel')
+  mkdirSync(join(entry, '..'), { recursive: true })
+  writeFileSync(join(source, 'package.json'), JSON.stringify({
+    name: DANIEL_PLUGIN_NAME,
+    version: '0.11.0',
+    type: 'module',
+    dsh: { bundle: { patch: './cordis.patch.yml' } },
+  }))
+  writeFileSync(join(source, 'cordis.patch.yml'), '- insert:\n    - id: daniel\n      name: daniel-dsh-plugin\n      config:\n        python: python3\n        timeoutMs: 180000\n')
+  writeFileSync(join(source, 'lib.js'), 'export const identity = {}\n')
+  writeFileSync(entry, '#!/usr/bin/env python3\n')
+  chmodSync(entry, 0o755)
+  return source
+}
+
+function profileFixture(root: string): string {
+  const profile = join(root, 'dsh-home', 'profiles', 'desktop')
+  mkdirSync(profile, { recursive: true, mode: 0o700 })
+  writeFileSync(join(profile, 'package.json'), JSON.stringify({
+    name: 'dsh-profile-desktop',
+    private: true,
+    dependencies: {},
+    dsh: { profile: { bundles: ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'] } },
+  }))
+  return profile
+}
+
+function bundles(profile: string): string[] {
+  return (JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+    dsh: { profile: { bundles: string[] } }
+  }).dsh.profile.bundles
+}
+
+describe('embedded Daniel plugin', () => {
+  it('copies the packaged plugin once and keeps an identical copy untouched', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    const target = join(profile, 'node_modules', DANIEL_PLUGIN_NAME)
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: true })
+    expect(statSync(join(target, 'vendor', 'data', 'daniel-cli', 'bin', 'daniel')).mode & 0o111).not.toBe(0)
+    const before = readFileSync(join(target, 'lib.js'), 'utf8')
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: false })
+    expect(readFileSync(join(target, 'lib.js'), 'utf8')).toBe(before)
+  })
+
+  it('replaces a damaged copy with the packaged one', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    embedDanielPlugin(source, profile)
+    writeFileSync(join(profile, 'node_modules', DANIEL_PLUGIN_NAME, 'lib.js'), 'broken\n')
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: true })
+    expect(readFileSync(join(profile, 'node_modules', DANIEL_PLUGIN_NAME, 'lib.js'), 'utf8')).toBe('export const identity = {}\n')
+  })
+
+  it('activates the bundle once and writes all five configuration keys', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    embedDanielPlugin(source, profile)
+    const embeds = { pluginSource: source, danielHome: join(root, 'daniel-home') }
+
+    expect(activateDanielPlugin(profile)).toBe(true)
+    expect(activateDanielPlugin(profile)).toBe(false)
+    expect(bundles(profile)).toEqual(['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app', DANIEL_PLUGIN_NAME])
+
+    expect(writeDanielProfilePatch(embeds, profile)).toBe(true)
+    expect(writeDanielProfilePatch(embeds, profile)).toBe(false)
+    const patch = readFileSync(join(profile, 'cordis.patch.yml'), 'utf8')
+    expect(patch.match(/^- id: daniel$/gmu)).toHaveLength(1)
+    for (const key of ['entry', 'python', 'danielHome', 'timeoutMs', 'trace']) {
+      expect(patch).toContain(`    ${key}:`)
+    }
+
+    expect(writeDanielAppOverlay(embeds, profile)).toBe(true)
+    expect(writeDanielAppOverlay(embeds, profile)).toBe(false)
+    const overlay = readFileSync(join(embeds.danielHome, 'app-overlay.yml'), 'utf8')
+    expect(overlay.match(/^- id: daniel$/gmu)).toHaveLength(1)
+    for (const key of ['entry', 'python', 'danielHome', 'timeoutMs', 'trace']) {
+      expect(overlay).toContain(`    ${key}:`)
+    }
+  })
+
+  it('keeps the plugin activated and configured across crash recovery', async () => {
+    const root = temporaryRoot()
+    const dsh = join(root, 'resources', 'dsh')
+    runtimeFixture(dsh)
+    const source = pluginFixture(root)
+    const danielHome = join(root, 'daniel-home')
+    const manager = new DesktopProjectManager(resolveDesktopPaths(join(root, 'dsh-home')), { dsh }, {
+      pluginSource: source,
+      danielHome,
+    })
+
+    await manager.applyRelease()
+    expect(bundles(manager.paths.profile)).toContain(DANIEL_PLUGIN_NAME)
+    expect(readFileSync(join(manager.paths.profile, 'cordis.patch.yml'), 'utf8')).toContain('    danielHome:')
+
+    await manager.disableAllPlugins()
+    expect(bundles(manager.paths.profile)).toContain(DANIEL_PLUGIN_NAME)
+    expect(bundles(manager.paths.profile)).toContain('@deepseek-ai/dsh-web-app')
+    expect(readFileSync(join(manager.paths.profile, 'cordis.patch.yml'), 'utf8')).toContain('    entry:')
+    expect(existsSync(join(danielHome, 'app-overlay.yml'))).toBe(true)
+
+    await manager.applyRelease()
+    expect(bundles(manager.paths.profile).filter(name => name === DANIEL_PLUGIN_NAME)).toHaveLength(1)
+  })
+
+  it('keeps the shell usable when the packaged plugin is absent', async () => {
+    const root = temporaryRoot()
+    const dsh = join(root, 'resources', 'dsh')
+    runtimeFixture(dsh)
+    const manager = new DesktopProjectManager(resolveDesktopPaths(join(root, 'dsh-home')), { dsh }, {
+      pluginSource: join(root, 'resources', 'vendor', DANIEL_PLUGIN_NAME),
+      danielHome: join(root, 'daniel-home'),
+    })
+
+    await expect(manager.applyRelease()).resolves.toBeUndefined()
+    expect(bundles(manager.paths.profile)).toEqual(['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'])
+    expect(existsSync(join(manager.paths.profile, 'node_modules', DANIEL_PLUGIN_NAME))).toBe(false)
+  })
+})
