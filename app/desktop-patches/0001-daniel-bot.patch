+#!/usr/bin/env node
+/**
+ * Trim the Daniel workflow map (built outside this repository tree) into the
+ * small, business-facing MODULE map the left rail ships.
+ *
+ *   node packages/client/ui-capability-map/scripts/build-module-map.mjs \
+ *     --from "/Users/…/daniel-bot/app/workflow-map.json"
+ *
+ * Why a generated table instead of a runtime read: the browser bundle must
+ * match a running tool call to a business module and a business action on a
+ * machine that only has the packaged app, so the mapping is baked in at build
+ * time and the generated module is checked in (same rule as the package's
+ * other build-time assets).
+ *
+ * Trimming rules (keep them in sync with CHANGES-RAIL-V2.md):
+ *
+ * 1. The rail publishes exactly the nine business modules below, in product
+ *    order. A source module maps to one published module through
+ *    `MODULE_SOURCES`; an unflagged source module fails the build, so a new
+ *    operational module can never leak into the rail by accident.
+ * 2. The operations modules (`OPS_MODULES`, e.g. 工序契约 / 宿主接入 / 出包 /
+ *    调度 / 授权 / 澄清) are never published. Their commands are asserted
+ *    absent from the generated lookup table.
+ * 3. The source row's `internal` flag and its `workflow.id` do NOT decide
+ *    publication any more; the `module` column does. 账号与工作区 is a
+ *    business module whose rows happen to carry `internal: true` and
+ *    `workflow.id: ops`, and the user asked for it in the panorama.
+ * 4. Every published command maps to exactly one authored business action.
+ *    Display copy is asserted clean at generation time: no ASCII letters,
+ *    no `_`, no `--`, no `.ts`／`.json`, no backticks. The only exception is
+ *    the fallback sentence, which may carry the product name "Daniel" (it is
+ *    never a command, tool, path, or field name).
+ * 5. `ALIASES` adds command tokens the CLI accepts but the workflow map does
+ *    not list (e.g. `workspaces list`). An alias must resolve to an existing
+ *    authored action, so it cannot invent a module.
+ * 6. Dedicated Daniel tools are bridged to a command (`TOOL_COMMANDS`) or
+ *    mapped directly (`TOOL_RULES`) when no CLI command exists. The argv
+ *    tools (`daniel_run`, `daniel_write_plan`, `daniel_batch`) are resolved
+ *    by the client fold at run time from their arguments.
+ * 7. Every published module carries **two** names: the Daniel Chinese name
+ *    (`name`, the one the workflow map uses) and its English name (`en`).
+ *    Both are asserted non-empty; the English one must also start with a
+ *    capital letter and be unique, so the rail and the guide can always show
+ *    a bilingual label without inventing one at run time.
+ */
+import { createHash } from 'node:crypto'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { parseArgs } from 'node:util'
+
+const PACKAGE_ROOT = fileURLToPath(new URL('..', import.meta.url))
+const OUTPUT = join(PACKAGE_ROOT, 'src/client/module-map.generated.ts')
+
+/** Hard ceiling on public modules (the nine below plus at most one spare). */
+const MAX_MODULES = 10
+/** Published commands: the nine modules' workflow rows. */
+const PUBLISHED_COMMANDS = 51
+
+/**
+ * The nine business modules, in product order. `sources` lists the workflow
+ * map's `module` values that feed them; an empty intersection is a build bug.
+ */
+const MODULES = [
+  { id: 'account', name: '账号与盘点', en: 'Account', sources: ['账号与工作区'] },
+  { id: 'brands', name: '品牌档案', en: 'Brand Profile', sources: ['品牌资产'] },
+  { id: 'discovery', name: '红人检索', en: 'Creator Search', sources: ['红人检索', '检索词清单'] },
+  { id: 'lists', name: '红人名单', en: 'Saved Lists', sources: ['红人名单'] },
+  { id: 'screening', name: '真实性核验', en: 'Authenticity', sources: ['真实性核验'] },
+  { id: 'tracking', name: '合作追踪', en: 'Campaigns', sources: ['合作追踪'] },
+  { id: 'mentions', name: '品牌提及', en: 'Brand Mentions', sources: ['品牌提及'] },
+  { id: 'intel', name: '内容情报', en: 'Intelligence', sources: ['内容情报'] },
+  { id: 'share', name: '声量份额', en: 'Share of Voice', sources: ['声量份额'] },
+]
+
+/**
+ * Operational / build-time modules that must never reach the rail. Kept as a
+ * closed list so renaming a workflow-map module fails here instead of
+ * silently publishing it.
+ */
+const OPS_MODULES = [
+  '工序契约', '宿主接入', '安装向导', '出包', '命令清单', '数据通路',
+  '接管验收', '口径一致性', '业务语料', '授权', '调度', '需求入口', '澄清',
+]
+
+/**
+ * Authored business action per command, keyed by the command's own two tokens
+ * (`<group> <subcommand>`). Written in business language on purpose: these are
+ * the only strings the rail ever shows for a step.
+ */
+const ACTIONS = {
+  // 账号与工作区
+  'account whoami': '查看当前账号',
+  'account list': '查看账号清单',
+  'account workspaces': '读取工作区清单',
+  'account capabilities': '查看账号能力',
+  'account switch': '切换当前账号',
+  'account login': '重新登录账号',
+  'account audit': '查看操作记录',
+  'account credentials': '查看凭据来源',
+  'account credentials-set': '更新本机凭据',
+  'account paths': '查看数据落点',
+  // 品牌资产
+  'brands list': '读取品牌列表',
+  'brands show': '查看品牌档案',
+  'brands competitors': '查看竞品清单',
+  'brands create': '新建品牌',
+  'brands update': '更新品牌资料',
+  'brands clone': '复制品牌档案',
+  'brands delete': '删除品牌',
+  // 红人检索
+  'search history': '查看检索历史',
+  'search job-status': '查看检索进度',
+  'search submit': '发起红人检索',
+  'keywords check': '校验检索词',
+  // 红人名单
+  'lists by-brand': '查看品牌下的名单',
+  'lists items': '查看名单成员',
+  'lists saved-channel-ids': '查看已存频道',
+  'lists share-status': '查看名单分享状态',
+  'lists auto-priority-status': '查看自动优先级',
+  'lists create': '新建名单',
+  'lists rename': '名单改名',
+  'lists delete': '删除名单',
+  // 真实性与背调
+  'authenticity channel': '核对粉丝真实性',
+  'authenticity weights': '查看评分权重',
+  // 合作追踪
+  'ct campaigns': '查看合作活动',
+  'ct campaign-stats': '查看活动统计',
+  'ct deals': '查看订单明细',
+  'ct videos': '查看共创视频',
+  'ct resolve-channel': '解析频道',
+  'ct interests': '查看频道兴趣画像',
+  'ct create-campaign': '新建合作活动',
+  'ct delete-campaign': '删除合作活动',
+  // 品牌提及
+  'mentions jobs': '查看提及任务',
+  'mentions status': '查看提及进度',
+  'mentions results': '查看视频评分',
+  'mentions run': '发起提及分析',
+  // 内容情报
+  'intel actions': '查看待办动作',
+  'intel keywords': '查看追踪关键词',
+  'intel topics': '查看选题',
+  'intel reviews': '查看内容审核单',
+  // 声量份额
+  'sov overview': '查看声量总览',
+  'sov categories': '查看品类竞争',
+  'sov brand-videos': '查看品牌视频',
+  'sov run-exposure': '发起曝光采集',
+}
+
+/**
+ * Command tokens the CLI accepts but the workflow map does not carry. The
+ * task's worked example is `daniel_run ["workspaces","list"]`; the shipped
+ * CLI spells the same read as `account workspaces`, so both land on one
+ * business action. An alias can only point at an action that already exists.
+ */
+const ALIASES = {
+  'workspaces list': { module: '账号与盘点', action: '读取工作区清单' },
+}
+
+/** Dedicated tools that wrap exactly one published command. */
+const TOOL_COMMANDS = {
+  daniel_brands_list: 'brands list',
+  daniel_brand_view: 'brands show',
+}
+
+/**
+ * Dedicated tools with no published command behind them. `module: null` is
+ * allowed: the write chain is not one of the nine business modules, so the
+ * row reads 其他能力 rather than claiming a module it does not belong to.
+ */
+const TOOL_RULES = {
+  daniel_brand_count: { module: '品牌档案', action: '统计品牌数量' },
+  daniel_roster_search: { module: '红人检索', action: '检索平台红人库' },
+  daniel_kol_profile: { module: '真实性核验', action: '查看红人档案' },
+  daniel_screen_ask: { module: '红人检索', action: '澄清检索条件' },
+  daniel_clarify: { module: '红人检索', action: '对齐需求参数' },
+  daniel_status: { module: '账号与盘点', action: '查看登录状态' },
+  daniel_login: { module: '账号与盘点', action: '重新登录账号' },
+  daniel_write_plan: { module: null, action: '准备写入计划' },
+  daniel_write_commit: { module: null, action: '执行已确认的写入' },
+}
+
+/**
+ * Business sentences for a call the table cannot place. `action` keeps the
+ * product name on purpose (it is copy, not an identifier); the rest of the
+ * display copy is asserted free of ASCII.
+ */
+const FALLBACK = {
+  module: '其他能力',
+  action: '正在调用 Daniel 能力…',
+  generic: '正在处理…',
+  batch: '批量读取多项数据',
+}
+
+/** Markers that must never reach the screen. */
+const FORBIDDEN_COPY = ['`', '_', '--', '.ts', '.json']
+
+/**
+ * Fail loudly instead of publishing a table the rail cannot render.
+ * @param {unknown} condition - asserted fact.
+ * @param {string} message - what the caller should fix.
+ */
+function assert(condition, message) {
+  if (!condition) {
+    process.stderr.write(`build-module-map: ${message}\n`)
+    process.exit(1)
+  }
+}
+
+/**
+ * Assert one display string carries business language only.
+ * @param {unknown} copy - the string the rail would render.
+ * @param {string} where - source location named in the failure.
+ * @param {{ allowProductName?: boolean }} [options] - permit "Daniel" in copy.
+ */
+function assertBusinessCopy(copy, where, options = {}) {
+  assert(typeof copy === 'string' && copy.trim() !== '', `${where} 缺少业务文案`)
+  for (const marker of FORBIDDEN_COPY) {
+    assert(!copy.includes(marker), `${where} 的文案含有内部标记 ${JSON.stringify(marker)}：${copy}`)
+  }
+  const scrubbed = options.allowProductName === true ? copy.replaceAll('Daniel', '') : copy
+  assert(!/[A-Za-z]/u.test(scrubbed), `${where} 的文案含有字母（命令名/常量/路径）：${copy}`)
+}
+
+/**
+ * Assert one module's English display name: present, trimmed, unique enough to
+ * label a row, and capitalized the way a product module is written.
+ * @param name - the authored English name.
+ * @param where - source location named in the failure.
+ */
+function assertEnglishName(name, where) {
+  assert(typeof name === 'string' && name.trim() !== '', `${where} 缺少英文模块名`)
+  assert(name === name.trim(), `${where} 的英文模块名首尾有空白：${JSON.stringify(name)}`)
+  assert(/^[A-Z]/u.test(name), `${where} 的英文模块名必须首字母大写：${name}`)
+  assert(!/[^A-Za-z ]/u.test(name), `${where} 的英文模块名只能是字母和空格：${name}`)
+}
+
+/**
+ * Normalize one workflow-map command into its two-token match key.
+ * @param {unknown} command - `match.command` from the workflow map.
+ * @returns {string} `<group> <subcommand>` in lower case.
+ */
+function commandKey(command) {
+  return String(command).trim().toLowerCase().split(/\s+/u).slice(0, 2).join(' ')
+}
+
+/**
+ * Read one workflow map file.
+ * @param {string} path - absolute workflow-map.json path.
+ * @returns {{ parsed: any, text: string }} its parsed body and raw text.
+ */
+function readWorkflowMap(path) {
+  let text
+  try {
+    text = readFileSync(path, 'utf8')
+  } catch (error) {
+    assert(false, `无法读取 ${path}：${error instanceof Error ? error.message : String(error)}`)
+  }
+  let parsed
+  try {
+    parsed = JSON.parse(text)
+  } catch (error) {
+    assert(false, `${path} 不是合法 JSON：${error instanceof Error ? error.message : String(error)}`)
+  }
+  assert(parsed.schema === 'daniel.workflow-map.v1', `未知 schema：${String(parsed.schema)}`)
+  assert(Array.isArray(parsed.entries), '缺少 entries')
+  return { parsed, text }
+}
+
+const { values } = parseArgs({
+  options: {
+    from: { type: 'string' },
+    help: { type: 'boolean', short: 'h' },
+  },
+})
+
+if (values.help === true) {
+  process.stdout.write('用法：node scripts/build-module-map.mjs --from <workflow-map.json>\n')
+  process.exit(0)
+}
+
+const source = values.from ?? process.env.DANIEL_WORKFLOW_MAP
+assert(source !== undefined && source !== '', '缺少输入：传 --from <workflow-map.json>，或设 DANIEL_WORKFLOW_MAP')
+const { parsed, text } = readWorkflowMap(resolve(source))
+
+// ── the closed module table ────────────────────────────────────────────────
+assert(MODULES.length <= MAX_MODULES, `对外模块不得超过 ${String(MAX_MODULES)} 个，实际 ${String(MODULES.length)} 个`)
+const moduleByName = new Map(MODULES.map(module => [module.name, module]))
+const moduleBySource = new Map()
+const englishNames = new Set()
+for (const module of MODULES) {
+  assertBusinessCopy(module.name, `模块 ${module.id}`)
+  assertEnglishName(module.en, `模块 ${module.id}`)
+  assert(!englishNames.has(module.en), `英文模块名重复：${module.en}`)
+  englishNames.add(module.en)
+  for (const sourceModule of module.sources) {
+    assert(!moduleBySource.has(sourceModule), `来源模块被两个对外模块同时占用：${sourceModule}`)
+    moduleBySource.set(sourceModule, module)
+  }
+}
+for (const module of MODULES) {
+  const owned = parsed.entries.filter(entry => module.sources.includes(entry?.module))
+  assert(owned.length > 0, `对外模块没有命令：${module.name}`)
+}
+
+const knownSources = new Set([...moduleBySource.keys(), ...OPS_MODULES])
+for (const entry of parsed.entries) {
+  const origin = entry?.module
+  assert(knownSources.has(origin),
+    `未知模块 ${String(origin)}（${String(entry?.id)}）：请把它归入九个业务模块，或加进 OPS_MODULES 后剔除`)
+}
+
+// ── publish the nine modules' commands ─────────────────────────────────────
+const commands = {}
+for (const entry of parsed.entries) {
+  const module = moduleBySource.get(entry?.module)
+  if (module === undefined) continue
+  assert(entry.match?.kind === 'cli', `命令映射不是 cli：${String(entry.id)}`)
+  const key = commandKey(entry.match.command)
+  const action = ACTIONS[key]
+  assert(action !== undefined, `缺少业务动作：${key}（${String(entry.id)}）`)
+  assertBusinessCopy(action, `命令 ${key}`)
+  assert(commands[key] === undefined, `命令重复：${key}`)
+  commands[key] = { module: module.name, action }
+}
+
+assert(Object.keys(commands).length === PUBLISHED_COMMANDS,
+  `对外命令应为 ${String(PUBLISHED_COMMANDS)} 条，实际 ${String(Object.keys(commands).length)} 条`)
+
+// Authored actions are a closed set: a stale row would silently never match.
+for (const key of Object.keys(ACTIONS)) {
+  assert(commands[key] !== undefined, `业务动作没有对应命令（已过期？）：${key}`)
+}
+
+// Operational modules must be absent from the published lookup table.
+for (const entry of parsed.entries) {
+  if (!OPS_MODULES.includes(entry?.module)) continue
+  const key = commandKey(entry.match?.command)
+  assert(commands[key] === undefined, `运维模块命令混进了对外映射：${key}（${String(entry.id)}）`)
+}
+
+// ── command aliases ────────────────────────────────────────────────────────
+const modules = MODULES.map(module => ({ ...module, actions: [] }))
+const moduleById = new Map(modules.map(module => [module.id, module]))
+const actionByModuleAndName = new Map()
+for (const module of modules) {
+  for (const [key, rule] of Object.entries(commands)) {
+    if (rule.module !== module.name) continue
+    let action = module.actions.find(candidate => candidate.name === rule.action)
+    if (action === undefined) {
+      action = { name: rule.action, commands: [] }
+      module.actions.push(action)
+      actionByModuleAndName.set(`${module.id}\u0000${rule.action}`, action)
+    }
+    action.commands.push(key)
+  }
+}
+for (const [key, alias] of Object.entries(ALIASES)) {
+  const module = modules.find(candidate => candidate.name === alias.module)
+  assert(module !== undefined, `别名 ${key} 指向未知模块：${alias.module}`)
+  const action = actionByModuleAndName.get(`${module.id}\u0000${alias.action}`)
+  assert(action !== undefined, `别名 ${key} 指向未知动作：${alias.action}`)
+  assert(commands[key] === undefined, `别名与既有命令重名：${key}`)
+  commands[key] = { module: module.name, action: alias.action }
+  action.commands.push(key)
+}
+
+// Every module carries actions, and every action carries commands.
+for (const module of modules) {
+  assert(module.actions.length > 0, `对外模块没有业务动作：${module.name}`)
+  for (const action of module.actions) {
+    assertBusinessCopy(action.name, `${module.name} 的动作`)
+    assert(action.commands.length > 0, `${module.name} · ${action.name} 没有覆盖命令`)
+  }
+}
+
+// ── dedicated tools ────────────────────────────────────────────────────────
+const moduleNames = new Set(modules.map(module => module.name))
+for (const [tool, key] of Object.entries(TOOL_COMMANDS)) {
+  assert(commands[key] !== undefined, `工具 ${tool} 指向未映射的命令：${key}`)
+}
+for (const [tool, rule] of Object.entries(TOOL_RULES)) {
+  assert(rule.module === null || moduleNames.has(rule.module), `工具 ${tool} 指向未知模块：${String(rule.module)}`)
+  assertBusinessCopy(rule.action, `工具 ${tool}`)
+}
+assertBusinessCopy(FALLBACK.module, '兜底模块')
+assertBusinessCopy(FALLBACK.action, '兜底文案', { allowProductName: true })
+assertBusinessCopy(FALLBACK.generic, '通用兜底文案')
+assertBusinessCopy(FALLBACK.batch, '批量兜底文案')
+
+const covered = modules.reduce((total, module) => total + module.actions.reduce((sum, action) => sum + action.commands.length, 0), 0)
+assert(covered === Object.keys(commands).length,
+  `模块覆盖命令 ${String(covered)} 条，查表 ${String(Object.keys(commands).length)} 条`)
+
+const payload = {
+  schema: 'daniel.module-map.v1',
+  source: {
+    workflowMap: 'daniel-bot/app/workflow-map.json',
+    sha256: createHash('sha256').update(text).digest('hex'),
+    workflows: parsed.workflows.length,
+    commands: parsed.entries.length,
+    published: Object.keys(commands).length,
+  },
+  modules: modules.map(module => ({
+    id: module.id,
+    name: module.name,
+    nameEn: module.en,
+    actions: module.actions.map(action => ({ name: action.name, commands: action.commands })),
+  })),
+  commands,
+  toolCommands: TOOL_COMMANDS,
+  toolRules: TOOL_RULES,
+  fallback: FALLBACK,
+}
+
+const header = `/**
+ * GENERATED FILE — do not edit by hand.
+ *
+ * Source: ${payload.source.workflowMap} (sha256 ${payload.source.sha256.slice(0, 12)})
+ * Regenerate: node packages/client/ui-capability-map/scripts/build-module-map.mjs --from <workflow-map.json>
+ *
+ * Daniel module map: ${String(modules.length)} modules, ${String(modules.reduce((total, module) => total + module.actions.length, 0))} business actions,
+ * ${String(Object.keys(commands).length)} commands (${String(parsed.entries.length - (Object.keys(commands).length - Object.keys(ALIASES).length))} operations rows trimmed).
+ * Keys are command match tokens and are never rendered.
+ * Every displayed string is business copy (asserted at generation time).
+ */
+import type { ModuleMapData } from './types.ts'
+
+`
+const body = `export const MODULE_MAP: ModuleMapData = ${JSON.stringify(payload, null, 2)}\n`
+writeFileSync(OUTPUT, `${header}${body}`, 'utf8')
+
+process.stdout.write([
+  `wrote ${OUTPUT}`,
+  `modules ${String(modules.length)} · actions ${String(modules.reduce((total, module) => total + module.actions.length, 0))} · commands ${String(Object.keys(commands).length)}/${String(parsed.entries.length)}`,
+  modules.map(module => `${module.name}=${String(module.actions.length)}动作/${String(module.actions.reduce((sum, action) => sum + action.commands.length, 0))}命令`).join(' '),
+  '',
+].join('\n'))
