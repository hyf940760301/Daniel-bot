+++ b/packages/client/ui-capability-map/src/client/CapabilityMap.module.css
@@ -0,0 +1,697 @@
+/* Left execution rail (S6.4).
+ *
+ * It is a real frame column (`shell.rail`), not a floating overlay: the frame
+ * owns the track width (48px strip / 320px panel) and paints the column, so the
+ * dock fills the track and never draws over the sidebar. Every colour comes
+ * from a theme token, so the rail follows both appearances and the Daniel
+ * palette without a local colour.
+ *
+ * The whole panel is a read-only glance: the only motion is the "running"
+ * pulse and the task-reset fade, both CSS-only and both disabled under
+ * `prefers-reduced-motion`. */
+
+/* The dock fills the column; the strip and the panel split that box. */
+.dock {
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  padding: calc(var(--dsh-frame-top-clearance, 0px) + 6px) 0 8px;
+}
+
+.rail,
+.panel {
+  box-sizing: border-box;
+  color: var(--dsw-alias-label-primary);
+}
+
+.rail {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  min-height: 0;
+  padding: 12px 6px;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font: inherit;
+  cursor: pointer;
+}
+
+.rail:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.railIcon {
+  display: inline-flex;
+  color: var(--dsw-alias-link);
+}
+
+.railTitle {
+  font-size: 13px;
+  line-height: 1;
+  letter-spacing: 0.16em;
+  writing-mode: vertical-rl;
+  text-orientation: mixed;
+}
+
+.panel {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+}
+
+.header {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 14px 12px 8px;
+}
+
+.headerIcon {
+  display: inline-flex;
+  margin-top: 2px;
+  color: var(--dsw-alias-link);
+}
+
+.headings {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.title {
+  margin: 0;
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.subtitle {
+  font-size: 12px;
+  line-height: 1.4;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.iconButton {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  flex: none;
+  padding: 0;
+  border: 0;
+  border-radius: var(--dsw-radius-sm);
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  cursor: pointer;
+}
+
+.iconButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+/* The body is the one scrolling region. Two blocks only: the task path and
+ * the nine-module panorama. */
+.body {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 14px;
+  min-height: 0;
+  padding: 2px 12px 10px;
+  overflow-y: auto;
+}
+
+.task {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+/* The fade belongs to the task block, and only to a reset: the rail marks the
+ * first 200ms after a new task and never marks a later update, so a status
+ * change can never replay the entry animation. */
+.task[data-enter='on'] {
+  animation: taskFade 180ms ease-out both;
+}
+
+@keyframes taskFade {
+  from {
+    opacity: 0;
+    transform: translateY(2px);
+  }
+
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.sectionHead {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.sectionTitle {
+  margin: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  line-height: 1.5;
+}
+
+.sectionMeta {
+  margin-left: auto;
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  line-height: 1.5;
+}
+
+/* The live line: what the task is doing now, or what it did last. Only a
+ * running task says 进行中; a finished path says 上次 plus 已完成. */
+.taskNow {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  margin: 0;
+  min-height: 20px;
+  font-size: 12px;
+  line-height: 1.5;
+}
+
+.taskNow[data-state='idle'] {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.nowDot {
+  flex: none;
+  align-self: center;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--dsw-alias-label-caption);
+}
+
+.nowDot[data-state='running'] {
+  background: var(--dsw-alias-state-business-primary);
+}
+
+.nowDot[data-pulse='on'] {
+  animation: railPulse 1.6s ease-in-out infinite;
+}
+
+.nowLabel {
+  flex: none;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.nowText {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.nowValue {
+  flex: 1 1 auto;
+  min-width: 0;
+  color: var(--dsw-alias-label-primary);
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+
+.nowDone {
+  flex: none;
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+}
+
+/* Honest footnote: the task did work, but none of it was a Daniel capability
+ * call. Quiet, one line, and it never invents a module. */
+.taskNote {
+  margin: 0;
+  padding: 0 0 0 2px;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 11px;
+  line-height: 1.5;
+}
+
+/* The step path: one row per business action, in start order. Calls that name
+ * the same module + action share a row, so the path has one line per action
+ * rather than one per invocation. The connector line
+ * belongs to the row above the next node, so a finished segment is brand, the
+ * segment into the running node is a brand-to-border gradient, and anything
+ * still pending is border only. */
+.steps {
+  display: flex;
+  flex-direction: column;
+  margin: 2px 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.step {
+  position: relative;
+  display: flex;
+  align-items: flex-start;
+  gap: 9px;
+  min-height: 30px;
+  padding: 0 0 6px;
+}
+
+.step::before {
+  content: '';
+  position: absolute;
+  top: 15px;
+  bottom: 0;
+  left: 7px;
+  width: 1px;
+  background: var(--dsw-alias-border-l2);
+}
+
+.step[data-line='brand']::before {
+  background: var(--dsw-alias-state-business-primary);
+}
+
+.step[data-line='gradient']::before {
+  background: linear-gradient(
+    to bottom,
+    var(--dsw-alias-state-business-primary),
+    var(--dsw-alias-border-l2)
+  );
+}
+
+.step:last-child::before {
+  display: none;
+}
+
+/* While the task still runs, a short pending tail leaves the last node. */
+.steps[data-running='true'] > .step:last-child::after {
+  content: '';
+  position: absolute;
+  top: 15px;
+  left: 7px;
+  width: 1px;
+  height: 10px;
+  background: var(--dsw-alias-border-l2);
+}
+
+.node {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  width: 15px;
+  height: 15px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 50%;
+  background: transparent;
+  color: var(--dsw-alias-label-primary-foreground);
+}
+
+.node[data-status='done'] {
+  border-color: var(--dsw-alias-state-business-primary);
+  background: var(--dsw-alias-state-business-primary);
+}
+
+.node[data-status='running'] {
+  border-color: var(--dsw-alias-state-business-primary);
+  background: var(--dsw-alias-state-business-primary);
+  box-shadow: 0 0 0 3px var(--dsw-alias-interactive-bg-hover);
+}
+
+.node[data-pulse='on'] {
+  animation: railPulse 1.6s ease-in-out infinite;
+}
+
+@keyframes railPulse {
+  0%,
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+
+  50% {
+    opacity: 0.45;
+    transform: scale(0.82);
+  }
+}
+
+.stepText {
+  display: flex;
+  flex: 1 1 auto;
+  align-items: baseline;
+  gap: 8px;
+  min-width: 0;
+  padding-top: 0.5px;
+}
+
+.stepAction {
+  flex: 1 1 auto;
+  min-width: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+
+.step[data-status='running'] .stepAction {
+  color: var(--dsw-alias-label-secondary);
+}
+
+/* The current step is the only large/bold row. */
+.step[data-current='true'] .stepAction {
+  color: var(--dsw-alias-label-primary);
+  font-size: 14px;
+  font-weight: 600;
+}
+
+/* The module tag is bilingual: Daniel's Chinese name on the first line, the
+ * English name muted under it. Stacking the two keeps both readable in the
+ * 320px panel where a single line ("真实性核验 Authenticity") would ellipsis the
+ * English half off the edge. */
+.stepTag {
+  display: inline-flex;
+  flex: 0 1 auto;
+  flex-direction: column;
+  align-items: flex-end;
+  max-width: 46%;
+  min-width: 0;
+  color: var(--dsw-alias-label-caption);
+  line-height: 1.4;
+  text-align: right;
+}
+
+.stepTagZh {
+  max-width: 100%;
+  overflow: hidden;
+  font-size: 10px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.stepTagEn {
+  max-width: 100%;
+  overflow: hidden;
+  color: var(--dsw-alias-label-caption);
+  font-size: 9px;
+  line-height: 1.3;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.step[data-current='true'] .stepTag {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* Repetition count ("×7"): plain text on the right edge, small and muted — no
+ * badge, no colour of its own, no border. It is part of the row's label for a
+ * screen reader, not a second control. */
+.stepCount {
+  flex: none;
+  padding-top: 0.5px;
+  color: var(--dsw-alias-label-caption);
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1.5;
+  white-space: nowrap;
+}
+
+/* Available to a screen reader and to tests; it never competes visually. */
+.srOnly {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+.panorama {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  padding-top: 10px;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+}
+
+/* The nine-row panorama is a plain list, not a card stack: one 30px row per
+ * module, a 3px rhythm between them, and a hairline separator as the only
+ * structure. No shadow, no per-row card, no hover state — it is a read-only
+ * glance. */
+.modules {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.moduleRow {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 30px;
+  padding: 0 6px;
+  border-bottom: 0.5px solid var(--dsw-alias-border-l1);
+  font-size: 13px;
+  line-height: 1.4;
+}
+
+.moduleRow:last-child {
+  border-bottom: 0;
+}
+
+/* State marks, in the order the panorama uses them:
+ * - 未用   hollow ring, secondary text: nothing happened here;
+ * - 已用   muted solid dot, primary text: done, but no longer running;
+ * - 使用中 brand solid dot with a soft brand halo, bold text: running now. */
+.moduleDot {
+  display: inline-flex;
+  flex: none;
+  width: 8px;
+  height: 8px;
+  border: 1px solid var(--dsw-alias-label-caption);
+  border-radius: 50%;
+  background: transparent;
+}
+
+.moduleDot[data-state='used'] {
+  border-color: var(--dsw-alias-label-caption);
+  background: var(--dsw-alias-label-caption);
+}
+
+.moduleDot[data-state='active'] {
+  border-color: var(--dsw-alias-state-business-primary);
+  background: var(--dsw-alias-state-business-primary);
+  box-shadow: 0 0 0 3px var(--dsw-alias-state-business-tertiary);
+}
+
+.moduleDot[data-pulse='on'] {
+  animation: railPulse 1.6s ease-in-out infinite;
+}
+
+/* The label keeps the Chinese name and its English half on one line. It may
+ * shrink (and ellipsize) so the trailing block always keeps its width. */
+.moduleLabel {
+  display: flex;
+  flex: 0 1 auto;
+  align-items: baseline;
+  gap: 6px;
+  min-width: 0;
+}
+
+.moduleName {
+  flex: 0 1 auto;
+  min-width: 0;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 13px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* English half of the module label: same row, one step down in weight and
+ * 10px. It never takes space from the Chinese name (which owns the ellipsis)
+ * and never wraps, so a row cannot grow into the counts on its right. */
+.moduleNameEn {
+  flex: 0 1 auto;
+  max-width: 46%;
+  min-width: 0;
+  color: var(--dsw-alias-label-caption);
+  font-size: 10px;
+  line-height: 1.5;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.moduleRow[data-state='used'] .moduleName,
+.moduleRow[data-state='active'] .moduleName {
+  color: var(--dsw-alias-label-primary);
+}
+
+.moduleRow[data-state='active'] .moduleName {
+  font-weight: 600;
+}
+
+.moduleRow[data-state='active'] .moduleNameEn {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* Count and state, pinned to the row's trailing edge. `margin-left: auto`
+ * pushes the block right no matter how long the Chinese name above is, and the
+ * two fixed grid cells keep every row's numbers on the same vertical line:
+ * the count is right-aligned in cell 1, the state is right-aligned in the fixed
+ * 3.4em cell 2, so the state column's right edge is identical on all nine rows.
+ * `grid-column` is explicit because an absent count must not let the state
+ * drift into the count's cell. */
+.moduleEnd {
+  display: grid;
+  flex: none;
+  grid-template-columns: minmax(0, auto) 3.4em;
+  align-items: center;
+  justify-items: end;
+  column-gap: 6px;
+  margin-left: auto;
+}
+
+.moduleCount {
+  grid-column: 1;
+  color: var(--dsw-alias-label-caption);
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1.4;
+  white-space: nowrap;
+}
+
+.moduleState {
+  grid-column: 2;
+  width: 3.4em;
+  color: var(--dsw-alias-label-caption);
+  font-size: 12px;
+  line-height: 1.4;
+  text-align: right;
+  white-space: nowrap;
+}
+
+.moduleRow[data-state='used'] .moduleState {
+  color: var(--dsw-alias-label-secondary);
+}
+
+.moduleRow[data-state='active'] .moduleState {
+  color: var(--dsw-alias-label-primary);
+  font-weight: 600;
+}
+
+.note {
+  margin: 0;
+  padding: 8px 12px 10px;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  line-height: 1.5;
+}
+
+.guideButton {
+  display: flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  width: 100%;
+  min-height: 38px;
+  padding: 8px 6px;
+  border: 0;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font: inherit;
+  font-size: 12px;
+  line-height: 18px;
+  cursor: pointer;
+}
+
+.guideButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.guideIcon {
+  display: inline-flex;
+  flex: none;
+  color: var(--dsw-alias-link);
+}
+
+.guideLabel {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* 48px collapsed strip: the panel body (and therefore every module row) is not
+ * mounted at all — the strip is the icon plus the vertical rail title. Should a
+ * module label ever be rendered in this track, the English half is dropped and
+ * the Chinese half ellipsizes inside the 48px, so the name can never push the
+ * strip wider than the column the frame reserved. */
+.dock[data-rail-width='48'] .moduleNameEn,
+.dock[data-rail-width='48'] .stepTagEn {
+  display: none;
+}
+
+.dock[data-rail-width='48'] .moduleName,
+.dock[data-rail-width='48'] .stepTagZh {
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* The 48px strip is one entry: the icon (22px, set in the component) above the
+ * vertical 13px words. The footer map button is not mounted there — the two
+ * outside entries (composer row, empty hero) own that path now. */
+
+.rail:focus-visible,
+.iconButton:focus-visible,
+.guideButton:focus-visible {
+  outline: var(--dsw-focus-ring-width, 2px) solid var(--dsw-focus-ring-color, var(--dsw-alias-state-business-primary));
+  outline-offset: 2px;
+}
+
+/* The preference removes both animations: the fade on task switch and the
+ * running pulse. `data-pulse` already turns the class off in JS; this block is
+ * the second guarantee for a stylesheet-only path. */
+@media (prefers-reduced-motion: reduce) {
+  .task[data-enter='on'] {
+    animation: none;
+  }
+
+  .nowDot[data-pulse='on'],
+  .node[data-pulse='on'],
+  .moduleDot[data-pulse='on'] {
+    animation: none;
+  }
+}
diff --git a/packages/client/ui-capability-map/src/client/CapabilityMap.tsx b/packages/client/ui-capability-map/src/client/CapabilityMap.tsx
