+/**
+ * The composer send gate: a business prerequisite that is not met must stop a
+ * human submission before any request leaves the renderer.
+ *
+ * What is pinned here:
+ * 1. a registered guard that raises a block means `submit()` dispatches
+ *    nothing — the default sink (the send choreography) is never called and the
+ *    draft stays in the composer;
+ * 2. a cleared guard lets the very same draft send;
+ * 3. guards are consulted in registration order, and the first block wins.
+ */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import { SessionInputShell } from '../src/client/input/facade.ts'
+import { ComposerSendGuardRegistry } from '../src/client/input/send-guard.ts'
+import type { ComposerSendBlock, ComposerSendGuard } from '../src/client/contract/send-guard.ts'
+import type { SubmitOutcome } from '../src/client/contract/input.ts'
+
+const commandAttachments = {
+  serialize: () => Promise.resolve([]),
+  release: () => {},
+  unsupportedNotice: (token: string) => `${token.trim()} attachments-unsupported`,
+}
+
+/**
+ * Build one shell over a fixed guard registry.
+ * @param guards - registry the shell consults, or undefined for no gate at all.
+ * @returns the shell and its send sink.
+ */
+function shellWith(guards: ComposerSendGuardRegistry | undefined): {
+  shell: SessionInputShell
+  sink: ReturnType<typeof vi.fn>
+} {
+  const sink = vi.fn(() => Promise.resolve<SubmitOutcome>({ kind: 'success' }))
+  const shell = new SessionInputShell({
+    actx: {} as Context,
+    defaultSink: sink as never,
+    commandAttachments,
+    ...guards === undefined ? {} : { sendGuard: () => guards },
+  })
+  return { shell, sink }
+}
+
+/** One guard that always raises the same block. */
+function blockedGuard(action = vi.fn()): ComposerSendGuard & { check: ReturnType<typeof vi.fn> } {
+  const block: ComposerSendBlock = { message: '先选一个工作区，我才能查你的数据', actionLabel: '选工作区', action }
+  return { check: vi.fn(() => block) }
+}
+
+afterEach(() => { vi.restoreAllMocks() })
+
+describe('composer send gate', () => {
+  it('dispatches nothing when a guard blocks, and keeps the draft', async () => {
+    const guards = new ComposerSendGuardRegistry()
+    const guard = blockedGuard()
+    guards.register(guard)
+    const { shell, sink } = shellWith(guards)
+    shell.setDraft('帮我找 10 个做智能戒指的 TikTok 红人')
+    shell.submit()
+    // No send transaction starts: the sink is the only path to the Host.
+    expect(sink).not.toHaveBeenCalled()
+    // The draft is untouched: the user's words survive a refused send.
+    expect(shell.snapshot.draft).toBe('帮我找 10 个做智能戒指的 TikTok 红人')
+    // The check ran, so the block's one-click action is still the way out.
+    expect(guard.check).toHaveBeenCalled()
+  })
+
+  it('sends the same draft once the guard stops blocking', async () => {
+    const guards = new ComposerSendGuardRegistry()
+    let blocked = true
+    guards.register({ check: () => blocked ? { message: '先选品牌', actionLabel: '选品牌', action: () => {} } : undefined })
+    const { shell, sink } = shellWith(guards)
+    shell.setDraft('查一下 Halliday 的负面')
+    shell.submit()
+    expect(sink).not.toHaveBeenCalled()
+    blocked = false
+    shell.submit()
+    await vi.waitFor(() => { expect(sink).toHaveBeenCalledTimes(1) })
+    expect(sink).toHaveBeenCalledWith('查一下 Halliday 的负面', [], 'queue', expect.any(AbortSignal), expect.any(Function))
+  })
+
+  it('does not consult the gate for an empty draft (that Enter is not a submission)', () => {
+    const guards = new ComposerSendGuardRegistry()
+    const check = vi.fn(() => undefined)
+    guards.register({ check })
+    const { shell, sink } = shellWith(guards)
+    shell.setDraft('')
+    shell.submit()
+    expect(check).not.toHaveBeenCalled()
+    expect(sink).not.toHaveBeenCalled()
+  })
+
+  it('evaluates guards in registration order and stops at the first block', () => {
+    const registry = new ComposerSendGuardRegistry()
+    const second = { check: vi.fn(() => ({ message: 'second', actionLabel: 'b', action: () => {} })) }
+    const third = { check: vi.fn(() => undefined) }
+    const first = { check: vi.fn(() => ({ message: 'first', actionLabel: 'a', action: () => {} })) }
+    registry.register(second)
+    registry.register(third)
+    registry.register(first)
+    expect(registry.blocked()?.message).toBe('second')
+    expect(first.check).not.toHaveBeenCalled()
+    expect(third.check).not.toHaveBeenCalled()
+  })
+
+  it('unregisters a guard with the returned disposer', () => {
+    const registry = new ComposerSendGuardRegistry()
+    const off = registry.register({ check: () => ({ message: 'x', actionLabel: 'x', action: () => {} }) })
+    expect(registry.blocked()).toBeDefined()
+    off()
+    expect(registry.blocked()).toBeUndefined()
+  })
+})
