diff --git a/packages/client/ui-conversation/src/client/input/send-guard.ts b/packages/client/ui-conversation/src/client/input/send-guard.ts
new file mode 100644
index 00000000..74673a35
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/send-guard.ts
@@ -0,0 +1,29 @@
+/**
+ * Send-gate registry: one ordered set of business checks consulted on every
+ * human submission (Enter and the Send button share the path).
+ *
+ * Registration order is evaluation order, and the first block wins, so a
+ * prerequisite another plugin also owns can never be shadowed by a later one.
+ */
+
+import type { ComposerSendBlock, ComposerSendGuard, ComposerSendGuards } from '../contract/send-guard.ts'
+
+/** The per-client registry (one instance per plugin fiber). */
+export class ComposerSendGuardRegistry implements ComposerSendGuards {
+  private readonly guards = new Set<ComposerSendGuard>()
+
+  /** @inheritdoc */
+  register(guard: ComposerSendGuard): () => void {
+    this.guards.add(guard)
+    return () => { this.guards.delete(guard) }
+  }
+
+  /** @inheritdoc */
+  blocked(): ComposerSendBlock | undefined {
+    for (const guard of this.guards) {
+      const block = guard.check()
+      if (block !== undefined) return block
+    }
+    return undefined
+  }
+}
