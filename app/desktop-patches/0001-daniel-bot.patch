+    expect(view.container.querySelector('[data-selection-notice]')?.getAttribute('data-missing')).toBe('workspace')
+    fireEvent.click(screen.getByRole('button', { name: /选工作区/u }))
+    expect(store.getSnapshot().open).toBe('workspace')
+    expect(sink).not.toHaveBeenCalled()
+  })
+
+  it('asks for the brand once the workspace is chosen, and never sends by itself', async () => {
+    const store = new ContextSelection({ bridge: fakeBridge() })
+    const sink = vi.fn(() => Promise.resolve<SubmitOutcome>({ kind: 'success' }))
+    const shell = new SessionInputShell({
+      actx: {} as never,
+      defaultSink: sink as never,
+      commandAttachments: { serialize: () => Promise.resolve([]), release: () => {}, unsupportedNotice: token => token },
+      sendGuard: () => registryOf(store),
