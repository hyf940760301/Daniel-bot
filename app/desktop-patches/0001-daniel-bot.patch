+ * policy query, downloads, and installation — stays compiled in but off unless an
+ * operator opts in. That keeps the upstream code intact (and testable) while
+ * guaranteeing a stock launch makes no release-feed request.
+ */
+
+/** Opt-in environment flag; every value except `1` keeps release traffic off. */
+export const DANIEL_ALLOW_UPDATE_ENV = 'DANIEL_BOT_ALLOW_UPDATE'
+
+/**
+ * Whether Desktop may query, download, or install a release.
+ * @param env - Desktop process environment; defaults to this process's.
+ * @returns true only for the explicit `DANIEL_BOT_ALLOW_UPDATE=1` opt-in.
+ */
+export function desktopUpdatesAllowed(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env[DANIEL_ALLOW_UPDATE_ENV]?.trim() === '1'
+}
diff --git a/apps/desktop/src/window-state.ts b/apps/desktop/src/window-state.ts
new file mode 100644
index 00000000..72fac024
--- /dev/null
+++ b/apps/desktop/src/window-state.ts
@@ -0,0 +1,293 @@
+/**
+ * Main-window geometry: first-launch default, persisted-placement validation,
+ * clamping to a display work area, and the debounced saver.
+ *
+ * The restore rules are pure functions over plain rectangles so they can be
+ * tested without a BrowserWindow or a real screen; {@link readWindowPlacement}
+ * and {@link createPlacementWriter} take structural subsets of the Electron
+ * objects they talk to.
+ * @module
+ */
+
+/** Persisted geometry of the main window; `x`/`y` stay absent until a position is known. */
+export interface WindowPlacement {
+  readonly width: number
+  readonly height: number
+  readonly x?: number
+  readonly y?: number
+  readonly maximized: boolean
+}
+
+/** The subset of Electron's `Rectangle` this module needs for `display.workArea`. */
+export interface DisplayWorkArea {
+  readonly x: number
+  readonly y: number
+  readonly width: number
+  readonly height: number
+}
+
+/** Geometry for `new BrowserWindow` plus the maximize state applied after construction. */
+export interface WindowGeometry {
+  readonly width: number
+  readonly height: number
+  readonly x?: number
+  readonly y?: number
+  readonly maximized: boolean
+}
+
+/** First-launch size of the main window (user decision, 2026-11). */
+export const DEFAULT_MAIN_WINDOW_SIZE = { width: 1360, height: 780 } as const
+
+/**
+ * Floor the main window may never go below. `createWindow` passes these same
+ * numbers as `minWidth`/`minHeight`, so the clamp and the window agree.
+ */
+export const MIN_MAIN_WINDOW_SIZE = { width: 520, height: 600 } as const
+
+/** Debounce for resize/move writes; maximize, unmaximize, close and quit write immediately. */
+export const WINDOW_PLACEMENT_DELAY_MS = 500
+
+/** Height of the draggable strip at the top of the window used by the visibility test. */
+const TITLE_BAR_STRIP_HEIGHT = 48
+/** Minimum horizontal overlap with one work area for a saved position to be reused. */
+const MIN_VISIBLE_WIDTH = 120
+/** Minimum vertical overlap with one work area for a saved position to be reused. */
+const MIN_VISIBLE_HEIGHT = 24
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+/** A window dimension: a positive safe integer. */
+function isDimension(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value > 0
+}
+
+/** A screen coordinate: any safe integer, including the negative ones of a display left of the primary. */
+function isCoordinate(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value)
+}
+
+function isWorkArea(value: unknown): value is DisplayWorkArea {
+  if (!isRecord(value)) return false
+  return isCoordinate(value.x) && isCoordinate(value.y) && isDimension(value.width) && isDimension(value.height)
+}
+
+/**
+ * Validate a persisted placement. Anything malformed — a missing size, a size
+ * that is not a positive integer, a non-boolean `maximized`, half a position,
+ * a string number — yields `undefined`, so the caller falls back to the
+ * default size instead of guessing at the user's intent.
+ * @param value - the raw `window` field of the settings document.
+ * @returns the validated placement, or `undefined` when it must be ignored.
+ */
+export function parseWindowPlacement(value: unknown): WindowPlacement | undefined {
+  if (!isRecord(value)) return undefined
+  const { width, height, x, y, maximized } = value
+  if (!isDimension(width) || !isDimension(height) || typeof maximized !== 'boolean') return undefined
+  if (x === undefined && y === undefined) return { width, height, maximized }
+  if (!isCoordinate(x) || !isCoordinate(y)) return undefined
+  return { width, height, x, y, maximized }
+}
+
+function clampDimension(value: number, min: number, max: number): number {
+  // `Math.max(min, max)` keeps the floor even when a display is smaller than the minimum.
+  return Math.min(Math.max(value, min), Math.max(min, max))
+}
+
+/** Width/height of the intersection of two rectangles; negative when they do not overlap. */
+function overlap(a: DisplayWorkArea, b: DisplayWorkArea): { width: number; height: number } {
+  return {
+    width: Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x),
+    height: Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y),
+  }
+}
+
+/**
+ * Whether a saved rectangle still has its title-bar strip on one of the
+ * attached displays. Testing the whole window is not enough: a window whose
+ * body pokes onto a display while its title bar sits above the screen cannot
+ * be dragged back, so the strip — the top {@link TITLE_BAR_STRIP_HEIGHT} px
+ * across the full width — is what must intersect a `workArea`.
+ * @param rect - the saved window rectangle, already clamped to a display.
+ * @param workAreas - `screen.getAllDisplays()` work areas.
+ * @returns true when the strip overlaps one work area by the minimum extent.
+ */
+export function isWindowPositionVisible(rect: DisplayWorkArea, workAreas: readonly DisplayWorkArea[]): boolean {
+  const strip: DisplayWorkArea = { x: rect.x, y: rect.y, width: rect.width, height: TITLE_BAR_STRIP_HEIGHT }
+  return workAreas.some((area) => {
+    const visible = overlap(strip, area)
+    return visible.width >= MIN_VISIBLE_WIDTH && visible.height >= MIN_VISIBLE_HEIGHT
+  })
+}
+
+/** The work area the rectangle sits on most; the primary area when it overlaps none. */
+function workAreaOwning(
+  rect: DisplayWorkArea,
+  primaryWorkArea: DisplayWorkArea,
+  workAreas: readonly DisplayWorkArea[],
+): DisplayWorkArea {
+  let owner: DisplayWorkArea | undefined
+  let largest = 0
+  for (const area of workAreas) {
+    const { width, height } = overlap(rect, area)
+    const shared = Math.max(0, width) * Math.max(0, height)
+    if (shared > largest) {
+      owner = area
+      largest = shared
+    }
+  }
+  return owner ?? primaryWorkArea
+}
+
+/**
+ * Resolve the geometry to restore: default size when nothing was saved, saved
+ * size clamped into the owning display's work area, saved position only while
+ * it is still reachable, and the maximized flag untouched.
+ * @param saved - validated placement from the settings document, if any.
+ * @param primaryWorkArea - `screen.getPrimaryDisplay().workArea`.
+ * @param workAreas - `screen.getAllDisplays()` work areas.
+ * @returns width/height/x/y for the new window plus the maximize state.
+ */
+export function resolveWindowGeometry(
+  saved: WindowPlacement | undefined,
+  primaryWorkArea: DisplayWorkArea,
+  workAreas: readonly DisplayWorkArea[],
+): WindowGeometry {
+  const areas = workAreas.filter(isWorkArea)
+  const primary = isWorkArea(primaryWorkArea) ? primaryWorkArea : areas[0]
+  const maximized = saved?.maximized ?? false
+  // Without any display there is nothing to clamp against; the default keeps the
+  // window usable and the platform centers it.
+  if (primary === undefined) return { ...DEFAULT_MAIN_WINDOW_SIZE, maximized }
+  const savedWidth = saved?.width ?? DEFAULT_MAIN_WINDOW_SIZE.width
+  const savedHeight = saved?.height ?? DEFAULT_MAIN_WINDOW_SIZE.height
+  const position = saved === undefined || saved.x === undefined || saved.y === undefined
+    ? undefined
+    : { x: saved.x, y: saved.y }
+  const savedRect: DisplayWorkArea | undefined = position === undefined
+    ? undefined
+    : { x: position.x, y: position.y, width: savedWidth, height: savedHeight }
+  const positionVisible = savedRect !== undefined && isWindowPositionVisible(savedRect, areas)
+  // The display that owns the saved position sets the ceiling; without a usable
+  // position the primary display does.
+  const target = positionVisible && savedRect !== undefined
+    ? workAreaOwning(savedRect, primary, areas)
+    : primary
+  const width = clampDimension(savedWidth, MIN_MAIN_WINDOW_SIZE.width, target.width)
+  const height = clampDimension(savedHeight, MIN_MAIN_WINDOW_SIZE.height, target.height)
+  // The position survives only when it was recorded AND remains reachable at the
+  // clamped size; otherwise the platform centers the window on the primary display.
+  const positioned = savedRect !== undefined && isWindowPositionVisible({ ...savedRect, width, height }, areas)
+  return {
+    width,
+    height,
+    ...(positioned && position !== undefined ? { x: position.x, y: position.y } : {}),
+    maximized,
+  }
+}
+
+/** The `BrowserWindow` subset needed to apply a restored maximize state. */
+export interface MaximizeTarget {
+  maximize(): void
+}
+
+/**
+ * Apply the persisted maximize state. `restore()` is deliberately not used: it
+ * is the counterpart of `minimize()`, and the window was constructed with the
+ * saved normal bounds, so `maximize()` alone leaves exactly those bounds as the
+ * unmaximize target. Constructing the window with the maximized bounds instead
+ * would lose the restore size the user left behind.
+ * @param window - the freshly constructed main window.
+ * @param geometry - resolved geometry carrying the persisted maximize flag.
+ */
+export function restoreMaximizedState(window: MaximizeTarget, geometry: WindowGeometry): void {
+  if (geometry.maximized) window.maximize()
+}
+
+/** The `BrowserWindow` subset {@link readWindowPlacement} needs. */
+export interface PlacementSource {
+  isDestroyed(): boolean
+  isMinimized(): boolean
+  isFullScreen(): boolean
+  isMaximized(): boolean
+  getNormalBounds(): DisplayWorkArea
+}
+
+/**
+ * Read the placement to persist. `getNormalBounds()` is what makes a maximized
+ * window save the size it will return to, not the size it currently covers.
+ * @param source - the main window, or a stand-in in tests.
+ * @returns the placement, or `undefined` when this moment must not overwrite the saved one.
+ */
+export function readWindowPlacement(source: PlacementSource): WindowPlacement | undefined {
+  // Minimized windows report icon bounds and fullscreen windows report the screen;
+  // neither describes the geometry the user chose, so the last good save stands.
+  if (source.isDestroyed() || source.isMinimized() || source.isFullScreen()) return undefined
+  const bounds = source.getNormalBounds()
+  const width = Math.round(bounds.width)
+  const height = Math.round(bounds.height)
+  const x = Math.round(bounds.x)
+  const y = Math.round(bounds.y)
+  if (!isDimension(width) || !isDimension(height) || !isCoordinate(x) || !isCoordinate(y)) return undefined
+  return { width, height, x, y, maximized: source.isMaximized() }
+}
+
+/** Debounced placement saver attached to one window's lifecycle events. */
+export interface PlacementWriter {
+  /** Request a write after the debounce delay; repeated calls coalesce into one write. */
+  schedule(): void
+  /** Write the current placement immediately and cancel any pending debounce. */
+  writeNow(): void
+  /** Cancel a pending write and ignore later requests; the window is gone. */
+  dispose(): void
+}
+
+/** Collaborators for {@link createPlacementWriter}. */
+export interface PlacementWriterOptions {
+  /** Read the placement to save; `undefined` skips this write. */
+  readonly read: () => WindowPlacement | undefined
+  /** Persist a placement. Failures are the callee's to report; they must not throw. */
+  readonly write: (placement: WindowPlacement) => void
+  /** Debounce in milliseconds; defaults to {@link WINDOW_PLACEMENT_DELAY_MS}. */
+  readonly delayMs?: number
+}
+
+/**
+ * Create the debounced writer used by resize/move plus the immediate writes of
+ * maximize/unmaximize/close/quit.
+ * @param options - read/write seams and the optional debounce override.
+ * @returns the writer; call {@link PlacementWriter.dispose} when the window closes.
+ */
+export function createPlacementWriter(options: PlacementWriterOptions): PlacementWriter {
+  const delay = options.delayMs ?? WINDOW_PLACEMENT_DELAY_MS
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let disposed = false
+  const cancel = (): void => {
+    if (timer === undefined) return
+    clearTimeout(timer)
+    timer = undefined
+  }
+  const save = (): void => {
+    cancel()
+    const placement = options.read()
+    if (placement !== undefined) options.write(placement)
+  }
+  return {
+    schedule(): void {
+      if (disposed) return
+      cancel()
+      timer = setTimeout(save, delay)
+      // An idle window must not hold the process open for a pending geometry write.
+      timer.unref?.()
+    },
+    writeNow(): void {
+      if (disposed) return
+      save()
+    },
+    dispose(): void {
+      disposed = true
+      cancel()
+    },
+  }
+}
