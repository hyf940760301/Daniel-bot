+/* The two "能做什么" entries outside the rail (D-078).
+ *
+ * Both are plain text buttons on theme tokens: no icon, no border, no card —
+ * the rail already carries the icon, and the requirement is a light entry, not
+ * a second navigation bar. The composer-row button matches the 13px tool row;
+ * the hero line is the empty state's quiet bottom note (left aligned under the
+ * input card). */
+
+.input {
+  display: inline-flex;
+  align-items: center;
+  height: 24px;
+  flex: none;
+  padding: 0 6px;
+  border: 0;
+  border-radius: var(--dsw-radius-sm);
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  font: inherit;
+  font-size: 13px;
+  line-height: 20px;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.input:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.hero {
+  display: inline-flex;
+  align-items: center;
+  max-width: 100%;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  font: inherit;
+  font-size: 13px;
+  line-height: 20px;
+  text-align: left;
+  overflow-wrap: anywhere;
+  cursor: pointer;
+}
+
+.hero:hover {
+  color: var(--dsw-alias-label-primary);
+}
+
+.input:focus-visible,
+.hero:focus-visible {
+  outline: var(--dsw-focus-ring-width, 2px) solid var(--dsw-focus-ring-color, var(--dsw-alias-state-business-primary));
+  outline-offset: 2px;
+}
diff --git a/packages/client/ui-capability-map/src/client/CapabilityEntry.tsx b/packages/client/ui-capability-map/src/client/CapabilityEntry.tsx
new file mode 100644
index 00000000..b4122599
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/CapabilityEntry.tsx
@@ -0,0 +1,139 @@
+/**
+ * The two "能做什么" entries outside the rail (D-078 / Phase 1 §3.4):
+ *
+ * - `conversation.input.left` — a 13px text button on the composer tool row;
+ * - `conversation.hero.capability` — the empty hero's bottom line.
+ *
+ * Both open the same thing, and the window width picks the shape (design
+ * §1.2): 1024px and wider ask the frame for its 320px rail; below that the rail
+ * cannot keep its track beside the centre, so the same guide opens as the 720px
+ * dialog instead. The dialog is the rail's own `GuideMap` — one content, two
+ * presentations — and it keeps the guide's only side effect: an unsent draft.
+ *
+ * The rail's open request is a memory-only layout flag (`ctx.layout.openRail`),
+ * so an entry click can never persist a panel state; every launch still starts
+ * on the 48px strip.
+ */
+import { useEffect, useRef, useState } from 'react'
+import type { ReactNode } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime, Translate } from '@deepseek-ai/dsh-client-ui-slots'
+import { GuideMap } from './GuideMap.tsx'
+import type { PrefillResult } from './prefill.ts'
+import { NS } from './locales.ts'
+import type { CapabilityMapKey } from './locales.ts'
+import css from './CapabilityEntry.module.css'
+
+/** Window width at which the 320px rail keeps its track beside the centre. */
+export const RAIL_ENTRY_MIN_VIEWPORT = 1024
+
+/** Where one "能做什么" click lands. */
+export type CapabilityRoute = 'rail' | 'modal'
+
+/**
+ * Pick the presentation for a window width (design §1.2).
+ * @param viewport - the window width in px (the frame fills it).
+ * @returns `rail` for the 320px drawer, `modal` for the 720px dialog.
+ */
+export function capabilityRoute(viewport: number): CapabilityRoute {
+  return viewport >= RAIL_ENTRY_MIN_VIEWPORT ? 'rail' : 'modal'
+}
+
+/** What either entry needs from the plugin: the guide's one write, one request. */
+export interface CapabilityEntryInjected {
+  /** Put one guide phrase into the composer, unsent (see `prefill.ts`). */
+  readonly prefill: (phrase: string) => PrefillResult
+  /** Give the keyboard back to the composer after a successful fill. */
+  readonly focusChat: () => boolean
+  /** `ctx.layout.openRail()`: ask the frame for the 320px panel. */
+  readonly openRail: () => void
+}
+
+/** Shared body props of the two entries. */
+export interface CapabilityEntryProps extends CapabilityEntryInjected {
+  /** The `capability-map` dictionary seat. */
+  readonly t: Translate<CapabilityMapKey>
+  /** Which entry this is: the composer-row button or the hero's bottom line. */
+  readonly variant: 'input' | 'hero'
+}
+
+/**
+ * Render one entry plus its dialog, and route the click by window width.
+ * @param props - the locale seat, the injected face, and the entry variant.
+ * @returns the entry button and, when open, the guide dialog.
+ */
+export function CapabilityEntry({ variant, t, prefill, focusChat, openRail }: CapabilityEntryProps): ReactNode {
+  const [guideOpen, setGuideOpen] = useState(false)
+  const triggerRef = useRef<HTMLButtonElement | null>(null)
+  const wasOpen = useRef(false)
+  const focusTarget = useRef<'trigger' | 'composer'>('trigger')
+
+  // Closing the dialog returns the keyboard to the button that opened it; a
+  // successful "fill into the chat" leaves it in the composer instead.
+  useEffect(() => {
+    if (!guideOpen && wasOpen.current) {
+      if (focusTarget.current === 'composer') focusChat()
+      else triggerRef.current?.focus()
+      focusTarget.current = 'trigger'
+    }
+    wasOpen.current = guideOpen
+  }, [guideOpen, focusChat])
+
+  const closeGuide = (focus: 'trigger' | 'composer' = 'trigger'): void => {
+    focusTarget.current = focus
+    setGuideOpen(false)
+  }
+
+  const activate = (): void => {
+    const viewport = typeof window === 'undefined' ? RAIL_ENTRY_MIN_VIEWPORT : window.innerWidth
+    if (capabilityRoute(viewport) === 'rail') {
+      openRail()
+      return
+    }
+    setGuideOpen(true)
+  }
+
+  return (
+    <>
+      <button
+        ref={triggerRef}
+        type="button"
+        className={variant === 'input' ? css.input : css.hero}
+        data-capability-entry={variant}
+        onClick={activate}
+      >
+        {variant === 'input' ? t('entry.open') : t('hero.more')}
+      </button>
+      {guideOpen && <GuideMap onClose={closeGuide} prefill={prefill} t={t} />}
+    </>
+  )
+}
+
+/** Props of the composer tool-row entry (`conversation.input.left`, session scoped). */
+export type InputCapabilityEntryProps =
+  & PropsRuntime<'conversation.input.left'>
+  & PropsLocale<typeof NS>
+  & InjectFace<CapabilityEntryInjected>
+
+/**
+ * The composer row's 13px text button.
+ * @param props - standard session props, the locale seat, and the injected face.
+ * @returns the entry.
+ */
+export function InputCapabilityEntry({ t, prefill, focusChat, openRail }: InputCapabilityEntryProps): ReactNode {
+  return <CapabilityEntry variant="input" t={t} prefill={prefill} focusChat={focusChat} openRail={openRail} />
+}
+
+/** Props of the empty hero's bottom entry (`conversation.hero.capability`, root scoped). */
+export type HeroCapabilityEntryProps =
+  & PropsRuntime<'conversation.hero.capability'>
+  & PropsLocale<typeof NS>
+  & InjectFace<CapabilityEntryInjected>
+
+/**
+ * The empty state's "不知道从哪开始？看看能做什么 →" line.
+ * @param props - the locale seat and the injected face.
+ * @returns the entry.
+ */
+export function HeroCapabilityEntry({ t, prefill, focusChat, openRail }: HeroCapabilityEntryProps): ReactNode {
+  return <CapabilityEntry variant="hero" t={t} prefill={prefill} focusChat={focusChat} openRail={openRail} />
+}
diff --git a/packages/client/ui-capability-map/src/client/CapabilityMap.module.css b/packages/client/ui-capability-map/src/client/CapabilityMap.module.css
new file mode 100644
index 00000000..f88806a8
