index 00000000..64ff6f9e
--- /dev/null
+++ b/packages/api/session-controller/src/selection.ts
@@ -0,0 +1,71 @@
+/**
+ * Host-side admission of the browser's top-bar selection.
+ *
+ * The selection crosses the RPC boundary as client-owned JSON, so it is
+ * untrusted input even though its TypeScript type says otherwise: a stale
+ * client, a hand-written request, or a future plugin can send anything. The
+ * canonicalizer returns the exact value that is worth recording on the user
+ * message source, or throws a `TypeError` naming the first invalid field.
+ *
+ * Rendering for the model belongs to the context provider, not here; this
+ * module only answers "is this a well-formed workspace + brand pair?".
+ */
+
+import type { ClientSelection } from './types.ts'
+
+/** Longest accepted display name; the selectors cap real names well below it. */
+export const MAX_SELECTION_NAME_LENGTH = 200
+
+/** Longest accepted brand identity. */
+export const MAX_SELECTION_ID_LENGTH = 200
+
+/**
+ * Trim one display name and reject empty or overlong values.
+ * @param value - untrusted name.
+ * @param field - dotted field name used in the error.
+ * @returns the trimmed name.
+ * @throws TypeError when the value is not a usable display name.
+ */
+function nameOf(value: unknown, field: string): string {
+  if (typeof value !== 'string') throw new TypeError(`${field}.name must be a string`)
+  const name = value.trim()
+  if (name === '') throw new TypeError(`${field}.name must not be empty`)
+  if (name.length > MAX_SELECTION_NAME_LENGTH) {
+    throw new TypeError(`${field}.name must be at most ${String(MAX_SELECTION_NAME_LENGTH)} characters`)
+  }
+  return name
+}
+
+/**
+ * Canonicalize one untrusted selection.
+ * @param value - the `clientSelection` field of a prompt request.
+ * @returns the trimmed workspace id/name and brand id/name.
+ * @throws TypeError when either half is missing or malformed.
+ */
+export function canonicalClientSelection(value: unknown): ClientSelection {
+  if (typeof value !== 'object' || value === null) throw new TypeError('clientSelection must be an object')
+  const record = value as Record<string, unknown>
+  const workspace = record['workspace']
+  if (typeof workspace !== 'object' || workspace === null) throw new TypeError('clientSelection.workspace must be an object')
+  const workspaceRecord = workspace as Record<string, unknown>
+  const workspaceId = workspaceRecord['id']
+  if (typeof workspaceId !== 'number' || !Number.isSafeInteger(workspaceId) || workspaceId < 0) {
+    throw new TypeError('clientSelection.workspace.id must be a non-negative safe integer')
+  }
+  const brand = record['brand']
+  if (typeof brand !== 'object' || brand === null) throw new TypeError('clientSelection.brand must be an object')
+  const brandRecord = brand as Record<string, unknown>
+  const rawBrandId = brandRecord['id']
+  if (typeof rawBrandId !== 'string' && typeof rawBrandId !== 'number') {
+    throw new TypeError('clientSelection.brand.id must be a string or a number')
+  }
+  const brandId = String(rawBrandId).trim()
+  if (brandId === '') throw new TypeError('clientSelection.brand.id must not be empty')
+  if (brandId.length > MAX_SELECTION_ID_LENGTH) {
+    throw new TypeError(`clientSelection.brand.id must be at most ${String(MAX_SELECTION_ID_LENGTH)} characters`)
+  }
+  return {
+    workspace: { id: workspaceId, name: nameOf(workspaceRecord['name'], 'clientSelection.workspace') },
+    brand: { id: brandId, name: nameOf(brandRecord['name'], 'clientSelection.brand') },
+  }
+}
