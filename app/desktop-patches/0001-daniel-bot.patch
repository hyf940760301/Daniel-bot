+/**
+ * Whether the document still holds values written before sealing existed —
+ * bare plaintext in `refs`, in an api-key record's `key`/`env`, or as a grant
+ * payload object. Boot rewrites exactly these; a fully sealed document is left
+ * byte-for-byte alone, which is what makes migration idempotent.
+ * @param document - the parsed document.
+ * @returns whether any stored secret is not sealed.
+ */
+export function needsSealing(document: CredentialsDocument): boolean {
+  for (const value of document.refs.values()) {
+    if (!isSealed(value)) return true
+  }
+  for (const record of document.records.values()) {
+    if (recordNeedsSealing(record)) return true
+  }
+  return false
+}
+
+/** Whether one record still carries a plaintext secret. */
+function recordNeedsSealing(record: CredentialRecord): boolean {
+  if (record.kind === 'grant') return !(typeof record.payload === 'string' && isSealed(record.payload))
+  if (record.key !== undefined && !isSealed(record.key)) return true
+  return Object.values(record.env ?? {}).some(value => !isSealed(value))
+}
+
+/**
+ * Seal every secret field of one record. A grant's payload is sealed as its
+ * JSON text, because the seam promises the owner the exact value back and the
+ * document's YAML shape must not learn that owner's format.
+ * @param sealer - the document's sealer.
+ * @param record - the plaintext record.
+ * @returns the record as stored.
+ */
+function sealRecord(sealer: CredentialSealer, record: CredentialRecord): CredentialRecord {
+  if (record.kind === 'grant') return { kind: 'grant', payload: sealer.seal(JSON.stringify(record.payload)) }
+  const env = record.env === undefined
+    ? undefined
+    : Object.fromEntries(Object.entries(record.env).map(([name, value]) => [name, sealer.seal(value)]))
+  return {
+    kind: 'api-key',
+    ...record.key === undefined ? {} : { key: sealer.seal(record.key) },
+    ...env === undefined ? {} : { env },
+  }
+}
+
