+// @vitest-environment jsdom
+/**
+ * The row filter's contract (CHANGES-TRACE-FILTER.md).
+ *
+ * A real task runs far more internal steps (writing the xlsx, running a
+ * script, reading a file, building a table) than Daniel capability calls. Those
+ * internal tools are not Daniel modules, so they must not become rows of their
+ * own: they fold into the task's single "整理结果" row, in time order, with no
+ * count and no tool name. A task that never called Daniel says so instead of
+ * pretending.
+ */
+import { useSyncExternalStore } from 'react'
+import type { ReactNode } from 'react'
+import { act, cleanup, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import { MODULE_MAP } from '../src/client/module-map.generated.ts'
+import {
+  CapabilityTrace, WORK_ROW_ACTION, WORK_ROW_ID, isDanielTool, isWorkRow,
+} from '../src/client/trace.ts'
+import type { TraceSnapshot } from '../src/client/trace.ts'
+import { TraceRail } from '../src/client/TraceRail.tsx'
+import { zh } from '../src/client/locales.ts'
+import type { SessionEventLikeEntry } from '@deepseek-ai/dsh-api-session-controller/client'
+
+afterEach(() => {
+  cleanup()
+})
+
+/* ── session-service fake: one event window per session ───────────────────── */
+
+/** Ordered sequence shared by the fake log entries. */
+let seq = 0
+
+/**
+ * Build one durable `tool/call` entry.
+ * @param callId - call identity.
+ * @param name - tool name as the log records it.
+ * @param args - argument value, JSON-encoded like the real log.
+ * @returns the window entry.
+ */
+function toolCall(callId: string, name: string, args: unknown = {}): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'tool/call', seq: ++seq, time: 0,
+      data: { turn: 1, step: 1, callId, name, arguments: JSON.stringify(args) },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/**
+ * Build one durable `tool/result` entry for a call.
+ * @param callId - call identity being settled.
+ * @returns the window entry.
+ */
+function toolResult(callId: string): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'tool/result', seq: ++seq, time: 0,
+      data: { turn: 1, step: 1, message: { source: { callId } } },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/**
+ * Build one `user/message` entry.
+ * @param kind - message source: `user` is the human, anything else is synthetic.
+ * @returns the window entry.
+ */
+function userMessage(kind = 'user'): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'user/message', seq: ++seq, time: 0,
+      data: { id: `m${String(seq)}`, role: 'user', content: [], source: { kind } },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/** One `turn/end` entry, which settles whatever the window left open. */
+function turnEnd(): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: { type: 'turn/end', seq: ++seq, time: 0, data: { turn: 1, reason: { kind: 'stop' } } },
+  } as unknown as SessionEventLikeEntry
+}
+
+/** One session's event window plus its subscribers. */
+class FakeSession {
+  readonly entries: SessionEventLikeEntry[] = []
+  change: { kind: 'replace' | 'append' | 'prepend'; entries: readonly SessionEventLikeEntry[] } = { kind: 'replace', entries: [] }
+  private readonly listeners = new Set<() => void>()
+
+  readonly eventSource = {
+    getSnapshot: () => ({
+      entries: this.entries, change: this.change, revision: this.entries.length, hasMore: false,
+    }),
+    subscribe: (listener: () => void) => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    },
+  }
+
+  /**
+   * @param id - session id this binding belongs to.
+   */
+  constructor(readonly id: string) {}
+
+  /** Append one entry and notify, like the live log does. */
+  push(entry: SessionEventLikeEntry): void {
+    this.entries.push(entry)
+    this.change = { kind: 'append', entries: [entry] }
+    for (const listener of [...this.listeners]) listener()
+  }
+}
+
+/** Minimal Client Session service the trace borrows from. */
+class FakeSessions {
+  readonly sessions = new Map<string, FakeSession>()
+  currentId: string | undefined
+  private readonly listeners = new Set<() => void>()
+
+  readonly list = {
+    getSnapshot: () => ({
+      ids: [...this.sessions.keys()] as never,
+      byId: Object.fromEntries([...this.sessions.keys()].map(id => [
+        id,
+        { id, retainedBy: id === this.currentId ? { mainView: 1 } : {} },
+      ])) as never,
+      phase: 'ready' as const,
+      projectionsBySession: {} as never,
+    }),
+    subscribe: (listener: () => void) => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    },
+  }
+
+  /**
+   * @param id - session id.
+   * @returns the live binding, or undefined when the session is unknown.
+   */
+  binding(id: string): { sessionId: string; eventSource: FakeSession['eventSource'] } | undefined {
+    const session = this.sessions.get(id)
+    return session === undefined ? undefined : { sessionId: id, eventSource: session.eventSource }
+  }
+
+  /**
+   * Add a session and make it current.
+   * @param id - session id.
+   * @returns the session's fake window.
+   */
+  add(id: string): FakeSession {
+    const session = new FakeSession(id)
+    this.sessions.set(id, session)
+    this.currentId = id
+    for (const listener of [...this.listeners]) listener()
+    return session
+  }
+}
+
+/**
+ * Wire a trace over a fake session service and subscribe it.
+ * @returns the trace and its event window.
+ */
+function liveTrace(): { trace: CapabilityTrace; session: FakeSession; stop: () => void } {
+  const fake = new FakeSessions()
+  const trace = new CapabilityTrace(fake as never)
+  const session = fake.add('s1')
+  const stop = trace.subscribe(() => {})
+  return { trace, session, stop }
+}
+
+/* ── rendering the rail body ─────────────────────────────────────────────── */
+
+/** Interpolate `{name}` placeholders like the locale service. */
+function translate(key: string, params?: Record<string, unknown>): string {
+  const template = (zh as Record<string, string>)[key] ?? key
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/gu, (match, name: string) => (name in params ? String(params[name]) : match))
+}
+
+/**
+ * Bind a trace feed the way the renderer binds an injected source.
+ * @param trace - the live fold.
+ * @returns the selector hook handed to the rail.
+ */
+function traceHook(trace: CapabilityTrace): never {
+  type Hook = (selector: (snapshot: TraceSnapshot) => unknown) => unknown
+  const useBound: Hook = selector => selector(useSyncExternalStore(trace.subscribe, trace.getSnapshot, trace.getSnapshot))
+  return useBound as never
+}
+
+/**
+ * Render the rail body over a live fold.
+ * @param trace - the fold to render.
+ * @returns the task section.
+ */
+function renderTask(trace: CapabilityTrace): HTMLElement {
+  function Body(): ReactNode {
+    return <TraceRail useTrace={traceHook(trace)} t={translate as never} />
+  }
+  render(<Body />)
+  return screen.getByRole('region', { name: zh['task.region'] })
+}
+
+/**
+ * Read an element's visible text with single interpolated spaces.
+ * @param element - element to read.
+ * @returns its text content, whitespace-normalized.
+ */
+function blank(element: HTMLElement): string {
+  return (element.textContent ?? '').replace(/\s+/gu, ' ').trim()
+}
+
+/**
+ * The rendered step rows of the task section.
+ * @param panel - the task section.
+ * @returns the step list items, oldest first.
+ */
+function stepRows(panel: HTMLElement): HTMLElement[] {
+  const list = within(panel).queryByRole('list', { name: zh['task.steps'] })
+  return list === null ? [] : within(list).getAllByRole('listitem')
+}
+
+/** Twelve internal actions, the shape a real "list my brands and export it" task produces. */
+const INTERNAL: readonly string[] = [
+  'bash', 'read', 'write', 'edit', 'bash', 'python', 'skill', 'web_search',
+  'web_fetch', 'bash', 'read', 'write',
+]
+
+/**
+ * Push one internal call and settle it.
+ * @param session - the event window.
+ * @param index - used for unique call ids.
+ * @param tool - tool name.
+ */
+function pushInternal(session: FakeSession, index: number, tool: string): void {
+  session.push(toolCall(`w${String(index)}`, tool, { path: `/tmp/brands-${String(index)}.xlsx` }))
+  session.push(toolResult(`w${String(index)}`))
+}
+
+/* ── classification ──────────────────────────────────────────────────────── */
+
+describe('non-Daniel tool classification', () => {
+  it('judges a call by its registered tool name, never by its arguments', () => {
+    // Registered Daniel tools: the shipped tables plus the namespace prefix.
+    expect(isDanielTool('daniel_brands_list')).toBe(true)
+    expect(isDanielTool('daniel_brand_view')).toBe(true)
+    expect(isDanielTool('daniel_run')).toBe(true)
+    expect(isDanielTool('daniel_skills_read')).toBe(true)
+    // Host tools are internal work, however Daniel-shaped the arguments look.
+    expect(isDanielTool('bash')).toBe(false)
+    expect(isDanielTool('read')).toBe(false)
+    expect(isDanielTool('write')).toBe(false)
+    expect(isDanielTool('python')).toBe(false)
+    expect(isDanielTool('skill')).toBe(false)
+    expect(isDanielTool('web_search')).toBe(false)
+    expect(isDanielTool('toString')).toBe(false)
+    // The bridge tables are the registered-tool list the prefix is checked against.
+    expect(Object.keys(MODULE_MAP.toolCommands).every(tool => isDanielTool(tool))).toBe(true)
+    expect(Object.keys(MODULE_MAP.toolRules).every(tool => isDanielTool(tool))).toBe(true)
+  })
+})
+
+/* ── the fold ────────────────────────────────────────────────────────────── */
+
+describe('internal work folds into one row', () => {
+  it('gives a non-Daniel tool no row of its own', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('b1', 'bash', { command: 'ls -la /tmp' }))
+    session.push(toolResult('b1'))
+    session.push(toolCall('r1', 'read', { path: '/tmp/brands.json' }))
+    session.push(toolResult('r1'))
+
+    const steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]).toMatchObject({
+      id: WORK_ROW_ID, module: null, action: WORK_ROW_ACTION, status: 'done',
+    })
+    // No argument, command, or tool name reaches the published row.
+    for (const marker of ['ls', 'tmp', 'brands.json', 'bash', 'read']) {
+      expect(steps[0]?.action).not.toContain(marker)
+    }
+    stop()
+  })
+
+  it('merges ten consecutive internal actions into one 整理结果 row', () => {
+    const { trace, session, stop } = liveTrace()
+    // Ten starts, no results yet: still exactly one row, and it is running.
+    for (let index = 0; index < 10; index += 1) {
+      session.push(toolCall(`w${String(index)}`, INTERNAL[index] ?? 'bash', { path: `/tmp/${String(index)}.xlsx` }))
+    }
+    let steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]).toMatchObject({ id: WORK_ROW_ID, action: WORK_ROW_ACTION, status: 'running' })
+    expect(trace.getSnapshot().running).toBe(true)
+
+    // Settling them one by one keeps the single row, then retires it.
+    for (let index = 0; index < 10; index += 1) session.push(toolResult(`w${String(index)}`))
+    steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]?.status).toBe('done')
+    expect(trace.getSnapshot().running).toBe(false)
+    // No count, no "steps", no tool name is written into it.
+    expect(steps[0]?.action).not.toMatch(/\d/u)
+    expect(steps[0]?.action).not.toContain('步')
+    expect(steps[0]?.action).not.toContain('次')
+    stop()
+  })
+
+  it('keeps time order when Daniel and internal steps interleave', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('c1', 'daniel_run', { argv: ['brands', 'list'] }))
+    session.push(toolResult('c1'))
+    pushInternal(session, 0, 'bash')
+    session.push(toolCall('c2', 'daniel_run', { argv: ['sov', 'overview'] }))
+    session.push(toolResult('c2'))
+    pushInternal(session, 1, 'write')
+
+    const steps = trace.getSnapshot().steps
+    // The folded row sits where the internal work started, between the two
+    // Daniel steps — not appended at the end of the path.
+    expect(steps.map(step => step.id)).toEqual(['c1', WORK_ROW_ID, 'c2'])
+    expect(steps.map(step => step.action)).toEqual(['读取品牌列表', WORK_ROW_ACTION, '查看声量总览'])
+    expect(steps[1]?.module).toBeNull()
+    expect(steps[2]?.module).not.toBeNull()
+    // A later internal burst updates the same row instead of appending another.
+    expect(steps.filter(step => isWorkRow(step))).toHaveLength(1)
+    stop()
+  })
+
+  it('settles the folded row on turn/end and clears it on a new human message', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('w1', 'bash', { command: 'python build.py' }))
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: WORK_ROW_ID, status: 'running', module: null })
+    session.push(turnEnd())
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: WORK_ROW_ID, status: 'done' })
+
+    // The next human prompt starts a new task: the folded row is gone.
+    session.push(userMessage('user'))
+    expect(trace.getSnapshot()).toMatchObject({ task: 1, running: false, steps: [] })
+
+    session.push(toolCall('w2', 'read', { path: '/tmp/a.csv' }))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: WORK_ROW_ID, status: 'running' })
+    stop()
+  })
+
+  it('merges consecutive Daniel calls the map cannot name into one fallback row', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('d1', 'daniel_skills_read', { name: 'kol-screening' }))
+    session.push(toolCall('d2', 'daniel_skills_list', {}))
+    session.push(toolCall('d3', 'daniel_run', { argv: ['auth', 'status'] }))
+    let steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]).toMatchObject({ id: 'd1', module: null, action: MODULE_MAP.fallback.action, status: 'running' })
+
+    // The shared row stays running until the last of its calls settles.
+    session.push(toolResult('d2'))
+    session.push(toolResult('d1'))
+    expect(trace.getSnapshot().steps[0]?.status).toBe('running')
+    session.push(toolResult('d3'))
+    steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]?.status).toBe('done')
+    stop()
+  })
+
+  it('keeps a row for a Daniel call the map cannot place instead of folding it', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('d1', 'daniel_skills_read', { name: 'kol-screening' }))
+    session.push(toolResult('d1'))
+    pushInternal(session, 0, 'bash')
+    session.push(toolCall('d2', 'daniel_skills_list', {}))
+    session.push(toolResult('d2'))
+
+    const steps = trace.getSnapshot().steps
+    expect(steps.map(step => step.id)).toEqual(['d1', WORK_ROW_ID, 'd2'])
+    expect(steps[0]?.action).toBe(MODULE_MAP.fallback.action)
+    expect(steps[2]?.action).toBe(MODULE_MAP.fallback.action)
+    expect(steps[1]?.action).toBe(WORK_ROW_ACTION)
+    stop()
+  })
+})
+
+/* ── the rendered rail ───────────────────────────────────────────────────── */
+
+describe('rendered task path', () => {
+  it('shows the real shape — one brand list plus twelve internal actions — as two rows', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('c1', 'daniel_brands_list', { workspace: 90002 }))
+    session.push(toolResult('c1'))
+    for (let index = 0; index < 12; index += 1) pushInternal(session, index, INTERNAL[index] ?? 'bash')
+
+    const panel = renderTask(trace)
+    const rows = stepRows(panel)
+    expect(rows).toHaveLength(2)
+    expect(rows[0]?.textContent).toContain('读取品牌列表')
+    expect(rows[0]?.textContent).toContain('品牌档案')
+    expect(rows[1]?.textContent).toBe(`${WORK_ROW_ACTION}已完成`)
+    expect(rows[1]?.getAttribute('data-row')).toBe('work')
+
+    const text = blank(panel)
+    expect(text).not.toContain('正在处理…')
+    expect(text).not.toContain(MODULE_MAP.fallback.module)
+    stop()
+  })
+
+  it('says 本次未调用 Daniel 能力 once a Daniel-free task settles', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('w0', 'bash', { command: 'node build.js' }))
+    const panel = renderTask(trace)
+
+    // Internal work is still running: the rail makes no claim about the task.
+    expect(blank(panel)).not.toContain(zh['task.noDaniel'])
+    act(() => { session.push(toolResult('w0')) })
+    expect(blank(panel)).toContain(zh['task.noDaniel'])
+    expect(stepRows(panel)).toHaveLength(1)
+    expect(stepRows(panel)[0]?.textContent).toBe(`${WORK_ROW_ACTION}已完成`)
+    // The nine modules stay untouched: internal work lights nothing.
+    expect(panel.querySelectorAll('[data-state="used"], [data-state="active"]')).toHaveLength(0)
+
+    // The note is not sticky: a settled Daniel step removes it.
+    act(() => {
+      session.push(toolCall('c9', 'daniel_run', { argv: ['brands', 'list'] }))
+      session.push(toolResult('c9'))
+    })
+    expect(blank(panel)).not.toContain(zh['task.noDaniel'])
+    stop()
+  })
+
+  it('writes no count, tool name, or command into the path', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('c1', 'daniel_brands_list', { workspace: 90002 }))
+    session.push(toolResult('c1'))
+    for (let index = 0; index < 12; index += 1) pushInternal(session, index, INTERNAL[index] ?? 'bash')
+    session.push(turnEnd())
+
+    const text = blank(renderTask(trace))
+    for (const marker of ['bash', 'read', 'write', 'edit', 'python', 'skill', 'web_search',
+      'web_fetch', 'xlsx', 'tmp', '--', '_', 'argv', '含', '步']) {
+      expect(text).not.toContain(marker)
+    }
+    // "N 次" belongs to the module panorama only, never to the task path.
+    expect(/[0-9０-９]+\s*次/u.test(text)).toBe(false)
+    expect(text).not.toMatch(/整理结果\s*[（(]\s*[0-9]/u)
+    stop()
+  })
+
+  it('keeps the folded row as a finished step after the task ends', () => {
+    const { trace, session, stop } = liveTrace()
+    pushInternal(session, 0, 'write')
+    session.push(turnEnd())
+    const panel = renderTask(trace)
+    expect(panel.getAttribute('data-state')).toBe('done')
+    expect(blank(panel)).toContain('上次')
+    expect(stepRows(panel)[0]?.getAttribute('data-status')).toBe('done')
+    // The row carries no module tag: it is not one of the nine modules.
+    expect(stepRows(panel)[0]?.getAttribute('data-row')).toBe('work')
+    expect(stepRows(panel)[0]?.getAttribute('aria-label')).toBe(`${WORK_ROW_ACTION}，${zh['task.step.done']}`)
+    stop()
+  })
+})
