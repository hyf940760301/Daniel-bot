+import {
+  ContextSelection, EMPTY_SELECTION, SELECTION_STORAGE_KEY, promptSelectionOf, readStoredSelection, writeStoredSelection,
+  type BrandOption, type WorkspaceOption,
+} from '../src/client/selection.ts'
+import { EMPTY_CONTEXT, type ContextSnapshot } from '../src/client/context.ts'
+import { zh } from '../src/client/locales.ts'
+import { SessionInputShell } from '../../ui-conversation/src/client/input/facade.ts'
+import { ComposerSendGuardRegistry } from '../../ui-conversation/src/client/input/send-guard.ts'
+import type { SubmitOutcome } from '../../ui-conversation/src/client/contract/input.ts'
+
+const BAR_CSS = 'packages/client/ui-capability-map/src/client/ContextBar.module.css'
+const SELECTOR_CSS = 'packages/client/ui-capability-map/src/client/Selector.module.css'
+
+const t = (key: string, values?: Record<string, string | number>): string => {
+  const text = (zh as Record<string, string>)[key] ?? key
+  if (values === undefined) return text
+  return text.replace(/\{(\w+)\}/gu, (_match, name: string) => String(values[name] ?? ''))
+}
+
+/** A session fold a test drives by hand. */
+class FakeFeed implements HostObservable<ContextSnapshot> {
+  private readonly listeners = new Set<() => void>()
+  snapshot: ContextSnapshot = EMPTY_CONTEXT
+
+  readonly getSnapshot = (): ContextSnapshot => this.snapshot
+
+  readonly subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  /**
+   * Publish one fold value and notify.
+   * @param next - fields to merge into the snapshot.
+   */
+  set(next: Partial<ContextSnapshot>): void {
+    this.snapshot = { ...this.snapshot, ...next }
+    for (const listener of [...this.listeners]) listener()
+  }
+}
+
+/** Binding the renderer performs for an injected `hooks.*` feed. */
+function bind<T>(feed: HostObservable<T>): (selector: (value: T) => unknown) => unknown {
+  return selector => useSyncExternalStore(feed.subscribe, () => selector(feed.getSnapshot()), () => selector(feed.getSnapshot()))
+}
+
+const WORKSPACES: readonly WorkspaceOption[] = [
+  { id: 90002, name: 'jack' },
+  { id: 90003, name: 'mike' },
+]
+const BRANDS: readonly BrandOption[] = [
+  { id: '4800023', name: 'Halliday', workspaceId: 90002 },
+  { id: '4800024', name: 'RingConn', workspaceId: 90002 },
+]
+
+/** A bridge whose two reads the test controls. */
+function fakeBridge(options: {
+  workspaces?: readonly WorkspaceOption[]
+  brands?: readonly BrandOption[]
+  workspacesFail?: boolean
+  brandFail?: boolean
+} = {}) {
+  const calls: string[] = []
+  return {
+    calls,
+    danielWorkspaces: vi.fn(() => {
+      calls.push('workspaces')
+      return Promise.resolve(options.workspacesFail === true
+        ? { ok: false as const, reason: { kind: 'cli' as const, message: '登录已过期' } }
+        : { ok: true as const, items: options.workspaces ?? WORKSPACES })
+    }),
+    danielBrands: vi.fn(() => {
+      calls.push('brands')
+      return Promise.resolve(options.brandFail === true
+        ? { ok: false as const, reason: { kind: 'timeout' as const } }
+        : { ok: true as const, items: options.brands ?? BRANDS })
+    }),
+  }
+}
+
+/** Wait for the bridge read to settle (the dropdown lists hydrate asynchronously). */
+async function ready(store: ContextSelection): Promise<void> {
+  store.start()
+  await vi.waitFor(() => { expect(store.getSnapshot().loading).toBe(false) })
+}
+
+/** Give the store a selection without going through the UI. */
+function seed(selection: { workspace: WorkspaceOption; brand: BrandOption }): void {
+  localStorage.setItem(SELECTION_STORAGE_KEY, JSON.stringify(selection))
+}
+
+/**
+ * Render the bar over one store and feed.
+ * @param store - the real selection store.
+ * @param feed - the session fold.
+ * @returns the render result plus the actions the bar calls.
+ */
+function renderBar(store: ContextSelection, feed: FakeFeed): ReturnType<typeof render> & { actions: ContextBarActions } {
+  const actions: ContextBarActions = {
+    setOpen: kind => { store.setOpen(kind) },
+    chooseWorkspace: id => { store.chooseWorkspace(id) },
+    chooseBrand: id => { store.chooseBrand(id) },
+    refresh: () => { void store.refresh() },
+    switchToDetected: () => { store.switchToDetected() },
+    keepDetected: () => { store.keepDetected() },
+    dismissKept: () => { store.dismissKept() },
+  }
+  const view = render(
+    <ContextBar t={t as never} useContext={bind(feed) as never} useSelection={bind(store) as never} actions={actions} />,
+  )
+  return Object.assign(view, { actions })
+}
+
+beforeEach(() => {
+  localStorage.clear()
+})
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+})
+
+describe('selector rendering', () => {
+  it('renders two 32px selectors and says 未选择 in the dashed state', () => {
+    const store = new ContextSelection({ bridge: fakeBridge() })
+    const bar = renderBar(store, new FakeFeed()).container
+    const workspace = bar.querySelector('[data-selector="workspace"]')
+    const brand = bar.querySelector('[data-selector="brand"]')
+    expect(workspace).not.toBeNull()
+    expect(brand).not.toBeNull()
+    expect(workspace?.getAttribute('data-selected')).toBe('false')
+    expect(brand?.getAttribute('data-selected')).toBe('false')
+    expect(workspace?.textContent).toContain('工作区')
+    expect(workspace?.textContent).toContain('未选择')
+    const cssText = readFileSync(SELECTOR_CSS, 'utf8')
+    // The measured specs are in the stylesheet, and the dashed state owns its border.
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bheight:\s*32px/u)
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bpadding:\s*0 10px/u)
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bborder:\s*1px solid #E5E6EB/u)
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bborder-radius:\s*8px/u)
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bfont-size:\s*13px/u)
+    expect(cssText).toMatch(/\.trigger\s*\{[^}]*\bfont-weight:\s*500/u)
+    expect(cssText).toMatch(/\.trigger:hover\s*\{[^}]*\bbackground:\s*#F5F6F7/u)
+    expect(cssText).toMatch(/\.empty\s*\{[^}]*\bborder-style:\s*dashed/u)
+    expect(cssText).toMatch(/\.empty\s*\{[^}]*\bborder-color:\s*#C9CDD4/u)
