+/**
+ * Read the declaration bodies of every rule written with this exact selector.
+ * A grouped rule matches on its first, comma-terminated, or last,
+ * brace-terminated line; a selector that also appears in a later standalone
+ * rule therefore returns both bodies.
+ * @param cssText - the stylesheet source.
+ * @param selector - the selector to look up, exactly as written.
+ * @returns the text from each matching rule's `{` to its `}`.
+ */
+function ruleOf(cssText: string, selector: string): string {
+  const lines = cssText.split('\n')
+  const bodies: string[] = []
+  for (const [index, line] of lines.entries()) {
+    const opened = line.trim()
+    if (opened !== selector && opened !== `${selector},` && opened !== `${selector} {`) continue
+    const body = lines.slice(index).join('\n')
+    const open = body.indexOf('{')
+    bodies.push(body.slice(open, body.indexOf('}', open)))
+  }
+  if (bodies.length === 0) throw new Error(`missing rule: ${selector}`)
+  return bodies.join('\n')
+}
