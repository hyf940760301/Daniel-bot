+/**
+ * The seal/unseal facade over an ordered cipher list. The first cipher seals
+ * new values; every listed cipher may open an envelope, so a document written
+ * under a scheme that is no longer preferred stays readable.
+ */
+export class CredentialSealer {
+  private readonly byTag: ReadonlyMap<number, CredentialCipher>
+
+  /**
+   * @param ciphers - ciphers in preference order; empty means encryption is unavailable for writing.
+   * @param unavailableReason - why no cipher resolved, quoted by the refused-write error.
+   */
