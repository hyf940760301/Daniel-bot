+++ b/apps/desktop/tests/window-state.spec.ts
@@ -0,0 +1,258 @@
+import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import * as fs from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { readDesktopSettings, saveDesktopWindowPlacement } from '../src/settings.ts'
+import {
+  createPlacementWriter,
+  DEFAULT_MAIN_WINDOW_SIZE,
+  MIN_MAIN_WINDOW_SIZE,
+  parseWindowPlacement,
+  readWindowPlacement,
+  resolveWindowGeometry,
+  restoreMaximizedState,
+  WINDOW_PLACEMENT_DELAY_MS,
+} from '../src/window-state.ts'
+
+vi.mock('node:fs', async importOriginal => ({ ...await importOriginal<typeof import('node:fs')>() }))
+
+/** A 1512x945 laptop work area under a 25px menu bar. */
+const primary = { x: 0, y: 25, width: 1512, height: 945 }
+/** A 1920x1080 external display to the right of {@link primary}. */
+const external = { x: 1512, y: 0, width: 1920, height: 1080 }
+
+beforeEach(() => { vi.spyOn(console, 'warn').mockImplementation(() => {}) })
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+function fixture() {
+  const userData = mkdtempSync(join(tmpdir(), 'dsh-desktop-window-'))
+  onTestFinished(() => { rmSync(userData, { recursive: true, force: true }) })
+  const directory = join(userData, 'desktop')
+  mkdirSync(directory)
+  return { userData, path: join(directory, 'settings.json') }
+}
+
+describe('first launch', () => {
+  it('uses 1360x780 with no position and not maximized when nothing was recorded', () => {
+    expect(resolveWindowGeometry(undefined, primary, [primary])).toEqual({
+      width: 1360,
+      height: 780,
+      maximized: false,
+    })
+    expect(DEFAULT_MAIN_WINDOW_SIZE).toEqual({ width: 1360, height: 780 })
+  })
+
+  it('keeps the window floor unchanged', () => {
+    expect(MIN_MAIN_WINDOW_SIZE).toEqual({ width: 520, height: 600 })
+  })
+})
+
+describe('restore', () => {
+  it('reuses a valid recorded size, position and maximize flag', () => {
+    const saved = { width: 1000, height: 700, x: 100, y: 60, maximized: false }
+    expect(resolveWindowGeometry(saved, primary, [primary])).toEqual(saved)
+  })
+
+  it('clamps an oversized record to the owning work area', () => {
+    const saved = { width: 4000, height: 3000, x: 0, y: 25, maximized: false }
+    expect(resolveWindowGeometry(saved, primary, [primary])).toMatchObject({ width: 1512, height: 945 })
+  })
+
+  it('clamps an undersized record up to the minWidth/minHeight floor', () => {
+    const saved = { width: 100, height: 100, x: 0, y: 25, maximized: false }
+    expect(resolveWindowGeometry(saved, primary, [primary])).toMatchObject({ width: 520, height: 600 })
+  })
+
+  it('clamps to the secondary display that owns the saved position', () => {
+    const saved = { width: 1600, height: 900, x: 1600, y: 50, maximized: false }
+    const geometry = resolveWindowGeometry(saved, primary, [primary, external])
+    expect(geometry).toMatchObject({ width: 1600, height: 900, x: 1600, y: 50 })
+    const oversized = resolveWindowGeometry({ ...saved, width: 3000, height: 2000 }, primary, [primary, external])
+    expect(oversized).toMatchObject({ width: 1920, height: 1080 })
+  })
+
+  it('discards a position that no display can show and lets the platform center the window', () => {
+    const saved = { width: 1200, height: 800, x: 5000, y: 4000, maximized: false }
+    const geometry = resolveWindowGeometry(saved, primary, [primary, external])
+    expect(geometry).toEqual({ width: 1200, height: 800, maximized: false })
+    expect('x' in geometry).toBe(false)
+    expect('y' in geometry).toBe(false)
+  })
+
+  it('keeps a position on a display left of the primary, where coordinates are negative', () => {
+    const left = { x: -1920, y: 0, width: 1920, height: 1080 }
+    const saved = { width: 1200, height: 800, x: -1900, y: 100, maximized: false }
+    expect(resolveWindowGeometry(saved, primary, [primary, left])).toMatchObject({ x: -1900, y: 100 })
+  })
+
+  it('maximizes an already maximized record instead of restoring its bounds', () => {
+    const maximize = vi.fn()
+    const geometry = resolveWindowGeometry({ width: 1200, height: 800, maximized: true }, primary, [primary])
+    restoreMaximizedState({ maximize }, geometry)
+    expect(maximize).toHaveBeenCalledTimes(1)
+  })
+
+  it('leaves a normal record unmaximized', () => {
+    const maximize = vi.fn()
+    restoreMaximizedState({ maximize }, resolveWindowGeometry(undefined, primary, [primary]))
+    expect(maximize).not.toHaveBeenCalled()
+  })
+})
+
+describe('validation', () => {
+  it.each([
+    null,
+    'window',
+    [],
+    {},
+    { width: 1000, height: 700 },
+    { width: '1000', height: 700, maximized: false },
+    { width: 1000, height: 700, maximized: 'yes' },
+    { width: 1000.5, height: 700, maximized: false },
+    { width: 0, height: 700, maximized: false },
+    { width: 1000, height: 700, x: 10, maximized: false },
+  ])('rejects a malformed record instead of guessing: %o', (raw) => {
+    expect(parseWindowPlacement(raw)).toBeUndefined()
+  })
+
+  it('accepts a position-only shape and a full record', () => {
+    expect(parseWindowPlacement({ width: 900, height: 650, maximized: true }))
+      .toEqual({ width: 900, height: 650, maximized: true })
+    expect(parseWindowPlacement({ width: 900, height: 650, x: -12, y: 0, maximized: false }))
+      .toEqual({ width: 900, height: 650, x: -12, y: 0, maximized: false })
+  })
+
+  it('reads the normal bounds of a maximized window and skips moments that would overwrite good geometry', () => {
+    const window = {
+      isDestroyed: () => false,
+      isMinimized: () => false,
+      isFullScreen: () => false,
+      isMaximized: () => true,
+      getNormalBounds: () => ({ x: 40, y: 30, width: 1200, height: 800 }),
+    }
+    expect(readWindowPlacement(window)).toEqual({ width: 1200, height: 800, x: 40, y: 30, maximized: true })
+    for (const moment of ['isMinimized', 'isFullScreen', 'isDestroyed'] as const) {
+      expect(readWindowPlacement({ ...window, [moment]: () => true })).toBeUndefined()
+    }
+  })
+})
+
+describe('persistence', () => {
+  it('keeps an old settings document without a window field intact and does not warn', () => {
+    const { userData, path } = fixture()
+    const raw = '{"updates":{"allowTestAuthPopupWindow":true},"custom":"preserve"}'
+    writeFileSync(path, raw)
+    const settings = readDesktopSettings(userData)
+    expect(settings.updates.allowTestAuthPopupWindow).toBe(true)
+    expect(settings.window).toBeUndefined()
+    expect(console.warn).not.toHaveBeenCalled()
+    expect(readFileSync(path, 'utf8')).toBe(raw)
+  })
+
+  it('saves the placement atomically without dropping other settings fields', () => {
+    const { userData, path } = fixture()
+    const directoryPath = join(userData, 'desktop')
+    writeFileSync(path, '{"updates":{"allowTestAuthPopupWindow":true},"custom":"preserve"}')
+    saveDesktopWindowPlacement(userData, { width: 1000, height: 700, x: 100, y: 60, maximized: true })
+    expect(JSON.parse(readFileSync(path, 'utf8'))).toEqual({
+      updates: { allowTestAuthPopupWindow: true },
+      custom: 'preserve',
+      window: { width: 1000, height: 700, x: 100, y: 60, maximized: true },
+    })
+    // The rename leaves no temporary sibling behind.
+    expect(readdirSync(directoryPath).sort()).toEqual(['settings.json'])
+    expect(readDesktopSettings(userData).window).toEqual({ width: 1000, height: 700, x: 100, y: 60, maximized: true })
+  })
+
+  it('creates the settings document when the placement is the first thing ever saved', () => {
+    const { userData, path } = fixture()
+    rmSync(join(userData, 'desktop'), { recursive: true })
+    saveDesktopWindowPlacement(userData, { width: 1360, height: 780, maximized: false })
+    expect(JSON.parse(readFileSync(path, 'utf8'))).toEqual({ window: { width: 1360, height: 780, maximized: false } })
+  })
+
+  it('falls back to the defaults for corrupt JSON without throwing or rewriting the file', () => {
+    const { userData, path } = fixture()
+    writeFileSync(path, '{')
+    expect(readDesktopSettings(userData)).toEqual({ updates: { allowTestAuthPopupWindow: false } })
+    expect(readFileSync(path, 'utf8')).toBe('{')
+  })
+
+  it('ignores an invalid window field but keeps the rest of the document', () => {
+    const { userData, path } = fixture()
+    const raw = '{"updates":{"allowTestAuthPopupWindow":true},"window":{"width":"wide","height":700,"maximized":false}}'
+    writeFileSync(path, raw)
+    const settings = readDesktopSettings(userData)
+    expect(settings).toEqual({ updates: { allowTestAuthPopupWindow: true } })
+    expect(console.warn).toHaveBeenCalledWith(expect.stringContaining(path))
+    expect(readFileSync(path, 'utf8')).toBe(raw)
+  })
+
+  it('warns instead of throwing when the atomic replace fails, and leaves the old document', () => {
+    const { userData, path } = fixture()
+    const raw = '{"updates":{"allowTestAuthPopupWindow":false}}'
+    writeFileSync(path, raw)
+    const failure = Object.assign(new Error('replace denied'), { code: 'EACCES' })
+    vi.spyOn(fs, 'renameSync').mockImplementation(() => { throw failure })
+    expect(() => { saveDesktopWindowPlacement(userData, { width: 900, height: 650, maximized: false }) }).not.toThrow()
+    expect(console.warn).toHaveBeenCalledWith(expect.stringContaining(path), failure)
+    expect(readFileSync(path, 'utf8')).toBe(raw)
+    expect(readdirSync(join(userData, 'desktop'))).toEqual(['settings.json'])
+  })
+})
+
+describe('debounce', () => {
+  it('coalesces a burst of resize events into a single write', () => {
+    vi.useFakeTimers()
+    const write = vi.fn()
+    const writer = createPlacementWriter({
+      read: () => ({ width: 1000, height: 700, x: 0, y: 25, maximized: false }),
+      write,
+    })
+    for (let index = 0; index < 5; index += 1) writer.schedule()
+    vi.advanceTimersByTime(WINDOW_PLACEMENT_DELAY_MS - 1)
+    expect(write).not.toHaveBeenCalled()
+    vi.advanceTimersByTime(1)
+    expect(write).toHaveBeenCalledTimes(1)
+    expect(write).toHaveBeenCalledWith({ width: 1000, height: 700, x: 0, y: 25, maximized: false })
+  })
+
+  it('writes immediately on demand and cancels the pending debounce', () => {
+    vi.useFakeTimers()
+    const write = vi.fn()
+    const writer = createPlacementWriter({ read: () => ({ width: 900, height: 650, maximized: true }), write })
+    writer.schedule()
+    writer.writeNow()
+    expect(write).toHaveBeenCalledTimes(1)
+    vi.advanceTimersByTime(WINDOW_PLACEMENT_DELAY_MS * 2)
+    expect(write).toHaveBeenCalledTimes(1)
+  })
+
+  it('skips the write when the window cannot describe its geometry', () => {
+    vi.useFakeTimers()
+    const write = vi.fn()
+    const writer = createPlacementWriter({ read: () => undefined, write })
+    writer.writeNow()
+    writer.schedule()
+    vi.advanceTimersByTime(WINDOW_PLACEMENT_DELAY_MS)
+    expect(write).not.toHaveBeenCalled()
+  })
+
+  it('stops writing once disposed', () => {
+    vi.useFakeTimers()
+    const write = vi.fn()
+    const writer = createPlacementWriter({
+      read: () => ({ width: 900, height: 650, maximized: false }),
+      write,
+    })
+    writer.schedule()
+    writer.dispose()
+    vi.advanceTimersByTime(WINDOW_PLACEMENT_DELAY_MS * 2)
+    writer.writeNow()
+    expect(write).not.toHaveBeenCalled()
+  })
+})
