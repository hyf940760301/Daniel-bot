new file mode 100644
index 00000000..9f11317b
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/prefill.ts
@@ -0,0 +1,113 @@
+/**
+ * The one write the panorama dialog is allowed to make: put an example phrase
+ * into the conversation composer, and nothing else.
+ *
+ * Path (see CHANGES-GUIDE.md §3): the Conversation plugin publishes the
+ * per-session input machine on the Session scope it retains —
+ * `ctx.conversation.input.for(scope)` — and `SessionInput.setDraft` is
+ * documented there as the programmatic-write verb ("Replace the whole draft
+ * (persisted-draft seed and programmatic writes)", contract/input.ts). That is
+ * a supported store action, not a DOM poke: no querySelector, no synthetic
+ * keyboard event, no `submit()`, no `send()`. The draft is private to the
+ * browser until the human presses Enter, so the dialog cannot send a message
+ * even by accident.
+ *
+ * The conversation service is resolved lazily and structurally: this package
+ * does not depend on ui-conversation at run time, and a shell without a
+ * composer simply answers "unavailable" instead of failing the rail.
+ */
+import type { ISessions } from '@deepseek-ai/dsh-api-session-controller/client'
+import { currentSessionId } from './trace.ts'
+
+/** Outcome of one prefill attempt. */
+export type PrefillResult = 'filled' | 'unavailable'
+
+/** The composer face this bridge needs; the rest of the input machine is not borrowed. */
+interface ComposerInput {
+  /** Replace the whole draft with plain text (the supported programmatic write). */
+  setDraft(text: string): void
+  /** Return the keyboard to the composer with its last caret. */
+  focus(): void
+  /** Published input state; `draft` is the clipboard projection of the editor. */
+  readonly state: { getSnapshot(): { readonly draft: string } }
+}
+
+/** The slice of `ctx.conversation` this bridge reads. */
+interface ConversationFace {
+  readonly input: { for(scope: unknown): ComposerInput }
+}
+
+/** The slice of the Client Session service this bridge reads. */
+export interface PrefillSessions {
+  readonly list: ISessions['list']
+  readonly scope: (id: Parameters<ISessions['scope']>[0]) => { get(name: string): unknown } | undefined
+}
+
+/**
+ * Resolve the current conversation's composer without touching it.
+ * @param sessions - the Client Session service.
+ * @returns the composer face, or undefined when this shell has no live session/composer.
+ */
+function resolveComposer(sessions: PrefillSessions): ComposerInput | undefined {
+  const sessionId = currentSessionId(sessions.list.getSnapshot())
+  if (sessionId === undefined) return undefined
+  const scope = sessions.scope(sessionId)
+  if (scope === undefined) return undefined
+  const conversation = scope.get('conversation') as ConversationFace | undefined
+  if (conversation === undefined) return undefined
+  try {
+    return conversation.input.for(scope)
+  } catch {
+    // No retained Session binding (or the plugin unloaded mid-click).
+    return undefined
+  }
+}
+
+/**
+ * Put one phrase into the current conversation's composer, unsent.
+ *
+ * A draft the human already typed is kept: the phrase is appended on its own
+ * line, because losing typed text would be worse than a longer draft. Empty
+ * draft ⇒ the phrase alone. Either way the composer is focused so `Enter`
+ * sends immediately.
+ * @param sessions - the Client Session service (resolution only).
+ * @param phrase - the example phrase to place in the composer.
+ * @returns 'filled' when the draft was written, 'unavailable' when this shell has no composer.
+ */
+export function prefillDraft(sessions: PrefillSessions, phrase: string): PrefillResult {
+  const text = phrase.trim()
+  if (text === '') return 'unavailable'
+  const input = resolveComposer(sessions)
+  if (input === undefined) return 'unavailable'
+  const existing = input.state.getSnapshot().draft
+  try {
+    input.setDraft(existing.trim() === '' ? text : `${existing}\n${text}`)
+  } catch {
+    return 'unavailable'
+  }
+  try {
+    input.focus()
+  } catch {
+    // A composer that is not mounted cannot take focus; the draft still landed.
+  }
+  return 'filled'
+}
+
+/**
+ * Give the keyboard back to the composer after an overlay took it. The dialog
+ * closes after a successful fill, and the shared modal layer restores focus to
+ * its opener on unmount, so the caller re-asserts the composer once the card
+ * is gone.
+ * @param sessions - the Client Session service (resolution only).
+ * @returns whether a composer took focus.
+ */
+export function focusComposer(sessions: PrefillSessions): boolean {
+  const input = resolveComposer(sessions)
+  if (input === undefined) return false
+  try {
+    input.focus()
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/packages/client/ui-capability-map/src/client/selection.ts b/packages/client/ui-capability-map/src/client/selection.ts
new file mode 100644
index 00000000..9618cb71
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/selection.ts
@@ -0,0 +1,551 @@
+/**
+ * The top bar's explicit workspace + brand selection (design §9).
+ *
+ * The strip used to *report* what a task produced; it now has to *ask* first,
+ * because every read and write needs both halves of the address. This module
+ * owns that answer:
+ *
+ * - **Both are required.** No workspace or no brand means the composer refuses
+ *   to send (`attemptSend`), and the inline notice above the input offers the
+ *   one pick that is missing. Picking never sends by itself.
+ * - **Options come from the desktop bridge when it exists.** `window.__dshDesktop`
+ *   exposes two read-only IPC channels (`daniel:workspaces`, `daniel:brands`).
+ *   A web build has no bridge, so the dropdown falls back to the ids and names
+ *   this session has already seen in tool results (`context.ts`) and says
+ *   「仅显示本次会话见过的」 — never a fabricated list.
+ * - **The choice survives a restart.** It is written to `localStorage` under
+ *   {@link SELECTION_STORAGE_KEY} and restored on the next launch.
+ * - **A mismatch is a question, not a switch.** When a tool result names a
+ *   different workspace/brand than the current choice, the bar raises one
+ *   prompt for that object (once per session), and only a click moves the
+ *   selection. 保持 keeps the choice and tags the result.
+ *
+ * Nothing here performs a request: loading the bridge is the only I/O, and it
+ * is read-only.
+ */
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ClientSelection } from '@deepseek-ai/dsh-api-session-controller/types'
+import type { ContextBrand, ContextFeed, ContextSnapshot, ContextWorkspace } from './context.ts'
+
+/** Which of the two selectors a value or an action belongs to. */
+export type SelectorKind = 'workspace' | 'brand'
+
+/** One workspace the account can see. */
+export interface WorkspaceOption {
+  readonly id: number
+  readonly name: string
+}
+
+/** One brand, with the workspace that owns it when the CLI reports one. */
+export interface BrandOption {
+  readonly id: string
+  readonly name: string
+  readonly workspaceId?: number
+}
+
+/** Why a bridge read failed, in the shape the Rust-free renderer can switch on. */
+export interface BridgeFailure {
+  readonly kind: 'timeout' | 'cli' | 'malformed'
+  readonly message?: string
+}
+
+/** Settled result of one list read: rows or a typed failure, never a throw. */
+export type OptionQuery<T> =
+  | { readonly ok: true; readonly items: readonly T[] }
+  | { readonly ok: false; readonly reason: BridgeFailure }
+
+/** The read-only desktop bridge (`window.__dshDesktop`). */
+export interface DanielDesktopBridge {
+  /**
+   * @param refresh - bypass the main process's 60s cache.
+   * @returns the account's workspaces.
+   */
+  danielWorkspaces(refresh?: boolean): Promise<OptionQuery<WorkspaceOption>>
+  /**
+   * @param refresh - bypass the main process's 60s cache.
+   * @returns the brands the index lists.
+   */
+  danielBrands(refresh?: boolean): Promise<OptionQuery<BrandOption>>
+}
+
+/** Persistence key: one machine, one remembered pair. */
+export const SELECTION_STORAGE_KEY = 'dsh.daniel.workspace-brand.v1'
+
+/** What is remembered between launches. */
+export interface StoredSelection {
+  readonly workspace?: WorkspaceOption
+  readonly brand?: BrandOption
+}
+
+/** A detected context the user has not accepted yet. */
+export interface DetectedContext {
+  /** The workspace the tool result named. */
+  readonly workspace: WorkspaceOption
+  /** The brand the tool result named, when it named one. */
+  readonly brand: BrandOption | undefined
+}
+
+/** The published shape the bar and the inline notice read. */
+export interface SelectionSnapshot {
+  readonly workspace: WorkspaceOption | undefined
+  readonly brand: BrandOption | undefined
+  readonly workspaces: readonly WorkspaceOption[]
+  readonly brands: readonly BrandOption[]
+  /** Where the option lists came from; `session` is the web fallback. */
+  readonly source: 'desktop' | 'session'
+  readonly loading: boolean
+  /** Why the last bridge read failed, already localized by the component. */
+  readonly failure: BridgeFailure | undefined
+  /** Which dropdown asks to be open (also set by the notice's one-click action). */
+  readonly open: SelectorKind | undefined
+  /** Which requirement a refused send named; clears as soon as a pick lands. */
+  readonly missing: SelectorKind | undefined
+  /** One question about a result that came from somewhere else; never auto-applied. */
+  readonly mismatch: DetectedContext | undefined
+  /** The question the user answered with 保持: this result is tagged with it. */
+  readonly kept: DetectedContext | undefined
+}
+
+/** Patch shape: a field may be explicitly cleared. */
+type SelectionPatch = { -readonly [K in keyof SelectionSnapshot]?: SelectionSnapshot[K] | undefined }
+
+/** Nothing selected, nothing known. */
+export const EMPTY_SELECTION: SelectionSnapshot = Object.freeze({
+  workspace: undefined,
+  brand: undefined,
+  workspaces: Object.freeze([]) as readonly WorkspaceOption[],
+  brands: Object.freeze([]) as readonly BrandOption[],
+  source: 'session',
+  loading: false,
+  failure: undefined,
+  open: undefined,
+  missing: undefined,
+  mismatch: undefined,
+  kept: undefined,
+})
+
+/** Stable observable the injected hook selects from. */
+export type SelectionFeed = HostObservable<SelectionSnapshot>
+
+/**
+ * Project the published state onto the prompt metadata the Host accepts.
+ * Both halves must be chosen: a single half is not a usable address, and the
+ * send gate refuses such a submission anyway.
+ * @param snapshot - current selection state.
+ * @returns the trimmed pair, or undefined when either selector is unset.
+ */
+export function promptSelectionOf(snapshot: SelectionSnapshot): ClientSelection | undefined {
+  const { workspace, brand } = snapshot
+  if (workspace === undefined || brand === undefined) return undefined
+  return {
+    workspace: { id: workspace.id, name: workspace.name },
+    brand: { id: brand.id, name: brand.name },
+  }
+}
+
+/**
+ * Read the stored pair without trusting it.
+ * @param storage - Storage-like object; defaults to the global `localStorage`.
+ * @returns the remembered pair (possibly empty) when it parses.
+ */
+export function readStoredSelection(storage: Pick<Storage, 'getItem'> | undefined = safeStorage()): StoredSelection {
+  if (storage === undefined) return {}
+  let raw: string | null
+  try {
+    raw = storage.getItem(SELECTION_STORAGE_KEY)
+  } catch {
+    return {}
+  }
+  if (raw === null || raw === '') return {}
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(raw)
+  } catch {
+    return {}
+  }
+  if (typeof parsed !== 'object' || parsed === null) return {}
+  const record = parsed as Record<string, unknown>
+  const workspace = record['workspace']
+  const brand = record['brand']
+  const stored: { workspace?: WorkspaceOption; brand?: BrandOption } = {}
+  if (typeof workspace === 'object' && workspace !== null) {
+    const row = workspace as Record<string, unknown>
+    const id = row['id']
+    const name = row['name']
+    if (typeof id === 'number' && Number.isFinite(id) && typeof name === 'string' && name.trim() !== '') {
+      stored.workspace = { id, name: name.trim() }
+    }
+  }
+  if (typeof brand === 'object' && brand !== null) {
+    const row = brand as Record<string, unknown>
+    const id = row['id']
+    const name = row['name']
+    if ((typeof id === 'string' || typeof id === 'number') && typeof name === 'string' && name.trim() !== '') {
+      const workspaceId = row['workspaceId']
+      stored.brand = {
+        id: String(id),
+        name: name.trim(),
+        ...typeof workspaceId === 'number' && Number.isFinite(workspaceId) ? { workspaceId } : {},
+      }
+    }
+  }
+  return stored
+}
+
+/**
+ * Persist the pair, best-effort (a locked-down storage must not break the bar).
+ * @param selection - what to remember; an absent half is stored as absent.
+ * @param storage - Storage-like object; defaults to the global `localStorage`.
+ */
+export function writeStoredSelection(
+  selection: StoredSelection,
+  storage: Pick<Storage, 'setItem'> | undefined = safeStorage(),
+): void {
+  if (storage === undefined) return
+  const body: Record<string, unknown> = {}
+  if (selection.workspace !== undefined) body['workspace'] = selection.workspace
+  if (selection.brand !== undefined) body['brand'] = selection.brand
+  try {
+    storage.setItem(SELECTION_STORAGE_KEY, JSON.stringify(body))
+  } catch {
+    // Quota or privacy mode: the in-memory choice still works for this run.
+  }
+}
+
+/** @returns the global storage when the document allows it. */
+function safeStorage(): Storage | undefined {
+  try {
+    return typeof localStorage === 'undefined' ? undefined : localStorage
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Find the desktop bridge on a global object.
+ * @param scope - object to inspect; defaults to `globalThis`.
+ * @returns the bridge when both reads are functions.
+ */
+export function desktopBridgeOf(scope: unknown = globalThis): DanielDesktopBridge | undefined {
+  const candidate = (scope as { __dshDesktop?: Partial<DanielDesktopBridge> } | null | undefined)?.__dshDesktop
+  if (candidate === undefined || candidate === null) return undefined
+  return typeof candidate.danielWorkspaces === 'function' && typeof candidate.danielBrands === 'function'
+    ? candidate as DanielDesktopBridge
+    : undefined
+}
+
+/** Construction inputs, all optional so a test can wire exactly what it needs. */
+export interface ContextSelectionOptions {
+  /** Read-only desktop bridge; absent in a web build. */
+  readonly bridge?: DanielDesktopBridge
+  /** Session-derived feed, for the web fallback and mismatch detection. */
+  readonly feed?: ContextFeed
+  /** Persistence target; defaults to the document's localStorage. */
+  readonly storage?: Pick<Storage, 'getItem' | 'setItem'>
+}
+
+/**
+ * The selection store: persisted pair, dropdown state, send gate, and the
+ * one-question mismatch policy.
+ */
+export class ContextSelection implements SelectionFeed {
+  private readonly listeners = new Set<() => void>()
+  private state: SelectionSnapshot = EMPTY_SELECTION
+  private readonly bridge: DanielDesktopBridge | undefined
+  private readonly feed: ContextFeed | undefined
+  private readonly storage: Pick<Storage, 'getItem' | 'setItem'> | undefined
+  private stopFeed: (() => void) | undefined
+  /** Reading is idempotent: the first subscriber starts it, later ones join. */
+  private started = false
+  /** Objects already asked about in this session; one prompt per object. */
+  private readonly asked = new Set<string>()
+  /** Last task ordinal seen from the feed, for the per-task 保持 tag. */
+  private lastTask = 0
+
+  /**
+   * @param options - bridge, feed, and storage; every one is optional.
+   */
+  constructor(options: ContextSelectionOptions = {}) {
+    this.bridge = options.bridge
+    this.feed = options.feed
+    this.storage = options.storage ?? safeStorage()
+    const stored = readStoredSelection(this.storage)
+    this.state = {
+      ...EMPTY_SELECTION,
+      workspace: stored.workspace,
+      brand: stored.brand,
+      source: this.bridge === undefined ? 'session' : 'desktop',
+    }
+  }
+
+  /** @returns the current selection state. */
+  readonly getSnapshot = (): SelectionSnapshot => this.state
+
+  /**
+   * Observe the selection; the first listener starts the feed and the load.
+   * @param listener - notified when the published shape changes.
+   * @returns the unsubscribe function.
+   */
+  readonly subscribe = (listener: () => void): () => void => {
+    this.listeners.add(listener)
+    if (this.listeners.size === 1) this.start()
+    return () => {
+      if (!this.listeners.delete(listener)) return
+      if (this.listeners.size === 0) this.stop()
+    }
+  }
+
+  /** Attach to the session feed and read the option lists once. */
+  start(): void {
+    if (this.started) return
+    this.started = true
+    if (this.feed !== undefined) {
+      this.stopFeed = this.feed.subscribe(() => { this.adoptFeed(this.feed?.getSnapshot()) })
+      this.adoptFeed(this.feed.getSnapshot())
+    }
+    if (this.bridge !== undefined) {
+      void this.load(false)
+    }
+  }
+
+  /** Detach from the session feed. */
+  stop(): void {
+    this.stopFeed?.()
+    this.stopFeed = undefined
+  }
+
+  /**
+   * Read both lists from the desktop bridge.
+   * @param refresh - true asks the main process to skip its 60s cache.
+   */
+  async load(refresh: boolean): Promise<void> {
+    const bridge = this.bridge
+    if (bridge === undefined) return
+    this.patch({ loading: true })
+    const [workspaces, brands] = await Promise.allSettled([
+      bridge.danielWorkspaces(refresh),
+      bridge.danielBrands(refresh),
+    ])
+    const rows: { workspaces?: readonly WorkspaceOption[]; brands?: readonly BrandOption[]; failure?: BridgeFailure } = {}
+    if (workspaces.status === 'fulfilled') {
+      if (workspaces.value.ok) rows.workspaces = workspaces.value.items
+      else rows.failure = workspaces.value.reason
+    } else {
+      rows.failure = { kind: 'cli', message: String((workspaces.reason as Error | undefined)?.message ?? workspaces.reason) }
+    }
+    if (brands.status === 'fulfilled') {
+      if (brands.value.ok) rows.brands = brands.value.items
+      else rows.failure ??= brands.value.reason
+    } else {
+      rows.failure ??= { kind: 'cli', message: String((brands.reason as Error | undefined)?.message ?? brands.reason) }
+    }
+    this.patch({
+      loading: false,
+      source: 'desktop',
+      ...rows.workspaces === undefined ? {} : { workspaces: rows.workspaces },
+      ...rows.brands === undefined ? {} : { brands: rows.brands },
+      failure: rows.failure,
+    })
+    this.reconcile()
+  }
+
+  /** Re-read the lists past the cache (the selectors' 刷新). */
+  async refresh(): Promise<void> {
+    if (this.bridge === undefined) return
+    await this.load(true)
+  }
+
+  /**
+   * Record a refused send and name the requirement it lacked.
+   * @returns the missing half, or undefined when the send may proceed.
+   */
+  attemptSend(): SelectorKind | undefined {
+    const missing = this.state.workspace === undefined
+      ? 'workspace' as const
+      : this.state.brand === undefined ? 'brand' as const : undefined
+    this.patch({ missing })
+    return missing
+  }
+
+  /**
+   * Pick a workspace.
+   * @param id - workspace id from the option list.
+   */
+  chooseWorkspace(id: number): void {
+    const workspace = this.state.workspaces.find(option => option.id === id)
+    if (workspace === undefined) return
+    // A brand that belongs to another workspace cannot survive the move; a
+    // brand the CLI did not scope keeps its seat (the lists are global).
+    const brand = this.state.brand !== undefined && this.state.brand.workspaceId !== undefined
+      && this.state.brand.workspaceId !== workspace.id
+      ? undefined
+      : this.state.brand
+    this.patch({ workspace, brand, missing: undefined, open: undefined })
+    this.persist()
+  }
+
+  /**
+   * Pick a brand.
+   * @param id - brand id from the option list.
+   */
+  chooseBrand(id: string): void {
+    const brand = this.state.brands.find(option => option.id === id)
+    if (brand === undefined) return
+    this.patch({ brand, missing: undefined, open: undefined })
+    this.persist()
+  }
+
+  /**
+   * Open or close one dropdown.
+   * @param kind - the selector to open; undefined closes both.
+   */
+  setOpen(kind: SelectorKind | undefined): void {
+    this.patch({ open: kind })
+  }
+
+  /** Accept the detected context: the selection moves to it. */
+  switchToDetected(): void {
+    const detected = this.state.mismatch
+    if (detected === undefined) return
+    const workspace = this.state.workspaces.find(option => option.id === detected.workspace.id) ?? detected.workspace
+    const brand = detected.brand === undefined
+      ? this.state.brand
+      : this.state.brands.find(option => option.id === detected.brand?.id) ?? detected.brand
+    this.patch({ workspace, brand, mismatch: undefined, kept: undefined })
+    this.persist()
+  }
+
+  /** Keep the current choice and tag this result with where it came from. */
+  keepDetected(): void {
+    const detected = this.state.mismatch
+    if (detected === undefined) return
+    this.patch({ mismatch: undefined, kept: detected })
+  }
+
+  /** Drop the 保持 tag (the bar's dismiss). */
+  dismissKept(): void {
+    this.patch({ kept: undefined })
+  }
+
+  /**
+   * Fold the session feed: the fallback option lists and mismatch detection.
+   * @param snapshot - the fold's current value.
+   */
+  private adoptFeed(snapshot: ContextSnapshot | undefined): void {
+    if (snapshot === undefined) return
+    const derived = snapshot.workspaces.map(row => ({ id: row.id, name: row.name }))
+    const derivedBrands = snapshot.brands.map(row => ({ id: row.id, name: row.name }))
+    const task = snapshot.task
+    const newTask = task !== this.lastTask
+    this.lastTask = task
+    const patch: SelectionPatch = {}
+    if (this.bridge === undefined && (derived.length > 0 || derivedBrands.length > 0)) {
+      if (!sameRows(this.state.workspaces, derived)) patch.workspaces = derived
+      if (!sameRows(this.state.brands, derivedBrands)) patch.brands = derivedBrands
+      patch.source = 'session'
+    }
+    if (newTask) {
+      // 保持 tags the result, so a new human task starts untagged.
+      patch.kept = undefined
+      patch.mismatch = undefined
+    }
+    const prompt = this.mismatchOf(snapshot)
+    if (prompt !== undefined && !newTask) {
+      const key = `${String(prompt.workspace.id)}|${prompt.brand?.id ?? '-'}`
+      if (!this.asked.has(key)) {
+        this.asked.add(key)
+        patch.mismatch = prompt
+        patch.kept = undefined
+      }
+    }
+    if (Object.keys(patch).length > 0) this.patch(patch)
+  }
+
+  /**
+   * Detect that a result came from somewhere else.
+   * @param snapshot - the session fold.
+   * @returns the detected context, or undefined when it agrees with the choice.
+   */
+  private mismatchOf(snapshot: ContextSnapshot): DetectedContext | undefined {
+    if (snapshot.workspace === undefined) return undefined
+    const workspace: WorkspaceOption = {
+      id: snapshot.workspace,
+      name: snapshot.workspaceName ?? String(snapshot.workspace),
+    }
+    const brand: BrandOption | undefined = snapshot.brand === undefined
+      ? undefined
+      : { id: snapshot.brandName ?? snapshot.brand, name: snapshot.brandName ?? snapshot.brand }
+    const workspaceDiffers = this.state.workspace !== undefined && this.state.workspace.id !== workspace.id
+    const brandDiffers = brand !== undefined && this.state.brand !== undefined
+      && this.state.brand.id !== brand.id && this.state.brand.name !== brand.id && this.state.brand.name !== brand.name
+    return workspaceDiffers || brandDiffers ? { workspace, brand } : undefined
+  }
+
+  /**
+   * Keep the stored pair compatible with the freshly loaded list: a brand the
+   * account no longer has is dropped, never silently swapped for another. An
+   * empty or failed list is not evidence, so it changes nothing.
+   */
+  private reconcile(): void {
+    const { brand } = this.state
+    if (brand === undefined || this.state.brands.length === 0) return
+    if (this.state.brands.some(option => option.id === brand.id)) return
+    const byName = this.state.brands.find(option => option.name === brand.name)
+    if (byName === undefined) this.patch({ brand: undefined })
+  }
+
+  /** Write the chosen pair through to the machine. */
+  private persist(): void {
+    const stored: { workspace?: WorkspaceOption; brand?: BrandOption } = {}
+    if (this.state.workspace !== undefined) stored.workspace = this.state.workspace
+    if (this.state.brand !== undefined) stored.brand = this.state.brand
+    writeStoredSelection(stored, this.storage)
+  }
+
+  /** Merge one patch and notify only when something really changed. */
+  private patch(patch: SelectionPatch): void {
+    let changed = false
+    for (const key of Object.keys(patch) as (keyof SelectionSnapshot)[]) {
+      const before = this.state[key]
+      const after = patch[key]
+      if (before === after) continue
+      if (Array.isArray(before) && Array.isArray(after) && before.length === after.length
+        && before.every((value, index) => value === after[index])) continue
+      changed = true
+      break
+    }
+    if (!changed) {
+      // The snapshot identity must still be stable when nothing moved.
+      return
+    }
+    this.state = {
+      workspace: 'workspace' in patch ? patch.workspace : this.state.workspace,
+      brand: 'brand' in patch ? patch.brand : this.state.brand,
+      workspaces: patch.workspaces ?? this.state.workspaces,
+      brands: patch.brands ?? this.state.brands,
+      source: patch.source ?? this.state.source,
+      loading: patch.loading ?? this.state.loading,
+      failure: 'failure' in patch ? patch.failure : this.state.failure,
+      open: 'open' in patch ? patch.open : this.state.open,
+      missing: 'missing' in patch ? patch.missing : this.state.missing,
