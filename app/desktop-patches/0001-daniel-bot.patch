+/**
+ * The two shipped Daniel payloads: the module map behind the execution rail
+ * (`scripts/build-module-map.mjs`) and the guide behind the panorama dialog
+ * (`scripts/build-guide.mjs`). Both are generated; every display string in
+ * them is business-facing copy, never an internal command, tool, or field
+ * name.
+ */
+
+/** One business action inside a module, with the commands it covers. */
+export interface ModuleAction {
+  /** Business action name (the only action text the rail renders). */
+  readonly name: string
+  /** Command match tokens behind it; never rendered. */
+  readonly commands: readonly string[]
+}
+
+/** One of the nine business modules Daniel works in. */
+export interface ModuleDefinition {
+  /** Stable module id used as a list key, never rendered. */
+  readonly id: string
+  /** Business module name in Daniel's own Chinese wording, shown first. */
+  readonly name: string
+  /** The same module's English name, shown as the muted second half. */
+  readonly nameEn: string
+  /** One or more business actions. */
+  readonly actions: readonly ModuleAction[]
+}
+
+/** The module + business action one tool call resolves to. */
+export interface ModuleRule {
+  /** Business module name, or null when the call belongs to no module. */
+  readonly module: string | null
+  /** Business action sentence. */
+  readonly action: string
+}
+
+/** Whole trimmed map, as shipped in the client bundle. */
+export interface ModuleMapData {
+  /** Payload schema id; the rail refuses unknown versions. */
+  readonly schema: string
+  /** Provenance of the generated payload (no source machine paths). */
+  readonly source: {
+    readonly workflowMap: string
+    readonly sha256: string
+    readonly workflows: number
+    /** All workflow-map rows (published + trimmed). */
+    readonly commands: number
+    /** Rows that survived the module trim. */
+    readonly published: number
+  }
+  /** The nine business modules, in product order. */
+  readonly modules: readonly ModuleDefinition[]
+  /**
+   * Command token (`<group> <subcommand>`) → module + action. The token is
+   * what a running tool call is matched against; it is never rendered.
+   */
+  readonly commands: Readonly<Record<string, ModuleRule>>
+  /** Dedicated Daniel tool name → the one command token it wraps. */
+  readonly toolCommands: Readonly<Record<string, string>>
+  /** Dedicated Daniel tools with no command behind them, mapped directly. */
+  readonly toolRules: Readonly<Record<string, ModuleRule>>
+  /** Business copy for calls the table cannot place. */
+  readonly fallback: {
+    /** Label for a step that belongs to no published module. */
+    readonly module: string
+    /** A Daniel call the map does not name. */
+    readonly action: string
+    /** Any other tool call: the assistant is working, but outside Daniel. */
+    readonly generic: string
+    /** One `daniel_batch` call that spans more than one command. */
+    readonly batch: string
+  }
+}
+
+/** Payload schema this build understands. */
+export const MODULE_MAP_SCHEMA = 'daniel.module-map.v1'
+
+/** One thing a module can do, in the words the guide dialog shows. */
+export interface GuideFunction {
+  /** Function name, e.g. 看品牌档案. */
+  readonly name: string
+  /** One sentence on what the function answers, never a field or command name. */
+  readonly detail: string
+  /** Example request the user could say; the dialog can prefill it. */
+  readonly example: string
+}
+
+/** One of the nine business modules, with its functions. */
+export interface GuideModule {
+  /** Stable module id used as a list key, never rendered. */
+  readonly id: string
+  /** Business module name in Daniel's own Chinese wording, shown first. */
+  readonly name: string
+  /** The same module's English name, shown beside the Chinese one. */
+  readonly nameEn: string
+  /** One sentence on what the module covers. */
+  readonly summary: string
+  /** At least two functions (asserted at generation time). */
+  readonly functions: readonly GuideFunction[]
+}
+
+/** Whole guide payload, as shipped in the client bundle. */
+export interface GuideData {
+  /** Payload schema id; the dialog refuses unknown versions. */
+  readonly schema: string
+  /** Provenance of the generated payload (no source machine paths). */
+  readonly source: {
+    /** Repo-relative path of the authored guide. */
+    readonly guide: string
+    /** sha256 of the authored file, so a stale regeneration is visible. */
+    readonly sha256: string
+    /** sha256 of the published content, so a hand edit is visible. */
+    readonly digest: string
+    readonly modules: number
+    readonly functions: number
+  }
+  /** The nine business modules, in product order. */
+  readonly modules: readonly GuideModule[]
+}
+
+/** Payload schema this build understands. */
+export const GUIDE_SCHEMA = 'daniel.guide.v1'
