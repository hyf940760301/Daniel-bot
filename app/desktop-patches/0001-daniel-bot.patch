+    private readonly unavailableReason = '未找到可用的加密方案',
+  ) {
+    const byTag = new Map<number, CredentialCipher>()
+    for (const cipher of ciphers) {
+      const tag = cipher.scheme === 'safe-storage' ? SCHEME_SAFE_STORAGE : SCHEME_AES_GCM
+      if (!byTag.has(tag)) byTag.set(tag, cipher)
+    }
+    this.byTag = byTag
+  }
