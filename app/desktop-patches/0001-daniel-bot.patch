@@ -0,0 +1,344 @@
+#!/usr/bin/env node
+/**
+ * Bake the authored Daniel guide (module → function → example phrase) into the
+ * typed table the panorama dialog ships.
+ *
+ *   node packages/client/ui-capability-map/scripts/build-guide.mjs \
+ *     --from "<…>/daniel-bot/app/guide/daniel-guide.json"
+ *   node …/build-guide.mjs --from <daniel-guide.json> --check
+ *
+ * Why a generated table instead of a runtime read: the dialog must open on a
+ * machine that only has the packaged app, so the copy is baked in at build
+ * time and the generated module is checked in (the same rule as the package's
+ * module map).
+ *
+ * Generation-time assertions (keep them in sync with CHANGES-GUIDE.md):
+ *
+ * 1. Exactly nine modules, with unique ids and names, in product order. Each
+ *    module carries two names — the Daniel Chinese name and its English name —
+ *    both non-empty, the English one capitalized and unique.
+ * 2. Every module carries at least two functions, so a module row in the
+ *    dialog is never empty; function names are unique inside their module.
+ * 3. Every example phrase is non-blank, single-line, at most 40 characters
+ *    (counted as code points), and exactly what the source says — the dialog
+ *    prefills it verbatim, so a trimmed or reworded copy is a bug.
+ * 4. No display string carries an internal marker (backtick, `_`, `--`,
+ *    `.ts`, `.json`), a lowercase command spelling (`brands list`), a tool
+ *    name (`daniel_…`), or an argv field name. Uppercase product words
+ *    (`YouTube`) and numerals are ordinary business copy and stay allowed.
+ * 5. The published content digest is recorded in the generated file; the
+ *    unit test recomputes it, so hand-editing an example without regenerating
+ *    fails the build instead of silently drifting from the authored guide.
+ * 6. `--check` re-renders from the authored file and compares byte for byte,
+ *    so a guide update that was not regenerated fails CI.
+ */
+import { createHash } from 'node:crypto'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { parseArgs } from 'node:util'
+
+/**
+ * This file's own path. Vitest imports the module through Vite, where
+ * `import.meta.url` is not a `file:` URL; the fallback keeps the imported
+ * helpers usable (only the CLI entry point needs the real path).
+ * @returns the absolute script path, or undefined when the URL is not a file.
+ */
+function scriptPath() {
+  try {
+    return fileURLToPath(import.meta.url)
+  } catch {
+    return undefined
+  }
+}
+
+/** Package root, falling back to the caller's working directory under Vite. */
+const PACKAGE_ROOT = (() => {
+  const self = scriptPath()
+  return self === undefined ? process.cwd() : fileURLToPath(new URL('..', `file://${self}`))
+})()
+/** Repository root, derived from the package root. */
+const REPO_ROOT = (() => {
+  const self = scriptPath()
+  return self === undefined ? process.cwd() : fileURLToPath(new URL('../../../../', `file://${self}`))
+})()
+const OUTPUT = join(PACKAGE_ROOT, 'src/client/guide.generated.ts')
+
+/** Payload schema the dialog understands. */
+export const GUIDE_SCHEMA = 'daniel.guide.v1'
+
+/** The authored guide publishes exactly the nine business modules. */
+const MODULE_COUNT = 9
+
+/** Display name of the one authored guide, as it appears in provenance. */
+const SOURCE_LABEL = 'daniel-bot/app/guide/daniel-guide.json'
+
+/** Longest example phrase the dialog pre-fills, in code points. */
+const MAX_EXAMPLE_CHARS = 40
+
+/** Markers that must never reach the screen. */
+const FORBIDDEN_COPY = ['`', '_', '--', '.ts', '.json']
+
+/** Lowercase multi-word ASCII runs are command spellings, not business copy. */
+const COMMAND_SPELLING = /(?:^|[\s，。、：；])[a-z][a-z-]*(?:\s+[a-z][a-z-]*)+(?=$|[\s，。、：；])/u
+
+/** Internal vocabulary the dialog never shows. */
+const INTERNAL_VOCABULARY = /\b(?:argv|mcpTool|sha256|workflow-map|sha)\b/u
+
+/**
+ * Fail loudly instead of publishing a guide the dialog cannot render.
+ * @param {unknown} condition - asserted fact.
+ * @param {string} message - what the caller should fix.
+ * @throws {Error} when the assertion is false.
+ */
+function assert(condition, message) {
+  if (!condition) throw new Error(`build-guide: ${message}`)
+}
+
+/**
+ * Assert one display string carries business language only.
+ * @param {unknown} copy - the string the dialog would render.
+ * @param {string} where - source location named in the failure.
+ */
+function assertCopy(copy, where) {
+  assert(typeof copy === 'string' && copy.trim() !== '', `${where} 缺少业务文案`)
+  assert(copy === copy.trim(), `${where} 的文案首尾有空白：${JSON.stringify(copy)}`)
+  for (const marker of FORBIDDEN_COPY) {
+    assert(!copy.includes(marker), `${where} 的文案含有内部标记 ${JSON.stringify(marker)}：${copy}`)
+  }
+  const spelling = COMMAND_SPELLING.exec(copy)
+  assert(spelling === null, `${where} 的文案含命令拼写 ${JSON.stringify(spelling?.[0])}：${copy}`)
+  const vocabulary = INTERNAL_VOCABULARY.exec(copy)
+  assert(vocabulary === null, `${where} 的文案含内部词 ${JSON.stringify(vocabulary?.[0])}：${copy}`)
+}
+
+/**
+ * Assert one module's English display name: present, trimmed, and capitalized
+ * like a product module, with letters and spaces only.
+ * @param name - the authored English name.
+ * @param where - source location named in the failure.
+ */
+function assertEnglishName(name, where) {
+  assert(typeof name === 'string' && name.trim() !== '', `${where} 缺少英文模块名`)
+  assert(name === name.trim(), `${where} 的英文模块名首尾有空白：${JSON.stringify(name)}`)
+  assert(/^[A-Z]/u.test(name), `${where} 的英文模块名必须首字母大写：${name}`)
+  assert(!/[^A-Za-z ]/u.test(name), `${where} 的英文模块名只能是字母和空格：${name}`)
+}
+
+/**
+ * Count code points, so an emoji in a phrase never counts twice.
+ * @param {string} text - display text.
+ * @returns {number} its code-point length.
+ */
+function chars(text) {
+  return [...text].length
+}
+
+/**
+ * Validate the authored guide and return the published payload.
+ * @param {unknown} guide - parsed daniel-guide.json body.
+ * @returns {Array<{ id: string, name: string, nameEn: string, summary: string, functions: Array<{ name: string, detail: string, example: string }> }>}
+ *   the nine modules, authored order preserved.
+ * @throws {Error} on the first violated rule.
+ */
+export function assertGuide(guide) {
+  assert(guide !== null && typeof guide === 'object', '指南内容不是对象')
+  assert(guide.schema === GUIDE_SCHEMA, `未知 schema：${String(guide.schema)}`)
+  assert(Array.isArray(guide.modules), '缺少 modules')
+  assert(guide.modules.length === MODULE_COUNT,
+    `模块应为 ${String(MODULE_COUNT)} 个，实际 ${String(guide.modules.length)} 个`)
+
+  const ids = new Set()
+  const names = new Set()
+  const englishNames = new Set()
+  const modules = []
+  let functions = 0
+
+  for (const [index, module] of guide.modules.entries()) {
+    const at = `模块 ${String(index + 1)}`
+    assert(module !== null && typeof module === 'object', `${at} 不是对象`)
+    assert(typeof module.id === 'string' && /^[a-z][a-z-]*$/u.test(module.id), `${at} 的 id 不合法：${String(module.id)}`)
+    assert(!ids.has(module.id), `模块 id 重复：${module.id}`)
+    ids.add(module.id)
+    assertCopy(module.name, `${at} 的名称`)
+    assert(!names.has(module.name), `模块名称重复：${module.name}`)
+    names.add(module.name)
+    assertEnglishName(module.nameEn, `${at}（${module.name}）的英文名`)
+    assert(!englishNames.has(module.nameEn), `英文模块名重复：${module.nameEn}`)
+    englishNames.add(module.nameEn)
+    assertCopy(module.summary, `${at}（${module.name}）的一句话`)
+    assert(Array.isArray(module.functions), `${at}（${module.name}）缺少 functions`)
+    assert(module.functions.length >= 2,
+      `${at}（${module.name}）至少要有 2 个功能，实际 ${String(module.functions.length)} 个`)
+
+    const functionNames = new Set()
+    const published = []
+    for (const [position, fn] of module.functions.entries()) {
+      const where = `${module.name} 的功能 ${String(position + 1)}`
+      assert(fn !== null && typeof fn === 'object', `${where} 不是对象`)
+      assertCopy(fn.name, `${where} 的名称`)
+      assert(!functionNames.has(fn.name), `${module.name} 的功能名称重复：${fn.name}`)
+      functionNames.add(fn.name)
+      assertCopy(fn.detail, `${where}（${fn.name}）的一句话`)
+      assertCopy(fn.example, `${where}（${fn.name}）的示例话术`)
+      assert(!fn.example.includes('\n'), `${where}（${fn.name}）的示例话术必须单行`)
+      assert(chars(fn.example) <= MAX_EXAMPLE_CHARS,
+        `${where}（${fn.name}）的示例话术 ${String(chars(fn.example))} 字，超过 ${String(MAX_EXAMPLE_CHARS)} 字上限：${fn.example}`)
+      published.push({ name: fn.name, detail: fn.detail, example: fn.example })
+    }
+    functions += published.length
+    modules.push({
+      id: module.id,
+      name: module.name,
+      nameEn: module.nameEn,
+      summary: module.summary,
+      functions: published,
+    })
+  }
+
+  assert(modules.length === MODULE_COUNT, `模块应为 ${String(MODULE_COUNT)} 个`)
+  return modules
+}
+
+/**
+ * Stable sha256 over the published content (modules, functions, phrases).
+ * The generated file records it and the unit test recomputes it, so a manual
+ * edit of an example phrase cannot pass as a regeneration.
+ * @param {ReadonlyArray<{ id: string, name: string, nameEn: string, summary: string, functions: ReadonlyArray<{ name: string, detail: string, example: string }> }>} modules
+ *   the validated modules.
+ * @returns {string} lowercase hex digest.
+ */
+export function guideDigest(modules) {
+  const canonical = JSON.stringify(modules.map(module => ({
+    id: module.id,
+    name: module.name,
+    nameEn: module.nameEn,
+    summary: module.summary,
+    functions: module.functions.map(fn => ({ name: fn.name, detail: fn.detail, example: fn.example })),
+  })))
+  return createHash('sha256').update(canonical).digest('hex')
+}
+
+/**
+ * Read and validate one authored guide.
+ * @param {string} path - absolute daniel-guide.json path.
+ * @returns {{ modules: ReturnType<typeof assertGuide>, sha256: string }} the payload and the file digest.
+ * @throws {Error} when the file is missing, not JSON, or invalid.
+ */
+export function readGuide(path) {
+  let text
+  try {
+    text = readFileSync(path, 'utf8')
+  } catch (error) {
+    throw new Error(`build-guide: 无法读取 ${path}：${error instanceof Error ? error.message : String(error)}`)
+  }
+  let parsed
+  try {
+    parsed = JSON.parse(text)
+  } catch (error) {
+    throw new Error(`build-guide: ${path} 不是合法 JSON：${error instanceof Error ? error.message : String(error)}`)
+  }
+  return {
+    modules: assertGuide(parsed),
+    sha256: createHash('sha256').update(text).digest('hex'),
+  }
+}
+
+/**
+ * Render the checked-in TypeScript module for one validated guide.
+ * @param {ReturnType<typeof assertGuide>} modules - validated modules.
+ * @param {{ guide: string, sha256: string }} source - display path and file digest.
+ * @returns {string} the file body.
+ */
+export function renderGuide(modules, source) {
+  const functions = modules.reduce((total, module) => total + module.functions.length, 0)
+  const payload = {
+    schema: GUIDE_SCHEMA,
+    source: {
+      guide: source.guide,
+      sha256: source.sha256,
+      digest: guideDigest(modules),
+      modules: modules.length,
+      functions,
+    },
+    modules,
+  }
+  return `/**
+ * GENERATED FILE — do not edit by hand.
+ *
+ * Source: ${source.guide} (sha256 ${source.sha256.slice(0, 12)})
+ * Regenerate: node packages/client/ui-capability-map/scripts/build-guide.mjs --from <daniel-guide.json>
+ *
+ * Daniel guide: ${String(modules.length)} modules, ${String(functions)} functions and phrases.
+ * Every displayed string is business copy (asserted at generation time).
+ */
+import type { GuideData } from './types.ts'
+
+export const GUIDE: GuideData = ${JSON.stringify(payload, null, 2)}
+`
+}
+
+/**
+ * Build the generated module from one authored file.
+ * @param {string} path - absolute guide path.
+ * @returns {{ text: string, modules: ReturnType<typeof assertGuide>, sha256: string }} render + payload.
+ */
+export function buildGuide(path) {
+  const { modules, sha256 } = readGuide(path)
+  return { text: renderGuide(modules, { guide: displayPath(path), sha256 }), modules, sha256 }
+}
+
+/**
+ * Repo-relative display path; an out-of-tree absolute path is never published.
+ * The authored copy lives in the app project, so anything outside this tree is
+ * labelled with the one source name the app documents.
+ * @param {string} path - absolute guide path.
+ * @returns {string} the path recorded in the generated file.
+ */
+function displayPath(path) {
+  return path.startsWith(REPO_ROOT)
+    ? path.slice(REPO_ROOT.length).split('\\').join('/')
+    : SOURCE_LABEL
+}
+
+/** CLI: `--from <guide.json> [--check] [--help]`. */
+function main() {
+  const { values } = parseArgs({
+    options: {
+      from: { type: 'string' },
+      check: { type: 'boolean' },
+      help: { type: 'boolean', short: 'h' },
+    },
+  })
+  if (values.help === true) {
+    process.stdout.write('用法：node scripts/build-guide.mjs --from <daniel-guide.json> [--check]\n')
+    return
+  }
+  const source = values.from ?? process.env.DANIEL_GUIDE
+  assert(source !== undefined && source !== '', '缺少输入：传 --from <daniel-guide.json>，或设 DANIEL_GUIDE')
+  const { text } = buildGuide(resolve(source))
+  if (values.check === true) {
+    let current
+    try {
+      current = readFileSync(OUTPUT, 'utf8')
+    } catch {
+      throw new Error(`build-guide: 缺少已生成的 ${OUTPUT}，先不带 --check 跑一次`)
+    }
+    if (current !== text) {
+      throw new Error('build-guide: 生成结果与指南不一致（内容漂移），请重新生成并一起提交')
+    }
+    process.stdout.write('build-guide: 生成结果与指南一致\n')
+    return
+  }
+  writeFileSync(OUTPUT, text)
+  process.stdout.write(`build-guide: 已写入 ${OUTPUT}\n`)
+}
+
+if (process.argv[1] !== undefined && resolve(process.argv[1]) === scriptPath()) {
+  try {
+    main()
+  } catch (error) {
+    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`)
+    process.exitCode = 1
+  }
+}
