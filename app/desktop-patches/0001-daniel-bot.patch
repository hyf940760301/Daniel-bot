+/* ── wiring and rail rendering ───────────────────────────────────────────── */
+
+describe('context strip registration', () => {
+  it('adds exactly one conversation.context.bar entry, with no control', async () => {
+    const { Context } = await import('@deepseek-ai/cordis')
+    const { SlotRegistry } = await import('@deepseek-ai/dsh-client-ui-renderer/client')
+    const { apply, inject } = await import('../src/client/index.ts')
+    const ctx = new Context()
+    await ctx.plugin(SlotRegistry).await()
+    const slots = ctx.get('slots') as InstanceType<typeof SlotRegistry>
+    const fake = new FakeSessions()
+    fake.add('s1')
+    const disposeRoot = slots.register({
+      name: 'root',
+      children: {
+        'shell.rail': { kind: 'single', scope: 'root' },
+        'conversation.context.bar': { kind: 'list', scope: 'root' },
+      },
+    } as never, () => null)
+    const disposeLocale = ctx.provide('locale', { register: () => () => {}, bind: () => () => '' } as never)
+    const disposeSessions = ctx.provide('sessions', fake as never)
+    const disposeLayout = ctx.provide('layout', { openRail: () => {} } as never)
+    await ctx.plugin({ inject: [...inject], apply }).await()
+    const entries = slots.entries('conversation.context.bar')
+    expect(entries).toHaveLength(1)
+    expect(entries[0]?.options.id).toBe('capability-map.context')
+    const injected = (entries[0]?.inject as (() => unknown) | undefined)?.()
+    expect(injected).toHaveProperty('hooks.context')
+    disposeLocale()
+    disposeSessions()
+    disposeLayout()
+    disposeRoot()
+  })
+})
+
+describe('rail and dialog bilingual rows', () => {
+  /**
+   * Build the composed props of the rail entry.
+   * @param snapshot - the trace snapshot the panel paints.
+   * @returns props for `CapabilityMap`.
+   */
+  function railProps(snapshot: unknown): CapabilityMapProps {
+    const feed = { getSnapshot: () => snapshot, subscribe: () => () => {} }
+    const hook = ((selector: (value: unknown) => unknown) =>
+      useSyncExternalStore(feed.subscribe, () => selector(feed.getSnapshot()), () => selector(feed.getSnapshot()))) as never
+    return {
+      t: (key: string): string => (zh as Record<string, string>)[key] ?? key,
+      open: true,
+      onToggle: () => {},
+      useTrace: hook,
+      prefill: () => 'unavailable',
+      focusChat: () => true,
+      usePanelInfo: () => undefined,
+      useSessions: () => undefined,
+      useSessionStatus: () => undefined,
+      useSessionRetainInfo: () => undefined,
+      useWorkspaces: () => undefined,
+      useResource: () => undefined,
+      useContextMenu: () => ({ getTriggerProps: () => ({}) }),
+      useRemoteAccess: () => true,
+      useAccess: () => true,
+      useSessionAccess: () => true,
+      useWorkspaceAccess: () => true,
+    } as unknown as CapabilityMapProps
+  }
+
+  it('shows the Chinese name first and the English name muted on every module row', () => {
+    const modules = MODULE_MAP.modules.map((module, index) => ({
+      id: module.id,
+      name: module.name,
+      calls: index === 0 ? 2 : 0,
+      state: index === 0 ? 'used' : 'unused',
+    }))
+    const view = render(<CapabilityMap {...railProps({
+      task: 1, running: false, current: null, steps: [], modules,
+    })} />)
+    for (const module of MODULE_MAP.modules) {
+      expect(view.getByText(module.name)).toBeTruthy()
+      expect(view.getByText(module.nameEn)).toBeTruthy()
+    }
+    // The row reads Chinese first, then the muted English name.
+    const row = view.container.querySelector('[data-module="brands"]')
+    expect(row?.querySelector('[data-module-en]')?.textContent).toBe('Brand Profile')
+    const text = row?.textContent ?? ''
+    expect(text.indexOf('品牌档案')).toBeGreaterThanOrEqual(0)
+    expect(text.indexOf('Brand Profile')).toBeGreaterThan(text.indexOf('品牌档案'))
+  })
+
+  it('shows both names in the panorama dialog index and detail title', () => {
+    const modules = MODULE_MAP.modules.map(module => ({
+      id: module.id, name: module.name, calls: 0, state: 'unused' as const,
+    }))
+    render(<CapabilityMap {...railProps({ task: 0, running: false, current: null, steps: [], modules })} />)
+    fireEvent.click(screen.getByRole('button', { name: zh['guide.open'] }))
+    const dialog = screen.getByRole('dialog')
+    const nav = within(dialog).getByRole('navigation', { name: zh['guide.modules'] })
+    expect(nav.textContent).toContain('账号与盘点')
+    expect(nav.textContent).toContain('Account')
+    expect(nav.textContent).toContain('Share of Voice')
+    expect(dialog.textContent).toContain('Brand Profile')
+  })
+})
