+/**
+ * Sessions with running work, by the rule the row's own status uses: the
+ * Session's turn runs, or one of its direct children's does. Actions that
+ * cannot act on live work (removal) read this set instead of a rendered node,
+ * so they cover rows outside the mounted list too. This seam carries no UI
+ * status layer, so a child counts only while its own summary still says it
+ * runs.
+ * @param list - Session list snapshot.
+ * @returns the running Session ids as a Set, for one lookup per row.
+ */
+export function runningSessionIds(list: SessionListState): ReadonlySet<SessionId> {
+  const running = new Set<SessionId>()
+  for (const id of list.ids) {
+    if (list.byId[id]?.running === true) running.add(id)
+  }
+  for (const [parentId, projection] of Object.entries(list.projectionsBySession)) {
+    const children = projection.values.subagentCatalog ?? []
+    if (children.some(child => list.byId[child.id]?.running === true)) running.add(parentId as SessionId)
+  }
+  return running
+}
