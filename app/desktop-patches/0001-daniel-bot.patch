@@ -0,0 +1,39 @@
+/**
+ * Bilingual module labels, derived from the generated module map.
+ *
+ * The rail, the step path, and the panorama dialog all show a module as
+ * `中文名 + 英文名` (Chinese first, English muted). Chinese stays the identity:
+ * the trace fold, the next-step parser, and the shipped command table key on
+ * it, so the module map remains the single source of both names. This file only
+ * projects the English half, keeping every call site free of a linear scan or a
+ * second hard-coded table.
+ */
+import { MODULE_MAP } from './module-map.generated.ts'
+
+/** Chinese module name → English module name, built once at module load. */
+const ENGLISH_BY_NAME: Readonly<Record<string, string>> = Object.freeze(
+  Object.fromEntries(MODULE_MAP.modules.map(module => [module.name, module.nameEn])),
+)
+
+/** Stable module id → English module name, for rows that only carry the id. */
+const ENGLISH_BY_ID: Readonly<Record<string, string>> = Object.freeze(
+  Object.fromEntries(MODULE_MAP.modules.map(module => [module.id, module.nameEn])),
+)
+
+/**
+ * English label of one module, by its Chinese business name.
+ * @param name - the module's Chinese name, or null for a row outside the map.
+ * @returns the English name, or undefined when the module is not published.
+ */
+export function moduleNameEn(name: string | null): string | undefined {
+  return name !== null && Object.hasOwn(ENGLISH_BY_NAME, name) ? ENGLISH_BY_NAME[name] : undefined
+}
+
+/**
+ * English label of one module, by its stable id.
+ * @param id - the module id used as a list key.
+ * @returns the English name, or undefined when no such module is published.
+ */
+export function moduleNameEnById(id: string): string | undefined {
+  return Object.hasOwn(ENGLISH_BY_ID, id) ? ENGLISH_BY_ID[id] : undefined
+}
diff --git a/packages/client/ui-capability-map/src/client/next-steps.ts b/packages/client/ui-capability-map/src/client/next-steps.ts
new file mode 100644
index 00000000..fd27ac34
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/next-steps.ts
@@ -0,0 +1,386 @@
+/**
+ * "Next step" extraction for the clickable cards under a finished answer (S6.6).
+ *
+ * The discipline layer already asks the model to close every delivery with one
+ * or two concrete next steps, each written as `<module>：<action>` and each
+ * naming one of Daniel's nine business modules. This module turns that tail
+ * prose into data the UI can render; it is a pure function over one string, so
+ * it can be tested without React, a Session, or a slot registry.
+ *
+ * Rules (see CHANGES-NEXT-STEPS.md §2 and CHANGES-NEXT-STEPS-FIX.md):
+ * - the heading is `下一步`, `下一步建议`, `建议下一步`, `接下来` or
+ *   `Next steps` (optionally a Markdown heading, bold, emoji-prefixed, and/or
+ *   followed by a colon);
+ * - only the LAST such heading in the message is read;
+ * - at most three list lines directly below it are considered (numbered,
+ *   `-`, `*` or `•`), and — since models routinely drop the bullet — a bare
+ *   `<module>：<action>` line counts as an item too;
+ * - with no heading at all, the LAST {@link NEXT_STEP_TAIL_LINES} non-empty
+ *   lines are scanned for bare `<module>：<action>` lines (at most two);
+ * - a line counts only as `<module>：<action>` where the module is exactly one
+ *   of the nine names; anything else is dropped rather than guessed;
+ * - at most two steps survive (the product limit on cards).
+ *
+ * Priority is decided here too, from the same text: {@link prioritizeNextSteps}
+ * marks at most one card as 优先 using a fixed phrase list, never a model
+ * judgement, and moves that card to the front when the answer listed it later.
+ *
+ * Fenced code blocks are removed first: a transcript that quotes an example
+ * "下一步" block must not grow cards of its own. Nothing here is lenient about
+ * module names — a wrong card is worse than a missing one, so the parser fails
+ * closed and the caller renders nothing.
+ */
+import { MODULE_MAP } from './module-map.generated.ts'
+
+/** The nine business module names, in product order; a step's module must be one of these. */
+export const NEXT_STEP_MODULES: readonly string[] = Object.freeze(
+  MODULE_MAP.modules.map(module => module.name),
+)
+
+/** Cards shown per answer. */
+export const NEXT_STEP_LIMIT = 2
+
+/** List lines read per heading; a longer list is truncated, never searched. */
+export const NEXT_STEP_SCAN_LIMIT = 3
+
+/**
+ * Non-empty tail lines scanned when the answer carries no heading at all. The
+ * fixed window keeps a step-like line from the middle of a report (a module
+ * name opening a summary sentence) from growing a card.
+ */
+export const NEXT_STEP_TAIL_LINES = 8
+
+/** One parsed next step: a business module and the sentence to put in the composer. */
+export interface NextStep {
+  /** One of {@link NEXT_STEP_MODULES}, in Daniel's own Chinese module name. */
+  readonly module: string
+  /** The action sentence after the colon, with wrapping emphasis removed. */
+  readonly action: string
+}
+
+/** A heading line, after Markdown decoration: `下一步`, `建议下一步`, `接下来`, `Next steps`. */
+const HEADING = /^(?:下一步建议|下一步|建议下一步|接下来|next\s+steps?)$/iu
+
+/**
+ * Action openers that mean "this has to happen first": the sentence starts with
+ * the prerequisite itself rather than with a follow-up reading of the result.
+ * Kept as an ordered, frozen list so the rule is data (and therefore testable)
+ * rather than a regex buried in the renderer.
+ */
+export const PRIORITY_PREFIXES: readonly string[] = Object.freeze([
+  '补齐',
+  '先确认',
+  '先建档',
+  '先补齐',
+  '需要先',
+])
+
+/**
+ * Phrases anywhere in the sentence that name a missing prerequisite — a brand
+ * that has no profile yet, a baseline that does not exist. They mark the step
+ * as "do this first" even when the sentence opens with a verb.
+ */
+export const PRIORITY_MARKERS: readonly string[] = Object.freeze([
+  '缺少',
+  '未建档',
+])
+
+/** A numbered (`1.` / `1、` / `1)`) or bulleted (`-` / `*` / `•`) list line, capturing its body. */
+const LIST_ITEM = /^\s*(?:\d{1,2}\s*[.、．)）]|[-*•–—])\s*(.+)$/u
+
+/** Wrapping emphasis or code ticks, at either edge of a fragment. */
+const EDGE_MARKS = /^(?:\*\*|__|\*|_|`)+|(?:\*\*|__|\*|_|`)+$/gu
+
+/** Leading decoration a heading may carry: emoji, bullets, quotes, spaces. */
+const EDGE_PREFIX = /^[^\p{L}\p{N}]+/u
+
+/**
+ * Strip wrapping Markdown emphasis/ticks from a fragment.
+ * @param value - one module name or action sentence.
+ * @returns the same words without pairing markers at either edge.
+ */
+function unwrap(value: string): string {
+  let text = value.trim()
+  for (;;) {
+    const next = text.replace(EDGE_MARKS, '').trim()
+    if (next === text) return text
+    text = next
+  }
+}
+
+/**
+ * Reduce a line to the heading text it might be, ignoring Markdown decoration.
+ * @param line - one raw line of the answer.
+ * @returns the matched heading text, or undefined when the line is not a heading.
+ */
+function headingOf(line: string): string | undefined {
+  // Decoration and the colon may sit in either order (`**下一步**：`), and a
+  // heading is often introduced by an emoji (`🎯 下一步建议`), so both edges are
+  // normalised until nothing changes.
+  let text = line.replace(/^\s*#{1,6}\s*/u, '').trim()
+  for (;;) {
+    const next = unwrap(text).replace(EDGE_PREFIX, '').replace(/[:：\s]+$/u, '').trim()
+    if (next === text) break
+    text = next
+  }
+  return HEADING.test(text) ? text : undefined
+}
+
+/**
+ * Test a line for list syntax and return its body.
+ * @param line - one raw line of the answer.
+ * @returns the list item's body, or undefined when the line is not a list item.
+ */
+function listItemOf(line: string): string | undefined {
+  return LIST_ITEM.exec(line)?.[1]
+}
+
+/**
+ * Split one list body into `<module>：<action>`.
+ * @param body - the text after the list marker.
+ * @returns the parsed step, or undefined when the module is not one of the nine.
+ */
+function stepOf(body: string): NextStep | undefined {
+  const text = unwrap(body)
+  if (text === '') return undefined
+  for (const module of NEXT_STEP_MODULES) {
+    if (!text.startsWith(module)) continue
+    const rest = text.slice(module.length)
+    // The module may itself be bolded: `**品牌档案**：…`.
+    const tail = unwrap(rest)
+    const colon = /^[:：]\s*/u.exec(tail)
+    if (colon === null) continue
+    const action = unwrap(tail.slice(colon[0].length))
+    if (action === '') continue
+    return { module, action }
+  }
+  return undefined
+}
+
+/**
+ * Drop fenced code blocks, so a quoted example cannot produce cards.
+ * @param text - the whole answer.
+ * @returns the answer without fenced blocks.
+ */
+function withoutFences(text: string): string {
+  return text.replace(/^[ \t]*(`{3,}|~{3,})[\s\S]*?^[ \t]*\1[^\n]*$/gmu, '')
+}
+
+/**
+ * Read one line as a candidate item body.
+ *
+ * A bullet or number is optional: models close with `品牌档案：…` about as often
+ * as with `- 品牌档案：…`, and refusing the bare form is what made the cards
+ * disappear. A line that is neither a list item nor a `<module>：<action>` line
+ * returns undefined, which ends the section (prose is never read as a step).
+ * @param line - one non-blank line below the heading.
+ * @returns the body to hand {@link stepOf}, or undefined when the line is not a step line.
+ */
+function itemOf(line: string): string | undefined {
+  const bounded = listItemOf(line)
+  if (bounded !== undefined) return bounded
+  return stepOf(line) === undefined ? undefined : line
+}
+
+/**
+ * Collect steps from the answer's tail when it carries no heading at all.
+ *
+ * The window is the last {@link NEXT_STEP_TAIL_LINES} non-empty lines, and only
+ * `<module>：<action>` lines count, so a task summary cannot grow cards from
+ * its body. Steps keep the answer's order and stop at the product limit.
+ * @param lines - the answer's lines, fences already removed.
+ * @returns at most two validated steps; empty when the tail has none.
+ */
+function tailSteps(lines: readonly string[]): readonly NextStep[] {
+  const tail = lines.filter(line => line.trim() !== '').slice(-NEXT_STEP_TAIL_LINES)
+  const steps: NextStep[] = []
+  for (const line of tail) {
+    const body = listItemOf(line) ?? line
+    const step = stepOf(body)
+    if (step === undefined) continue
+    steps.push(step)
+    if (steps.length === NEXT_STEP_LIMIT) break
+  }
+  return steps
+}
+
+/**
+ * Extract the answer's next-step list.
+ *
+ * @param text - the visible prose of the last assistant message.
+ * @returns at most two validated steps, in the answer's order; empty when the
+ *   answer carries no conforming section (the caller then renders nothing).
+ */
+export function parseNextSteps(text: string): readonly NextStep[] {
+  const lines = withoutFences(text).split(/\r?\n/u)
+
+  // The last heading wins: a later "下一步" supersedes an earlier one.
+  let heading = -1
+  for (let index = lines.length - 1; index >= 0; index--) {
+    if (headingOf(lines[index] ?? '') !== undefined) {
+      heading = index
+      break
+    }
+  }
+  // No heading: fall back to the tail, where a model that ignored the format
+  // still writes its steps as `<module>：<action>`.
+  if (heading === -1) return tailSteps(lines)
+
+  const items: string[] = []
+  for (let index = heading + 1; index < lines.length && items.length < NEXT_STEP_SCAN_LIMIT; index++) {
+    const line = lines[index] ?? ''
+    // Blank lines may separate the heading from the list and its items.
+    if (line.trim() === '') continue
+    const item = itemOf(line)
+    // The first line that is neither an item nor a step ends the section.
+    if (item === undefined) break
+    items.push(item)
+  }
+
+  const steps: NextStep[] = []
+  for (const item of items) {
+    const step = stepOf(item)
+    if (step === undefined) continue
+    steps.push(step)
+    if (steps.length === NEXT_STEP_LIMIT) break
+  }
+  return steps
+}
+
+/**
+ * Verbs that mean the step writes something (a list, a brand profile, a
+ * campaign). Textual and deterministic: the card only carries a landing target
+ * when its own sentence says it will write.
+ */
+export const WRITE_VERBS: readonly string[] = Object.freeze([
+  '写入', '写进', '加进', '加入', '存进', '建名单', '建档', '新建', '新增', '创建', '添加', '更新', '导入', '保存',
+])
+
+/** A quoted list name: 「第十一批」名单 / "Q4 creators" 名单. */
+const QUOTED_LIST = /[「“"]([^」”"]{1,24})[」”"]\s*名单/u
+
+/** An unquoted Chinese `<name>名单` phrase. */
+const CHINESE_LIST = /([\u4e00-\u9fa5]{1,12})名单/u
+
+/** A Latin `<name> 名单` phrase (spaces allowed inside the name). */
+const LATIN_LIST = /([A-Za-z0-9][A-Za-z0-9 _-]{0,15}?)\s*名单/u
+
+/** The batch fallback the roster workflow uses (第十一批). */
+const BATCH = /(第[一二三四五六七八九十百零\d]{1,3}批)/u
+
+/** Where a write-shaped next step would land (§9.4). */
+export interface WriteTarget {
+  /** The chosen workspace's name, when one is chosen. */
+  readonly workspace: string | undefined
+  /** The chosen brand's name, when one is chosen. */
+  readonly brand: string | undefined
+  /** The list the sentence names, when it names one. */
+  readonly list: string | undefined
+}
+
+/**
+ * Whether a step's own sentence says it writes something.
+ * @param step - one parsed next step.
+ * @returns true when the action carries a write verb.
+ */
+export function isWriteStep(step: NextStep): boolean {
+  return WRITE_VERBS.some(verb => step.action.includes(verb))
+}
+
+/**
+ * Read the list the action names, if it names one.
+ * @param action - the sentence after `<module>：`.
+ * @returns the list name, or undefined.
+ */
+export function listNameOf(action: string): string | undefined {
+  const quoted = QUOTED_LIST.exec(action)
+  if (quoted?.[1] !== undefined && quoted[1].trim() !== '') return quoted[1].trim()
+  const batch = BATCH.exec(action)
+  if (batch?.[1] !== undefined) return batch[1]
+  const chinese = CHINESE_LIST.exec(action)
+  if (chinese?.[1] !== undefined) {
+    const name = chinese[1].replace(/^(?:把|将|这|那|个|的|进|到|批|些)+/u, '').trim()
+    if (name !== '') return name
+  }
+  const latin = LATIN_LIST.exec(action)
+  if (latin?.[1] !== undefined) {
+    const name = latin[1].trim()
+    if (name !== '') return name
+  }
+  return undefined
+}
+
+/**
+ * Resolve the landing target of a write-shaped step.
+ *
+ * The target is the current explicit selection plus the list the sentence
+ * names: 「工作区 › 品牌 › 名单」. A step that does not write returns undefined,
+ * so ordinary suggestion cards stay clean.
+ * @param step - one parsed next step.
+ * @param selection - the chosen workspace and brand names.
+ * @returns the target, or undefined when the step does not write.
+ */
+export function writeTargetOf(
+  step: NextStep,
+  selection: { readonly workspace?: string; readonly brand?: string },
+): WriteTarget | undefined {
+  if (!isWriteStep(step)) return undefined
+  return {
+    workspace: selection.workspace,
+    brand: selection.brand,
+    list: listNameOf(step.action),
+  }
+}
+
+/**
+ * Decide whether one action sentence is the "do this first" step.
+ *
+ * The test is textual and deterministic — no model output is trusted, inferred,
+ * or scored. A sentence qualifies when it opens with a prerequisite verb
+ * ({@link PRIORITY_PREFIXES}) or names a missing prerequisite anywhere
+ * ({@link PRIORITY_MARKERS}). Everything else is an ordinary step.
+ * @param action - the action sentence after `<module>：`.
+ * @returns true when the sentence itself says it comes first.
+ */
+export function isPriorityAction(action: string): boolean {
+  const text = action.trim()
+  return PRIORITY_PREFIXES.some(prefix => text.startsWith(prefix))
+    || PRIORITY_MARKERS.some(marker => text.includes(marker))
+}
+
+/** A next step after the priority pass: the sentence plus its priority mark. */
+export interface PrioritizedNextStep extends NextStep {
+  /** Whether this card carries the 优先 badge (exactly one card may). */
+  readonly priority: boolean
+}
+
+/**
+ * Mark at most one step as high priority and move it to the front.
+ *
+ * The rule, in order:
+ * 1. the **first** sentence that {@link isPriorityAction} accepts is the
+ *    priority card (later matches are left alone);
+ * 2. otherwise, a lone card is the priority card (there is nothing to order it
+ *    against);
+ * 3. otherwise nothing is marked and the answer's own order is kept.
+ *
+ * Reordering is a single stable move of the marked card to index 0: the other
+ * cards keep their relative order, so the same input always yields the same
+ * output. The function is pure and returns fresh objects, so a re-render of
+ * unchanged input cannot reorder anything a second time.
+ * @param steps - parsed steps, in the answer's order.
+ * @returns the same steps, at most one marked `priority: true`, marked step first.
+ */
+export function prioritizeNextSteps(steps: readonly NextStep[]): readonly PrioritizedNextStep[] {
+  const match = steps.findIndex(step => isPriorityAction(step.action))
+  // A single card is the suggestion by construction; two ordinary cards keep
+  // the answer's order because the rule has nothing to rank them by.
+  const marked = match !== -1 ? match : steps.length === 1 ? 0 : -1
+  const ordered: PrioritizedNextStep[] = []
+  if (marked !== -1) ordered.push({ ...steps[marked]!, priority: true })
+  for (const [index, step] of steps.entries()) {
+    if (index === marked) continue
+    ordered.push({ ...step, priority: false })
+  }
+  return ordered
+}
