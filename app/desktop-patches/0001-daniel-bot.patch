+// @vitest-environment jsdom
+/**
+ * The panorama dialog's behavioural contract: it opens from the empty state's
+ * "能做什么" entry on a narrow window (the rail is 320px-only, so < 1024 the
+ * same guide is a dialog), behaves like a modal (initial focus, Escape, mask,
+ * focus return), filters its own copy locally, describes all nine modules /
+ * thirty-one functions, and its one action writes a composer draft without
+ * ever sending.
+ *
+ * The generator half is covered here too: the checked-in payload must match
+ * the authored guide, and a hand-edited phrase must fail rather than ship.
+ */
+import { readFileSync } from 'node:fs'
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { CapabilityEntry } from '../src/client/CapabilityEntry.tsx'
+import type { CapabilityEntryProps } from '../src/client/CapabilityEntry.tsx'
+import { GUIDE } from '../src/client/guide.generated.ts'
+import { filterGuide } from '../src/client/GuideMap.tsx'
+import { prefillDraft, type PrefillResult, type PrefillSessions } from '../src/client/prefill.ts'
+import { zh } from '../src/client/locales.ts'
+import { assertGuide, guideDigest, readGuide } from '../scripts/build-guide.mjs'
+
+const FIXTURE = 'packages/client/ui-capability-map/tests/fixtures/daniel-guide.json'
+const GUIDE_CSS = 'packages/client/ui-capability-map/src/client/GuideMap.module.css'
+const MODAL_CSS = 'packages/client/ui-primitives/src/Modal.module.css'
+
+afterEach(() => {
+  cleanup()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+/**
+ * Interpolate `{name}` placeholders like the locale service.
+ * @param template - dictionary value.
+ * @param params - interpolation values.
+ * @returns the rendered string.
+ */
+function interpolate(template: string, params?: Record<string, unknown>): string {
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/gu, (match, name: string) => (name in params ? String(params[name]) : match))
+}
+
+/**
+ * Build the body props the outside entry (and its dialog) renders with.
+ * @param overrides - guide actions to bind.
+ * @returns props for `CapabilityEntry`.
+ */
+function props(overrides: {
+  prefill?: (phrase: string) => PrefillResult
+  focusChat?: () => boolean
+} = {}): CapabilityEntryProps {
+  return {
+    variant: 'hero',
+    t: (key: string, params?: Record<string, unknown>) =>
+      interpolate((zh as Record<string, string>)[key] ?? key, params),
+    prefill: overrides.prefill ?? (() => 'unavailable'),
+    focusChat: overrides.focusChat ?? (() => true),
+    openRail: () => {},
+  }
+}
+
+/**
+ * Mount the empty state's entry on a narrow window, open the dialog, return it.
+ * @param overrides - guide actions to bind.
+ * @returns the dialog element.
+ */
+function openGuide(overrides: {
+  prefill?: (phrase: string) => PrefillResult
+  focusChat?: () => boolean
+} = {}): HTMLElement {
+  // 900px: below the 1024 rail breakpoint, so the entry opens the dialog.
+  vi.stubGlobal('innerWidth', 900)
+  render(<CapabilityEntry {...props(overrides)} variant="hero" />)
+  fireEvent.click(screen.getByRole('button', { name: zh['hero.more'] }))
+  return screen.getByRole('dialog')
+}
+
+/**
+ * The module index's buttons, in product order.
+ * @param dialog - the open dialog.
+ * @returns the module buttons.
+ */
+function moduleButtons(dialog: HTMLElement): HTMLElement[] {
+  const nav = within(dialog).getByRole('navigation', { name: zh['guide.modules'] })
+  return within(nav).queryAllByRole('button')
+}
+
+/**
+ * Read a dialog's visible text with single interpolated spaces.
+ * @param element - dialog root.
+ * @returns its text content, whitespace-normalized.
+ */
+function blank(element: HTMLElement): string {
+  return (element.textContent ?? '').replace(/\s+/gu, ' ').trim()
+}
+
+/* ── the dialog as a modal ──────────────────────────────────────────────── */
+
+describe('panorama dialog shell', () => {
+  it('opens from the empty-state entry and lands focus in the search box', () => {
+    // 900px: below the 1024 rail breakpoint, so this entry opens the dialog.
+    vi.stubGlobal('innerWidth', 900)
+    render(<CapabilityEntry {...props()} variant="hero" />)
+    const trigger = screen.getByRole('button', { name: zh['hero.more'] })
+    expect(zh['hero.more']).toBe('不知道从哪开始？看看能做什么 →')
+    expect(screen.queryByRole('dialog')).toBeNull()
+
+    fireEvent.click(trigger)
+
+    const dialog = screen.getByRole('dialog')
+    expect(dialog.getAttribute('aria-modal')).toBe('true')
+    expect(dialog.getAttribute('aria-label')).toBe(zh['guide.title'])
+    expect(document.activeElement).toBe(within(dialog).getByRole('searchbox'))
+  })
+
+  it('closes on Escape and returns focus to the trigger', () => {
+    openGuide()
+    fireEvent.keyDown(document, { key: 'Escape' })
+    expect(screen.queryByRole('dialog')).toBeNull()
+    expect(document.activeElement).toBe(screen.getByRole('button', { name: zh['hero.more'] }))
+  })
+
+  it('closes on the mask and on the close control', () => {
+    const dialog = openGuide()
+    // The shared modal renders the mask as the dialog's preceding sibling in the portal root.
+    const mask = dialog.parentElement?.firstElementChild
+    expect(mask).not.toBeNull()
+    fireEvent.click(mask as HTMLElement)
+    expect(screen.queryByRole('dialog')).toBeNull()
+    expect(document.activeElement).toBe(screen.getByRole('button', { name: zh['hero.more'] }))
+
