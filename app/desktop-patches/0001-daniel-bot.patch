+    const shell = new SessionInputShell({
+      actx: {} as never,
+      defaultSink: sink as never,
+      commandAttachments: { serialize: () => Promise.resolve([]), release: () => {}, unsupportedNotice: token => token },
+      sendGuard: () => registryOf(store),
+    })
+    shell.setDraft('查一下 Halliday 的负面')
+    shell.submit()
+    expect(sink).not.toHaveBeenCalled()
+    expect(store.getSnapshot().missing).toBe('workspace')
+    // The one-click notice is now on screen, and it only opens the picker.
+    const view = render(createElement(SelectionNotice as never, {
+      t,
+      useSelection: bind(store),
+      actions: { openPicker: (kind: never) => { store.setOpen(kind) } },
