+/**
+ * At-rest sealing for the values a credentials document stores.
+ *
+ * A stored value is either the version-1 sealed envelope `v1:<base64>` or a
+ * legacy plaintext scalar. The envelope's base64 body starts with one scheme
+ * byte, so a document written under one cipher stays readable after another
+ * cipher becomes the preferred writer: `safeStorage` (Electron's OS-keychain
+ * backed API) and `aes-256-gcm` (a 32-byte key kept in an owner-only sibling
+ * file) can share a document.
+ *
+ * Sealing never degrades to plaintext. When no cipher is available the sealer
+ * refuses to seal — the caller turns that into a refused write — and when a
+ * stored envelope cannot be opened the sealer throws
+ * {@link CredentialDecryptionError}. Neither error carries a value: the whole
+ * point of the module is that a secret reaches disk only inside an envelope.
+ *
+ * @module @deepseek-ai/dsh-credentials-local/sealing
+ */
+
+import { createCipheriv, createDecipheriv, randomBytes } from 'node:crypto'
+import { mkdir, readFile, stat, writeFile } from 'node:fs/promises'
+import { dirname } from 'node:path'
+
+/** Prefix every sealed value carries; a value without it is legacy plaintext. */
+export const SEALED_PREFIX = 'v1:'
+
+/** Scheme byte stored at the head of an envelope's base64 body. */
+const SCHEME_SAFE_STORAGE = 1
+const SCHEME_AES_GCM = 2
+
+/** Bytes of a sealed value that precede the cipher's own payload. */
+const SCHEME_BYTES = 1
+
+/** AES-256-GCM parameters: 12-byte nonce, 16-byte authentication tag, 32-byte key. */
+const AES_KEY_BYTES = 32
+const AES_IV_BYTES = 12
+const AES_TAG_BYTES = 16
+
+/** Encryption key file suffix appended to the document path (`.credentials.yaml.key`). */
+const KEY_FILE_SUFFIX = '.key'
+
+/** Permission bits outside the owner; a key file must have none of them. */
+const GROUP_OTHER_BITS = 0o077
+
+/** The ciphers this build can write and read, named by the byte the envelope stores. */
+export type SealedScheme = 'safe-storage' | 'aes-256-gcm'
+
+/** One cipher capable of sealing and opening an envelope payload. */
+export interface CredentialCipher {
+  /** Scheme recorded in the envelope, so decryption picks this cipher back up. */
+  readonly scheme: SealedScheme
+  /** Seal one UTF-8 plaintext into cipher bytes (scheme byte excluded). */
+  seal(plain: string): Uint8Array
+  /** Open cipher bytes back into the plaintext that produced them. */
+  open(payload: Uint8Array): string
+}
+
+/** The slice of Electron's `safeStorage` this module uses. */
+export interface SafeStorageLike {
+  /** Whether the platform can encrypt; Electron returns false on an unusable keychain. */
+  isEncryptionAvailable(): boolean
+  /** Encrypt one string with the OS-held key. */
+  encryptString(plain: string): Buffer
+  /** Decrypt bytes produced by {@link encryptString}. */
+  decryptString(encrypted: Buffer): string
+}
+
+/**
+ * A write was refused because no cipher could be resolved. The message is the
+ * actionable text a settings surface shows; it names no value.
+ */
+export class CredentialEncryptionUnavailableError extends Error {
+  constructor(reason: string) {
+    super(
+      '凭据无法加密保存：本机加密不可用（' + reason + '）。'
+      + '请修复后重试；本应用不会把 API Key 明文写入磁盘。',
+    )
+    this.name = 'CredentialEncryptionUnavailableError'
+  }
+}
+
+/**
+ * A stored envelope could not be opened. The message is the actionable text a
+ * settings surface shows; it names no value and never includes the ciphertext.
+ */
+export class CredentialDecryptionError extends Error {
+  constructor(reason: string) {
+    super(`凭据无法解密，请重新输入 API Key（${reason}）；本机不会回退读取明文。`)
+    this.name = 'CredentialDecryptionError'
+  }
+}
+
+/**
+ * Whether a stored scalar carries the sealed envelope. Legacy documents hold
+ * bare plaintext here, which is exactly what migration rewrites.
+ * @param value - the scalar as stored.
+ * @returns whether the value claims to be sealed.
+ */
+export function isSealed(value: string): boolean {
+  return value.startsWith(SEALED_PREFIX)
