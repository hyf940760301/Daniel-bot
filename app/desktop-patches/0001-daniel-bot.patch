@@ -0,0 +1,220 @@
+/**
+ * Capability rail, browser half: register the dictionary and the one occupant
+ * of the frame's `shell.rail` single slot.
+ *
+ * Why this seat (see CHANGES-RAIL-COLUMN.md):
+ * - `shell.rail` is a real grid column declared by AppFrame, left of the
+ *   sidebar. The frame sizes it (48px strip / 320px panel), owns the open
+ *   request, and passes `{ open, onToggle }`; the rail therefore never covers
+ *   the sidebar's pixels, which the old `shell.overlay` floating strip did.
+ * - `sidebar` is a single slot occupied by ui-sidebar's SidebarRoot; a second
+ *   registration shadows the navigation column instead of sitting beside it.
+ * - `shell.leading` is a single slot occupied by the sidebar's window-chrome
+ *   controls, and AppFrame mounts it only for drawers and collapsed macOS
+ *   sidebars — the rail would be invisible in the default expanded frame.
+ * - `shell.overlay` was the previous seat for this rail: a floating list layer
+ *   above every column. The real column supersedes it.
+ *
+ * The live execution fold (S6.4) rides on the same registration as an injected
+ * face: the plugin builds one `CapabilityTrace` over the Client Session service
+ * and hands it to the panel through `inject`, which the renderer binds into the
+ * component's `useTrace` selector hook. That keeps the reading path on services
+ * the Client already publishes (see CHANGES-RAIL-V2.md §4) and keeps the feed
+ * lazy — its first subscriber is the expanded panel.
+ */
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-api-session-controller/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+// Type-only: pulls `ctx.layout` (the rail's open request) and the Conversation
+// SlotMap entries this plugin fills (`conversation.context.bar`, the hero's
+// capability entry, and the composer tool row).
+import type {} from '@deepseek-ai/dsh-client-ui-layout/client'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { CapabilityMap } from './CapabilityMap.tsx'
+import type { CapabilityMapInjected } from './CapabilityMap.tsx'
+import { HeroCapabilityEntry, InputCapabilityEntry } from './CapabilityEntry.tsx'
+import type { CapabilityEntryInjected } from './CapabilityEntry.tsx'
+import { ContextBar } from './ContextBar.tsx'
+import type { ContextBarInjected } from './ContextBar.tsx'
+import { ContextSelection, desktopBridgeOf, promptSelectionOf } from './selection.ts'
+import { SelectionNotice, type SelectionNoticeInjected } from './SelectionNotice.tsx'
+import { ContextTrace } from './context.ts'
+import { NextStepCards, type NextStepsInjected } from './NextSteps.tsx'
+import { CapabilityTrace } from './trace.ts'
+import { focusComposer, prefillDraft } from './prefill.ts'
+import { en, NS, zh, type CapabilityMapKey } from './locales.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Execution-rail copy. */
+    'capability-map': CapabilityMapKey
+  }
+}
+
+export type { CapabilityMapProps } from './CapabilityMap.tsx'
+export type { CapabilityEntryInjected, CapabilityEntryProps, CapabilityRoute, HeroCapabilityEntryProps, InputCapabilityEntryProps } from './CapabilityEntry.tsx'
+export {
+  CapabilityEntry, HeroCapabilityEntry, InputCapabilityEntry, RAIL_ENTRY_MIN_VIEWPORT, capabilityRoute,
+} from './CapabilityEntry.tsx'
+export type { ContextBarActions, ContextBarInjected } from './ContextBar.tsx'
+export { ContextBar } from './ContextBar.tsx'
+export type { SelectionNoticeInjected } from './SelectionNotice.tsx'
+export { SelectionNotice } from './SelectionNotice.tsx'
+export type { SelectorOption, SelectorProps } from './Selector.tsx'
+export { Selector } from './Selector.tsx'
+export type {
+  BrandOption, BridgeFailure, ContextSelectionOptions, DanielDesktopBridge, DetectedContext,
+  OptionQuery, SelectionFeed, SelectionSnapshot, SelectorKind, StoredSelection, WorkspaceOption,
+} from './selection.ts'
+export {
+  ContextSelection, EMPTY_SELECTION, SELECTION_STORAGE_KEY, desktopBridgeOf, readStoredSelection, writeStoredSelection,
+} from './selection.ts'
+export type { ContextFeed, ContextSnapshot } from './context.ts'
+export { ContextTrace, EMPTY_CONTEXT, brandOfArgv, brandOfCall, callKind, workspaceId, workspaceNames } from './context.ts'
+export { moduleNameEn, moduleNameEnById } from './module-names.ts'
+export type { NextStepsInjected } from './NextSteps.tsx'
+export { NextStepCards } from './NextSteps.tsx'
+export type { NextStep, WriteTarget } from './next-steps.ts'
+export {
+  NEXT_STEP_LIMIT, NEXT_STEP_MODULES, WRITE_VERBS, isWriteStep, listNameOf, parseNextSteps, writeTargetOf,
+} from './next-steps.ts'
+export type { GuideMatch, GuideMapProps } from './GuideMap.tsx'
+export { GuideMap, filterGuide } from './GuideMap.tsx'
+export type { PrefillResult, PrefillSessions } from './prefill.ts'
+export { focusComposer, prefillDraft } from './prefill.ts'
+export type {
+  ModuleAction, ModuleDefinition, ModuleMapData, ModuleRule,
+} from './types.ts'
+export { MODULE_MAP_SCHEMA } from './types.ts'
+export { NS, en, zh } from './locales.ts'
+export { MODULE_MAP } from './module-map.generated.ts'
+export { GUIDE } from './guide.generated.ts'
+export type { GuideData, GuideFunction, GuideModule } from './types.ts'
+export { GUIDE_SCHEMA } from './types.ts'
+export type { ModuleState, ModuleStatus, TraceFeed, TraceSnapshot, TraceStep, TraceStatus } from './trace.ts'
+export { CapabilityTrace, EMPTY_TRACE, UNUSED_MODULES, commandToken, describeToolCall, isHumanPrompt } from './trace.ts'
+
+/** Required services: the slot registry, the locale service, the Client Session service, and the frame's layout face. */
+export const inject = ['slots', 'locale', 'sessions', 'layout']
+
+/**
+ * Client plugin body: register the dictionaries, the rail occupant, the
+ * read-only context strip above the conversation, and the next-step cards
+ * under a finished answer.
+ * @param ctx - client root context.
+ */
+export function apply(ctx: ClientContext): void {
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'capability-map: dictionaries')
+  const trace = new CapabilityTrace(ctx.sessions)
+  // The outside entries' injected face. Same one write as the rail's guide — a
+  // composer draft, never a send — plus the frame's memory-only rail request.
+  const entryFace = (): CapabilityEntryInjected => ({
+    prefill: phrase => prefillDraft(ctx.sessions, phrase),
+    focusChat: () => focusComposer(ctx.sessions),
+    openRail: () => { ctx.layout.openRail() },
+  })
+  // The context strip's fold is separate from the rail's: the strip is always
+  // mounted with the conversation, while the rail body only subscribes when
+  // the panel is open. Keeping them apart preserves that laziness.
+  const context = new ContextTrace(ctx.sessions)
+  // The explicit workspace/brand choice (design §9). Options come from the
+  // desktop bridge when this build has one; a web build falls back to what the
+  // session fold has already seen. The fold is still read, but only for that
+  // fallback and for the mismatch question — it never sets the choice.
+  const bridge = desktopBridgeOf()
+  const selection = new ContextSelection({
+    feed: context,
+    ...bridge === undefined ? {} : { bridge },
+  })
+  const contextBarActions = {
+    setOpen: (kind: Parameters<ContextSelection['setOpen']>[0]) => { selection.setOpen(kind) },
+    chooseWorkspace: (id: number) => { selection.chooseWorkspace(id) },
+    chooseBrand: (id: string) => { selection.chooseBrand(id) },
+    refresh: () => { void selection.refresh() },
+    switchToDetected: () => { selection.switchToDetected() },
+    keepDetected: () => { selection.keepDetected() },
+    dismissKept: () => { selection.dismissKept() },
+  }
+  ctx.slots.inject('shell.rail', () => ctx.slots.register({
+    name: 'shell.rail',
+    locale: NS,
+    inject: (): CapabilityMapInjected => ({
+      hooks: { trace },
+      // The guide's only write: a composer draft, never a send (see prefill.ts).
+      prefill: phrase => prefillDraft(ctx.sessions, phrase),
+      focusChat: () => focusComposer(ctx.sessions),
+    }),
+  }, CapabilityMap))
+  // The conversation top bar: two explicit selectors (工作区 / 品牌) plus the
+  // one-question mismatch banner. It reads the desktop directory (read-only) or
+  // this session's own results, and writes only the local remembered choice.
+  ctx.slots.inject('conversation.context.bar', () => ctx.slots.register({
+    name: 'conversation.context.bar',
+    id: 'capability-map.context',
+    locale: NS,
+    inject: (): ContextBarInjected => ({ hooks: { context, selection }, actions: contextBarActions }),
+  }, ContextBar))
+  // The refused-send notice, directly above the composer card. It has one
+  // action (open the missing selector) and never sends.
+  ctx.slots.inject('conversation.input.dock', () => ctx.slots.register({
+    name: 'conversation.input.dock',
+    id: 'capability-map.selection-notice',
+    order: -10,
+    locale: NS,
+    inject: (): SelectionNoticeInjected => ({
+      hooks: { selection },
+      actions: { openPicker: kind => { selection.setOpen(kind) } },
+    }),
+  }, SelectionNotice))
+  // The send gate: the composer consults it before dispatching a human
+  // submission. Registering through the Conversation service keeps the
+  // dependency pointing one way (the composer never imports this package).
+  const t = ctx.locale.bind(NS)
+  ctx.inject(['conversation'], (scope) => {
+    scope.effect(() => scope.conversation.sendGuard.register({
+      check: () => {
+        const missing = selection.attemptSend()
+        if (missing === undefined) return undefined
+        const workspace = missing === 'workspace'
+        return {
+          message: t(workspace ? 'gate.workspace' : 'gate.brand'),
+          actionLabel: t(workspace ? 'gate.chooseWorkspace' : 'gate.chooseBrand'),
+          action: () => { selection.setOpen(missing) },
+        }
+      },
+    }), 'capability-map: send gate')
+    // The same pair rides every accepted prompt as request metadata, so the
+    // model learns it from system-level context instead of the user's words
+    // (design §9.8). Absent selection contributes nothing.
+    scope.effect(() => scope.conversation.requestContext.register({
+      selection: () => promptSelectionOf(selection.getSnapshot()),
+    }), 'capability-map: prompt selection context')
+  })
+  // Next-step cards: same one write, one group per finished Turn (see
+  // CHANGES-NEXT-STEPS.md §3). No answer tail ⇒ the entry renders nothing.
+  ctx.slots.inject('conversation.chat.turnTail', () => ctx.slots.register({
+    name: 'conversation.chat.turnTail',
+    id: 'capability-map.next-steps',
+    order: 30,
+    locale: NS,
+    inject: (): NextStepsInjected => ({
+      hooks: { selection },
+      prefill: phrase => prefillDraft(ctx.sessions, phrase),
+    }),
+  }, NextStepCards))
+  // The two D-078 "能做什么" entries outside the rail. Both open the 320px
+  // panel on a wide frame and the 720px guide dialog below 1024px, so the
+  // entry is reachable even when the rail track does not exist (< 768).
+  ctx.slots.inject('conversation.input.left', () => ctx.slots.register({
+    name: 'conversation.input.left',
+    id: 'capability-map.entry',
+    locale: NS,
+    inject: entryFace,
+  }, InputCapabilityEntry))
+  ctx.slots.inject('conversation.hero.capability', () => ctx.slots.register({
+    name: 'conversation.hero.capability',
+    locale: NS,
+    inject: entryFace,
+  }, HeroCapabilityEntry))
+}
diff --git a/packages/client/ui-capability-map/src/client/locales.ts b/packages/client/ui-capability-map/src/client/locales.ts
new file mode 100644
index 00000000..c77e548e
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/locales.ts
@@ -0,0 +1,189 @@
+/**
+ * `capability-map` namespace dictionaries for the left execution rail.
+ *
+ * Only two languages ship: the desktop product is Chinese, and English is the
+ * fallback every other locale resolves to. Module names are data (see
+ * `module-map.generated.ts`), not copy: each module ships Daniel's own Chinese
+ * name plus its English name, so the rail and the guide render `中文名 + 英文名`
+ * without a lookup in this dictionary. Business actions stay Chinese-only —
+ * they are sentences about what Daniel did, not module identity.
