@@ -0,0 +1,214 @@
+/**
+ * The left execution rail (S6.4): a read-only window on the current task and
+ * on the nine Daniel modules that task has touched.
+ *
+ * Presentation contract:
+ * - The frame owns the open state. AppFrame's `shell.rail` column passes
+ *   `{ open, onToggle }` from its own solve: collapsed is the 48px strip, and
+ *   the frame mounts the column that way by default. The component keeps no
+ *   view state of its own and never toggles itself.
+ * - Expanded, it is the 320px panel: a title, the task path (step list), the
+ *   nine-module panorama, and one read-only note. There is no search box and
+ *   no static capability catalogue in the panel — the rail shows execution;
+ *   the manual lives in the dialog, opened from the footer control.
+ * - Read-only by construction: no RPC, no command, no link, no data action.
+ *   The controls are the strip (open), the panel's close button, and the
+ *   footer map opener, which opens a read-only dialog. Inside that dialog the
+ *   only action writes an unsent composer draft (see `prefill.ts`).
+ * - The 48px strip is ONE entry (D-078): a 22px icon plus the vertical words
+ *   "能做什么". No module name, no progress, no second button — the former
+ *   footer map button moved into the composer row and the empty hero, which
+ *   open the 320px rail (wide frames) or this dialog (narrow frames).
+ * - The live body is a child component, so a collapsed rail neither renders
+ *   it nor subscribes to the feed behind it.
+ *
+ * The rail is a real grid column, so the component draws inside the track the
+ * frame reserved and never positions itself over the sidebar.
+ */
+import { useEffect, useId, useRef, useState } from 'react'
+import type { ReactNode } from 'react'
+import {
+  IconChecklistOutlineRegular, IconCloseOutlineRegular,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type {} from '@deepseek-ai/dsh-client-ui-layout/client'
+import { TraceRail } from './TraceRail.tsx'
+import { GuideMap } from './GuideMap.tsx'
+import type { PrefillResult } from './prefill.ts'
+import type { TraceFeed } from './trace.ts'
+import { NS } from './locales.ts'
+import css from './CapabilityMap.module.css'
+
+/**
+ * Business face the registration injects: the live trace feed, bound by the
+ * renderer into the `useTrace` selector hook of the component props.
+ */
+export interface CapabilityMapInjected {
+  readonly hooks: {
+    /** Session-event-derived, per-task execution trace (see `trace.ts`). */
+    readonly trace: TraceFeed
+  }
+  /**
+   * Put one guide phrase into the conversation composer, unsent (see
+   * `prefill.ts`). It is the dialog's only side effect.
+   */
+  readonly prefill: (phrase: string) => PrefillResult
+  /**
+   * Give the keyboard back to the composer after a successful fill; the modal
+   * layer restores focus to its opener when the card unmounts.
+   * @returns whether a composer took focus.
+   */
+  readonly focusChat: () => boolean
+}
+
+/** Props of the `shell.rail` entry: the frame's open share, the locale seat, the trace feed. */
+export type CapabilityMapProps =
+  PropsRuntime<'shell.rail'>
+  & PropsLocale<typeof NS>
+  & InjectFace<CapabilityMapInjected>
+
+/**
+ * Render the execution rail inside the frame's rail column.
+ * @param props - the frame's open share, the locale seat, and the trace feed.
+ * @returns the collapsed strip or the expanded panel.
+ */
+export function CapabilityMap({ open, onToggle, t, useTrace, prefill, focusChat }: CapabilityMapProps): ReactNode {
+  const railRef = useRef<HTMLButtonElement | null>(null)
+  const closeRef = useRef<HTMLButtonElement | null>(null)
+  const guideRef = useRef<HTMLButtonElement | null>(null)
+  const wasOpen = useRef(open)
+  const instance = useId().replaceAll(':', '')
+  const panelId = `capability-map-${instance}`
+  const [guideOpen, setGuideOpen] = useState(false)
+  const wasGuideOpen = useRef(false)
+  const guideFocus = useRef<'trigger' | 'composer'>('trigger')
+
+  // Focus follows the frame's state: opening lands on the close control (the
+  // panel has no input), closing returns focus to the strip.
+  useEffect(() => {
+    if (open) closeRef.current?.focus()
+    else if (wasOpen.current) railRef.current?.focus()
+    wasOpen.current = open
+  }, [open])
+
+  // Closing the panorama dialog returns the keyboard to the control that
+  // opened it, whether it closed by Escape, the mask, or the close button. A
+  // successful "fill into the chat" instead leaves it in the composer, after
+  // the modal layer has restored focus to its opener.
+  useEffect(() => {
+    if (!guideOpen && wasGuideOpen.current) {
+      if (guideFocus.current === 'composer') focusChat()
+      else guideRef.current?.focus()
+      guideFocus.current = 'trigger'
+    }
+    wasGuideOpen.current = guideOpen
+  }, [guideOpen, focusChat])
+
+  const closeGuide = (focus: 'trigger' | 'composer' = 'trigger'): void => {
+    guideFocus.current = focus
+    setGuideOpen(false)
+  }
+
+  const guideButton = (
+    <button
+      ref={guideRef}
+      type="button"
+      className={css.guideButton}
+      aria-label={t('guide.open')}
+      aria-haspopup="dialog"
+      aria-expanded={guideOpen}
+      onClick={() => { setGuideOpen(true) }}
+    >
+      <span className={css.guideIcon} aria-hidden="true"><MapGlyph /></span>
+      <span className={css.guideLabel}>{t('guide.open')}</span>
+    </button>
+  )
+
+  if (!open) {
+    return (
+      <div className={css.dock} data-capability-map="collapsed" data-rail-width="48">
+        <button
+          ref={railRef}
+          type="button"
+          className={css.rail}
+          data-rail-entry=""
+          aria-expanded={false}
+          aria-label={t('map.open')}
+          title={t('rail.entryHint')}
+          onClick={onToggle}
+        >
+          <span className={css.railIcon} aria-hidden="true"><IconChecklistOutlineRegular size={22} /></span>
+          <span className={css.railTitle}>{t('rail.title')}</span>
+        </button>
+        {guideOpen && <GuideMap onClose={closeGuide} prefill={prefill} t={t} />}
+      </div>
+    )
+  }
+
+  return (
+    <div className={css.dock} data-capability-map="expanded" data-rail-width="320">
+      <aside
+        id={panelId}
+        className={css.panel}
+        aria-label={t('map.region')}
+        onKeyDown={(event) => {
+          if (event.key !== 'Escape' || event.defaultPrevented) return
+          event.preventDefault()
+          event.stopPropagation()
+          onToggle()
+        }}
+      >
+        <header className={css.header}>
+          <span className={css.headerIcon} aria-hidden="true"><IconChecklistOutlineRegular size={18} /></span>
+          <div className={css.headings}>
+            <h2 className={css.title}>{t('map.title')}</h2>
+            <span className={css.subtitle}>{t('map.subtitle')}</span>
+          </div>
+          <button
+            ref={closeRef}
+            type="button"
+            className={css.iconButton}
+            aria-label={t('map.collapse')}
+            onClick={onToggle}
+          >
+            <IconCloseOutlineRegular size={16} />
+          </button>
+        </header>
+
+        <div className={css.body}>
+          <TraceRail useTrace={useTrace} t={t} />
+        </div>
+
+        <p className={css.note}>{t('readonly.note')}</p>
+      </aside>
+      {guideButton}
+      {guideOpen && <GuideMap onClose={closeGuide} prefill={prefill} t={t} />}
+    </div>
+  )
+}
+
+/**
+ * The rail's own map glyph (the primitives set has no map/book icon): a folded
+ * map, drawn in `currentColor` so the button's theme colour applies.
+ * @returns the icon.
+ */
+function MapGlyph(): ReactNode {
+  return (
+    <svg
+      width="16"
+      height="16"
+      viewBox="0 0 16 16"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.1"
+      strokeLinejoin="round"
+      strokeLinecap="round"
+      aria-hidden="true"
+      focusable="false"
+    >
+      <path d="M1.9 3.7 5.95 2.2v10.1L1.9 13.8V3.7Z" />
+      <path d="M5.95 2.2 10.05 3.7v10.1L5.95 12.3V2.2Z" />
+      <path d="M10.05 3.7 14.1 2.2v10.1l-4.05 1.5" />
+    </svg>
+  )
+}
diff --git a/packages/client/ui-capability-map/src/client/ContextBar.module.css b/packages/client/ui-capability-map/src/client/ContextBar.module.css
new file mode 100644
index 00000000..d2be2e9a
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/ContextBar.module.css
@@ -0,0 +1,81 @@
+/* The conversation top bar: the two explicit selectors (design §9.7).
+ *
+ * The selectors own their own 32px/10px/8px/13px specs (Selector.module.css);
+ * this file owns the strip that holds them. The strip keeps the conversation
+ * header's inline inset so it reads as part of that column, and it stacks: the
+ * selector row, then an optional one-line mismatch question or 保持 tag.
+ * Nothing here animates. */
+
+.bar {
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 0;
+  padding: 8px 28px 8px 20px;
+  border-bottom: 0.5px solid var(--dsw-alias-border-l3);
+  background: var(--dsw-alias-bg-base);
+  color: var(--dsw-alias-label-primary);
+}
+
+/* The two selectors sit 8px apart — spec, not taste. */
+.row {
+  display: flex;
+  flex-wrap: nowrap;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+/* 不一致提示：一句话 + 两个按钮，不抢眼也不可忽略。 */
+.mismatch,
+.kept {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-top: 8px;
+  padding: 6px 10px;
+  border-radius: 8px;
+  background: var(--dsw-alias-bg-l2);
+  color: var(--dsw-alias-label-secondary);
+  font-size: 12px;
+  font-weight: 400;
+  line-height: 1.4;
+}
+
+.mismatchText {
+  flex: 0 1 auto;
+  min-width: 0;
+}
+
+.bannerAction,
+.bannerQuiet {
+  flex: none;
+  height: 24px;
+  padding: 0 8px;
+  border: 1px solid #E5E6EB;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+}
+
+.bannerAction {
+  border-color: #C9CDD4;
+}
+
+.bannerAction:hover,
+.bannerQuiet:hover {
+  background: #F5F6F7;
+}
+
+/* Narrow frames: tighten the inset; the selectors themselves ellipsize. */
+@media (max-width: 720px) {
+  .bar {
+    padding: 8px 16px;
+  }
+}
diff --git a/packages/client/ui-capability-map/src/client/ContextBar.tsx b/packages/client/ui-capability-map/src/client/ContextBar.tsx
new file mode 100644
index 00000000..57ca84d2
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/ContextBar.tsx
@@ -0,0 +1,191 @@
+/**
+ * The conversation top bar: two explicit selectors — 工作区 and 品牌 — instead of
+ * the old read-only line (design §9).
+ *
+ * Both halves are required. Neither answers from the task any more: the bar
+ * asks, the store remembers (localStorage), and the desktop bridge supplies the
+ * lists. The session fold is still read, but only for two jobs (§9.5):
+ * the web build's fallback option list, and detecting that a result came from
+ * a different workspace/brand — which raises a question, never a switch.
+ *
+ * The strip stays one line: 32px selectors separated by the 8px gap, and an
+ * optional second line for the mismatch question or the 保持 tag.
+ */
+import type { ReactNode } from 'react'
+import type { InjectFace, PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'
+// Type-only: pulls the Conversation SlotMap entry for `conversation.context.bar`.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { Selector } from './Selector.tsx'
+import type { ContextFeed } from './context.ts'
+import type { SelectionFeed, SelectionSnapshot, SelectorKind } from './selection.ts'
+import type { NS } from './locales.ts'
+import css from './ContextBar.module.css'
+
+/** The bar's one write each: pick, open, refresh, and the mismatch answers. */
+export interface ContextBarActions {
+  /** Open one dropdown, or close both with undefined. */
+  readonly setOpen: (kind: SelectorKind | undefined) => void
+  /** Choose a workspace by id. */
+  readonly chooseWorkspace: (id: number) => void
+  /** Choose a brand by id. */
+  readonly chooseBrand: (id: string) => void
+  /** Re-read both lists past the main process cache. */
+  readonly refresh: () => void
+  /** Accept the detected context (the 「切到 X」 answer). */
+  readonly switchToDetected: () => void
+  /** Keep the current choice (the 「保持」 answer). */
+  readonly keepDetected: () => void
+  /** Drop the 保持 tag. */
+  readonly dismissKept: () => void
+}
+
+/** Business face the registration injects. */
+export interface ContextBarInjected {
+  readonly hooks: {
+    /** Session-event-derived context, used only for the fallback list and mismatch detection. */
+    readonly context: ContextFeed
+    /** The persisted, explicit workspace/brand selection. */
+    readonly selection: SelectionFeed
+  }
+  readonly actions: ContextBarActions
+}
+
+/** Composed props of the `conversation.context.bar` entry. */
+type ContextBarProps = PropsLocale<typeof NS> & InjectFace<ContextBarInjected>
+
+/**
+ * Render the two selectors and the optional mismatch line.
+ * @param props - injected feeds and actions, plus the rail dictionary.
+ * @returns the top bar.
+ */
+export function ContextBar({
+  t, useContext, useSelection, actions,
+}: ContextBarProps): ReactNode {
+  const context = useContext(snapshot => snapshot)
+  const selection = useSelection(snapshot => snapshot)
+  const mismatch = selection.mismatch
+  const kept = selection.kept
+  return (
+    <div
+      className={css.bar}
+      data-context-bar=""
+      data-task={context.task}
+      data-context-source={selection.source}
+      role="group"
+      aria-label={t('context.region')}
+    >
+      <div className={css.row}>
+        <Selector
+          kind="workspace"
+          label={t('context.workspace')}
+          placeholder={t('context.unselected')}
+          selected={selection.workspace?.name}
+          options={selection.workspaces.map(option => ({ id: String(option.id), name: option.name }))}
+          open={selection.open === 'workspace'}
+          onOpenChange={open => { actions.setOpen(open ? 'workspace' : undefined) }}
+          onSelect={(id) => { actions.chooseWorkspace(Number(id)) }}
+          searchLabel={t('context.searchWorkspace')}
+          searchPlaceholder={t('context.searchWorkspace')}
+          emptyText={t('context.emptyWorkspace')}
+          refreshLabel={t('context.refresh')}
+          onRefresh={() => { actions.refresh() }}
+          loading={selection.loading}
+          loadingText={t('context.loading')}
+          failure={failureText(selection, t)}
+          footer={selection.source === 'session' ? t('context.sessionOnly') : undefined}
+        />
+        <Selector
+          kind="brand"
+          label={t('context.brand')}
+          placeholder={t('context.unselected')}
+          selected={selection.brand?.name}
+          options={selection.brands.map(option => ({ id: option.id, name: option.name }))}
+          open={selection.open === 'brand'}
+          onOpenChange={open => { actions.setOpen(open ? 'brand' : undefined) }}
+          onSelect={(id) => { actions.chooseBrand(id) }}
+          searchLabel={t('context.searchBrand')}
+          searchPlaceholder={t('context.searchBrand')}
+          emptyText={t('context.emptyBrand')}
+          refreshLabel={t('context.refresh')}
+          onRefresh={() => { actions.refresh() }}
+          loading={selection.loading}
+          loadingText={t('context.loading')}
+          failure={failureText(selection, t)}
+          footer={selection.source === 'session' ? t('context.sessionOnly') : undefined}
+        />
+      </div>
+      {mismatch !== undefined && (
+        <div className={css.mismatch} role="status" data-context-mismatch="">
+          <span className={css.mismatchText}>
+            {t('context.mismatch', {
+              detected: mismatchName(mismatch, selection),
+              current: currentName(mismatch, selection, t('context.unselected')),
+            })}
+          </span>
+          <button type="button" className={css.bannerAction} data-context-switch="" onClick={() => { actions.switchToDetected() }}>
+            {t('context.switchTo', { name: mismatchName(mismatch, selection) })}
+          </button>
+          <button type="button" className={css.bannerQuiet} data-context-keep="" onClick={() => { actions.keepDetected() }}>
+            {t('context.keep')}
+          </button>
+        </div>
+      )}
+      {kept !== undefined && (
+        <div className={css.kept} role="status" data-context-kept="">
+          <span>{t('context.kept', { name: mismatchName(kept, selection) })}</span>
+          <button type="button" className={css.bannerQuiet} data-context-kept-dismiss="" onClick={() => { actions.dismissKept() }}>
+            {t('context.dismiss')}
+          </button>
+        </div>
+      )}
+    </div>
+  )
+}
+
+/**
+ * The name of the half the question is about.
+ * @param detected - the context a result came from.
+ * @param selection - the current choice.
+ * @returns the workspace name when the workspace differs, else the brand name.
+ */
+function mismatchName(
+  detected: SelectionSnapshot['mismatch'] | SelectionSnapshot['kept'],
+  selection: SelectionSnapshot,
+): string {
+  if (detected === undefined) return ''
+  if (selection.workspace?.id !== detected.workspace.id) return detected.workspace.name
+  return detected.brand?.name ?? detected.workspace.name
+}
+
+/**
+ * The current choice's name for the same half the question is about.
+ * @param detected - the context a result came from.
+ * @param selection - the current choice.
+ * @param unselected - localized 「未选择」.
+ * @returns the current name, or the placeholder.
+ */
+function currentName(
+  detected: SelectionSnapshot['mismatch'],
+  selection: SelectionSnapshot,
+  unselected: string,
+): string {
+  if (detected === undefined) return unselected
+  if (selection.workspace?.id !== detected.workspace.id) return selection.workspace?.name ?? unselected
+  return selection.brand?.name ?? unselected
+}
+
+/**
+ * Turn the bridge's typed failure into one localized line.
+ * @param selection - the published selection state.
+ * @param t - the `capability-map` dictionary.
+ * @returns the line, or undefined when the last read succeeded.
+ */
+function failureText(
+  selection: SelectionSnapshot,
+  t: (key: 'context.timeout' | 'context.failed') => string,
+): string | undefined {
+  const failure = selection.failure
+  if (failure === undefined) return undefined
+  if (failure.kind === 'timeout') return t('context.timeout')
+  return t('context.failed')
+}
diff --git a/packages/client/ui-capability-map/src/client/GuideMap.module.css b/packages/client/ui-capability-map/src/client/GuideMap.module.css
