+// @vitest-environment jsdom
+/**
+ * The conversation-top context strip and the bilingual module names.
+ *
+ * Two contracts are pinned here:
+ *
+ * 1. **上下文条** — the thin strip above the conversation shows the task's real
+ *    `activeWorkspaceId` (never a guess) and the brand the task last named on
+ *    `--brand` (never a global "current brand", because Daniel has none). The
+ *    strip is read-only: it issues no request, renders no control, and clears
+ *    the brand when a new human task starts while keeping the workspace.
+ * 2. **中英双语** — the nine published modules carry Daniel's own Chinese name
+ *    plus an English name, in the rail, the step path, and the guide dialog;
+ *    the 48px collapsed strip has no module rows to squeeze.
+ */
+import { readFileSync } from 'node:fs'
+import { useSyncExternalStore } from 'react'
