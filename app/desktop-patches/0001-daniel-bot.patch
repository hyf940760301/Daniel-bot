--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/context.ts
@@ -0,0 +1,588 @@
+/**
+ * "Which workspace and which brand is this task working in?" — the read-only
+ * context strip above the conversation.
+ *
+ * Background (see CHANGES-CONTEXT-NAMING.md §1): the two halves of the answer
+ * have different sources, and the strip must not invent either.
+ *
+ * - **Workspace is real state.** `account workspaces` reports the account's
+ *   `activeWorkspaceId`; the strip reads it off the result the task itself
+ *   produced. The same result carries the `workspaces[]` rows, so the strip can
+ *   show the workspace's **name** (90002 → `Jack`) instead of its number; the
+ *   number is only the fallback when that row is missing from the result.
+ *   Before that result, or when its output carries no id, the strip says
+ *   工作区：未知 rather than guessing from the session's cwd or workspace files.
+ * - **A brand is per call, not global.** Daniel has no "current brand" — every
+ *   command names one with `--brand <编号或名字>`. So the strip shows the brand
+ *   of the most recent call in the current task, and 品牌：未指定 when the task
+ *   has not named one. A numeric id is translated to its name only through a
+ *   `brands list` result the same session already produced; when that mapping
+ *   is missing the raw value stays on screen, because hiding it would be worse
+ *   than showing an id.
+ *
+ * Task boundary: a human `user/message` starts a new task and clears the brand
+ * (the workspace is account state and survives). A session switch, or the last
+ * subscriber detaching, forgets everything.
+ *
+ * Cost and safety: one subscription to the session's existing event window,
+ * held only while the strip is mounted; it reads `tool/call` arguments and
+ * `tool/result` text, never issues a request, and never writes anything.
+ */
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type {
+  ISessions, SessionBinding, SessionEventLikeEntry, SessionListState,
+} from '@deepseek-ai/dsh-api-session-controller/client'
+import { currentSessionId, isHumanPrompt } from './trace.ts'
+
+/** Arguments larger than this are never parsed; a call that big is not ours. */
+const ARGUMENT_LIMIT = 65_536
+
+/** What one tool call is expected to produce, when it can teach the strip anything. */
+type CallKind = 'workspaces' | 'brands'
+
+/** What the strip renders. */
+export interface ContextSnapshot {
+  /** Task ordinal, bumped on every new human message (keys the reset). */
+  readonly task: number
+  /** `activeWorkspaceId` from this session's `account workspaces` result. */
+  readonly workspace: number | undefined
+  /** Name for {@link workspace} from the same result's `workspaces[]` rows, when known. */
+  readonly workspaceName: string | undefined
+  /** Raw value of the most recent `--brand` argument in this task. */
+  readonly brand: string | undefined
+  /** Name for {@link brand} resolved through a `brands list` result, when known. */
+  readonly brandName: string | undefined
+  /**
+   * Every workspace this session has seen named, in first-seen order. The
+   * selectors' web fallback lists these when the desktop bridge is absent
+   * (design §9.7); the fold already collects them to translate ids to names.
+   */
+  readonly workspaces: readonly ContextWorkspace[]
+  /** Every brand this session has seen named, in first-seen order (same fallback). */
+  readonly brands: readonly ContextBrand[]
+}
+
+/** One workspace row recovered from a session result. */
+export interface ContextWorkspace {
+  readonly id: number
+  readonly name: string
+}
+
+/** One brand row recovered from a session result. */
+export interface ContextBrand {
+  readonly id: string
+  readonly name: string
+}
+
+/** Stable observable the strip's hook selects from. */
+export type ContextFeed = HostObservable<ContextSnapshot>
+
+/** Nothing known yet. */
+export const EMPTY_CONTEXT: ContextSnapshot = Object.freeze({
+  task: 0,
+  workspace: undefined,
+  workspaceName: undefined,
+  brand: undefined,
+  brandName: undefined,
+  workspaces: Object.freeze([]) as readonly ContextWorkspace[],
+  brands: Object.freeze([]) as readonly ContextBrand[],
+})
+
+/** Branded Session identity, as the Client session list types its keys. */
+type SessionKey = SessionListState['ids'][number]
+
+/** One brand row recovered from a `brands list` result, keyed by id when read. */
+interface BrandPair {
+  readonly id: string
+  readonly name: string
+}
+
+/**
+ * Parse a tool call's argument JSON, tolerating anything the model sent.
+ * @param raw - raw argument string from the session log.
+ * @returns the parsed object, or undefined when absent, oversized, or not an object.
+ */
+function argumentObject(raw: string): Record<string, unknown> | undefined {
+  if (raw === '' || raw.length > ARGUMENT_LIMIT) return undefined
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(raw)
+  } catch {
+    return undefined
+  }
+  return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+    ? parsed as Record<string, unknown>
+    : undefined
+}
+
+/**
+ * Strip the quotes an argv value may carry.
+ * @param value - one argument token.
+ * @returns the token without surrounding quotes.
+ */
+function unquote(value: string): string {
+  return value.replace(/^["'`]+/u, '').replace(/["'`]+$/u, '')
+}
+
+/**
+ * Read the `--brand` value out of one argv array. Both spellings the CLI
+ * accepts are understood: `--brand <值>` and `--brand=<值>`.
+ * @param argv - candidate command tokens, as the model passed them.
+ * @returns the last brand value in the array, or undefined when none names one.
+ */
+export function brandOfArgv(argv: unknown): string | undefined {
+  if (!Array.isArray(argv)) return undefined
+  let brand: string | undefined
+  const tokens = argv.filter((token): token is string => typeof token === 'string')
+  for (const [index, token] of tokens.entries()) {
+    const assigned = /^--brand=(.+)$/u.exec(token)
+    if (assigned !== null) {
+      const value = unquote(assigned[1] ?? '').trim()
+      if (value !== '') brand = value
+      continue
+    }
+    if (token !== '--brand') continue
+    const next = tokens[index + 1]
+    if (next === undefined || next.startsWith('-')) continue
+    const value = unquote(next).trim()
+    if (value !== '') brand = value
+  }
+  return brand
+}
+
+/**
+ * Read the brand one tool call names, across the argv-shaped Daniel tools.
+ * @param tool - tool name as recorded in the log.
+ * @param args - parsed arguments, when they were an object.
+ * @returns the brand value, or undefined when the call names none.
+ */
+export function brandOfCall(tool: string, args: Record<string, unknown> | undefined): string | undefined {
+  if (args === undefined) return undefined
+  if (tool === 'daniel_run' || tool === 'daniel_write_plan') return brandOfArgv(args['argv'])
+  if (tool !== 'daniel_batch') return undefined
+  const calls = args['calls']
+  if (!Array.isArray(calls)) return undefined
+  let brand: string | undefined
+  for (const call of calls) {
+    const resolved = brandOfArgv(call)
+    if (resolved !== undefined) brand = resolved
+  }
+  return brand
+}
+
+/**
+ * Reduce one argv array to the two-token command it runs.
+ * @param argv - candidate tokens.
+ * @returns `<group> <subcommand>` in lower case, or undefined when absent.
+ */
+function argvCommand(argv: unknown): string | undefined {
+  if (!Array.isArray(argv)) return undefined
+  const tokens: string[] = []
+  for (const token of argv) {
+    if (typeof token !== 'string' || token.startsWith('-')) continue
+    tokens.push(token.toLowerCase())
+    if (tokens.length === 2) break
+  }
+  return tokens.length === 2 ? tokens.join(' ') : undefined
+}
+
+/**
+ * Which published command, if any, a call runs — only the two the strip reads.
+ * @param tool - tool name as recorded in the log.
+ * @param args - parsed arguments, when they were an object.
+ * @returns the call kind, or undefined when the call teaches the strip nothing.
+ */
+export function callKind(tool: string, args: Record<string, unknown> | undefined): CallKind | undefined {
+  if (tool === 'daniel_brands_list') return 'brands'
+  if (tool === 'daniel_run' || tool === 'daniel_write_plan') {
+    const command = argvCommand(args?.['argv'])
+    if (command === 'account workspaces' || command === 'workspaces list') return 'workspaces'
+    if (command === 'brands list') return 'brands'
+    return undefined
+  }
+  if (tool !== 'daniel_batch') return undefined
+  const calls = args?.['calls']
+  if (!Array.isArray(calls)) return undefined
+  let kind: CallKind | undefined
+  for (const call of calls) {
+    const command = argvCommand(call)
+    if (command === 'account workspaces' || command === 'workspaces list') kind = 'workspaces'
+    else if (command === 'brands list') kind = 'brands'
+  }
+  return kind
+}
+
+/**
+ * Join the text blocks of a tool result into one string.
+ * @param message - the `tool/result` message record.
+ * @returns its text content; empty when the result carries no text.
+ */
+function resultText(message: unknown): string {
+  if (typeof message !== 'object' || message === null) return ''
+  const content = (message as { content?: unknown }).content
+  if (!Array.isArray(content)) return ''
+  const parts: string[] = []
+  for (const block of content) {
+    if (typeof block === 'object' && block !== null) {
+      const text = (block as { text?: unknown }).text
+      if (typeof text === 'string') parts.push(text)
+    }
+  }
+  return parts.join('\n')
+}
+
+/**
+ * Walk parsed JSON for the first value stored under one key.
+ * @param value - any parsed JSON node.
+ * @param key - the key to look for.
+ * @returns the value, or undefined when the key never appears.
+ */
+function findKey(value: unknown, key: string): unknown {
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      const found = findKey(item, key)
+      if (found !== undefined) return found
+    }
+    return undefined
+  }
+  if (typeof value !== 'object' || value === null) return undefined
+  const record = value as Record<string, unknown>
+  if (Object.hasOwn(record, key)) return record[key]
+  for (const item of Object.values(record)) {
+    const found = findKey(item, key)
+    if (found !== undefined) return found
+  }
+  return undefined
+}
+
+/**
+ * Collect the brand rows of one `brands list` result.
+ * @param parsed - parsed JSON body, when the text was JSON.
+ * @returns the recoverable brand id / name pairs.
+ */
+function pairsFromJson(parsed: unknown): BrandPair[] {
+  const brands = findKey(parsed, 'brands')
+  if (!Array.isArray(brands)) return []
+  const pairs: BrandPair[] = []
+  for (const brand of brands) {
+    if (typeof brand !== 'object' || brand === null) continue
+    const record = brand as Record<string, unknown>
+    const id = record['id']
+    const name = record['name']
+    if (typeof id !== 'number' && typeof id !== 'string') continue
+    if (typeof name !== 'string' || name.trim() === '') continue
+    pairs.push({ id: String(id), name: name.trim() })
+  }
+  return pairs
+}
+
+/**
+ * Recover brand id / name pairs from a text body, JSON first and a tolerant
+ * scan second (the result may be wrapped in prose or truncated).
+ * @param text - the result's text.
+ * @returns the recoverable pairs; empty when the text names no brand.
+ */
+function brandPairs(text: string): BrandPair[] {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    parsed = undefined
+  }
+  const fromJson = parsed === undefined ? [] : pairsFromJson(parsed)
+  if (fromJson.length > 0) return fromJson
+  const pairs: BrandPair[] = []
+  for (const match of text.matchAll(/"id"\s*:\s*(\d+)[\s\S]{0,400}?"name"\s*:\s*"([^"\\]*)"/gu)) {
+    const id = match[1]
+    const name = match[2]
+    if (id !== undefined && name !== undefined && name.trim() !== '') pairs.push({ id, name: name.trim() })
+  }
+  for (const match of text.matchAll(/"name"\s*:\s*"([^"\\]*)"[\s\S]{0,400}?"id"\s*:\s*(\d+)/gu)) {
+    const name = match[1]
+    const id = match[2]
+    if (id !== undefined && name !== undefined && name.trim() !== '' && !pairs.some(pair => pair.id === id)) {
+      pairs.push({ id, name: name.trim() })
+    }
+  }
+  return pairs
+}
+
+/**
+ * Read the active workspace id out of an `account workspaces` result.
+ * @param text - the result's text.
+ * @returns the id, or undefined when the result does not carry one.
+ */
+export function workspaceId(text: string): number | undefined {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    parsed = undefined
+  }
+  if (parsed !== undefined) {
+    const active = findKey(parsed, 'activeWorkspaceId')
+    if (typeof active === 'number' && Number.isFinite(active)) return active
+    const chineseActive = findKey(parsed, '当前工作区') ?? findKey(parsed, '工作区编号')
+    if (typeof chineseActive === 'number' && Number.isFinite(chineseActive)) return chineseActive
+    const workspaces = findKey(parsed, 'workspaces')
+    if (Array.isArray(workspaces)) {
+      for (const row of workspaces) {
+        if (typeof row !== 'object' || row === null) continue
+        const record = row as Record<string, unknown>
+        if (record['isActive'] !== true) continue
+        const id = record['id'] ?? record['编号']
+        if (typeof id === 'number' && Number.isFinite(id)) return id
+      }
+    }
+  }
+  const active = /"activeWorkspaceId"\s*:\s*(\d+)/u.exec(text)
+  if (active?.[1] !== undefined) return Number(active[1])
+  // 最后兜底：Bot 有时用自然语言给结论（"你现在处于工作区 90002（jack）"）。
+  const spoken = /工作区[^0-9]{0,12}(\d{4,})/u.exec(text)
+  if (spoken?.[1] !== undefined) return Number(spoken[1])
+  return undefined
+}
+
+/**
+ * Read the workspace name of every row in an `account workspaces` result.
+ *
+ * The payload that carries `activeWorkspaceId` also carries `workspaces[]`
+ * (`{id, name, isActive, …}`), so the strip can show 90002 as `Jack` from the
+ * very result the task already produced — no second call, no lookup table.
+ *
+ * @param text - the result's text.
+ * @returns id → name for every row carrying both; empty when none does.
+ */
+export function workspaceNames(text: string): Map<number, string> {
+  const names = new Map<number, string>()
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    parsed = undefined
+  }
+  // A well-formed payload is authoritative: a row without a usable name leaves
+  // its id unknown (the strip then shows the id) instead of borrowing the next
+  // row's name. Only unparseable text — prose, a cut-off result — is scanned.
+  if (parsed !== undefined) {
+    const rows = findKey(parsed, 'workspaces')
+    if (Array.isArray(rows)) {
+      for (const row of rows) {
+        if (typeof row !== 'object' || row === null) continue
+        const record = row as Record<string, unknown>
+        // The CLI payload speaks Chinese (`编号`/`名称`); older fixtures and the
+        // web payload speak English (`id`/`name`). Accept both, never guess.
+        const id = record['id'] ?? record['编号']
+        const name = record['name'] ?? record['名称']
+        if (typeof id !== 'number' || !Number.isFinite(id)) continue
+        if (typeof name !== 'string' || name.trim() === '') continue
+        names.set(id, name.trim())
+      }
+    }
+    return names
+  }
+  // Wrapped in prose or cut short: scan only the workspaces segment, so a
+  // neighbouring `brands[]` array can never lend the strip a workspace name.
+  const at = text.indexOf('"workspaces"')
+  if (at < 0) return names
+  for (const match of text.slice(at).matchAll(/"id"\s*:\s*(\d+)[\s\S]{0,400}?"name"\s*:\s*"([^"\\]*)"|"编号"\s*:\s*(\d+)[\s\S]{0,400}?"名称"\s*:\s*"([^"\\]*)"/gu)) {
+    if (match[3] !== undefined) { const id = Number(match[3]); const name = (match[4] ?? '').trim(); if (name !== '') names.set(id, name); continue }
+    const raw = match[1]
+    const name = match[2]?.trim() ?? ''
+    if (raw === undefined || name === '') continue
+    names.set(Number(raw), name)
+  }
+  // 兜底：自然语言里出现「90002（jack）」时也认。
+  for (const m of text.matchAll(/(\d{4,})\s*[（(]([^）)]{1,24})[）)]/gu)) {
+    const id = Number(m[1])
+    const name = (m[2] ?? '').trim()
+    if (Number.isFinite(id) && name !== '') names.set(id, name)
+  }
+  return names
+}
+
+/**
+ * Fold a session's event window into the strip's two facts.
+ *
+ * One instance per client; it subscribes only while a subscriber exists (the
+ * strip mounting), and a session switch or teardown forgets everything.
+ */
+export class ContextTrace implements ContextFeed {
+  private readonly listeners = new Set<() => void>()
+  private snapshot: ContextSnapshot = EMPTY_CONTEXT
+  private signature = ''
+  private stopList: (() => void) | undefined
+  private stopEvents: (() => void) | undefined
+  private sessionId: SessionKey | undefined
+  private binding: SessionBinding | undefined
+  /** Calls of this session that will teach the strip something, by call id. */
+  private readonly calls = new Map<string, CallKind>()
+  /** Brand id → name, from this session's `brands list` results. */
+  private readonly brands = new Map<string, string>()
+  /** Workspace id → name, from this session's `account workspaces` results. */
+  private readonly workspaces = new Map<number, string>()
+  private workspace: number | undefined
+  private brand: string | undefined
+  private task = 0
+  private lastSeq = -1
+
+  /**
+   * @param sessions - the Client Session service the strip borrows its window from.
+   */
+  constructor(private readonly sessions: ISessions) {}
+
+  /** @returns the current context; identity changes only when the strip must repaint. */
+  readonly getSnapshot = (): ContextSnapshot => this.snapshot
+
+  /**
+   * Watch the context. The first listener attaches to the session, the last
+   * one detaches and forgets everything.
+   * @param listener - notified when the visible context changes.
+   * @returns the unsubscribe function.
+   */
+  readonly subscribe = (listener: () => void): () => void => {
+    this.listeners.add(listener)
+    if (this.listeners.size === 1) this.attach()
+    return () => {
+      if (!this.listeners.delete(listener)) return
+      if (this.listeners.size === 0) this.detach()
+    }
+  }
+
+  /** Start following the current session and its event window. */
+  private attach(): void {
+    this.stopList = this.sessions.list.subscribe(() => { this.follow() })
+    this.follow()
+  }
+
+  /** Re-resolve the current session; a switch clears the strip. */
+  private follow(): void {
+    const nextId = currentSessionId(this.sessions.list.getSnapshot())
+    const nextBinding = nextId === undefined ? undefined : this.sessions.binding(nextId)
+    if (nextId === this.sessionId && nextBinding === this.binding) return
+    this.sessionId = nextId
+    this.binding = nextBinding
+    this.stopEvents?.()
+    this.stopEvents = undefined
+    this.forget()
+    if (nextBinding === undefined) {
+      this.publish()
+      return
+    }
+    this.stopEvents = nextBinding.eventSource.subscribe(() => { this.ingest(nextBinding) })
+    this.ingest(nextBinding)
+  }
+
+  /** Stop following; nothing is remembered while the strip is unmounted. */
+  private detach(): void {
+    this.stopEvents?.()
+    this.stopList?.()
+    this.stopEvents = undefined
+    this.stopList = undefined
+    this.sessionId = undefined
+    this.binding = undefined
+    this.forget()
+  }
+
+  /** Drop every fact and the derived view. */
+  private forget(): void {
+    this.calls.clear()
+    this.brands.clear()
+    this.workspaces.clear()
+    this.workspace = undefined
+    this.brand = undefined
+    this.task = 0
+    this.lastSeq = -1
+    this.signature = ''
+    this.snapshot = EMPTY_CONTEXT
+  }
+
+  /**
+   * Apply the events that arrived since the previous read.
+   * @param binding - the window's binding; a stale notification is ignored.
+   */
+  private ingest(binding: SessionBinding): void {
+    /* v8 ignore next -- defensive: a window that notifies during teardown must not fold into the next session. */
+    if (this.binding !== binding) return
+    const window = binding.eventSource.getSnapshot()
+    if (this.lastSeq < 0 || window.change.kind === 'replace') {
+      this.forget()
+      for (const entry of window.entries) this.apply(entry)
+    } else if (window.change.kind === 'append' || window.change.kind === 'prepend') {
+      for (const entry of window.change.entries) this.apply(entry)
+    }
+    this.publish()
+  }
+
+  /**
+   * Fold one window entry; nothing outside `tool/call`, `tool/result`, and a
+   * human `user/message` can change the strip.
+   * @param entry - one durable log entry or live chunk.
+   */
+  private apply(entry: SessionEventLikeEntry): void {
+    if (entry.type !== 'event') return
+    const event = entry.event
+    if (event.seq <= this.lastSeq) return
+    this.lastSeq = event.seq
+    switch (event.type) {
+      case 'tool/call': {
+        const args = argumentObject(event.data.arguments)
+        const kind = callKind(event.data.name, args)
+        if (kind !== undefined) this.calls.set(event.data.callId, kind)
+        const brand = brandOfCall(event.data.name, args)
+        if (brand !== undefined) this.brand = brand
+        return
+      }
+      case 'tool/result': {
+        // 解析不再按命令白名单：只要结果文本里带工作区/品牌的结构化字段就吸收。
+        // 早先只认 `account workspaces` 这一条命令，Bot 换用 daniel_status 或
+        // 别的只读命令时顶部就不更新 —— 这是"改了两次仍不显示"的根因。
+        const text = resultText(event.data.message)
+        if (!text) return
+        const workspace = workspaceId(text)
+        if (workspace !== undefined) this.workspace = workspace
+        // The same result names the rows it lists; keep every id → name so
+        // the strip can show 90002 as `Jack` and still fall back to the id.
+        for (const [id, name] of workspaceNames(text)) this.workspaces.set(id, name)
+        for (const pair of brandPairs(text)) this.brands.set(pair.id, pair.name)
+        return
+      }
+      case 'user/message':
+        if (isHumanPrompt(event.data)) {
+          this.task += 1
+          this.brand = undefined
+        }
+        return
+      default:
+    }
+  }
+
+  /** Recompute the published shape and notify only when it really changed. */
+  private publish(): void {
+    const brandName = this.brand === undefined ? undefined : this.brands.get(this.brand)
+    const workspaceName = this.workspace === undefined ? undefined : this.workspaces.get(this.workspace)
+    const signature = [
+      String(this.task),
+      String(this.workspace ?? '-'),
+      workspaceName ?? '-',
+      this.brand ?? '-',
+      brandName ?? '-',
+      // The fallback option lists repaint too: a result may add rows without
+      // changing the current pair.
+      String(this.workspaces.size),
+      String(this.brands.size),
+    ].join('|')
+    if (signature === this.signature) return
+    this.signature = signature
+    this.snapshot = {
+      task: this.task,
+      workspace: this.workspace,
+      workspaceName,
+      brand: this.brand,
+      brandName,
+      workspaces: Object.freeze([...this.workspaces].map(([id, name]) => ({ id, name }))),
+      brands: Object.freeze([...this.brands].map(([id, name]) => ({ id, name }))),
+    }
+    for (const listener of [...this.listeners]) listener()
+  }
+}
