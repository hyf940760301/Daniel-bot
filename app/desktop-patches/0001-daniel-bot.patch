+/* ── the fold ────────────────────────────────────────────────────────────── */
+
+describe('execution fold', () => {
+  it('starts empty and follows a running call', () => {
+    const { trace, fake } = traceWithFake()
+    expect(trace.getSnapshot()).toBe(EMPTY_TRACE)
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+
+    session.push(toolCall('c1', 'daniel_run', { argv: ['workspaces', 'list'] }))
+    expect(trace.getSnapshot()).toEqual({
+      task: 0,
+      running: true,
+      current: { id: 'c1', module: '账号与盘点', action: '读取工作区清单', status: 'running' },
+      steps: [{ id: 'c1', module: '账号与盘点', action: '读取工作区清单', status: 'running' }],
+      modules: expect.arrayContaining([
+        { id: 'account', name: '账号与盘点', calls: 1, state: 'active' },
+        { id: 'brands', name: '品牌档案', calls: 0, state: 'unused' },
+      ]),
+    })
+
+    session.push(toolResult('c1'))
+    expect(trace.getSnapshot()).toMatchObject({
+      running: false,
+      current: null,
+      steps: [{ id: 'c1', status: 'done' }],
+    })
+    expect(trace.getSnapshot().modules.find(module => module.id === 'account'))
+      .toEqual({ id: 'account', name: '账号与盘点', calls: 1, state: 'used' })
+    stop()
+    // Nothing is remembered while the panel is closed.
+    expect(trace.getSnapshot()).toBe(EMPTY_TRACE)
+  })
+
+  it('deduplicates one call id into exactly one row, updated in place', () => {
+    const { trace, fake } = traceWithFake()
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    session.push(toolCall('c1', 'daniel_run', { argv: ['brands', 'list'] }))
+    const started = trace.getSnapshot()
+    // A replayed start for the same invocation must not add a second row.
+    session.push(toolCall('c1', 'daniel_run', { argv: ['brands', 'list'] }))
+    expect(trace.getSnapshot()).toBe(started)
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+    session.push(toolResult('c1'))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: 'c1', status: 'done' })
+    // A result for an unknown call is harmless.
+    session.push(toolResult('ghost'))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+    stop()
+  })
+
+  it('counts calls per module and derives 未用 / 使用中 / 已用', () => {
+    const { trace, fake } = traceWithFake()
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    session.push(toolCall('c1', 'daniel_run', { argv: ['account', 'workspaces'] }))
+    session.push(toolCall('c2', 'daniel_run', { argv: ['account', 'capabilities'] }))
+    session.push(toolCall('c3', 'daniel_run', { argv: ['brands', 'list'] }))
+    session.push(toolResult('c1'))
+    const modules = trace.getSnapshot().modules
+    expect(modules.find(module => module.id === 'account'))
+      .toEqual({ id: 'account', name: '账号与盘点', calls: 2, state: 'active' })
+    expect(modules.find(module => module.id === 'brands'))
+      .toEqual({ id: 'brands', name: '品牌档案', calls: 1, state: 'active' })
+    expect(modules.find(module => module.id === 'lists'))
+      .toEqual({ id: 'lists', name: '红人名单', calls: 0, state: 'unused' })
+    session.push(toolResult('c2'))
+    session.push(toolResult('c3'))
+    expect(trace.getSnapshot().modules.filter(module => module.state === 'used')).toHaveLength(2)
+    expect(trace.getSnapshot().modules.filter(module => module.state === 'active')).toHaveLength(0)
+    expect(trace.getSnapshot().modules.filter(module => module.state === 'unused')).toHaveLength(7)
+    stop()
+  })
+
+  it('clears the path on a new human message but keeps the finished path on turn/end', () => {
+    const { trace, fake } = traceWithFake()
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    session.push(toolCall('c1', 'daniel_run', { argv: ['brands', 'list'] }))
+    session.push(toolResult('c1'))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+
+    // The turn ending is not a new task: the finished path stays readable.
+    session.push(turnEnd())
+    expect(trace.getSnapshot()).toMatchObject({ running: false, steps: [{ id: 'c1', status: 'done' }] })
+
+    // A synthetic user-role injection is not a human task either.
+    session.push(userMessage('agent.inject'))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+
+    // The human's next prompt starts a new task: the path is empty again.
+    session.push(userMessage('user'))
+    expect(trace.getSnapshot()).toMatchObject({ task: 1, running: false, current: null, steps: [] })
+    expect(trace.getSnapshot().modules.every(module => module.state === 'unused' && module.calls === 0)).toBe(true)
+
+    session.push(toolCall('c2', 'daniel_run', { argv: ['workspaces', 'list'] }))
+    expect(trace.getSnapshot().steps).toEqual([
+      { id: 'c2', module: '账号与盘点', action: '读取工作区清单', status: 'running' },
+    ])
+    expect(trace.getSnapshot().task).toBe(1)
+    stop()
+  })
+
+  it('replays only the newest task when the window is replaced', () => {
+    const { trace, fake } = traceWithFake()
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    session.replace([
+      toolCall('old', 'daniel_run', { argv: ['brands', 'list'] }),
+      toolResult('old'),
+      userMessage('user'),
+      toolCall('new', 'daniel_run', { argv: ['sov', 'overview'] }),
+    ])
+    expect(trace.getSnapshot().steps.map(step => step.id)).toEqual(['new'])
+    expect(trace.getSnapshot().task).toBe(1)
+    expect(trace.getSnapshot().modules.find(module => module.id === 'brands'))
+      .toEqual({ id: 'brands', name: '品牌档案', calls: 0, state: 'unused' })
+    stop()
+  })
+
+  it('settles open calls on turn/end and clears on a session switch', () => {
+    const { trace, fake } = traceWithFake()
+    const first = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    first.push(toolCall('c1', 'daniel_run', { argv: ['authenticity', 'channel'] }))
+    expect(trace.getSnapshot().running).toBe(true)
+    first.push(turnEnd())
+    expect(trace.getSnapshot()).toMatchObject({ running: false, current: null })
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: 'c1', status: 'done' })
+
+    const second = fake.add('s2')
+    expect(trace.getSnapshot()).toBe(EMPTY_TRACE)
+    second.push(toolCall('d1', 'daniel_run', { argv: ['lists', 'items'] }))
+    expect(trace.getSnapshot().current).toMatchObject({ module: '红人名单', action: '查看名单成员' })
+    stop()
+  })
+
+  it('renders at most the newest 24 steps but keeps counting every module call', () => {
+    const { trace, fake } = traceWithFake()
+    const session = fake.add('s1')
+    const stop = trace.subscribe(() => {})
+    // Thirty calls, each a different business action: rows merge only on
+    // `module + action`, so this is still thirty rows to window down to 24.
+    const distinct = [...new Map(Object.entries(MODULE_MAP.commands)
+      .flatMap(([token, rule]) => (rule.module === null
+        ? []
+        : [[`${rule.module}\u0000${rule.action}`, { token, module: rule.module }] as const]))).values()]
+      .slice(0, 30)
+    expect(distinct).toHaveLength(30)
+    const expected = new Map<string, number>()
+    for (const { module } of distinct) expected.set(module, (expected.get(module) ?? 0) + 1)
+    for (let index = 0; index < distinct.length; index += 1) {
+      session.push(toolCall(`c${String(index)}`, 'daniel_run', { argv: distinct[index]?.token.split(' ') }))
+      session.push(toolResult(`c${String(index)}`))
+    }
+    expect(trace.getSnapshot().steps).toHaveLength(24)
+    expect(trace.getSnapshot().steps[0]?.id).toBe('c6')
+    expect(trace.getSnapshot().steps.at(-1)?.id).toBe('c29')
+    for (const [module, calls] of expected) {
+      expect(trace.getSnapshot().modules.find(entry => entry.name === module)?.calls).toBe(calls)
+    }
+    expect(trace.getSnapshot().modules.reduce((total, entry) => total + entry.calls, 0)).toBe(30)
+    stop()
+  })
+
+  it('tolerates no session, a double unsubscribe, and a missing list row', () => {
+    const { trace, fake } = traceWithFake()
+    const listener = vi.fn()
+    const stop = trace.subscribe(listener)
+    expect(trace.getSnapshot()).toBe(EMPTY_TRACE)
+    stop()
+    expect(() => { stop() }).not.toThrow()
+
+    const session = fake.add('s1')
+    const stopAgain = trace.subscribe(listener)
+    session.push(toolCall('c1', 'daniel_run', { argv: ['brands', 'list'] }))
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+
+    fake.select('missing')
+    expect(trace.getSnapshot()).toBe(EMPTY_TRACE)
+    stopAgain()
+  })
+
+  it('reads the main-view session from the session list', () => {
+    const list = {
+      ids: ['a', 'b'],
+      byId: { a: { retainedBy: {} }, b: { retainedBy: { mainView: 2 } } },
+    }
+    expect(currentSessionId(list as never)).toBe('b')
+    expect(currentSessionId({ ids: ['a'], byId: { a: { retainedBy: {} } } } as never)).toBeUndefined()
+    expect(currentSessionId({ ids: ['ghost'], byId: {} } as never)).toBeUndefined()
+  })
+})
