+/**
+ * Types for `build-guide.mjs`, imported by the guide dialog's unit test.
+ * Kept beside the script (the same convention as the desktop installer
+ * scripts) so the test needs no `allowJs` and the generator stays plain ESM.
+ */
+
+/** One function in the published payload. */
+export interface GuideFunctionPayload {
+  readonly name: string
+  readonly detail: string
+  readonly example: string
+}
+
+/** One module in the published payload. */
+export interface GuideModulePayload {
+  readonly id: string
+  readonly name: string
+  readonly summary: string
+  readonly functions: readonly GuideFunctionPayload[]
+}
+
+/** Payload schema id the dialog understands. */
+export declare const GUIDE_SCHEMA: 'daniel.guide.v1'
+
+/**
+ * Validate the authored guide.
+ * @param guide - parsed guide JSON.
+ * @returns the nine modules to publish.
+ * @throws when a generation rule is violated.
+ */
+export declare function assertGuide(guide: unknown): GuideModulePayload[]
+
+/**
+ * Stable sha256 over the published content.
+ * @param modules - validated modules.
+ * @returns lowercase hex digest.
+ */
+export declare function guideDigest(modules: readonly GuideModulePayload[]): string
+
+/**
+ * Read and validate one authored guide.
+ * @param path - absolute guide path.
+ * @returns the payload plus the authored file digest.
+ */
+export declare function readGuide(path: string): { modules: GuideModulePayload[], sha256: string }
+
+/**
+ * Render the checked-in TypeScript module.
+ * @param modules - validated modules.
+ * @param source - display path plus file digest.
+ * @returns the file body.
+ */
+export declare function renderGuide(
+  modules: readonly GuideModulePayload[],
+  source: { guide: string, sha256: string },
+): string
+
+/**
+ * Build the generated module from one authored file.
+ * @param path - absolute guide path.
+ * @returns rendered text, payload, and file digest.
+ */
+export declare function buildGuide(path: string): {
+  text: string
+  modules: GuideModulePayload[]
+  sha256: string
+}
