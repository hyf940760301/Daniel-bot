+  it('shows the chosen names with the solid border state', () => {
+    seed({ workspace: WORKSPACES[0] as WorkspaceOption, brand: BRANDS[0] as BrandOption })
+    const store = new ContextSelection({ bridge: fakeBridge() })
+    const bar = renderBar(store, new FakeFeed()).container
+    expect(bar.querySelector('[data-selector="workspace"]')?.getAttribute('data-selected')).toBe('true')
+    expect(bar.querySelector('[data-selector="workspace"]')?.textContent).toContain('jack')
+    expect(bar.querySelector('[data-selector="brand"]')?.textContent).toContain('Halliday')
+    expect(bar.querySelector('[data-selector="brand"]')?.getAttribute('data-selected')).toBe('true')
+  })
+
+  it('says 仅显示本次会话见过的 when the web fallback supplies the list', () => {
+    const feed = new FakeFeed()
+    feed.set({ workspaces: [{ id: 90002, name: 'jack' }], brands: [{ id: '4800023', name: 'Halliday' }] })
+    const store = new ContextSelection({ feed })
+    const bar = renderBar(store, feed).container
+    expect(bar.querySelector('[data-context-bar]')?.getAttribute('data-context-source')).toBe('session')
+    const workspace = bar.querySelector('[data-selector="workspace"]') as HTMLElement
