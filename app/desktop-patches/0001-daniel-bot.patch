@@ -0,0 +1,60 @@
+/**
+ * The one write the New Session hero is allowed to make: put an example
+ * phrase into the composer draft, and nothing else.
+ *
+ * Path (see CHANGES-GUIDE.md §3 for the panorama dialog's identical bridge):
+ * the Conversation plugin retains the per-session input machine and
+ * `SessionInput.setDraft` is its documented programmatic-write verb
+ * (contract/input.ts). That is a supported store action, not a DOM poke: no
+ * querySelector, no synthetic keyboard event, no `submit()`, no `send()`. The
+ * draft is private to the browser until the human presses Enter, so an
+ * example click cannot send a message even by accident.
+ *
+ * This module deliberately types the composer down to the three verbs it may
+ * use, so the no-send guarantee is visible in the signature rather than in a
+ * convention.
+ */
+
+/** The composer face an example click may borrow; nothing else is reachable. */
+export interface ExampleDraftTarget {
+  /** Replace the whole draft with plain text (the supported programmatic write). */
+  setDraft(text: string): void
+  /** Return the keyboard to the composer with its last caret. */
+  focus(): void
+  /** Published input state; `draft` is the clipboard projection of the editor. */
+  readonly state: { getSnapshot(): { readonly draft: string } }
+}
+
+/**
+ * Put one example phrase into the composer, unsent.
+ *
+ * A draft the human already typed is kept: the phrase is appended on its own
+ * line, because losing typed text would be worse than a longer draft. Empty
+ * draft ⇒ the phrase alone. Either way the composer is focused so `Enter`
+ * sends immediately, once the human decides to.
+ * @param input - the session's input facade (see {@link ExampleDraftTarget}).
+ * @param phrase - the example prompt to place in the composer.
+ * @returns whether the draft was written.
+ */
+export function prefillExampleDraft(input: ExampleDraftTarget, phrase: string): boolean {
+  const text = phrase.trim()
+  if (text === '') return false
+  let existing = ''
+  try {
+    existing = input.state.getSnapshot().draft
+  } catch {
+    // A detached store has no draft to preserve; start from empty.
+    existing = ''
+  }
+  try {
+    input.setDraft(existing.trim() === '' ? text : `${existing}\n${text}`)
+  } catch {
+    return false
+  }
+  try {
+    input.focus()
+  } catch {
+    // A composer that is not mounted cannot take focus; the draft still landed.
+  }
+  return true
+}
