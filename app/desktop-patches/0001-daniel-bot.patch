+
+/** The base64 body of an envelope, validate-then-decode. */
+function decodeEnvelope(token: string): Buffer {
+  const body = token.slice(SEALED_PREFIX.length)
+  if (body.length === 0) throw new CredentialDecryptionError('密文为空')
