+
+describe('send gate', () => {
+  /**
+   * Wire the same guard `index.ts` registers.
+   * @param store - the selection store.
+   * @returns the registry the composer shell consults.
+   */
+  function registryOf(store: ContextSelection): ComposerSendGuardRegistry {
+    const registry = new ComposerSendGuardRegistry()
+    registry.register({
+      check: () => {
+        const missing = store.attemptSend()
+        if (missing === undefined) return undefined
+        const workspace = missing === 'workspace'
+        return {
+          message: t(workspace ? 'gate.workspace' : 'gate.brand'),
+          actionLabel: t(workspace ? 'gate.chooseWorkspace' : 'gate.chooseBrand'),
+          action: () => { store.setOpen(missing) },
+        }
+      },
+    })
+    return registry
+  }
+
+  it('refuses to send with no workspace and sends nothing', async () => {
+    const store = new ContextSelection({ bridge: fakeBridge() })
