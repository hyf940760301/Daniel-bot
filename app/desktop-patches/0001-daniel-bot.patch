+// @vitest-environment jsdom
+/**
+ * The trace's dedupe / current-pointer / paint contract (CHANGES-TRACE-DEDUPE.md).
+ *
+ * Three complaints from the running desktop app, one file:
+ *
+ * 1. A task that looks up seven brand profiles printed seven identical
+ *    "查看品牌档案" lines, because the fold keyed rows by call id. Rows now
+ *    key on the business `module + action`: one line, at the first position,
+ *    with `×N` once N > 1, status running while any of its calls is in flight.
+ *    `A → B → A` merges too (the trade-off is documented).
+ * 2. A later call that finished first left the "current" highlight on an older
+ *    row. The pointer now follows the call log — the newest started call that
+ *    has not settled — with a 300ms hold, and `turn/end` settles everything.
+ * 3. The panel flickered under rapid events. Rows keep their node (stable key),
+ *    the fade is marked only on a task reset, a settled call never reopens, and
+ *    bursts are coalesced.
+ */
+import { useSyncExternalStore } from 'react'
+import type { ReactNode } from 'react'
+import { act, cleanup, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  BURST_PUBLISH_LIMIT, CURRENT_HOLD_MS, CapabilityTrace, WORK_ROW_ACTION, WORK_ROW_ID,
+} from '../src/client/trace.ts'
+import type { TraceSnapshot } from '../src/client/trace.ts'
+import { TraceRail } from '../src/client/TraceRail.tsx'
+import { zh } from '../src/client/locales.ts'
+import type { SessionEventLikeEntry } from '@deepseek-ai/dsh-api-session-controller/client'
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  vi.unstubAllGlobals()
+})
+
+/* ── session-service fake: one event window per session ───────────────────── */
+
+/** Ordered sequence shared by the fake log entries. */
+let seq = 0
+
+/**
+ * Build one durable `tool/call` entry.
+ * @param callId - call identity.
+ * @param name - tool name as the log records it.
+ * @param args - argument value, JSON-encoded like the real log.
+ * @returns the window entry.
+ */
+function toolCall(callId: string, name: string, args: unknown = {}): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'tool/call', seq: ++seq, time: 0,
+      data: { turn: 1, step: 1, callId, name, arguments: JSON.stringify(args) },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/**
+ * Build one durable `tool/result` entry for a call.
+ * @param callId - call identity being settled.
+ * @returns the window entry.
+ */
+function toolResult(callId: string): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'tool/result', seq: ++seq, time: 0,
+      data: { turn: 1, step: 1, message: { source: { callId } } },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/**
+ * Build one `user/message` entry.
+ * @param kind - message source: `user` is the human, anything else is synthetic.
+ * @returns the window entry.
+ */
+function userMessage(kind = 'user'): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: {
+      type: 'user/message', seq: ++seq, time: 0,
+      data: { id: `m${String(seq)}`, role: 'user', content: [], source: { kind } },
+    },
+  } as unknown as SessionEventLikeEntry
+}
+
+/** One `turn/end` entry, which settles whatever the window left open. */
+function turnEnd(): SessionEventLikeEntry {
+  return {
+    type: 'event',
+    event: { type: 'turn/end', seq: ++seq, time: 0, data: { turn: 1, reason: { kind: 'stop' } } },
+  } as unknown as SessionEventLikeEntry
+}
+
+/** One session's event window plus its subscribers. */
+class FakeSession {
+  readonly entries: SessionEventLikeEntry[] = []
+  change: { kind: 'replace' | 'append' | 'prepend'; entries: readonly SessionEventLikeEntry[] } = { kind: 'replace', entries: [] }
+  private readonly listeners = new Set<() => void>()
+
+  readonly eventSource = {
+    getSnapshot: () => ({
+      entries: this.entries, change: this.change, revision: this.entries.length, hasMore: false,
+    }),
+    subscribe: (listener: () => void) => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    },
+  }
+
+  /**
+   * @param id - session id this binding belongs to.
+   */
+  constructor(readonly id: string) {}
+
+  /** Append one entry and notify, like the live log does. */
+  push(entry: SessionEventLikeEntry): void {
+    this.entries.push(entry)
+    this.change = { kind: 'append', entries: [entry] }
+    for (const listener of [...this.listeners]) listener()
+  }
+}
+
+/** Minimal Client Session service the trace borrows from. */
+class FakeSessions {
+  readonly sessions = new Map<string, FakeSession>()
+  currentId: string | undefined
+  private readonly listeners = new Set<() => void>()
+
+  readonly list = {
+    getSnapshot: () => ({
+      ids: [...this.sessions.keys()] as never,
+      byId: Object.fromEntries([...this.sessions.keys()].map(id => [
+        id,
+        { id, retainedBy: id === this.currentId ? { mainView: 1 } : {} },
+      ])) as never,
+      phase: 'ready' as const,
+      projectionsBySession: {} as never,
+    }),
+    subscribe: (listener: () => void) => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    },
+  }
+
+  /**
+   * @param id - session id.
+   * @returns the live binding, or undefined when the session is unknown.
+   */
+  binding(id: string): { sessionId: string; eventSource: FakeSession['eventSource'] } | undefined {
+    const session = this.sessions.get(id)
+    return session === undefined ? undefined : { sessionId: id, eventSource: session.eventSource }
+  }
+
+  /**
+   * Add a session and make it current.
+   * @param id - session id.
+   * @returns the session's fake window.
+   */
+  add(id = 's1'): FakeSession {
+    const session = new FakeSession(id)
+    this.sessions.set(id, session)
+    this.currentId = id
+    for (const listener of [...this.listeners]) listener()
+    return session
+  }
+}
+
+/**
+ * Wire a trace over a fake session service and subscribe it.
+ * @returns the trace, its event window, and the unsubscribe.
+ */
+function liveTrace(): { trace: CapabilityTrace; session: FakeSession; stop: () => void } {
+  const fake = new FakeSessions()
+  const trace = new CapabilityTrace(fake as never)
+  const session = fake.add()
+  const stop = trace.subscribe(() => {})
+  return { trace, session, stop }
+}
+
+/* ── rendering helpers ───────────────────────────────────────────────────── */
+
+/** Interpolate `{name}` placeholders like the locale service. */
+function translate(key: string, params?: Record<string, unknown>): string {
+  const template = (zh as Record<string, string>)[key] ?? key
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/gu, (match, name: string) => (name in params ? String(params[name]) : match))
+}
+
+/**
+ * Bind a trace feed the way the renderer binds an injected source.
+ * @param trace - the live fold.
+ * @returns the selector hook handed to the rail.
+ */
+function traceHook(trace: CapabilityTrace): never {
+  type Hook = (selector: (snapshot: TraceSnapshot) => unknown) => unknown
+  const useBound: Hook = selector => selector(useSyncExternalStore(trace.subscribe, trace.getSnapshot, trace.getSnapshot))
+  return useBound as never
+}
+
+/**
+ * Render the rail body over a live fold.
+ * @param trace - the fold to render.
+ * @returns the task section.
+ */
+function renderTask(trace: CapabilityTrace): HTMLElement {
+  function Body(): ReactNode {
+    return <TraceRail useTrace={traceHook(trace)} t={translate as never} />
+  }
+  render(<Body />)
+  return screen.getByRole('region', { name: zh['task.region'] })
+}
+
+/**
+ * Read an element's visible text with single interpolated spaces.
+ * @param element - element to read.
+ * @returns its text content, whitespace-normalized.
+ */
+function blank(element: HTMLElement): string {
+  return (element.textContent ?? '').replace(/\s+/gu, ' ').trim()
+}
+
+/**
+ * The rendered step rows of the task section.
+ * @param panel - the task section.
+ * @returns the step list items, oldest first.
+ */
+function stepRows(panel: HTMLElement): HTMLElement[] {
+  const list = within(panel).queryByRole('list', { name: zh['task.steps'] })
+  return list === null ? [] : within(list).getAllByRole('listitem')
+}
+
+/** The business action of the seven repeated profile lookups in the report. */
+const PROFILE = { tool: 'daniel_brand_view', args: {} } as const
+/** 读取工作区清单 — the task's first and last call. */
+const WORKSPACES = { tool: 'daniel_run', args: { argv: ['workspaces', 'list'] } } as const
+/** 读取品牌列表 — a different action on the same module. */
+const BRANDS = { tool: 'daniel_run', args: { argv: ['brands', 'list'] } } as const
+/** 查看声量总览 — a different module. */
+const SOV = { tool: 'daniel_run', args: { argv: ['sov', 'overview'] } } as const
+/** 查看名单成员 — yet another row, for the pointer-hold window. */
+const LISTS = { tool: 'daniel_run', args: { argv: ['lists', 'items'] } } as const
+
+/**
+ * Push one call and settle it.
+ * @param session - the event window.
+ * @param id - call identity.
+ * @param spec - tool name and arguments.
+ */
+function settled(session: FakeSession, id: string, spec: { tool: string; args: unknown }): void {
+  session.push(toolCall(id, spec.tool, spec.args))
+  session.push(toolResult(id))
+}
+
+/* ── 1. merge key = module + action ──────────────────────────────────────── */
+
+describe('repeated calls merge on module + action', () => {
+  it('merges seven consecutive profile lookups into one row at the first position', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('c1', WORKSPACES.tool, WORKSPACES.args))
+    session.push(toolResult('c1'))
+    for (let index = 0; index < 7; index += 1) {
+      session.push(toolCall(`p${String(index)}`, PROFILE.tool, PROFILE.args))
+    }
+
+    const steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(2)
+    expect(steps[0]?.action).toBe('读取工作区清单')
+    expect(steps[1]).toMatchObject({ id: 'p0', action: '查看品牌档案', module: '品牌档案', count: 7, status: 'running' })
+    // The row keeps the position of its first call, not of its latest one.
+    expect(steps.map(step => step.id)).toEqual(['c1', 'p0'])
+
+    for (let index = 0; index < 7; index += 1) session.push(toolResult(`p${String(index)}`))
+    expect(trace.getSnapshot().steps[1]).toMatchObject({ id: 'p0', status: 'done', count: 7 })
+    stop()
+  })
+
+  it('merges a repeat separated by another action, keeping the first position', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'a1', PROFILE)
+    settled(session, 'b1', SOV)
+    settled(session, 'a2', PROFILE)
+
+    const steps = trace.getSnapshot().steps
+    // A → B → A is two rows: the two A calls are the same action, so they share
+    // one row where the first A opened it — the documented trade-off.
+    expect(steps.map(step => step.id)).toEqual(['a1', 'b1'])
+    expect(steps.map(step => step.action)).toEqual(['查看品牌档案', '查看声量总览'])
+    expect(steps[0]).toMatchObject({ count: 2, status: 'done' })
+    expect(steps[1]?.count).toBeUndefined()
+    stop()
+  })
+
+  it('never merges a different module or a different action', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'w1', WORKSPACES)
+    settled(session, 'b1', BRANDS)
+    settled(session, 's1', SOV)
+
+    const steps = trace.getSnapshot().steps
+    expect(steps.map(step => `${step.module ?? 'null'}:${step.action}`)).toEqual([
+      '账号与盘点:读取工作区清单',
+      '品牌档案:读取品牌列表',
+      '声量份额:查看声量总览',
+    ])
+    expect(steps.every(step => step.count === undefined)).toBe(true)
+    stop()
+  })
+
+  it('keeps the folded 整理结果 row out of Daniel rows and never counts it', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'p1', PROFILE)
+    settled(session, 'b1', { tool: 'bash', args: { command: 'ls /tmp' } })
+    settled(session, 'p2', PROFILE)
+
+    const steps = trace.getSnapshot().steps
+    expect(steps.map(step => step.id)).toEqual(['p1', WORK_ROW_ID])
+    expect(steps[0]).toMatchObject({ action: '查看品牌档案', count: 2 })
+    expect(steps[1]).toMatchObject({ action: WORK_ROW_ACTION, module: null })
+    expect(steps[1]?.count).toBeUndefined()
+    stop()
+  })
+
+  it('counts every merged call in the module panorama', () => {
+    const { trace, session, stop } = liveTrace()
+    for (let index = 0; index < 7; index += 1) settled(session, `p${String(index)}`, PROFILE)
+    expect(trace.getSnapshot().steps).toHaveLength(1)
+    expect(trace.getSnapshot().modules.find(module => module.id === 'brands'))
+      .toEqual({ id: 'brands', name: '品牌档案', calls: 7, state: 'used' })
+    stop()
+  })
+
+  it('restarts the count in a new task', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'p1', PROFILE)
+    settled(session, 'p2', PROFILE)
+    settled(session, 'p3', PROFILE)
+    expect(trace.getSnapshot().steps[0]?.count).toBe(3)
+
+    session.push(userMessage('user'))
+    expect(trace.getSnapshot()).toMatchObject({ task: 1, steps: [], running: false, current: null })
+
+    settled(session, 'q1', PROFILE)
+    const steps = trace.getSnapshot().steps
+    expect(steps).toHaveLength(1)
+    expect(steps[0]?.id).toBe('q1')
+    // One call again: no count, not the previous task's three-plus-one.
+    expect(steps[0]?.count).toBeUndefined()
+    stop()
+  })
+})
+
+/* ── 2. the count in the rendered row ────────────────────────────────────── */
+
+describe('rendered repetition count', () => {
+  it('shows ×N on the merged row and nothing on a single call', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'w1', WORKSPACES)
+    for (let index = 0; index < 7; index += 1) settled(session, `p${String(index)}`, PROFILE)
+
+    const panel = renderTask(trace)
+    const rows = stepRows(panel)
+    expect(rows).toHaveLength(2)
+
+    const count = rows[1]?.querySelector('[data-count]')
+    expect(count?.textContent).toBe('×7')
+    expect(count?.getAttribute('data-count')).toBe('7')
+    // Plain text on the right, not a coloured badge: no role, no aria-hidden
+    // lie, and the row's label carries it for a screen reader.
+    expect(count?.getAttribute('role')).toBeNull()
+    expect(rows[1]?.getAttribute('aria-label')).toBe('查看品牌档案，品牌档案 Brand Profile，已完成，×7')
+    // The single call has no count at all.
+    expect(rows[0]?.querySelector('[data-count]')).toBeNull()
+    expect(rows[0]?.textContent).not.toContain('×')
+    stop()
+  })
+
+  it('renders the reported shape — 1 workspace + 7 brand profiles + 1 workspace — as two rows', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'w1', WORKSPACES)
+    for (let index = 0; index < 7; index += 1) settled(session, `p${String(index)}`, PROFILE)
+    settled(session, 'w2', WORKSPACES)
+
+    const panel = renderTask(trace)
+    const rows = stepRows(panel)
+    expect(rows).toHaveLength(2)
+    expect(rows[0]?.getAttribute('aria-label')).toBe('读取工作区清单，账号与盘点 Account，已完成，×2')
+    expect(rows[1]?.getAttribute('aria-label')).toBe('查看品牌档案，品牌档案 Brand Profile，已完成，×7')
+    expect(rows[0]?.querySelector('[data-count]')?.textContent).toBe('×2')
+    expect(rows[1]?.querySelector('[data-count]')?.textContent).toBe('×7')
+    // What the panel prints: two lines, each with its repetition count.
+    expect(blank(panel)).toContain('×2')
+    expect(blank(panel)).toContain('×7')
+    // The module panorama still counts calls, not rows.
+    expect(trace.getSnapshot().modules.find(module => module.id === 'account')?.calls).toBe(2)
+    expect(trace.getSnapshot().modules.find(module => module.id === 'brands')?.calls).toBe(7)
+    stop()
+  })
+})
+
+/* ── 3. status aggregation ───────────────────────────────────────────────── */
+
+describe('merged row status', () => {
+  it('stays 进行中 while one call of the row is in flight and settles when all are done', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('p1', PROFILE.tool, PROFILE.args))
+    session.push(toolCall('p2', PROFILE.tool, PROFILE.args))
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ id: 'p1', count: 2, status: 'running' })
+
+    session.push(toolResult('p1'))
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ status: 'running' })
+    expect(trace.getSnapshot().running).toBe(true)
+
+    session.push(toolResult('p2'))
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ status: 'done', count: 2 })
+    expect(trace.getSnapshot()).toMatchObject({ running: false, current: null })
+    stop()
+  })
+
+  it('never regresses a settled call when its result or start is replayed', () => {
+    const { trace, session, stop } = liveTrace()
+    settled(session, 'p1', PROFILE)
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ status: 'done' })
+    expect(trace.getSnapshot().steps[0]?.count).toBeUndefined()
+
+    // A duplicated result, then a duplicated start, for the same invocation.
+    session.push(toolResult('p1'))
+    session.push(toolCall('p1', PROFILE.tool, PROFILE.args))
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ status: 'done' })
+    expect(trace.getSnapshot().steps[0]?.count).toBeUndefined()
+    expect(trace.getSnapshot().running).toBe(false)
+    stop()
+  })
+})
+
+/* ── 4. the current pointer ──────────────────────────────────────────────── */
+
+describe('current pointer', () => {
+  it('follows the newest started open call, not the first unfinished row', () => {
+    vi.useFakeTimers()
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('p1', PROFILE.tool, PROFILE.args))
+    expect(trace.getSnapshot().current).toMatchObject({ id: 'p1' })
+
+    // A call starting later takes the pointer; the older one stays 进行中.
+    vi.advanceTimersByTime(CURRENT_HOLD_MS + 1)
+    session.push(toolCall('p2', PROFILE.tool, PROFILE.args))
+    const snapshot = trace.getSnapshot()
+    expect(snapshot.current).toMatchObject({ id: 'p1' })
+    expect(snapshot.steps[0]).toMatchObject({ id: 'p1', status: 'running' })
+
+    // Two different rows: the newest started one is current, the older is
+    // running but does not own the pointer.
+    session.push(toolCall('s1', SOV.tool, SOV.args))
+    vi.advanceTimersByTime(CURRENT_HOLD_MS + 1)
+    session.push(toolCall('s2', SOV.tool, SOV.args))
+    const withTwo = trace.getSnapshot()
+    expect(withTwo.steps.map(step => step.id)).toEqual(['p1', 's1'])
+    expect(withTwo.current?.id).toBe('s1')
+    expect(withTwo.steps[0]?.status).toBe('running')
+    stop()
+  })
+
+  it('keeps start order when a later call settles first', () => {
+    vi.useFakeTimers()
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('a1', BRANDS.tool, BRANDS.args))
+    vi.advanceTimersByTime(CURRENT_HOLD_MS + 1)
+    session.push(toolCall('b1', SOV.tool, SOV.args))
+    expect(trace.getSnapshot().current?.id).toBe('b1')
+
+    // The newer call returns first: the rows do not reorder, the pointer falls
+    // back to the call that is still in flight.
+    session.push(toolResult('b1'))
+    const snapshot = trace.getSnapshot()
+    expect(snapshot.steps.map(step => step.id)).toEqual(['a1', 'b1'])
+    expect(snapshot.steps.map(step => step.status)).toEqual(['running', 'done'])
+    expect(snapshot.current?.id).toBe('a1')
+    stop()
+  })
+
+  it('settles every call the window left open on turn/end', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('a1', BRANDS.tool, BRANDS.args))
+    session.push(toolCall('b1', SOV.tool, SOV.args))
+    session.push(toolResult('a1'))
+    expect(trace.getSnapshot().running).toBe(true)
+
+    session.push(turnEnd())
+    const snapshot = trace.getSnapshot()
+    expect(snapshot).toMatchObject({ running: false, current: null })
+    expect(snapshot.steps.map(step => step.status)).toEqual(['done', 'done'])
+    // A late result for an already settled call changes nothing.
+    session.push(toolResult('b1'))
+    expect(trace.getSnapshot().steps.map(step => step.status)).toEqual(['done', 'done'])
+    stop()
+  })
+
+  it('clears the pointer on a new task and picks the new task\'s call', () => {
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('a1', BRANDS.tool, BRANDS.args))
+    expect(trace.getSnapshot().current?.id).toBe('a1')
+
+    session.push(userMessage('user'))
+    expect(trace.getSnapshot()).toMatchObject({ task: 1, running: false, current: null, steps: [] })
+
+    session.push(toolCall('b1', SOV.tool, SOV.args))
+    expect(trace.getSnapshot().current).toMatchObject({ id: 'b1', module: '声量份额' })
+    stop()
+  })
+
+  it('holds the pointer for 300ms so two nearby events cannot make it bounce', () => {
+    vi.useFakeTimers()
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('a1', BRANDS.tool, BRANDS.args))
+    expect(trace.getSnapshot().current?.id).toBe('a1')
+
+    // Inside the window the newer call runs but does not steal the highlight.
+    vi.advanceTimersByTime(50)
+    session.push(toolCall('b1', SOV.tool, SOV.args))
+    expect(trace.getSnapshot().current?.id).toBe('a1')
+    vi.advanceTimersByTime(CURRENT_HOLD_MS - 51)
+    session.push(toolCall('c1', BRANDS.tool, BRANDS.args))
+    expect(trace.getSnapshot().current?.id).toBe('a1')
+
+    // Once the window has passed, the newest started call takes the pointer —
+    // it does not flip back to a1 afterwards.
+    vi.advanceTimersByTime(2)
+    session.push(toolCall('d1', LISTS.tool, LISTS.args))
+    expect(trace.getSnapshot().current?.id).toBe('d1')
+    expect(trace.getSnapshot().current?.id).not.toBe('a1')
+    stop()
+  })
+})
+
+/* ── 5. paint: stable nodes, one fade, coalesced bursts ──────────────────── */
+
+describe('paint stability', () => {
+  it('keeps one row node and one merged row across twenty rapid events', () => {
+    vi.useFakeTimers()
+    const { trace, session, stop } = liveTrace()
+    const panel = renderTask(trace)
+    const notified = vi.fn()
+    const stopCounting = trace.subscribe(notified)
+
+    act(() => { session.push(toolCall('p0', PROFILE.tool, PROFILE.args)) })
+    act(() => { session.push(toolResult('p0')) })
+    const before = stepRows(panel)[0]
+    expect(before).toBeDefined()
+
+    for (let index = 1; index < 20; index += 1) {
+      act(() => {
+        session.push(toolCall(`p${String(index)}`, PROFILE.tool, PROFILE.args))
+        session.push(toolResult(`p${String(index)}`))
+      })
+    }
+
+    // The trailing burst publish lands once, with the newest state.
+    act(() => { vi.advanceTimersByTime(120) })
+
+    // Same row, same DOM node: React updates in place, never remounts it.
+    expect(stepRows(panel)).toHaveLength(1)
+    expect(stepRows(panel)[0]).toBe(before)
+    expect(stepRows(panel)[0]?.querySelector('[data-count]')?.getAttribute('data-count')).toBe('20')
+    expect(trace.getSnapshot().steps[0]).toMatchObject({ count: 20, status: 'done' })
+    // The burst was coalesced: forty log events did not mean forty repaints.
+    expect(notified.mock.calls.length).toBeLessThan(40)
+    expect(notified.mock.calls.length).toBeLessThanOrEqual(BURST_PUBLISH_LIMIT + 3)
+    stopCounting()
+    stop()
+  })
+
+  it('marks the fade only on a task reset, never on a status update', () => {
+    vi.useFakeTimers()
+    const { trace, session, stop } = liveTrace()
+    renderTask(trace)
+    const taskSection = (): HTMLElement => screen.getByRole('region', { name: zh['task.region'] })
+    // Opening the panel is a mount: the fade runs once and leaves.
+    expect(taskSection().getAttribute('data-enter')).toBe('on')
+    act(() => { vi.advanceTimersByTime(250) })
+    expect(taskSection().getAttribute('data-enter')).toBeNull()
+
+    // Updates inside the task never bring it back.
+    act(() => { settled(session, 'p0', PROFILE) })
+    act(() => { session.push(toolCall('p1', PROFILE.tool, PROFILE.args)) })
+    expect(taskSection().getAttribute('data-enter')).toBeNull()
+
+    // A new task resets it: the marker appears once, then leaves again.
+    act(() => { session.push(userMessage('user')) })
+    expect(taskSection().getAttribute('data-task')).toBe('1')
+    expect(taskSection().getAttribute('data-enter')).toBe('on')
+    act(() => { vi.advanceTimersByTime(250) })
+    expect(taskSection().getAttribute('data-enter')).toBeNull()
+    stop()
+  })
+
+  it('adds no animation at all under prefers-reduced-motion', () => {
+    vi.stubGlobal('matchMedia', vi.fn(() => ({
+      matches: true,
+      addEventListener: vi.fn(),
+      removeEventListener: vi.fn(),
+    })))
+    const { trace, session, stop } = liveTrace()
+    session.push(toolCall('p1', PROFILE.tool, PROFILE.args))
+    const panel = renderTask(trace)
+    expect(panel.getAttribute('data-enter')).toBeNull()
+    const running = panel.querySelector('[data-status="running"] [data-pulse]')
+    expect(running?.getAttribute('data-pulse')).toBe('off')
+    stop()
+  })
+})
