@@ -0,0 +1,681 @@
+// @vitest-environment jsdom
+/**
+ * The execution rail's behavioural contract (S6.4): the frame owns the open
+ * state, the strip is the default, the panel is a read-only task path plus the
+ * nine-module panorama (no static capability catalogue), a new task fades in,
+ * and reduced motion removes the pulse.
+ */
+import { readFileSync } from 'node:fs'
+import { useState, useSyncExternalStore } from 'react'
+import { Context } from '@deepseek-ai/cordis'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { act, cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { CapabilityMap, type CapabilityMapProps } from '../src/client/CapabilityMap.tsx'
+import { CapabilityEntry, RAIL_ENTRY_MIN_VIEWPORT, capabilityRoute } from '../src/client/CapabilityEntry.tsx'
+import type { CapabilityEntryProps } from '../src/client/CapabilityEntry.tsx'
+import { MODULE_MAP } from '../src/client/module-map.generated.ts'
+import { apply, inject } from '../src/client/index.ts'
+import { EMPTY_TRACE, type TraceFeed, type TraceSnapshot, type TraceStep } from '../src/client/trace.ts'
+import { en, zh } from '../src/client/locales.ts'
+import css from '../src/client/CapabilityMap.module.css'
+import entryCss from '../src/client/CapabilityEntry.module.css'
+
+afterEach(() => {
+  cleanup()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+/** Interpolate `{name}` placeholders like the locale service. */
+function interpolate(template: string, params?: Record<string, unknown>): string {
+  if (params === undefined) return template
+  return template.replace(/\{(\w+)\}/gu, (match, name: string) => (name in params ? String(params[name]) : match))
+}
+
+/** A hook the rail never reads; failing loudly keeps a stray read visible. */
+function unusedHook(): never {
+  throw new Error('the execution rail reads no such slot source')
+}
+
+/**
+ * Build a snapshot from this task's steps, the way the fold does.
+ * @param steps - the steps to publish.
+ * @param task - task ordinal; the UI keys its fade on it.
+ * @returns a snapshot with derived module counts.
+ */
+function snapshotFrom(steps: readonly TraceStep[], task = 1): TraceSnapshot {
+  const counts = new Map<string, number>()
+  const active = new Set<string>()
+  for (const step of steps) {
+    if (step.module === null) continue
+    counts.set(step.module, (counts.get(step.module) ?? 0) + 1)
+    if (step.status === 'running') active.add(step.module)
+  }
+  const modules = MODULE_MAP.modules.map((module) => {
+    const calls = counts.get(module.name) ?? 0
+    return {
+      id: module.id,
+      name: module.name,
+      calls,
+      state: active.has(module.name) ? 'active' as const : calls > 0 ? 'used' as const : 'unused' as const,
+    }
+  })
+  const running = steps.some(step => step.status === 'running')
+  return {
+    task,
+    running,
+    current: running ? [...steps].reverse().find(step => step.status === 'running') ?? null : null,
+    steps,
+    modules,
+  }
+}
+
+/**
+ * Build a panorama snapshot with explicit per-module call counts and states,
+ * which the step-derived helper cannot express (a module called seven times).
+ * @param byId - module id → its calls and state; absent ids are unused.
+ * @returns a snapshot whose nine module rows carry those values.
+ */
+function panoramaOf(
+  byId: Readonly<Record<string, { calls: number; state: 'unused' | 'used' | 'active' }>>,
+): TraceSnapshot {
+  const modules = MODULE_MAP.modules.map((module) => {
+    const entry = byId[module.id] ?? { calls: 0, state: 'unused' as const }
+    return { id: module.id, name: module.name, calls: entry.calls, state: entry.state }
+  })
+  return { task: 1, running: false, current: null, steps: [], modules }
+}
+
+/** The rail stylesheet, read as text (CSS modules are opaque class names at runtime). */
+const RAIL_CSS = 'packages/client/ui-capability-map/src/client/CapabilityMap.module.css'
+const railCss = (): string => readFileSync(RAIL_CSS, 'utf8')
+
+/**
+ * Read the declaration bodies of every rule written with this exact selector.
+ * A grouped rule matches on its first, comma-terminated, or last,
+ * brace-terminated line; a selector that also appears in a later standalone
+ * rule therefore returns both bodies.
+ * @param cssText - the stylesheet source.
+ * @param selector - the selector to look up, exactly as written.
+ * @returns the text from each matching rule's `{` to its `}`.
+ */
+function ruleOf(cssText: string, selector: string): string {
+  const lines = cssText.split('\n')
+  const bodies: string[] = []
+  for (const [index, line] of lines.entries()) {
+    const opened = line.trim()
+    if (opened !== selector && opened !== `${selector},` && opened !== `${selector} {`) continue
+    const body = lines.slice(index).join('\n')
+    const open = body.indexOf('{')
+    bodies.push(body.slice(open, body.indexOf('}', open)))
+  }
+  if (bodies.length === 0) throw new Error(`missing rule: ${selector}`)
+  return bodies.join('\n')
+}
+
+/** Mutable feed that counts subscriptions, like the injected trace source. */
+class FakeFeed implements TraceFeed {
+  private current: TraceSnapshot
+  private readonly listeners = new Set<() => void>()
+  subscriptions = 0
+
+  /**
+   * @param snapshot - initial snapshot.
+   */
+  constructor(snapshot: TraceSnapshot = EMPTY_TRACE) {
+    this.current = snapshot
+  }
+
+  /** @returns the current snapshot. */
+  readonly getSnapshot = (): TraceSnapshot => this.current
+
+  /**
+   * @param listener - notified on every publish.
+   * @returns the unsubscribe function.
+   */
+  readonly subscribe = (listener: () => void): () => void => {
+    this.subscriptions += 1
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  /**
+   * Publish a new snapshot.
+   * @param snapshot - the next snapshot.
+   */
+  set(snapshot: TraceSnapshot): void {
+    this.current = snapshot
+    for (const listener of [...this.listeners]) listener()
+  }
+}
+
+/**
+ * Bind a feed the way the renderer binds an injected source.
+ * @param feed - trace source.
+ * @returns the hook handed to the component as `useTrace`.
+ */
+function traceHook(feed: TraceFeed): CapabilityMapProps['useTrace'] {
+  type Hook = (selector: (snapshot: TraceSnapshot) => unknown) => unknown
+  const useBound: Hook = selector => selector(useSyncExternalStore(feed.subscribe, feed.getSnapshot, feed.getSnapshot))
+  return useBound as unknown as CapabilityMapProps['useTrace']
+}
+
+/**
+ * Build the composed props the framework hands this entry.
+ * @param overrides - open state, feed hook, dictionary, and toggle.
+ * @returns props for `CapabilityMap`.
+ */
+function props(overrides: {
+  open?: boolean
+  onToggle?: () => void
+  useTrace?: CapabilityMapProps['useTrace']
+  copy?: Record<string, string> | undefined
+} = {}): CapabilityMapProps {
+  const copy: Record<string, string> = overrides.copy ?? en
+  return {
+    t: (key: string, params?: Record<string, unknown>) => interpolate(copy[key] ?? key, params),
+    open: overrides.open ?? false,
+    onToggle: overrides.onToggle ?? (() => {}),
+    useTrace: overrides.useTrace ?? traceHook(new FakeFeed()),
+    usePanelInfo: unusedHook,
+    useSessions: unusedHook,
+    useSessionStatus: unusedHook,
+    useSessionRetainInfo: unusedHook,
+    useWorkspaces: unusedHook,
+    useResource: unusedHook,
+    useContextMenu: unusedHook,
+    useRemoteAccess: () => true,
+    useAccess: () => true,
+    useSessionAccess: () => true,
+    useWorkspaceAccess: () => true,
+  } as unknown as CapabilityMapProps
+}
+
+/** Frame-like harness that owns the open state, like AppFrame does. */
+function Harness({ useTrace, copy }: { useTrace: CapabilityMapProps['useTrace']; copy?: Record<string, string> | undefined }) {
+  const [open, setOpen] = useState(false)
+  return <CapabilityMap {...props({ open, onToggle: () => { setOpen(value => !value) }, useTrace, copy })} />
+}
+
+/**
+ * Mount the rail and open it.
+ * @param feed - feed to bind.
+ * @param copy - dictionary to translate with.
+ * @returns the expanded panel.
+ */
+function openPanel(feed: FakeFeed, copy: Record<string, string> = en): HTMLElement {
+  render(<Harness useTrace={traceHook(feed)} copy={copy} />)
+  fireEvent.click(screen.getByRole('button', { name: copy['map.open'] ?? 'map.open' }))
+  return screen.getByRole('complementary', { name: copy['map.region'] ?? 'map.region' })
+}
+
+/** A finished account step, the worked example from the task. */
+const ACCOUNT_DONE: TraceStep = {
+  id: 'c1', module: '账号与盘点', action: '读取工作区清单', status: 'done',
+}
+
+describe('execution rail shell', () => {
+  it('renders exactly one entry on the 48px strip: a 22px icon + vertical 能做什么', () => {
+    const feed = new FakeFeed()
+    const view = render(<Harness useTrace={traceHook(feed)} />)
+    const dock = view.container.querySelector('[data-capability-map]')
+    expect(dock?.getAttribute('data-capability-map')).toBe('collapsed')
+    expect(dock?.getAttribute('data-rail-width')).toBe('48')
+    // ONE entry: the former footer "Daniel 全景地图" button is gone (design §1.1
+    // / §1.3 — two entries made the strip a half navigation bar).
+    const entries = dock?.querySelectorAll('button') ?? []
+    expect(entries).toHaveLength(1)
+    const strip = entries[0] as HTMLButtonElement
+    expect(strip.getAttribute('data-rail-entry')).toBe('')
+    expect(strip.getAttribute('aria-expanded')).toBe('false')
+    expect(strip.getAttribute('aria-label')).toBe(en['map.open'])
+    expect(strip.getAttribute('title')).toBe(en['rail.entryHint'])
+    expect(strip.textContent).toBe(en['rail.title'])
+    // The checklist icon is drawn at 22px (was 18px).
+    const icon = strip.querySelector('svg')
+    expect(icon?.getAttribute('width')).toBe('22')
+    expect(icon?.getAttribute('height')).toBe('22')
+    // No progress, no module name, no second control, no subscription.
+    expect(screen.queryByRole('complementary')).toBeNull()
+    expect(screen.queryByRole('searchbox')).toBeNull()
+    expect(feed.subscriptions).toBe(0)
+  })
+
+  it('is controlled and expands into the 320px read-only panel', () => {
+    const onToggle = vi.fn()
+    const { rerender } = render(<CapabilityMap {...props({ open: false, onToggle })} />)
+    fireEvent.click(screen.getByRole('button', { name: en['map.open'] }))
+    expect(onToggle).toHaveBeenCalledTimes(1)
+    expect(screen.queryByRole('complementary')).toBeNull()
+
+    rerender(<CapabilityMap {...props({ open: true, onToggle })} />)
+    const panel = screen.getByRole('complementary', { name: en['map.region'] })
+    expect(document.querySelector('[data-capability-map]')?.getAttribute('data-rail-width')).toBe('320')
+    expect(document.querySelector('[data-capability-map]')?.getAttribute('data-capability-map')).toBe('expanded')
