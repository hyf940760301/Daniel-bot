+// @vitest-environment jsdom
+/**
+ * The explicit workspace/brand selection (design §9): rendering, keyboard,
+ * empty data, the send gate, the one-question mismatch policy, and persistence.
+ *
+ * The suite drives the real store and the real components; its one cross-package
+ * assertion builds the guard exactly as `index.ts` does and hands it to the real
+ * composer shell, which is what makes 「缺值不发」 a structural fact rather than
+ * a UI opinion.
+ */
+import { readFileSync } from 'node:fs'
+import { createElement, useSyncExternalStore } from 'react'
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import { ContextBar, type ContextBarActions } from '../src/client/ContextBar.tsx'
