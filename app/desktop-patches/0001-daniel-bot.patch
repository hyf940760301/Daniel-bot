@@ -0,0 +1,55 @@
+/* The refused-send notice above the composer card (design §9.2).
+ *
+ * One quiet line: the sentence the refused send raised, then the single action
+ * that opens the missing selector. It never covers the composer and never
+ * animates; a pick removes it because the store clears `missing`. */
+
+.notice {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  box-sizing: border-box;
+  width: 100%;
+  margin-bottom: 8px;
+  padding: 8px 12px;
+  border: 1px solid #E5E6EB;
+  border-radius: 8px;
+  background: var(--dsw-alias-bg-l2);
+  color: var(--dsw-alias-label-primary);
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.4;
+}
+
+.text {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.action {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  gap: 4px;
+  height: 28px;
+  padding: 0 10px;
+  border: 1px solid #C9CDD4;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+}
+
+.action:hover {
+  background: #F5F6F7;
+}
+
+.caret {
+  font-size: 10px;
+  line-height: 1;
+  opacity: 0.6;
+}
diff --git a/packages/client/ui-capability-map/src/client/SelectionNotice.tsx b/packages/client/ui-capability-map/src/client/SelectionNotice.tsx
new file mode 100644
index 00000000..6d469358
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/SelectionNotice.tsx
@@ -0,0 +1,62 @@
+/**
+ * The inline "pick a workspace/brand first" notice above the composer (design
+ * §9.2).
+ *
+ * It appears only after a send was refused (`selection.missing`), never on
+ * mount: typing is always allowed, and the bar's own selectors stay the normal
+ * way to choose. The notice carries exactly one action — open the dropdown of
+ * the half that is missing — and that action never sends; after a pick the
+ * notice disappears and the user confirms the send themselves.
+ *
+ * Seat: `conversation.input.dock`, the full-width list above the composer card.
+ */
+import type { ReactNode } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+// Type-only: pulls the Conversation SlotMap entry for `conversation.input.dock`.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { SelectionFeed, SelectorKind } from './selection.ts'
+import type { NS } from './locales.ts'
+import css from './SelectionNotice.module.css'
+
+/** The notice's only write: open one selector, never select or send for the user. */
+export interface SelectionNoticeInjected {
+  readonly hooks: {
+    /** The same selection store the top bar renders. */
+    readonly selection: SelectionFeed
+  }
+  readonly actions: {
+    /** Open the dropdown for the missing half. */
+    readonly openPicker: (kind: SelectorKind) => void
+  }
+}
+
+/** Composed props of the `conversation.input.dock` entry. */
+type SelectionNoticeProps = PropsRuntime<'conversation.input.dock'>
+  & PropsLocale<typeof NS>
+  & InjectFace<SelectionNoticeInjected>
+
+/**
+ * Render the refused-send notice.
+ * @param props - the selection feed, the picker action, and the dictionary.
+ * @returns the notice, or null while both halves are chosen.
+ */
+export function SelectionNotice({ t, useSelection, actions }: SelectionNoticeProps): ReactNode {
+  const missing = useSelection(snapshot => snapshot.missing)
+  if (missing === undefined) return null
+  const workspace = missing === 'workspace'
+  return (
+    <div className={css.notice} role="alert" data-selection-notice="" data-missing={missing}>
+      <span className={css.text}>{t(workspace ? 'gate.workspace' : 'gate.brand')}</span>
+      <button
+        type="button"
+        className={css.action}
+        data-selection-notice-action={missing}
+        // The picker is a menu in the top bar; the notice only opens it.
+        onClick={() => { actions.openPicker(missing) }}
+      >
+        {t(workspace ? 'gate.chooseWorkspace' : 'gate.chooseBrand')}
+        <span className={css.caret} aria-hidden="true">▾</span>
+      </button>
+    </div>
+  )
+}
diff --git a/packages/client/ui-capability-map/src/client/Selector.module.css b/packages/client/ui-capability-map/src/client/Selector.module.css
new file mode 100644
index 00000000..fbac0ebe
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/Selector.module.css
@@ -0,0 +1,214 @@
+/* One workspace/brand selector (design §9.7).
+ *
+ * Dimensions are the approved spec, not taste: a 32px capsule with 10px side
+ * padding and an 8px radius, 13px/500 type, an 8px gap between the two
+ * selectors (set by the bar), and a 240px-wide / 320px-tall dropdown with a
+ * 32px search row and 36px option rows.
+ *
+ * Two states, and only two:
+ * - 已选: a solid 1px #E5E6EB border; hover fills #F5F6F7;
+ * - 未选: a dashed 1px #C9CDD4 border and grey placeholder text.
+ *
+ * Below 480px the label disappears and the value is capped at eight characters
+ * with an ellipsis, so both selectors stay on the line.
+ */
+
+.root {
+  position: relative;
+  display: inline-flex;
+  flex: 0 0 auto;
+  min-width: 0;
+}
+
+.trigger {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  box-sizing: border-box;
+  height: 32px;
+  max-width: 100%;
+  padding: 0 10px;
+  border: 1px solid #E5E6EB;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.trigger:hover {
+  background: #F5F6F7;
+}
+
+.trigger:focus-visible {
+  outline: 2px solid var(--dsw-alias-label-primary);
+  outline-offset: 1px;
+}
+
+/* 未选：虚线边框 + 灰色文案 */
+.empty {
+  border-style: dashed;
+  border-color: #C9CDD4;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.empty .value {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.label {
+  flex: none;
+  color: var(--dsw-alias-label-secondary);
+  font-weight: 400;
+}
+
+.value {
+  max-width: 180px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.caret {
+  flex: none;
+  font-size: 10px;
+  line-height: 1;
+  opacity: 0.6;
+}
+
+.menu {
+  position: absolute;
+  top: calc(100% + 6px);
+  left: 0;
+  z-index: 60;
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  width: max-content;
+  min-width: 240px;
+  max-width: 360px;
+  max-height: 320px;
+  overflow: hidden;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 10px;
+  background: var(--dsw-alias-bg-base);
+  box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
+}
+
+.search {
+  box-sizing: border-box;
+  flex: none;
+  height: 32px;
+  margin: 0;
+  padding: 0 10px;
+  border: 0;
+  border-bottom: 1px solid var(--dsw-alias-border-l3);
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 13px;
+  outline: none;
+}
+
+.search::placeholder {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.list {
+  flex: 1 1 auto;
+  margin: 0;
+  padding: 4px;
+  overflow-y: auto;
+  list-style: none;
+}
+
+.option {
+  display: flex;
+  align-items: center;
+  box-sizing: border-box;
+  width: 100%;
+  height: 36px;
+  padding: 0 10px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 13px;
+  font-weight: 400;
+  text-align: left;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  cursor: pointer;
+}
+
+.option[aria-selected='true'],
+.optionActive {
+  background: #F5F6F7;
+}
+
+.emptyState {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 10px 12px;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 13px;
+  line-height: 1.4;
+}
+
+.refresh {
+  flex: none;
+  height: 24px;
+  padding: 0 8px;
+  border: 1px solid #E5E6EB;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-family: inherit;
+  font-size: 12px;
+  cursor: pointer;
+}
+
+.refresh:hover {
+  background: #F5F6F7;
+}
+
+.failure {
+  flex: none;
+  padding: 6px 12px;
+  border-top: 1px solid var(--dsw-alias-border-l3);
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 1.4;
+}
+
+.footer {
+  flex: none;
+  padding: 6px 12px;
+  border-top: 1px solid var(--dsw-alias-border-l3);
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 1.4;
+}
+
+/* 窄屏（<480px）：只显示当前值，超 8 字截断加省略号 */
+@media (max-width: 480px) {
+  .label {
+    display: none;
+  }
+
+  .value {
+    max-width: 8em;
+  }
+
+  .menu {
+    min-width: 220px;
+    max-width: calc(100vw - 32px);
+  }
+}
