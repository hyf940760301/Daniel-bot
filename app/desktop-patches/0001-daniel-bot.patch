@@ -0,0 +1,105 @@
+/**
+ * Model context for the workspace and brand the browser's top bar has
+ * selected.
+ *
+ * Why this package exists: the selectors know the pair, but the model cannot
+ * see the browser. The pair therefore rides each prompt RPC as
+ * `source.clientSelection` metadata (never as message text), and this plugin
+ * turns the newest one into request context — the same channel the harness uses
+ * for the working directory and the Web surface. A user who only picks the two
+ * values and asks "which workspace am I in?" is answered from context, not
+ * from a sentence the user did not type.
+ *
+ * Lifecycle: the prompt that carries a pair arrives in `agent/pre-step`
+ * *before* the request assembly is refreshed, so the listener records the
+ * newest pair per Session, and the context provider reads that record when the
+ * request is admitted. Switching the selection changes the pair on the next
+ * prompt; the request then carries a new snapshot whose text supersedes the
+ * previous one. A Session that never carried a pair contributes nothing at
+ * all — no placeholder, no invented workspace.
+ *
+ * @module @deepseek-ai/dsh-client-selection-context
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import type { ClientSelection } from '@deepseek-ai/dsh-api-session-controller/types'
+import type { UserMessage } from '@deepseek-ai/dsh-llm'
+import type { Session } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-system-prompt'
+
+/** Stable Cordis plugin name. */
+export const name = 'client-selection-context'
+
+/** The prompt registries this provider contributes to. */
+export const inject = ['systemPrompt']
+
+/** Runtime-context name; also the name a suppressing preset can reason about. */
+export const SELECTION_CONTEXT_NAME = 'app:client-selection'
+
+/**
+ * Placement among runtime contexts: after the delegation and team facts, and
+ * well before the process-specific harness paths. The pair is an address for
+ * every Daniel tool, so it belongs with the operational facts rather than the
+ * system prompt (which is cached and should not change per turn).
+ */
+export const SELECTION_CONTEXT_ORDER = 130
+
+/**
+ * Read the pair a prompt carried.
+ * @param message - one proposed or committed user message.
+ * @returns the canonical pair, or undefined when this message carried none.
+ */
+export function selectionOf(message: UserMessage): ClientSelection | undefined {
+  const { source } = message
+  return source.kind === 'user' && 'clientSelection' in source ? source.clientSelection : undefined
+}
+
+/**
+ * Render the model-facing snapshot.
+ * @param selection - canonical pair from the prompt source.
+ * @returns the paragraph this plugin contributes to the request context.
+ */
+export function renderSelection(selection: ClientSelection): string {
+  // Names are quoted so a name containing a newline or a dash cannot forge
+  // another line of the paragraph.
+  return [
+    'Current workspace and brand selected in the app\'s top bar (authoritative for this conversation even though the user\'s message does not repeat them):',
+    `- Workspace: ${JSON.stringify(selection.workspace.name)} (id ${String(selection.workspace.id)})`,
+    `- Brand: ${JSON.stringify(selection.brand.name)} (id ${selection.brand.id})`,
+    'When the user asks which workspace or brand is active, answer with these values. A newer snapshot supersedes these values.',
+  ].join('\n')
+}
+
+/**
+ * Record the newest pair per Session and contribute it as runtime context.
+ * @param ctx - plugin context with the prompt registry mounted.
+ */
+export function apply(ctx: Context): void {
+  /** Newest pair each Session's prompts carried; an absent key means none yet. */
+  const latest = new WeakMap<Session, ClientSelection>()
+  // The claimed prompt reaches this waterfall before the step's assembly is
+  // refreshed, so recording here makes the very first request of the turn
+  // carry the pair. Continuation steps claim nothing and keep the record.
+  ctx.on('agent/pre-step', ({ agent, messages }: {
+    agent: Agent
+    messages: UserMessage[]
+  }, next: () => Promise<PreStepDecision>): Promise<PreStepDecision> => {
+    for (const message of messages) {
+      const selection = selectionOf(message)
+      if (selection !== undefined) latest.set(agent.session, selection)
+    }
+    return next()
+  })
+  ctx.systemPrompt.context({
+    name: SELECTION_CONTEXT_NAME,
+    order: SELECTION_CONTEXT_ORDER,
+    // Literal text: brand and workspace names are data, not prompt variables.
+    interpolate: false,
+    text: (assembly) => {
+      const session = assembly.agent?.session
+      const selection = session === undefined ? undefined : latest.get(session)
+      return selection === undefined ? '' : renderSelection(selection)
+    },
+  })
+}
