--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/Selector.tsx
@@ -0,0 +1,209 @@
+/**
+ * One explicit selector (工作区 or 品牌) for the conversation top bar.
+ *
+ * The control is a 32px capsule: a solid `#E5E6EB` border with the chosen name,
+ * or a dashed `#C9CDD4` border with the grey 「未选择」 placeholder. The dropdown
+ * is at least 240px wide and 320px tall, opens on a 32px search row, lists
+ * 36px options, and is fully keyboard driven (↑ ↓ Enter Esc, typing filters).
+ *
+ * The trigger shows only the chosen value, never the label, below 480px, and
+ * truncates a value longer than eight characters — the bar must not push the
+ * brand selector off a phone-width frame.
+ *
+ * Data attributes are part of the acceptance surface:
+ * `data-selector="workspace|brand"`, `data-selected="true|false"`, `data-open`.
+ */
+import { useEffect, useMemo, useRef, useState } from 'react'
+import type { KeyboardEvent, ReactNode } from 'react'
+import css from './Selector.module.css'
+import type { SelectorKind } from './selection.ts'
+
+/** One row the dropdown may offer. */
+export interface SelectorOption {
+  readonly id: string
+  readonly name: string
+}
+
+/** Everything one selector needs; copy is supplied by the bar (locale-aware). */
+export interface SelectorProps {
+  readonly kind: SelectorKind
+  readonly label: string
+  readonly placeholder: string
+  /** Chosen option's name, or undefined when nothing is chosen. */
+  readonly selected: string | undefined
+  readonly options: readonly SelectorOption[]
+  readonly open: boolean
+  readonly onOpenChange: (open: boolean) => void
+  readonly onSelect: (id: string) => void
+  readonly searchLabel: string
+  readonly searchPlaceholder: string
+  readonly emptyText: string
+  readonly refreshLabel: string
+  readonly onRefresh: () => void
+  readonly loading: boolean
+  /** Localized 「正在读取…」 line while a read is in flight. */
+  readonly loadingText: string
+  /** Localized failure line, when the last read failed. */
+  readonly failure: string | undefined
+  /** Localized footer (the web fallback's 「仅显示本次会话见过的」). */
+  readonly footer: string | undefined
+}
+
+/**
+ * Render one selector and its dropdown.
+ * @param props - selected value, options, open state, and localized copy.
+ * @returns the trigger plus the dropdown while open.
+ */
+export function Selector({
+  kind, label, placeholder, selected, options, open, onOpenChange, onSelect,
+  searchLabel, searchPlaceholder, emptyText, refreshLabel, onRefresh, loading, loadingText, failure, footer,
+}: SelectorProps): ReactNode {
+  const root = useRef<HTMLDivElement>(null)
+  const search = useRef<HTMLInputElement>(null)
+  const [query, setQuery] = useState('')
+  const [active, setActive] = useState(0)
+  const filtered = useMemo(() => {
+    const needle = query.trim().toLocaleLowerCase()
+    if (needle === '') return options
+    return options.filter(option => option.name.toLocaleLowerCase().includes(needle))
+  }, [options, query])
+
+  // Reopen with a clean query and the first row active; the chosen row is not
+  // special-cased (the list is short and the search narrows it quickly).
+  useEffect(() => {
+    if (!open) return
+    setQuery('')
+    setActive(0)
+    search.current?.focus()
+  }, [open])
+
+  // A filter change must keep the active row inside the list.
+  useEffect(() => {
+    setActive(current => filtered.length === 0 ? 0 : Math.min(current, filtered.length - 1))
+  }, [filtered])
+
+  // Clicking anywhere outside the selector closes it, like every menu here.
+  useEffect(() => {
+    if (!open) return
+    const onPointerDown = (event: globalThis.PointerEvent): void => {
+      if (!(event.target instanceof Node)) return
+      if (root.current?.contains(event.target) === true) return
+      onOpenChange(false)
+    }
+    document.addEventListener('pointerdown', onPointerDown)
+    return () => { document.removeEventListener('pointerdown', onPointerDown) }
+  }, [open, onOpenChange])
+
+  const pick = (option: SelectorOption | undefined): void => {
+    if (option === undefined) return
+    onSelect(option.id)
+  }
+
+  const onSearchKeyDown = (event: KeyboardEvent<HTMLInputElement>): void => {
+    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+      event.preventDefault()
+      if (filtered.length === 0) return
+      const step = event.key === 'ArrowDown' ? 1 : -1
+      setActive(current => (current + step + filtered.length) % filtered.length)
+      return
+    }
+    if (event.key === 'Enter') {
+      event.preventDefault()
+      pick(filtered[active])
+      return
+    }
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      onOpenChange(false)
+      return
+    }
+    if (event.key === 'Home' || event.key === 'End') {
+      event.preventDefault()
+      setActive(event.key === 'Home' ? 0 : Math.max(0, filtered.length - 1))
+    }
+  }
+
+  const onTriggerKeyDown = (event: KeyboardEvent<HTMLButtonElement>): void => {
+    if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
+      if (open) return
+      event.preventDefault()
+      onOpenChange(true)
+    }
+    if (event.key === 'Escape' && open) {
+      event.preventDefault()
+      onOpenChange(false)
+    }
+  }
+
+  const hasValue = selected !== undefined
+
+  return (
+    <div className={css.root} ref={root} data-selector-root={kind}>
+      <button
+        type="button"
+        className={[css.trigger, hasValue ? css.selected : css.empty].join(' ')}
+        data-selector={kind}
+        data-selected={hasValue ? 'true' : 'false'}
+        data-open={open ? 'true' : undefined}
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        aria-label={hasValue ? `${label}：${selected}` : `${label}：${placeholder}`}
+        onClick={() => { onOpenChange(!open) }}
+        onKeyDown={onTriggerKeyDown}
+      >
+        <span className={css.label}>{label}</span>
+        <span className={css.value} data-selector-value={kind}>{hasValue ? selected : placeholder}</span>
+        <span className={css.caret} aria-hidden="true">▾</span>
+      </button>
+      {open && (
+        <div className={css.menu} data-selector-menu={kind}>
+          <input
+            ref={search}
+            type="text"
+            className={css.search}
+            value={query}
+            placeholder={searchPlaceholder}
+            aria-label={searchLabel}
+            onChange={event => { setQuery(event.target.value) }}
+            onKeyDown={onSearchKeyDown}
+          />
+          {filtered.length > 0 && (
+            <ul className={css.list} role="listbox" aria-label={label}>
+              {filtered.map((option, index) => (
+                <li key={option.id}>
+                  <button
+                    type="button"
+                    role="option"
+                    aria-selected={index === active}
+                    className={[css.option, index === active ? css.optionActive : ''].filter(Boolean).join(' ')}
+                    data-option-id={option.id}
+                    // Keep the search box focused: a click must not blur the
+                    // input before the pick lands.
+                    onMouseDown={event => { event.preventDefault() }}
+                    onClick={() => { pick(option) }}
+                  >
+                    {option.name}
+                  </button>
+                </li>
+              ))}
+            </ul>
+          )}
+          {filtered.length === 0 && (
+            <div className={css.emptyState} data-selector-empty={kind}>
+              <span>{loading ? loadingText : emptyText}</span>
+              <button type="button" className={css.refresh} onClick={onRefresh} disabled={loading}>
+                {refreshLabel}
+              </button>
+            </div>
+          )}
+          {failure !== undefined && (
+            <div className={css.failure} role="status" data-selector-failure={kind}>{failure}</div>
+          )}
+          {footer !== undefined && (
+            <div className={css.footer} data-selector-footer={kind}>{footer}</div>
+          )}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/packages/client/ui-capability-map/src/client/TraceRail.tsx b/packages/client/ui-capability-map/src/client/TraceRail.tsx
new file mode 100644
index 00000000..e209a679
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/TraceRail.tsx
@@ -0,0 +1,251 @@
+/**
+ * The execution rail's live body (S6.4): the current task's step path and the
+ * nine-module panorama that lights up as modules are used.
+ *
+ * It answers two questions in business language — "what is Daniel doing right
+ * now, in which module?" and "which modules has this task touched?" — and it is
+ * deliberately poor in detail: no command line, no tool name, no arguments, no
+ * result. Those exist in the conversation transcript; the rail is the glance.
+ *
+ * It is mounted only while the panel is expanded, and it subscribes only
+ * through the `useTrace` hook it is handed — so a collapsed rail holds no
+ * subscription and runs no fold (see CHANGES-RAIL-V2.md §6).
+ */
+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { IconCheckOutlineRegular } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { SnapshotSelectorHook, Translate } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TraceSnapshot, TraceStep } from './trace.ts'
+import { isWorkRow } from './trace.ts'
+import type { CapabilityMapKey } from './locales.ts'
+import { MODULE_MAP } from './module-map.generated.ts'
+import { moduleNameEn, moduleNameEnById } from './module-names.ts'
+import css from './CapabilityMap.module.css'
+
+/**
+ * How long the task block carries its enter marker, in milliseconds. The CSS
+ * fade is 180ms; the marker outlives it by a hair so the animation is never cut
+ * off, and then leaves so no later update can replay it.
+ */
+const TASK_ENTER_MS = 200
+
+/** Props of the rail body: the injected feed hook plus the panel's translate seat. */
+export interface TraceRailProps {
+  /** Selector hook over the trace feed injected by the rail registration. */
+  readonly useTrace: SnapshotSelectorHook<TraceSnapshot>
+  /** Panel dictionary. */
+  readonly t: Translate<CapabilityMapKey>
+}
+
+/**
+ * Whether the user asked the system to reduce motion. The pulse is a CSS
+ * animation, but the panel also refuses to add it at all under this setting
+ * (`data-pulse="off"`), so the preference is visible in the DOM and testable.
+ * A missing `matchMedia` (older webviews, jsdom) means "no preference".
+ * @returns true when reduced motion is requested.
+ */
+function useReducedMotion(): boolean {
+  const [reduced, setReduced] = useState(false)
+  useEffect(() => {
+    if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return
+    const query = window.matchMedia('(prefers-reduced-motion: reduce)')
+    const update = (): void => { setReduced(query.matches) }
+    update()
+    query.addEventListener('change', update)
+    return () => { query.removeEventListener('change', update) }
+  }, [])
+  return reduced
+}
+
+/**
+ * Business module label of one step: its module, or the shared "other" label.
+ * @param step - step to label.
+ * @returns the module text the rail renders.
+ */
+function moduleLabel(step: TraceStep): string {
+  return step.module ?? MODULE_MAP.fallback.module
+}
+
+/**
+ * English half of a step's module label, when the module is one of the nine.
+ * @param step - step to label.
+ * @returns the English module name, or undefined for the fallback row.
+ */
+function moduleLabelEn(step: TraceStep): string | undefined {
+  return moduleNameEn(step.module)
+}
+
+/**
+ * Render the live body inside the expanded panel: this task's path, then the
+ * module panorama.
+ * @param props - the injected feed hook and the panel dictionary.
+ * @returns the task section and the nine-module status list.
+ */
+export function TraceRail({ useTrace, t }: TraceRailProps): ReactNode {
+  const trace = useTrace(snapshot => snapshot)
+  const reduced = useReducedMotion()
+  // The fade belongs to a *task reset*, not to every snapshot: the marker is
+  // set when the task ordinal differs from the one already shown, and removed
+  // once the animation had its time. A status update can then never restart it.
+  const [enteredTask, setEnteredTask] = useState<number | null>(null)
+  const entering = trace.task !== enteredTask
+  useEffect(() => {
+    if (!entering) return
+    const timer = setTimeout(() => { setEnteredTask(trace.task) }, TASK_ENTER_MS)
+    return () => { clearTimeout(timer) }
+  }, [entering, trace.task])
+  const current = trace.current
+  const latest = trace.steps.length > 0 ? trace.steps[trace.steps.length - 1] : undefined
+  const state = current !== null ? 'running' : latest !== undefined ? 'done' : 'idle'
+  const nowAction = state === 'running' ? current?.action ?? '' : state === 'done' ? latest?.action ?? '' : ''
+  // The settled task has content, but none of it is a Daniel capability call:
+  // say so instead of dressing internal work up as one. Waiting for `done`
+  // keeps the note from flashing mid-task while internal work is still running.
+  const danielCalled = trace.steps.some(step => !isWorkRow(step))
+  const noDaniel = !danielCalled && trace.steps.length > 0 && state === 'done'
+
+  return (
+    <>
+      <section
+        // A new task replaces the block once (the fade rides on that mount and
+        // on the `data-enter` marker); within a task every update reuses it.
+        key={trace.task}
+        className={css.task}
+        aria-label={t('task.region')}
+        data-task={trace.task}
+        data-state={state}
+        data-enter={entering && !reduced ? 'on' : undefined}
+      >
+        <header className={css.sectionHead}>
+          <h3 className={css.sectionTitle}>{t('task.title')}</h3>
+          {state === 'done' && <span className={css.sectionMeta}>{t('task.done')}</span>}
+        </header>
+
+        <p className={css.taskNow} data-state={state}>
+          {state !== 'idle' && (
+            <span
+              className={css.nowDot}
+              data-state={state}
+              data-pulse={state === 'running' && !reduced ? 'on' : 'off'}
+              aria-hidden="true"
+            />
+          )}
+          {state === 'idle'
+            ? <span className={css.nowText}>{t('task.idle')}</span>
+            : (
+              <>
+                <span className={css.nowLabel}>{t(state === 'running' ? 'task.now' : 'task.last')}</span>
+                <span className={css.nowValue}>{nowAction}</span>
+                {state === 'done' && <span className={css.nowDone}>{t('task.done')}</span>}
+              </>
+            )}
+        </p>
+
+        {trace.steps.length > 0 && (
+          <ol className={css.steps} aria-label={t('task.steps')} data-running={trace.running ? 'true' : undefined}>
+            {trace.steps.map((step, index) => {
+              const isCurrent = current !== null && step.id === current.id && step.status === 'running'
+              const next = trace.steps[index + 1]
+              const line = step.status !== 'done'
+                ? 'muted'
+                : next !== undefined && next.status === 'running' ? 'gradient' : 'brand'
+              const statusLabel = t(step.status === 'running' ? 'task.step.running' : 'task.step.done')
+              // The folded row is not a Daniel module, so it carries no module
+              // tag: "整理结果" is the whole line by design.
+              const folded = isWorkRow(step)
+              const count = step.count ?? 1
+              const times = count > 1 ? t('task.step.times', { count }) : ''
+              const labelEn = folded ? undefined : moduleLabelEn(step)
+              const moduleText = labelEn === undefined
+                ? moduleLabel(step)
+                : `${moduleLabel(step)} ${labelEn}`
+              const label = folded
+                ? `${step.action}，${statusLabel}${times === '' ? '' : `，${times}`}`
+                : `${step.action}，${moduleText}，${statusLabel}${times === '' ? '' : `，${times}`}`
+              return (
+                <li
+                  // The row key is the first call's id (or `work`), which the
+                  // fold never changes: merging a later call into this row
+                  // updates it in place instead of remounting it.
+                  key={step.id}
+                  className={css.step}
+                  data-status={step.status}
+                  data-current={isCurrent ? 'true' : undefined}
+                  data-line={line}
+                  data-row={folded ? 'work' : 'daniel'}
+                  aria-label={label}
+                >
+                  <span
+                    className={css.node}
+                    data-status={step.status}
+                    data-pulse={isCurrent && !reduced ? 'on' : 'off'}
+                    aria-hidden="true"
+                  >
+                    {step.status === 'done' && <IconCheckOutlineRegular size={9} />}
+                  </span>
+                  <span className={css.stepText}>
+                    <span className={css.stepAction}>{step.action}</span>
+                    {!folded && (
+                      <span className={css.stepTag}>
+                        <span className={css.stepTagZh}>{moduleLabel(step)}</span>
+                        {labelEn !== undefined && (
+                          <span className={css.stepTagEn} data-module-en="">{labelEn}</span>
+                        )}
+                      </span>
+                    )}
+                  </span>
+                  {times !== '' && (
+                    <span className={css.stepCount} data-count={String(count)}>{times}</span>
+                  )}
+                  <span className={css.srOnly}>{statusLabel}</span>
+                </li>
+              )
+            })}
+          </ol>
+        )}
+
+        {noDaniel && (
+          <p className={css.taskNote} data-note="no-daniel">{t('task.noDaniel')}</p>
+        )}
+      </section>
+
+      <section className={css.panorama} aria-label={t('panorama.region')}>
+        <h3 className={css.sectionTitle}>{t('panorama.title')}</h3>
+        <ul className={css.modules} aria-label={t('panorama.region')}>
+          {trace.modules.map((module) => {
+            const stateKey = module.state === 'active'
+              ? 'module.active'
+              : module.state === 'used' ? 'module.used' : 'module.unused'
+            const times = module.calls > 1 ? t('module.times', { count: module.calls }) : undefined
+            return (
+              <li key={module.id} className={css.moduleRow} data-state={module.state} data-module={module.id}>
+                <span
+                  className={css.moduleDot}
+                  data-state={module.state}
+                  data-pulse={module.state === 'active' && !reduced ? 'on' : 'off'}
+                  aria-hidden="true"
+                />
+                <span className={css.moduleLabel}>
+                  <span className={css.moduleName}>{module.name}</span>
+                  {moduleNameEnById(module.id) !== undefined && (
+                    <span className={css.moduleNameEn} data-module-en="">{moduleNameEnById(module.id)}</span>
+                  )}
+                </span>
+                {/* The trailing block owns both numbers: it is pushed to the
+                    row's end and lays the cells out on a fixed grid, so the
+                    state column's right edge is the same on every row however
+                    long the Chinese name is. */}
+                <span className={css.moduleEnd} data-module-end="">
+                  {times !== undefined && (
+                    <span className={css.moduleCount} data-count={String(module.calls)}>{times}</span>
+                  )}
+                  <span className={css.moduleState}>{t(stateKey)}</span>
+                </span>
+              </li>
+            )
+          })}
+        </ul>
+      </section>
+    </>
+  )
+}
