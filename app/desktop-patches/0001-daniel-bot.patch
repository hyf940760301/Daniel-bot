+++ b/packages/client/ui-settings-account/src/client/daniel-auth.ts
@@ -0,0 +1,45 @@
+/**
+ * The Desktop shell's Daniel account bridge, as the account surfaces see it.
+ *
+ * It is installed by the owning window's preload only. A plain browser has no
+ * bridge, and those account surfaces keep using the shipped DeepSeek account
+ * flow instead — this module never falls back on its own.
+ */
+
+/** One signed-in Daniel account; `email` is empty only when the service could not name it. */
+export interface DanielAuthAccount {
+  readonly email: string
+}
+
+/**
+ * Operations the Desktop shell exposes as `window.danielAuth`.
+ * Signing in opens the native window; it never returns a URL and never reaches
+ * a browser authorization page.
+ */
+export interface DanielAuthBridge {
+  /** @returns the signed-in account, or `null` when no session is stored. */
+  status(): Promise<DanielAuthAccount | null>
+  /** @returns the account after the native window stored a session, or `null` when it was closed. */
+  signIn(): Promise<DanielAuthAccount | null>
+  signOut(): Promise<void>
+}
+
+declare global {
+  /** Present in the Desktop application window; absent in a plain browser. */
+  interface Window {
+    readonly danielAuth?: DanielAuthBridge
+  }
+}
+
+/**
+ * Read the bridge without trusting whatever a page may have assigned to the name.
+ * @returns the bridge, or undefined in a plain browser and for a partial stub.
+ */
+export function readDanielAuthBridge(): DanielAuthBridge | undefined {
+  const candidate = (globalThis as { danielAuth?: Partial<DanielAuthBridge> }).danielAuth
+  if (candidate === undefined
+    || typeof candidate.status !== 'function'
+    || typeof candidate.signIn !== 'function'
+    || typeof candidate.signOut !== 'function') return undefined
+  return candidate as DanielAuthBridge
+}
