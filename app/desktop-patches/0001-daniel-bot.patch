@@ -0,0 +1,342 @@
+/* Daniel panorama dialog (read-only guide).
+ *
+ * The card is the shared Modal's, widened to 720px and capped at 80vh: the
+ * header, the search row, and the note stay put while the module list and the
+ * function cards scroll inside. Every colour is a theme token, so both
+ * appearances and the Daniel palette come from the same sheet.
+ *
+ * No motion of its own: opening, closing, and filtering are instantaneous. The
+ * shared Modal keeps its fade and drops it under `prefers-reduced-motion`. */
+
+/* Specificity beats the primitive's base `.dialog` regardless of bundle order. */
+.dialog.dialog {
+  width: min(720px, calc(100vw - 48px));
+  max-height: 80vh;
+  padding: 0;
+  gap: 0;
+  overflow: hidden;
+}
+
+.header {
+  display: flex;
+  flex: none;
+  align-items: flex-start;
+  gap: 12px;
+  padding: 20px 20px 0;
+}
+
+.headings {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.title {
+  margin: 0;
+  color: var(--dsw-alias-label-primary);
+  font-size: 16px;
+  font-weight: 600;
+  line-height: 24px;
+}
+
+.subtitle {
+  margin: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.iconButton {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  border-radius: var(--dsw-radius-sm);
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  cursor: pointer;
+}
+
+.iconButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.searchRow {
+  flex: none;
+  padding: 14px 20px 12px;
+}
+
+.search {
+  box-sizing: border-box;
+  width: 100%;
+  height: 34px;
+  padding: 0 10px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: var(--dsw-radius-sm);
+  background: var(--dsw-alias-bg-layer-1);
+  color: var(--dsw-alias-label-primary);
+  font: inherit;
+  font-size: 13px;
+  line-height: 20px;
+}
+
+.search::placeholder {
+  color: var(--dsw-alias-label-caption);
+}
+
+/* Two panes: the nine-module index on the left, this module's cards on the
+ * right. Only these two panes scroll. */
+.main {
+  display: flex;
+  flex: 1 1 auto;
+  min-height: 0;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+}
+
+.modules {
+  flex: 0 0 208px;
+  min-width: 0;
+  padding: 8px;
+  overflow-y: auto;
+  border-right: 1px solid var(--dsw-alias-border-l2);
+}
+
+.moduleList {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.moduleButton {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  width: 100%;
+  padding: 7px 8px;
+  border: 0;
+  border-radius: var(--dsw-radius-sm);
+  background: transparent;
+  color: var(--dsw-alias-label-secondary);
+  font: inherit;
+  font-size: 13px;
+  line-height: 20px;
+  text-align: left;
+  cursor: pointer;
+}
+
+.moduleButton:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-primary);
+}
+
+.moduleButton[aria-pressed='true'] {
+  background: var(--dsw-alias-interactive-bg-active);
+  color: var(--dsw-alias-label-primary);
+  font-weight: 600;
+}
+
+.moduleName {
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* English half of a module name, muted and one step smaller than the Chinese
+ * name it follows. It shrinks (and ellipsizes) before the Chinese name does,
+ * so the 208px index column never grows or wraps. */
+.moduleNameEn {
+  flex: 0 1 auto;
+  max-width: 42%;
+  min-width: 0;
+  color: var(--dsw-alias-label-caption);
+  font-size: 10px;
+  font-weight: 400;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.moduleCount {
+  flex: none;
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  font-weight: 400;
+  font-variant-numeric: tabular-nums;
+}
+
+.detail {
+  flex: 1 1 auto;
+  min-width: 0;
+  padding: 14px 20px 20px;
+  overflow-y: auto;
+}
+
+.detailHead {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin-bottom: 12px;
+}
+
+.detailTitle {
+  margin: 0;
+  color: var(--dsw-alias-label-primary);
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 22px;
+}
+
+.detailTitleEn {
+  margin-left: 8px;
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  font-weight: 400;
+  letter-spacing: 0.02em;
+}
+
+.detailSummary {
+  margin: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.cards {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.card {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 12px 14px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: var(--dsw-radius-md);
+  background: var(--dsw-alias-bg-layer-1);
+}
+
+.cardTitle {
+  margin: 0;
+  color: var(--dsw-alias-label-primary);
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 20px;
+}
+
+.cardDetail {
+  margin: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.example {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin: 2px 0 6px;
+  padding: 6px 10px;
+  border-radius: var(--dsw-radius-sm);
+  background: var(--dsw-alias-bg-layer-2);
+}
+
+.exampleLabel {
+  flex: none;
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  line-height: 18px;
+}
+
+.exampleText {
+  min-width: 0;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 12px;
+  line-height: 18px;
+  overflow-wrap: anywhere;
+}
+
+.fill {
+  align-self: flex-start;
+  height: 26px;
+  padding: 0 10px;
+  border: 1px solid var(--dsw-alias-border-l3);
+  border-radius: var(--dsw-radius-sm);
+  background: var(--dsw-alias-bg-layer-2);
+  color: var(--dsw-alias-label-primary);
+  font: inherit;
+  font-size: 12px;
+  line-height: 24px;
+  cursor: pointer;
+}
+
+.fill:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  border-color: var(--dsw-alias-state-business-primary);
+}
+
+.empty {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 40px 0;
+  text-align: center;
+}
+
+.emptyTitle {
+  margin: 0;
+  color: var(--dsw-alias-label-secondary);
+  font-size: 13px;
+  line-height: 20px;
+}
+
+.emptyHint {
+  margin: 0;
+  color: var(--dsw-alias-label-caption);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.notice {
+  flex: none;
+  margin: 0;
+  padding: 8px 20px;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+  color: var(--dsw-alias-label-secondary);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.note {
+  flex: none;
+  margin: 0;
+  padding: 8px 20px 10px;
+  border-top: 1px solid var(--dsw-alias-border-l2);
+  color: var(--dsw-alias-label-caption);
+  font-size: 11px;
+  line-height: 16px;
+}
+
+.iconButton:focus-visible,
+.moduleButton:focus-visible,
+.fill:focus-visible,
+.search:focus-visible {
+  outline: var(--dsw-focus-ring-width, 2px) solid var(--dsw-focus-ring-color, var(--dsw-alias-state-business-primary));
+  outline-offset: 2px;
+}
diff --git a/packages/client/ui-capability-map/src/client/GuideMap.tsx b/packages/client/ui-capability-map/src/client/GuideMap.tsx
new file mode 100644
index 00000000..871c4b8c
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/GuideMap.tsx
@@ -0,0 +1,176 @@
+/**
+ * The Daniel panorama dialog: what the nine modules can answer, in the words a
+ * user would say it.
+ *
+ * It is a read-only manual with one affordance — "fill into the chat". The
+ * button writes the example phrase into the conversation composer through the
+ * Conversation plugin's published `setDraft` (see `prefill.ts`) and closes;
+ * it never sends, never fetches, and never calls a tool. Everything else on
+ * screen is text and local filtering.
+ *
+ * The dialog itself is the shared `Modal` primitive in headless mode, so the
+ * portal, the mask, Escape, the focus trap, and the reduced-motion rule all
+ * come from one place; this file only supplies the density of a 720px guide.
+ */
+import { useMemo, useState } from 'react'
+import type { ReactNode } from 'react'
+import { IconCloseOutlineRegular, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { Translate } from '@deepseek-ai/dsh-client-ui-slots'
+import { GUIDE } from './guide.generated.ts'
+import type { GuideFunction, GuideModule } from './types.ts'
+import type { PrefillResult } from './prefill.ts'
+import type { CapabilityMapKey } from './locales.ts'
+import css from './GuideMap.module.css'
+
+/** One module with the functions the current query kept. */
+export interface GuideMatch {
+  readonly module: GuideModule
+  readonly functions: readonly GuideFunction[]
+}
+
+/** Props of the panorama dialog. */
+export interface GuideMapProps {
+  /**
+   * Close the dialog (mask, Escape, the close control, or a successful fill).
+   * @param focus - who keeps the keyboard after the card is gone: the rail
+   *   control that opened it, or the composer a fill just wrote into.
+   */
+  readonly onClose: (focus?: 'trigger' | 'composer') => void
+  /** Put one phrase into the composer, unsent; see `prefill.ts`. */
+  readonly prefill: (phrase: string) => PrefillResult
+  /** Panel dictionary. */
+  readonly t: Translate<CapabilityMapKey>
+}
+
+/**
+ * Filter the guide locally. A module-name hit — Chinese or English — keeps all
+ * of its functions; a function-name or phrase hit keeps only the functions
+ * that matched.
+ * @param query - what the user typed; blank keeps everything.
+ * @returns matching modules in product order.
+ */
+export function filterGuide(query: string): GuideMatch[] {
+  const needle = query.trim().toLowerCase()
+  if (needle === '') return GUIDE.modules.map(module => ({ module, functions: module.functions }))
+  const matches: GuideMatch[] = []
+  for (const module of GUIDE.modules) {
+    if (module.name.toLowerCase().includes(needle)
+      || module.nameEn.toLowerCase().includes(needle)) {
+      matches.push({ module, functions: module.functions })
+      continue
+    }
+    const functions = module.functions.filter(fn =>
+      fn.name.toLowerCase().includes(needle) || fn.example.toLowerCase().includes(needle))
+    if (functions.length > 0) matches.push({ module, functions })
+  }
+  return matches
+}
+
+/**
+ * Render the panorama dialog content (the caller mounts it only while open).
+ * @param props - the close command, the prefill bridge, and the dictionary.
+ * @returns the dialog.
+ */
+export function GuideMap({ onClose, prefill, t }: GuideMapProps): ReactNode {
+  const [query, setQuery] = useState('')
+  const [selected, setSelected] = useState<string>(GUIDE.modules[0]?.id ?? '')
+  const [notice, setNotice] = useState<string | null>(null)
+  const matches = useMemo(() => filterGuide(query), [query])
+  // A query that drops the selected module falls back to the first hit, so
+  // the right pane is never a blank page beside a populated list.
+  const active = matches.find(match => match.module.id === selected) ?? matches[0]
+
+  const fill = (example: string): void => {
+    if (prefill(example) === 'filled') {
+      onClose('composer')
+      return
+    }
+    setNotice(t('guide.fillUnavailable'))
+  }
+
+  return (
+    <Modal headless open onClose={onClose} title={t('guide.title')} className={css.dialog ?? ''}>
+      <header className={css.header}>
+        <div className={css.headings}>
+          <h2 className={css.title}>{t('guide.title')}</h2>
+          <p className={css.subtitle}>{t('guide.subtitle')}</p>
+        </div>
+        <button type="button" className={css.iconButton} aria-label={t('guide.close')} onClick={() => { onClose() }}>
+          <IconCloseOutlineRegular size={16} />
+        </button>
+      </header>
+
+      <div className={css.searchRow}>
+        <input
+          type="search"
+          className={css.search}
+          data-modal-autofocus
+          value={query}
+          aria-label={t('guide.search')}
+          placeholder={t('guide.searchPlaceholder')}
+          onChange={(event) => { setQuery(event.target.value); setNotice(null) }}
+        />
+      </div>
+
+      <div className={css.main}>
+        <nav className={css.modules} aria-label={t('guide.modules')}>
+          <ul className={css.moduleList}>
+            {matches.map(({ module, functions }) => (
+              <li key={module.id}>
+                <button
+                  type="button"
+                  className={css.moduleButton}
+                  aria-pressed={module.id === active?.module.id}
+                  onClick={() => { setSelected(module.id); setNotice(null) }}
+                >
+                  <span className={css.moduleName}>{module.name}</span>
+                  <span className={css.moduleNameEn} data-module-en="">{module.nameEn}</span>
+                  <span className={css.moduleCount}>{t('guide.functionCount', { count: functions.length })}</span>
+                </button>
+              </li>
+            ))}
+          </ul>
+        </nav>
+
+        <section className={css.detail} aria-label={active?.module.name ?? t('guide.empty')}>
+          {active === undefined
+            ? (
+              <div className={css.empty} role="status">
+                <p className={css.emptyTitle}>{t('guide.empty')}</p>
+                <p className={css.emptyHint}>{t('guide.emptyHint')}</p>
+              </div>
+            )
+            : (
+              <>
+                <header className={css.detailHead}>
+                  <h3 className={css.detailTitle}>
+                    {active.module.name}
+                    <span className={css.detailTitleEn} data-module-en="">{active.module.nameEn}</span>
+                  </h3>
+                  <p className={css.detailSummary}>{active.module.summary}</p>
+                </header>
+                <ul className={css.cards}>
+                  {active.functions.map(fn => (
+                    <li key={fn.name} className={css.card}>
+                      <h4 className={css.cardTitle}>{fn.name}</h4>
+                      <p className={css.cardDetail}>{fn.detail}</p>
+                      <p className={css.example}>
+                        <span className={css.exampleLabel}>{t('guide.example')}</span>
+                        <span className={css.exampleText}>{fn.example}</span>
+                      </p>
+                      <button type="button" className={css.fill} onClick={() => { fill(fn.example) }}>
+                        {t('guide.fill')}
+                      </button>
+                    </li>
+                  ))}
+                </ul>
+              </>
+            )}
+        </section>
+      </div>
+
+      {notice !== null && <p className={css.notice} role="status">{notice}</p>}
+      <p className={css.note}>{t('guide.note')}</p>
+    </Modal>
+  )
+}
diff --git a/packages/client/ui-capability-map/src/client/NextSteps.module.css b/packages/client/ui-capability-map/src/client/NextSteps.module.css
new file mode 100644
index 00000000..58ceb50a
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/NextSteps.module.css
@@ -0,0 +1,198 @@
+/* Next-step cards under a finished answer (S6.6).
+ *
+ * Every colour is a theme token (`--dsw-*`), so the cards follow both
+ * appearances and the Daniel palette without a local colour. One card is the
+ * "do this first" suggestion: it carries a brand hairline on its left edge and
+ * a 优先 capsule, and it is always the first card (see `prioritizeNextSteps`).
+ * The only motion is the hover tint, removed under `prefers-reduced-motion`.
+ */
+
+.group {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 10px 0 2px;
+  min-width: 0;
+}
+
+.caption {
+  font-family: var(--dsw-font-family);
+  font-size: 11px;
+  line-height: 1.4;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.cards {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 8px;
+  min-width: 0;
+}
+
+/* One line per action: 46px tall, 12px radius, a module capsule on the left,
+ * the sentence in the middle, the fill hint on the right. The priority mark
+ * sits on the same line, before the hint, so nothing overlaps. */
+.card {
+  position: relative;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  box-sizing: border-box;
+  width: 100%;
+  max-width: 100%;
+  min-height: 46px;
+  margin: 0;
+  padding: 8px 12px;
+  border: 0.5px solid var(--dsw-alias-border-l2);
+  /* The product spec fixes the card radius at 12px (same value as
+   * `--dsw-radius-md`); it is written literally so the size is checkable. */
+  border-radius: 12px;
+  background: var(--dsw-alias-bg-layer-1);
+  color: var(--dsw-alias-label-primary);
+  font-family: var(--dsw-font-family);
+  font-size: 13px;
+  line-height: 1.5;
+  text-align: start;
+  cursor: pointer;
+  transition: background-color 120ms ease, border-color 120ms ease;
+}
+
+.card:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  border-color: var(--dsw-alias-border-l3);
+}
+
+.card:active {
+  background: var(--dsw-alias-interactive-bg-active);
+}
+
+.card:focus-visible {
+  outline: var(--dsw-focus-ring-width) solid var(--dsw-focus-ring-color);
+  outline-offset: 2px;
+}
+
+/* The priority card: a brand hairline on the left edge, a slightly stronger
+ * border, and the 优先 capsule after the sentence. One card only, by rule. */
+.card[data-priority='true']::before {
+  content: '';
+  position: absolute;
+  top: 9px;
+  bottom: 9px;
+  left: 0;
+  width: 2.5px;
+  border-radius: 0 2px 2px 0;
+  background: var(--dsw-alias-state-business-primary);
+}
+
+.card[data-priority='true'] {
+  border-color: var(--dsw-alias-border-l3);
+}
+
+.card[data-priority='true']:hover {
+  border-color: var(--dsw-alias-border-l4);
+}
+
+.module {
+  flex: none;
+  padding: 1px 8px;
+  border-radius: 999px;
+  background: var(--dsw-alias-markdown-tag);
+  color: var(--dsw-alias-label-secondary);
+  font-size: 12px;
+  line-height: 1.6;
+  white-space: nowrap;
+}
+
+.action {
+  flex: 1 1 auto;
+  min-width: 0;
+  color: var(--dsw-alias-label-primary);
+  font-size: 13px;
+  overflow-wrap: anywhere;
+}
+
+.priorityBadge {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  padding: 1px 7px;
+  border-radius: 999px;
+  background: var(--dsw-alias-state-business-tertiary);
+  color: var(--dsw-alias-state-business-primary);
+  font-size: 11px;
+  line-height: 1.6;
+  white-space: nowrap;
+}
+
+.hint {
+  flex: none;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+/* 写入类卡片的落点（§9.4）：工作区 › 品牌 › 名单，独占卡片第二行。 */
+.target {
+  flex: 1 1 100%;
+  min-width: 0;
+  color: var(--dsw-alias-label-tertiary);
+  font-size: 12px;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+
+.card[data-filled='true'] .target {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* Available to a screen reader and to tests; it never competes visually. */
+.srOnly {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+/* A card the user already filled is history, not an action: flat, muted, and
+ * it keeps the tab stop so focus is not dropped mid-keyboard. */
+.card[data-filled='true'] {
+  background: transparent;
+  border-color: var(--dsw-alias-border-l2);
+  color: var(--dsw-alias-label-tertiary);
+  cursor: default;
+}
+
+.card[data-filled='true'] .module {
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.card[data-filled='true'] .action {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.card[data-filled='true'] .priorityBadge {
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.card[data-filled='true']::before {
+  background: var(--dsw-alias-border-l2);
+}
+
+.card[data-filled='true']:hover {
+  background: transparent;
+  border-color: var(--dsw-alias-border-l2);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .card {
+    transition: none;
+  }
+}
diff --git a/packages/client/ui-capability-map/src/client/NextSteps.tsx b/packages/client/ui-capability-map/src/client/NextSteps.tsx
new file mode 100644
index 00000000..c5361fd1
--- /dev/null
+++ b/packages/client/ui-capability-map/src/client/NextSteps.tsx
@@ -0,0 +1,120 @@
+/**
+ * The clickable "next step" cards under a finished answer (S6.6).
+ *
+ * Seat: `conversation.chat.turnTail` — a list slot the Chat tail renders
+ * between a completed Turn's answer and its action row, so one Turn shows at
+ * most one group of cards and the cards scroll away with their message. The
+ * parser is pure (`next-steps.ts`); this file only maps its result to buttons.
+ *
+ * The one write on click is `prefill` (see `prefill.ts`): the action sentence
+ * lands in the composer, unsent, and focus returns to the editor. There is no
+ * submit/send path here, so a mis-click cannot post a message.
+ *
+ * Rendering is fail-closed: a Turn without a conforming "下一步" section, or an
+ * open Turn with no closing answer, renders `null` and occupies no space.
+ */
+import { useMemo, useState } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+// Type-only: pulls Chat's SlotMap entry for `conversation.chat.turnTail` and the
+// `turn-tail` Turn data (closing Assistant blocks) through the assembly boundary.
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+import { parseNextSteps, prioritizeNextSteps, writeTargetOf } from './next-steps.ts'
+import type { SelectionFeed } from './selection.ts'
+import type { PrefillResult } from './prefill.ts'
+import type { NS } from './locales.ts'
+import css from './NextSteps.module.css'
+
+/** The one write this plugin offers the cards: a composer draft, never a send. */
+export interface NextStepsInjected {
+  readonly hooks: {
+    /** Current explicit selection, for the write cards' landing target. */
+    readonly selection: SelectionFeed
+  }
+  /**
+   * Put one action sentence into the conversation composer, unsent.
+   * @param phrase - the parsed action sentence.
+   * @returns whether a composer accepted the draft.
+   */
+  readonly prefill: (phrase: string) => PrefillResult
+}
+
+/** Composed props of the `conversation.chat.turnTail` entry. */
+type NextStepsProps = PropsRuntime<'conversation.chat.turnTail'>
+  & InjectFace<NextStepsInjected>
+  & PropsLocale<typeof NS>
+
+/**
+ * Render a Turn's next-step cards.
+ * @param props - Turn location, the prefill bridge, and the dictionary.
+ * @returns one to two buttons, or null when the answer carries no next-step section.
+ */
+export function NextStepCards({ turn, prefill, useSelection, t }: NextStepsProps) {
+  // Never offer a step while the Turn is still open: the "last assistant
+  // message" of a running Turn is not final yet.
+  const closing = turn.end === undefined ? undefined : turn.data.get('turn-tail')?.closing
+  const steps = useMemo(() => {
+    if (closing === null || closing === undefined) return []
+    return prioritizeNextSteps(parseNextSteps(
+      closing.blocks.flatMap(block => (block.kind === 'text' ? [block.text] : [])).join(''),
+    ))
+  }, [closing])
+  const selection = useSelection(snapshot => snapshot)
+  const [filled, setFilled] = useState<readonly number[]>([])
+  if (steps.length === 0) return null
+  return (
+    <section className={css.group} aria-label={t('nextSteps.region')} data-next-steps>
+      <span className={css.caption}>{t('nextSteps.caption')}</span>
+      <div className={css.cards}>
+        {steps.map((step, index) => {
+          const done = filled.includes(index)
+          // A write card must say where it lands before the user clicks it:
+          // 工作区 › 品牌 › 名单, from the explicit selection (§9.4).
+          const target = writeTargetOf(step, {
+            ...selection.workspace === undefined ? {} : { workspace: selection.workspace.name },
+            ...selection.brand === undefined ? {} : { brand: selection.brand.name },
+          })
+          return (
+            <button
+              key={`${step.module}:${index}`}
+              type="button"
+              className={css.card}
+              data-next-step={index}
+              // At most one card is marked, and it is the first: the badge is
+              // a rule's verdict, not a guess about the model's tone.
+              data-priority={step.priority ? 'true' : undefined}
+              data-filled={done ? 'true' : undefined}
+              // A filled card stays focusable (unlike `disabled`), so the
+              // keyboard is not dropped when the composer takes it back.
+              aria-disabled={done || undefined}
+              onClick={() => {
+                if (done) return
+                if (prefill(step.action) === 'filled') setFilled(previous => [...previous, index])
+              }}
+            >
+              <span className={css.module}>{step.module}</span>
+              <span className={css.action}>{step.action}</span>
+              {target !== undefined && (
+                <span className={css.target} data-next-step-target="">
+                  {t('nextSteps.writeTarget', {
+                    target: [
+                      target.workspace ?? t('nextSteps.writeNoWorkspace'),
+                      target.brand ?? t('nextSteps.writeNoBrand'),
+                      ...target.list === undefined ? [] : [target.list],
+                    ].join(' › '),
+                  })}
+                </span>
+              )}
+              {step.priority && (
+                <span className={css.priorityBadge} data-priority-badge="">
+                  <span className={css.srOnly}>{t('nextSteps.priorityHint')}</span>
+                  {t('nextSteps.priority')}
+                </span>
+              )}
+              <span className={css.hint} aria-hidden="true">{done ? t('nextSteps.filled') : t('nextSteps.fill')}</span>
+            </button>
+          )
+        })}
+      </div>
+    </section>
+  )
+}
