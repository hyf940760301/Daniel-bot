+/* ── the rendered bar ───────────────────────────────────────────────────── */
+
+/** Storage stand-in so a test never leaks a remembered choice to another file. */
+function memoryStorage(initial?: { workspace: unknown; brand: unknown }): {
+  getItem: (key: string) => string | null
+  setItem: (key: string, value: string) => void
+} {
+  let value = initial === undefined ? null : JSON.stringify(initial)
+  return { getItem: () => value, setItem: (_key, next) => { value = next } }
+}
+
+/** Binding the renderer performs for one injected `hooks.*` feed. */
+function bind<T>(feed: { getSnapshot: () => T; subscribe: (listener: () => void) => () => void }) {
+  return (selector: (value: T) => unknown): unknown =>
+    useSyncExternalStore(feed.subscribe, () => selector(feed.getSnapshot()), () => selector(feed.getSnapshot()))
+}
+
+/**
+ * Render the bar with a real selection store over one fixed context snapshot.
+ * @param overrides - session-fold fields the fallback/mismatch logic reads.
+ * @param stored - a remembered pair to start from.
+ * @returns the rendered container.
+ */
+function renderBar(
+  overrides: Partial<ContextBarSnapshot> = {},
+  stored?: { workspace: WorkspaceOption; brand: BrandOption },
+): HTMLElement {
+  const snapshot = { ...EMPTY_CONTEXT, ...overrides }
+  const feed = { getSnapshot: () => snapshot, subscribe: () => () => {} }
+  const store = new ContextSelection({ feed, storage: memoryStorage(stored) })
+  const t = (key: string, values?: Record<string, string>): string => {
+    const text = (zh as Record<string, string>)[key] ?? key
+    return values === undefined ? text : text.replace(/\{(\w+)\}/gu, (_match, name: string) => values[name] ?? '')
+  }
+  const actions = {
+    setOpen: (kind: 'workspace' | 'brand' | undefined) => { store.setOpen(kind) },
+    chooseWorkspace: (id: number) => { store.chooseWorkspace(id) },
+    chooseBrand: (id: string) => { store.chooseBrand(id) },
+    refresh: () => {},
+    switchToDetected: () => { store.switchToDetected() },
+    keepDetected: () => { store.keepDetected() },
+    dismissKept: () => { store.dismissKept() },
+  }
+  const view = render(
+    <ContextBar
+      t={t as never}
+      useContext={bind(feed) as never}
+      useSelection={bind(store) as never}
+      actions={actions as never}
+    />,
+  )
+  return view.container
+}
