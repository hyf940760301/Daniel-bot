+ * @throws TypeError when the key length is wrong.
+ */
+export function aesGcmCipher(key: Uint8Array): CredentialCipher {
+  if (key.length !== AES_KEY_BYTES) {
+    throw new TypeError(`credentials-local: an AES-256-GCM key must be ${String(AES_KEY_BYTES)} bytes`)
+  }
+  const keyBytes = Buffer.from(key)
+  return {
+    scheme: 'aes-256-gcm',
+    seal: (plain) => {
+      const iv = randomBytes(AES_IV_BYTES)
+      const cipher = createCipheriv('aes-256-gcm', keyBytes, iv)
+      const ciphertext = Buffer.concat([cipher.update(plain, 'utf8'), cipher.final()])
+      return Buffer.concat([iv, cipher.getAuthTag(), ciphertext])
+    },
+    open: (payload) => {
+      const bytes = Buffer.from(payload)
+      if (bytes.length < AES_IV_BYTES + AES_TAG_BYTES) throw new Error('sealed value is shorter than its nonce and tag')
+      const iv = bytes.subarray(0, AES_IV_BYTES)
+      const tag = bytes.subarray(AES_IV_BYTES, AES_IV_BYTES + AES_TAG_BYTES)
+      const ciphertext = bytes.subarray(AES_IV_BYTES + AES_TAG_BYTES)
+      const decipher = createDecipheriv('aes-256-gcm', keyBytes, iv)
+      decipher.setAuthTag(tag)
+      return Buffer.concat([decipher.update(ciphertext), decipher.final()]).toString('utf8')
+    },
+  }
+}
+
+/** The key file that belongs to one document: `<document>.key`. */
+export function keyFileFor(documentPath: string): string {
+  return `${documentPath}${KEY_FILE_SUFFIX}`
+}
+
+/** Decode and validate a key file's content; a damaged key must not be silently replaced. */
+function parseKey(text: string, keyFile: string): Buffer {
+  const key = Buffer.from(text.trim(), 'base64')
+  if (key.length !== AES_KEY_BYTES) {
+    throw new Error(`credentials-local: ${keyFile} does not hold a ${String(AES_KEY_BYTES)}-byte key`)
+  }
+  return key
+}
+
+/** Refuse a key file other OS users can read; the sibling document already refuses one. */
+async function assertOwnerOnlyKey(keyFile: string): Promise<void> {
+  /* v8 ignore next -- Windows has no POSIX mode to inspect and no chmod to enforce. */
+  if (process.platform === 'win32') return
+  const mode = (await stat(keyFile)).mode
+  if ((mode & GROUP_OTHER_BITS) === 0) return
+  throw new Error(
+    `credentials-local: ${keyFile} is readable beyond its owner (mode ${(mode & 0o777).toString(8)});`
+    + ` run "chmod 600 ${keyFile}" before starting again`,
+  )
+}
+
+/**
+ * Read the document's key file, creating it at `0600` with fresh random bytes
+ * when it does not exist yet. Creation is `wx`, so two boots racing the first
+ * write cannot mint two keys over one document: the loser re-reads the winner's
+ * file. A damaged file is an error rather than a rotation, because rotating it
+ * would silently orphan every value already sealed under that key.
+ * @param documentPath - the credentials document the key belongs to.
+ * @returns the 32-byte key.
+ */
+export async function loadOrCreateKeyFile(documentPath: string): Promise<Buffer> {
+  const keyFile = keyFileFor(documentPath)
+  try {
+    await assertOwnerOnlyKey(keyFile)
+    return parseKey(await readFile(keyFile, 'utf8'), keyFile)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException | null)?.code !== 'ENOENT') throw error
+  }
+  await mkdir(dirname(keyFile), { recursive: true, mode: 0o700 })
+  const key = randomBytes(AES_KEY_BYTES)
+  try {
+    await writeFile(keyFile, key.toString('base64'), { flag: 'wx', mode: 0o600 })
+    return key
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException | null)?.code !== 'EEXIST') throw error
+    // Another process minted the key between the read and this create.
+    return parseKey(await readFile(keyFile, 'utf8'), keyFile)
+  }
+}
+
+/**
+ * Read an existing key file for decryption without creating one. A missing
+ * file is the ordinary "nothing was ever sealed here" case, not a failure.
+ * @param documentPath - the credentials document the key belongs to.
+ * @returns the key, or `undefined` when the file is absent.
+ */
+export async function loadKeyFileIfPresent(documentPath: string): Promise<Buffer | undefined> {
+  const keyFile = keyFileFor(documentPath)
+  try {
+    await assertOwnerOnlyKey(keyFile)
+    return parseKey(await readFile(keyFile, 'utf8'), keyFile)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException | null)?.code === 'ENOENT') return undefined
+    throw error
+  }
+}
+
+/**
+ * Load Electron's `safeStorage` when this process is Electron's browser
+ * process. Everywhere else — a plain Node process, or the Electron Node-mode
+ * child that actually hosts this provider — the module has no `safeStorage`,
+ * and the platform check below reports that instead of throwing. A false
+ * `isEncryptionAvailable()` is the adhoc-signed/hostile-keychain case: the
+ * caller must fall back, never pretend.
+ * @returns the usable slice, or `undefined`.
+ */
+export async function loadSafeStorage(): Promise<SafeStorageLike | undefined> {
+  try {
+    // A non-literal specifier: the import must not be resolved or bundled at
+    // build time, because most hosts (this one included) have no Electron
+    // module at all, and the ones that do expose it only in the browser process.
+    const electronModule = 'electron'
+    const module = await import(electronModule) as { safeStorage?: SafeStorageLike }
+    const safe = module.safeStorage
+    if (safe === undefined || typeof safe.isEncryptionAvailable !== 'function') return undefined
+    return safe.isEncryptionAvailable() ? safe : undefined
+  } catch {
+    // No Electron module (plain Node), or an import shim that refuses: both
+    // mean "this process cannot use safeStorage".
+    return undefined
+  }
+}
+
+/** Options for {@link resolveSealer}; every probe is injectable for tests. */
+export interface SealerOptions {
+  /** The credentials document the key file sits beside. */
+  readonly documentPath: string
+  /** A `safeStorage` slice to prefer; defaults to {@link loadSafeStorage}. */
+  readonly safeStorage?: SafeStorageLike | undefined
+  /** Loader replacing the Electron probe entirely (tests and embedders). */
+  readonly probeSafeStorage?: (() => Promise<SafeStorageLike | undefined>) | undefined
+}
+
+/** Resolve the cipher list a document can use in this process. */
+async function resolveCipherList(options: SealerOptions): Promise<{ ciphers: CredentialCipher[]; reason?: string }> {
+  const ciphers: CredentialCipher[] = []
+  let reason: string | undefined
+  let safe: SafeStorageLike | undefined
+  try {
+    safe = options.safeStorage ?? await (options.probeSafeStorage ?? loadSafeStorage)()
+  } catch (error) {
+    reason = `safeStorage 探测失败：${error instanceof Error ? error.message : 'unknown'}`
+    safe = undefined
+  }
+  if (safe !== undefined) ciphers.push(safeStorageCipher(safe))
+  // An existing key file is always a decryption candidate, so a document
+  // sealed before safeStorage became available is not stranded.
+  try {
+    const existing = await loadKeyFileIfPresent(options.documentPath)
+    if (existing !== undefined) ciphers.push(aesGcmCipher(existing))
+  } catch (error) {
+    // A damaged or over-readable key file is reported, never deleted: it is
+    // the only thing that can open the values already on disk.
+    reason = error instanceof Error ? error.message : String(error)
+  }
+  if (ciphers.length === 0) {
+    // Nothing to decrypt or encrypt with: mint the fallback key beside the
+    // document, at 0600, so writes still land sealed.
+    try {
+      ciphers.push(aesGcmCipher(await loadOrCreateKeyFile(options.documentPath)))
+    } catch (error) {
+      reason = error instanceof Error ? error.message : String(error)
+    }
+  }
+  return reason === undefined ? { ciphers } : { ciphers, reason }
+}
+
+/**
+ * Resolve the seal an environment can offer, preferring Electron's
+ * OS-keychain-backed `safeStorage` and falling back to AES-256-GCM with a
+ * 0600 key file beside the document. Never returns a plaintext mode: when
+ * neither works the sealer reports itself unavailable and writes are refused.
+ * @param options - document path and optional probes.
+ * @returns the sealer; `available` is false when no cipher resolved.
+ */
+export async function resolveSealer(options: SealerOptions): Promise<CredentialSealer> {
+  const { ciphers, reason } = await resolveCipherList(options)
+  const unavailable = reason ?? `无法在 ${dirname(options.documentPath)} 写入加密密钥文件`
+  return new CredentialSealer(ciphers, unavailable)
+}
