+// @vitest-environment jsdom
+import { readFileSync } from 'node:fs'
+import { apply as applyMenus, inject as injectMenus } from '@deepseek-ai/dsh-client-ui-context-menu/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+/**
+ * Removal through the assembled browser on SlotTestRuntime (real apply, real
+ * WorkspaceBrowser, the real context-menu plugin, the shipped row actions and
+ * overlay surfaces): the row's "..." trigger → the shared menu's 移除会话 row →
+ * the archival confirmation in `shell.overlay` → the existing archive hop
+ * (`uiWorkspace.archiveSession` → `workspaces.archiveSession`) → the row leaves
+ * the default list and the archived set keeps it recoverable. The data-level
+ * entries live in session-menu-actions.client.spec, the dialog's own arms in
+ * session-actions.client.spec, and Host rejection in apply.client.spec.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, waitFor, within } from '@testing-library/react'
+import type { WorkspaceId } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { PropsRenderSlots } from '@deepseek-ai/dsh-client-ui-slots'
+import { SlotTestRuntime, usePinnedBrowserLanguages } from '@deepseek-ai/dsh-client-test-runtime'
+import { COMMON_NS, LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-workspace/client'
+
+// The service reads its initial locale from the browser; these specs assert
+// the shipped Chinese copy, so they state the browser they assume.
+usePinnedBrowserLanguages('zh-CN')
+
+const SID = 's1' as SessionId
+const TITLE = '待移除会话'
+const TRIGGER = `会话“${TITLE}”的操作`
+
+afterEach(cleanup)
+beforeEach(() => { localStorage.clear() })
+
+/** Runtime with the locale face installed (the browser entry declares `locale:` — zh default backs the t seat). */
+async function createRuntime(): Promise<SlotTestRuntime> {
+  const runtime = await SlotTestRuntime.create()
+  runtime.ctx.provide('shortcuts', { register: () => () => {}, catalog: createSnapshotStore([]) })
+  runtime.ctx.provide('layout', { selectPanel: vi.fn(), beginNavigation: () => new AbortController().signal })
+  runtime.releaseWorkspaceSource()
+  // Removal never picks a directory; the namespace only has to be there
+  // for ui-workspace's inject to settle.
+  runtime.remote.provideNamespaces({ directoryPicker: {} })
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  // The dialog's Cancel/close vocabulary is the shared common namespace; the
+  // real shell registers it in the locale plugin this harness leaves out.
+  locale.register(COMMON_NS, { zh: commonZh, en: commonEn })
+  runtime.slots.installLocale(locale)
+  await runtime.mount({ inject: [...injectMenus], apply: applyMenus })
+  return runtime
+}
+
+/** Test-owned shell role: declares and renders the browsing region and the frame-wide overlay list. */
+type FrameProps = PropsRenderSlots<'sidebar.workspaces' | 'shell.overlay'>
+function SidebarFrame({ renderSlot }: FrameProps) {
+  return (
+    <>
+      {renderSlot('sidebar.workspaces', { wide: true, expandSidebar: () => {} })}
+      {renderSlot('shell.overlay', {})}
+    </>
+  )
+}
+
+/** Declare the sidebar hole and the overlay list the confirmation and notices mount in. */
+async function declareFrame(runtime: SlotTestRuntime): Promise<void> {
+  await runtime.root.declare(
+    {
+      'sidebar.workspaces': { kind: 'single', scope: 'root' },
+      'shell.overlay': { kind: 'list', scope: 'root' },
+    } as never,
+    SidebarFrame as never,
+  )
+}
+
+/**
+ * One current Session in one Workspace with the whole feature mounted over
+ * it, in the order the rename assembly uses: fixtures, declarations, apply.
+ * @param options - seed a Session whose turn still runs.
+ * @returns the mounted runtime.
+ */
+async function setup(options: { running?: boolean } = {}): Promise<SlotTestRuntime> {
+  const runtime = await createRuntime()
+  await runtime.sessions.add({
+    id: SID,
+    summary: {
+      title: TITLE, displayTitle: TITLE, cwd: '/w/alpha',
+      ...options.running === true ? { running: true } : {},
+    },
+    session: { rename: vi.fn() },
+  })
+  await runtime.sessions.retainFor(runtime.ctx, SID, { source: 'mainView' }).ready
+  await runtime.workspaces.update((draft) => {
+    draft.items = [{
+      workspaceId: 'w1' as WorkspaceId, title: 'alpha', path: '/w/alpha',
+      sessionIds: [SID], createdAt: '2026-01-01T00:00:00.000Z', updatedAt: '2026-01-01T00:00:00.000Z',
+    }] as never
+  })
+  await declareFrame(runtime)
+  await runtime.mount({ inject: [...inject], apply })
+  await runtime.flush()
+  return runtime
+}
+
+/** Open the current row's action menu exactly as a pointer does. */
+async function openRowMenu(runtime: SlotTestRuntime) {
+  const view = runtime.renderRoot()
+  const row = (await view.findByText(TITLE)).closest('[role="treeitem"]') as HTMLElement
+  fireEvent.click(within(row).getByLabelText(TRIGGER))
+  await view.findByRole('menu')
+  return view
+}
+
+/** Let the dialog's own async settlement land before the runtime is torn down. */
+async function settle(runtime: SlotTestRuntime): Promise<void> {
+  await act(async () => { await Promise.resolve() })
+  await runtime.flush()
+}
+
+/** The archive-hop calls the Host recorded (setup calls are irrelevant here). */
+function archiveCalls(runtime: SlotTestRuntime) {
+  return runtime.workspaces.calls.filter(call => call.method === 'archiveSession')
+}
+
+describe('session removal through the assembled browser', () => {
+  it('offers 移除会话 as the last row action and asks with the archival copy before doing anything', async () => {
+    const runtime = await setup()
+    const view = await openRowMenu(runtime)
+
+    // Existing rows keep their order; removal closes the menu.
+    expect(view.getAllByRole('menuitem').map(item => item.textContent)).toEqual([
+      '置顶会话', '重命名', '分叉会话', '复制 Session ID', '归档会话', '移除会话',
+    ])
+    fireEvent.click(view.getByRole('menuitem', { name: '移除会话' }))
+
+    const dialog = await view.findByRole('dialog', { name: '移除这个会话？' })
+    expect(dialog.textContent).toContain('移除后会从列表消失，可在归档中找回。')
+    // Cancel is the initial focus of a destructive question.
+    expect(within(dialog).getByRole('button', { name: '取消' })).toBe(document.activeElement)
+    expect(within(dialog).getByRole('button', { name: '移除' })).toBeTruthy()
+    // The removal question lists no work: it stops nothing.
+    expect(within(dialog).queryByRole('list')).toBeNull()
+    // Opening the question archives nothing.
+    expect(archiveCalls(runtime)).toHaveLength(0)
+    expect(runtime.workspaces.list.getSnapshot().archivedSessionIds).not.toContain(SID)
+    await runtime.dispose()
+  })
+
+  it('cancelling archives nothing and keeps the row', async () => {
+    const runtime = await setup()
+    const view = await openRowMenu(runtime)
+    fireEvent.click(view.getByRole('menuitem', { name: '移除会话' }))
+    const dialog = await view.findByRole('dialog', { name: '移除这个会话？' })
+    fireEvent.click(within(dialog).getByRole('button', { name: '取消' }))
+
+    await waitFor(() => { expect(view.queryByRole('dialog')).toBeNull() })
+    // 取消不删：the Host was never asked, the archive set is unchanged, the row stays.
+    expect(archiveCalls(runtime)).toHaveLength(0)
+    expect(runtime.workspaces.list.getSnapshot().archivedSessionIds).not.toContain(SID)
+    expect(view.getByText(TITLE)).toBeTruthy()
+    await runtime.dispose()
+  })
+
+  it('confirming archives the session and the row leaves the list', async () => {
+    const runtime = await setup()
+    const view = await openRowMenu(runtime)
+    fireEvent.click(view.getByRole('menuitem', { name: '移除会话' }))
+    const dialog = await view.findByRole('dialog', { name: '移除这个会话？' })
+    await act(async () => {
+      fireEvent.click(within(dialog).getByRole('button', { name: '移除' }))
+    })
+
+    // 确认才删：the row disappears through the existing archive hop.
+    await waitFor(() => { expect(view.queryByText(TITLE)).toBeNull() })
+    await waitFor(() => { expect(view.queryByRole('dialog')).toBeNull() })
+    expect(archiveCalls(runtime)).toEqual([{ method: 'archiveSession', args: [SID] }])
+    // Removal is archival: the id sits in the archived set, not a deleted log.
+    expect(runtime.workspaces.list.getSnapshot().archivedSessionIds).toContain(SID)
+    await settle(runtime)
+    await runtime.dispose()
+  })
+
+  it('Escape closes the menu and returns focus to the row actions trigger', async () => {
+    const runtime = await setup()
+    const view = runtime.renderRoot()
+    const row = (await view.findByText(TITLE)).closest('[role="treeitem"]') as HTMLElement
+    const trigger = within(row).getByLabelText(TRIGGER)
+    fireEvent.click(trigger)
+    await view.findByRole('menu')
+    expect(document.activeElement).not.toBe(trigger)
+    fireEvent.keyDown(document.activeElement!, { key: 'Escape' })
+    await waitFor(() => { expect(view.queryByRole('menu')).toBeNull() })
+    expect(document.activeElement).toBe(trigger)
+    await runtime.dispose()
+  })
+
+  it('walks the menu by keyboard to the removal row, whose native button opens the question', async () => {
+    const runtime = await setup()
+    const view = await openRowMenu(runtime)
+    // Down walks the rows; End reaches the removal row (the menu's last).
+    fireEvent.keyDown(document.activeElement!, { key: 'ArrowDown' })
+    expect(document.activeElement?.textContent).toBe('重命名')
+    fireEvent.keyDown(document.activeElement!, { key: 'End' })
+    const remove = view.getByRole('menuitem', { name: '移除会话' })
+    expect(document.activeElement).toBe(remove)
+    // Enter activates a focused native button in the browser; the row is one,
+    // and that activation is what opens the question.
+    expect(remove.tagName).toBe('BUTTON')
+    fireEvent.click(remove)
+    expect(await view.findByRole('dialog', { name: '移除这个会话？' })).toBeTruthy()
+    await runtime.dispose()
+  })
+
+  it('disables removal while the session runs and says why', async () => {
+    const runtime = await setup({ running: true })
+    const view = await openRowMenu(runtime)
+    // The menu row still names the action and explains the refusal in place;
+    // activating it can neither archive nor ask.
+    const disabled = view.getByRole('menuitem', { name: '移除会话（会话运行中，需先停止）' })
+    expect(disabled.hasAttribute('disabled') || disabled.getAttribute('aria-disabled') === 'true').toBe(true)
+    fireEvent.click(disabled)
+    expect(view.queryByRole('dialog')).toBeNull()
+    expect(archiveCalls(runtime)).toHaveLength(0)
+    await runtime.dispose()
+  })
+
+  it('re-asks after a cancelled question', async () => {
+    const runtime = await setup()
+    const view = await openRowMenu(runtime)
+    fireEvent.click(view.getByRole('menuitem', { name: '移除会话' }))
+    await view.findByRole('dialog', { name: '移除这个会话？' })
+    fireEvent.keyDown(document, { key: 'Escape' })
+    await waitFor(() => { expect(view.queryByRole('dialog')).toBeNull() })
+    expect(archiveCalls(runtime)).toHaveLength(0)
+
+    const row = view.getByText(TITLE).closest('[role="treeitem"]') as HTMLElement
+    fireEvent.click(within(row).getByLabelText(TRIGGER))
+    fireEvent.click(await view.findByRole('menuitem', { name: '移除会话' }))
+    expect(await view.findByRole('dialog', { name: '移除这个会话？' })).toBeTruthy()
+    await act(async () => { await Promise.resolve() })
+    await runtime.dispose()
+  })
+})
+
+describe('removal trigger styling', () => {
+  it('keeps the hover trigger hidden until the row is hovered, focused, or its menu is open', () => {
+    const css = readFileSync('packages/client/ui-workspace/src/client/rows/Rows.module.css', 'utf8')
+      .replace(/\/\*[\s\S]*?\*\//g, ' ')
+    // The strip rests hidden; one hover/focus/menu state reveals it, so the
+    // "..." button and the quick actions share the row's existing style.
+    expect(/\.rowActions\s*\{[^}]*display:\s*none/.test(css)).toBe(true)
+    const reveal = /\.sessionRow:hover \.rowActions,[^{]*\{([^}]*)\}/.exec(css)
+    expect(reveal).not.toBeNull()
+    expect(reveal?.[0]).toContain('.sessionRow.menuOpen .rowActions')
+    expect(reveal?.[0]).toContain(":global(html[data-input-modality='keyboard']) .sessionRow:focus-within .rowActions")
+    expect(reveal?.[1]).toContain('display: inline-flex')
+    // The title keeps its own lane and its resting ellipsis.
+    expect(/\.title\s*\{[^}]*min-width:\s*0/.test(css)).toBe(true)
+    expect(/\.title\s*\{[^}]*text-overflow:\s*ellipsis/.test(css)).toBe(true)
+  })
+})
