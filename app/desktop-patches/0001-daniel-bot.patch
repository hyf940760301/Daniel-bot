+// At-rest sealing: the envelope format, both ciphers, boot migration of a
+// legacy plaintext document, the refusal that replaces a plaintext fallback,
+// and the promise that no diagnostic ever quotes a stored value.
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { chmod, mkdtemp, readFile, rm, stat, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { credentialKey, credentialRef } from '@deepseek-ai/dsh-credentials'
+import { LocalCredentialProvider } from '../src/index.ts'
+import {
+  CredentialDecryptionError,
+  CredentialEncryptionUnavailableError,
+  CredentialSealer,
+  SEALED_PREFIX,
+  aesGcmCipher,
+  keyFileFor,
+  loadOrCreateKeyFile,
+  resolveSealer,
+  safeStorageCipher,
+} from '../src/sealing.ts'
+
+const cleanups: Array<() => Promise<void>> = []
+
+afterEach(async () => {
+  while (cleanups.length > 0) await cleanups.pop()!()
+})
+
+async function tempDir(): Promise<string> {
+  const dir = await mkdtemp(join(tmpdir(), 'dsh-cred-sealing-'))
+  cleanups.push(() => rm(dir, { recursive: true, force: true }))
+  return dir
+}
+
+async function boot(config: ConstructorParameters<typeof LocalCredentialProvider>[1]): Promise<Context> {
+  const ctx = new Context()
+  const fiber = ctx.plugin(LocalCredentialProvider, config)
+  cleanups.push(async () => { await fiber.dispose() })
+  await fiber
+  return ctx
+}
+
+function writeCredentials(file: string, text: string): Promise<void> {
+  return writeFile(file, text, { mode: 0o600 })
+}
+
+/** Every sealed envelope in a document, for assertions about what reached disk. */
+const ENVELOPE = /v1:[A-Za-z0-9+/=]+/g
+
+describe('envelope format', () => {
+  it('seals and opens a value, and the stored envelope is self-describing', async () => {
+    const dir = await tempDir()
+    const sealer = await resolveSealer({ documentPath: join(dir, '.credentials.yaml') })
+    expect(sealer.available).toBe(true)
+    expect(sealer.scheme).toBe('aes-256-gcm')
+    const token = sealer.seal('sk-round-trip-value')
+    expect(token.startsWith(SEALED_PREFIX)).toBe(true)
+    // One scheme byte, then the AES-GCM nonce + tag + ciphertext.
+    expect(Buffer.from(token.slice(SEALED_PREFIX.length), 'base64')[0]).toBe(2)
+    expect(sealer.open(token)).toBe('sk-round-trip-value')
+  })
+
+  it('never spells the plaintext in the envelope', async () => {
+    const dir = await tempDir()
+    const sealer = await resolveSealer({ documentPath: join(dir, '.credentials.yaml') })
+    const token = sealer.seal('sk-plaintext-must-not-appear')
+    expect(token).not.toContain('sk-plaintext-must-not-appear')
+    expect(Buffer.from(token.slice(SEALED_PREFIX.length), 'base64').toString('utf8'))
+      .not.toContain('sk-plaintext-must-not-appear')
+  })
+
+  it('rejects a tampered envelope with the actionable error and quotes no value', async () => {
+    const dir = await tempDir()
+    const sealer = await resolveSealer({ documentPath: join(dir, '.credentials.yaml') })
+    const token = sealer.seal('sk-tamper-target')
+    const bytes = Buffer.from(token.slice(SEALED_PREFIX.length), 'base64')
+    // Flip one ciphertext bit: the GCM tag must refuse the result rather than
+    // decrypt into garbage.
+    bytes[bytes.length - 1] = bytes[bytes.length - 1]! ^ 0xff
+    const tampered = SEALED_PREFIX + bytes.toString('base64')
+    expect(() => sealer.open(tampered)).toThrow(/凭据无法解密，请重新输入 API Key/)
+    expect(() => sealer.open(tampered)).toThrow(CredentialDecryptionError)
+  })
+
+  it('refuses an envelope that claims a scheme this process does not have', async () => {
+    const dir = await tempDir()
+    const sealer = await resolveSealer({ documentPath: join(dir, '.credentials.yaml') })
+    const wrong = `${SEALED_PREFIX}${Buffer.from([9, 1, 2, 3]).toString('base64')}`
+    expect(() => sealer.open(wrong)).toThrow(/没有可用的解密方案/)
+  })
+
+  it('uses safeStorage when the environment offers it', () => {
+    const store = new Map<string, string>()
+    const fake = {
+      isEncryptionAvailable: () => true,
+      encryptString: (plain: string) => {
+        const token = Buffer.from(`os:${plain}`)
+        store.set(token.toString('base64'), plain)
+        return token
+      },
+      decryptString: (encrypted: Buffer) => {
+        const plain = store.get(encrypted.toString('base64'))
+        if (plain === undefined) throw new Error('keychain refused')
+        return plain
+      },
+    }
+    const sealer = new CredentialSealer([safeStorageCipher(fake), aesGcmCipher(Buffer.alloc(32, 7))])
+    expect(sealer.scheme).toBe('safe-storage')
+    const token = sealer.seal('sk-keychain')
+    expect(Buffer.from(token.slice(SEALED_PREFIX.length), 'base64')[0]).toBe(1)
+    expect(sealer.open(token)).toBe('sk-keychain')
+    expect(token).not.toContain('sk-keychain')
+  })
+
+  it('reports itself unavailable instead of offering a plaintext mode', () => {
+    const sealer = new CredentialSealer([], '测试环境没有可用的加密方案')
+    expect(sealer.available).toBe(false)
+    expect(() => sealer.seal('sk-nope')).toThrow(CredentialEncryptionUnavailableError)
+    expect(() => sealer.seal('sk-nope')).toThrow(/不会把 API Key 明文写入磁盘/)
+  })
+
+  it('creates the key file owner-only', async () => {
+    const dir = await tempDir()
+    const key = await loadOrCreateKeyFile(join(dir, '.credentials.yaml'))
+    expect(key).toHaveLength(32)
+    if (process.platform !== 'win32') {
+      expect((await stat(keyFileFor(join(dir, '.credentials.yaml')))).mode & 0o777).toBe(0o600)
+    }
+  })
+})
+
+describe('provider at-rest sealing', () => {
+  it('migrates a plaintext document to sealed values, preserving every value', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    const original = {
+      'DSH_SEAL_ONE': 'sk-migrated-one',
+      'DSH_SEAL_TWO': 'line one\nline two',
+    }
+    await writeCredentials(path, `version: 1\nrefs:\n  # keep me\n  DSH_SEAL_ONE: ${JSON.stringify(original.DSH_SEAL_ONE)}\n`
+      + `  DSH_SEAL_TWO: ${JSON.stringify(original['DSH_SEAL_TWO'])}\n`)
+    const ctx = await boot({ path, watch: false })
+
+    const text = await readFile(path, 'utf8')
+    expect(text).toContain('# keep me')
+    // Nothing plaintext survives, and every value still resolves exactly.
+    expect(text).not.toContain('sk-migrated-one')
+    expect(text).not.toContain('line one')
+    expect(text.match(ENVELOPE)).toHaveLength(2)
+    expect(await ctx.credentials.resolve(credentialRef('DSH_SEAL_ONE')))
+      .toEqual({ value: 'sk-migrated-one', source: 'file' })
+    expect(await ctx.credentials.resolve(credentialRef('DSH_SEAL_TWO')))
+      .toEqual({ value: 'line one\nline two', source: 'file' })
+    if (process.platform !== 'win32') expect((await stat(path)).mode & 0o777).toBe(0o600)
+  })
+
+  it('is idempotent: a second boot does not rewrite a sealed document', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    await writeCredentials(path, 'version: 1\nrefs:\n  DSH_SEAL_ONE: sk-first\n')
+    await boot({ path, watch: false })
+    const afterFirst = await readFile(path, 'utf8')
+    const ctx = await boot({ path, watch: false })
+    expect(await readFile(path, 'utf8')).toBe(afterFirst)
+    expect(await ctx.credentials.resolve(credentialRef('DSH_SEAL_ONE')))
+      .toEqual({ value: 'sk-first', source: 'file' })
+  })
+
+  it('seals record secrets: an api-key key and env, and a grant payload', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    const ctx = await boot({ path, watch: false })
+    const bedrock = credentialKey('llm-pi-ai', 'amazon-bedrock')
+    const codex = credentialKey('llm-pi-ai', 'openai-codex')
+    await ctx.credentials.modifyRecord(bedrock, async () => ({
+      kind: 'api-key',
+      key: 'sk-bedrock-secret',
+      env: { AWS_PROFILE: 'prod-profile' },
+    }))
+    await ctx.credentials.modifyRecord(codex, async () => ({
+      kind: 'grant',
+      payload: { token: 'grant-secret-value' },
+    }))
+
+    const text = await readFile(path, 'utf8')
+    expect(text).not.toContain('sk-bedrock-secret')
+    expect(text).not.toContain('prod-profile')
+    expect(text).not.toContain('grant-secret-value')
+    expect(await ctx.credentials.readRecord(bedrock)).toEqual({
+      kind: 'api-key',
+      key: 'sk-bedrock-secret',
+      env: { AWS_PROFILE: 'prod-profile' },
+    })
+    expect(await ctx.credentials.readRecord(codex)).toEqual({
+      kind: 'grant',
+      payload: { token: 'grant-secret-value' },
+    })
+  })
+
+  it('refuses writes when encryption is unavailable, and leaves the plaintext file alone', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    const text = 'version: 1\nrefs:\n  DSH_SEAL_ONE: sk-existing\n'
+    await writeCredentials(path, text)
+    // A damaged key file disables the only cipher this process has; the
+    // provider must neither migrate to plaintext nor write one.
+    await writeFile(keyFileFor(path), 'not-a-valid-key', { mode: 0o600 })
+    const ctx = new Context()
+    const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => {})
+    const fiber = ctx.plugin(LocalCredentialProvider, { path, watch: false })
+    cleanups.push(async () => { await fiber.dispose() })
+    await fiber
+
+    expect(await ctx.credentials.describe(credentialRef('DSH_SEAL_ONE')))
+      .toEqual({ configured: true, source: 'file', writable: false })
+    await expect(ctx.credentials.set(credentialRef('DSH_SEAL_TWO'), 'sk-new'))
+      .rejects.toThrow(/凭据无法加密保存/)
+    expect(await readFile(path, 'utf8')).toBe(text)
+    expect(warn.mock.calls.some(call => String(call[0]).includes('加密不可用'))).toBe(true)
+  })
+
+  it('keeps the original file and warns when the sealed rewrite cannot be written', async () => {
+    if (process.platform === 'win32') return
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    const text = 'version: 1\nrefs:\n  DSH_SEAL_ONE: sk-unwritable\n'
+    await writeCredentials(path, text)
+    // A valid key exists, so the sealer is available and migration is
+    // attempted; the directory then refuses the temp file that the atomic
+    // replace needs before its rename.
+    await loadOrCreateKeyFile(path)
+    await chmod(dir, 0o500)
+    try {
+      const ctx = new Context()
+      const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => {})
+      const fiber = ctx.plugin(LocalCredentialProvider, { path, watch: false })
+      cleanups.push(async () => { await fiber.dispose() })
+      await fiber
+      expect(await readFile(path, 'utf8')).toBe(text)
+      expect(warn.mock.calls.some(call => String(call[0]).includes('sealing migration failed'))).toBe(true)
+      // Boot is not blocked: the legacy plaintext value still resolves.
+      expect(await ctx.credentials.resolve(credentialRef('DSH_SEAL_ONE')))
+        .toEqual({ value: 'sk-unwritable', source: 'file' })
+    } finally {
+      await chmod(dir, 0o700)
+    }
+  })
+
+  it('keeps the old document intact when an atomic commit fails', async () => {
+    if (process.platform === 'win32') return
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    const ctx = await boot({ path, watch: false })
+    await ctx.credentials.set(credentialRef('DSH_SEAL_ONE'), 'sk-committed')
+    const before = await readFile(path, 'utf8')
+    await chmod(dir, 0o500)
+    try {
+      await expect(ctx.credentials.set(credentialRef('DSH_SEAL_TWO'), 'sk-lost'))
+        .rejects.toThrow()
+    } finally {
+      await chmod(dir, 0o700)
+    }
+    expect(await readFile(path, 'utf8')).toBe(before)
+    expect(await ctx.credentials.resolve(credentialRef('DSH_SEAL_ONE')))
+      .toEqual({ value: 'sk-committed', source: 'file' })
+  })
+
+  it('fails boot with the actionable decryption error when the value cannot be opened', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    // Seal one value under a key, then swap the key file: the tag mismatch is
+    // the "another keychain, another key" case. The provider must report it
+    // and must not serve ciphertext or plaintext instead.
+    await boot({ path, watch: false })
+    const sealed = new CredentialSealer([aesGcmCipher(Buffer.alloc(32, 3))]).seal('sk-other-key')
+    await writeFile(path, `version: 1\nrefs:\n  DSH_SEAL_ONE: ${sealed}\n`, { mode: 0o600 })
+    // The key file stays the one the first boot minted, so the tag cannot match.
+    const ctx = new Context()
+    const failure = await ctx.plugin(LocalCredentialProvider, { path, watch: false })
+      .then(() => undefined, (error: unknown) => error)
+    expect(failure).toBeInstanceOf(Error)
+    expect((failure as Error).message).toContain('凭据无法解密，请重新输入 API Key')
+    await expect(readFile(path, 'utf8')).resolves.toContain(sealed)
+  })
+
+  it('logs no stored value while migrating', async () => {
+    const dir = await tempDir()
+    const path = join(dir, '.credentials.yaml')
+    await writeCredentials(path, 'version: 1\nrefs:\n  DSH_SEAL_ONE: sk-never-in-logs\n')
+    const ctx = new Context()
+    const info = vi.spyOn(ctx.logger, 'info').mockImplementation(() => {})
+    const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => {})
+    const error = vi.spyOn(ctx.logger, 'error').mockImplementation(() => {})
+    const fiber = ctx.plugin(LocalCredentialProvider, { path, watch: false })
+    cleanups.push(async () => { await fiber.dispose() })
+    await fiber
+    const logged = JSON.stringify([...info.mock.calls, ...warn.mock.calls, ...error.mock.calls])
+    expect(logged).not.toContain('sk-never-in-logs')
+    expect(info.mock.calls.some(call => String(call[0]).includes('sealed'))).toBe(true)
+  })
+})
