+   * A Daniel capability call joins the row of its business `module + action`.
+   * Any other tool — the host's shell, files, python, skill, and web tools
+   * included — joins the task's one folded "整理结果" row instead of appending
+   * a row of its own.
+   * @param id - call identity.
+   * @param tool - tool name as recorded.
+   * @param raw - raw argument JSON.
+   * @param seq - log sequence of this call, which orders "current".
+   */
+  private start(id: string, tool: string, raw: string, seq: number): void {
+    if (this.calls.has(id)) return
+    const row = isDanielTool(tool)
+      ? this.danielRow(id, tool, raw)
+      : this.foldedRow()
+    row.open += 1
+    row.count += 1
+    this.calls.set(id, { row, seq, settled: false })
+  }
+
+  /**
+   * The row one Daniel capability call belongs to: same business module and
+   * action, same row, wherever that row sits in the path.
+   *
+   * A Daniel call the map cannot place is the one exception: it carries no
+   * business identity, so two unrelated unnamed calls must not be sold as one
+   * action. Those rows keep the older rule — only an adjacent one merges —
+   * which is also what keeps a named step between them visible.
+   * @param id - call identity, used as the row key of a fresh row.
+   * @param tool - tool name as recorded.
+   * @param raw - raw argument JSON.
+   * @returns the row, ready to take the call.
+   */
+  private danielRow(id: string, tool: string, raw: string): FoldedCall {
+    const rule = describeToolCall(tool, raw)
+    const key = mergeKey(rule.module, rule.action)
+    const existing = this.rows.get(key)
+    if (existing !== undefined) {
+      const unplaceable = rule.module === null && rule.action === MODULE_MAP.fallback.action
+      if (!unplaceable || this.order.at(-1) === existing) return existing
+    }
+    const row: FoldedCall = { id, module: rule.module, action: rule.action, open: 0, count: 0 }
+    this.rows.set(key, row)
+    this.order.push(row)
+    return row
+  }
+
+  /**
+   * The task's single folded row for internal work. It opens where the first
+   * internal call started — between Daniel steps when the work is interleaved —
+   * and every later internal call updates it in place instead of appending.
+   * @returns the existing row, or a new one at the end of the path.
+   */
+  private foldedRow(): FoldedCall {
+    if (this.work !== undefined) return this.work
+    const row: FoldedCall = { id: WORK_ROW_ID, module: null, action: WORK_ROW_ACTION, open: 0, count: 0 }
+    this.work = row
+    this.order.push(row)
+    return row
+  }
+
+  /**
+   * The row the "current" pointer belongs on: the one holding the call with
+   * the greatest start sequence among those not yet settled.
+   *
+   * The pointer only moves while the row it sits on is no longer running, or
+   * once {@link CURRENT_HOLD_MS} has passed — so a call that starts and settles
+   * a few milliseconds later cannot make the highlight jump back and forth.
+   * @param steps - the published rows, in start order.
+   * @returns the current step, or null when nothing is in flight.
+   */
+  private pickCurrent(steps: readonly TraceStep[]): TraceStep | null {
+    let latest: StartedCall | undefined
+    for (const call of this.calls.values()) {
+      if (call.settled) continue
+      if (latest === undefined || call.seq > latest.seq) latest = call
+    }
+    if (latest === undefined) {
+      this.currentRow = undefined
+      return null
+    }
+    const candidate = latest.row
+    if (this.currentRow === undefined || this.currentRow === candidate) {
+      if (this.currentRow === undefined) {
+        this.currentRow = candidate
+        this.currentSince = this.now()
+      }
+    } else if (this.currentRow.open === 0 || this.now() - this.currentSince >= CURRENT_HOLD_MS) {
+      this.currentRow = candidate
+      this.currentSince = this.now()
+    }
+    return steps.find(step => step.id === this.currentRow?.id) ?? null
+  }
+
+  /** Cancel a queued trailing publish; nothing is remembered while closed. */
+  private clearTrailing(): void {
+    if (this.trailing === undefined) return
+    clearTimeout(this.trailing)
+    this.trailing = undefined
+  }
+
+  /** Recompute the visible projection and notify only when it really changed. */
+  private publish(): void {
+    // Copy each fold into the published shape: snapshots stay immutable even
+    // though the fold keeps mutating the same call records. A merged row keeps
+    // the first call's id as its key, so React updates it in place; `count` is
+    // published only once it says something (the folded 整理结果 row never).
+    const steps: TraceStep[] = this.order.map((call) => {
+      const row: TraceStep = {
+        id: call.id,
+        module: call.module,
+        action: call.action,
+        status: call.open > 0 ? 'running' : 'done',
+      }
+      return call.id === WORK_ROW_ID || call.count < 2 ? row : { ...row, count: call.count }
+    })
+    // The panorama counts calls, not rows: seven profile lookups merged into
+    // one line still light 品牌资产 seven times.
+    const counts = new Map<string, number>()
+    const active = new Set<string>()
+    for (const call of this.order) {
+      if (call.module === null) continue
+      counts.set(call.module, (counts.get(call.module) ?? 0) + call.count)
+      if (call.open > 0) active.add(call.module)
+    }
+    const modules: ModuleStatus[] = MODULE_MAP.modules.map((module) => {
+      const calls = counts.get(module.name) ?? 0
+      const state: ModuleState = active.has(module.name) ? 'active' : calls > 0 ? 'used' : 'unused'
+      return { id: module.id, name: module.name, calls, state }
+    })
+    const running = this.order.some(call => call.open > 0)
+    const visible = steps.slice(-TRACE_STEP_LIMIT)
+    const current = this.pickCurrent(steps)
+    const signature = [
+      String(this.task),
+      steps.map(step => `${step.id}:${step.status}:${String(step.count ?? 1)}`).join(','),
+      `current:${current?.id ?? '-'}`,
+      modules.map(module => `${module.id}:${String(module.calls)}:${module.state}`).join(','),
+    ].join('|')
+    if (signature === this.signature) return
+    this.signature = signature
+    if (steps.length === 0 && this.task === 0) {
+      this.snapshot = EMPTY_TRACE
+      return
+    }
+    this.snapshot = { task: this.task, running, current, steps: visible, modules }
+    this.notify()
+  }
+
+  /**
+   * Hand the new snapshot to the rail, coalescing bursts.
+   *
+   * A task's normal pace is a handful of publishes, and each one repaints
+   * immediately. A storm — a replay, a batch, two calls settling together —
+   * stops paying one repaint per event after
+   * {@link BURST_PUBLISH_LIMIT} publishes: the rest of the window is delivered
+   * once, {@link PUBLISH_COALESCE_MS} after it started, with the newest state.
+   * The snapshot itself is always up to date; only the notification waits.
+   */
+  private notify(): void {
+    const now = this.now()
+    if (now - this.burstStart > PUBLISH_COALESCE_MS) {
+      this.burstStart = now
+      this.burstCount = 0
+    }
+    this.burstCount += 1
+    if (this.burstCount <= BURST_PUBLISH_LIMIT) {
+      this.clearTrailing()
+      for (const listener of [...this.listeners]) listener()
+      return
+    }
+    if (this.trailing !== undefined) return
+    const timer = setTimeout(() => {
+      this.trailing = undefined
+      for (const listener of [...this.listeners]) listener()
+    }, PUBLISH_COALESCE_MS)
+    // Node keeps the process alive for a bare timer; the browser returns a number.
+    ;(timer as { unref?: () => void }).unref?.()
+    this.trailing = timer
+  }
+}
