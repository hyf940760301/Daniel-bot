+  // round trip is what proves the body is real base64 rather than damage we
+  // would otherwise "decrypt" into a misleading failure.
+  const decoded = Buffer.from(body, 'base64')
+  if (decoded.toString('base64') !== body) throw new CredentialDecryptionError('密文不是有效的 base64')
+  return decoded
