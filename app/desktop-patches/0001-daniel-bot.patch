diff --git a/apps/desktop/tests/daniel-context.spec.ts b/apps/desktop/tests/daniel-context.spec.ts
new file mode 100644
index 00000000..7905d57f
--- /dev/null
+++ b/apps/desktop/tests/daniel-context.spec.ts
@@ -0,0 +1,209 @@
+/**
+ * The workspace/brand directory bridge: read-only commands, a hard deadline,
+ * and a 60s memory cache.
+ *
+ * The IPC installer itself needs Electron's `ipcMain`, which this suite stubs;
+ * the behaviour that matters (which command runs, what a failure settles to,
+ * when the cache expires) lives in the catalog and is exercised directly.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import { join } from 'node:path'
+import {
+  DANIEL_CONTEXT_ARGV, DANIEL_CONTEXT_CACHE_TTL_MS, DANIEL_CONTEXT_TIMEOUT_MS, DanielContextCatalog, createDanielRunner,
+  danielCliEntry, danielContextEnv, parseBrands, parseCliJson, parseWorkspaces,
+} from '../src/daniel-context.ts'
+import type { DanielCliRun, DanielContextRunner } from '../src/daniel-context.ts'
+import { DANIEL_CONTEXT_IPC } from '../src/daniel-context-api.ts'
+
+vi.mock('electron', () => ({
+  ipcMain: { handle: vi.fn(), removeHandler: vi.fn() },
+}))
+
+/** One successful CLI body. */
+function ok(data: unknown): string {
+  return JSON.stringify({ ok: true, cli: 'daniel', data })
+}
+
+/**
+ * Build a runner that answers from a table and records every argv.
+ * @param answers - stdout per command, in call order.
+ * @returns the runner plus its call log.
+ */
+function runnerOf(answers: readonly (string | DanielCliRun)[]): { run: DanielContextRunner; calls: (readonly string[])[] } {
+  const calls: (readonly string[])[] = []
+  let index = 0
+  const run: DanielContextRunner = async (argv) => {
+    calls.push(argv)
+    const answer = answers[index] ?? answers.at(-1) ?? ''
+    index += 1
+    return typeof answer === 'string'
+      ? { stdout: answer, stderr: '', timedOut: false, exitCode: 0 }
+      : answer
+  }
+  return { run, calls }
+}
+
+describe('workspace / brand command contract', () => {
+  it('runs exactly the two read-only commands and nothing that can write', () => {
+    expect(DANIEL_CONTEXT_ARGV.workspaces).toEqual(['account', 'workspaces', '--json'])
+    expect(DANIEL_CONTEXT_ARGV.brands).toEqual(['brands', 'list', '--json', '--limit', '200'])
+    for (const argv of Object.values(DANIEL_CONTEXT_ARGV)) {
+      // A write would need --confirm (the CLI's write gate) or a write verb.
+      expect(argv).not.toContain('--confirm')
+      expect(argv.some(token => /create|update|delete|remove|add|write|import|login|logout/i.test(token))).toBe(false)
+    }
+  })
+
+  it('exposes exactly the two renderer channels', () => {
+    expect(Object.values(DANIEL_CONTEXT_IPC)).toEqual(['daniel:workspaces', 'daniel:brands'])
+  })
+
+  it('resolves the CLI the way the embedded plugin does, with $DANIEL_BIN winning', () => {
+    const profile = join('/tmp', 'profile')
+    expect(danielCliEntry(profile, {})).toBe(join(profile, 'node_modules', 'daniel-dsh-plugin', 'vendor', 'data', 'daniel-cli', 'bin', 'daniel'))
+    expect(danielCliEntry(profile, { DANIEL_BIN: '/opt/daniel' })).toBe('/opt/daniel')
+    expect(danielCliEntry(profile, { DANIEL_BIN: '  ' })).toBe(join(profile, 'node_modules', 'daniel-dsh-plugin', 'vendor', 'data', 'daniel-cli', 'bin', 'daniel'))
+  })
+
+  it('strips model keys from the child environment and pins the data home', () => {
+    const env = danielContextEnv('/data/daniel', { DEEPSEEK_API_KEY: 'secret', PATH: '/bin' })
+    expect(env['DEEPSEEK_API_KEY']).toBeUndefined()
+    expect(env['PATH']).toBe('/bin')
+    expect(env['DANIEL_HOME']).toBe('/data/daniel')
+    expect(env['DANIEL_NO_OPEN']).toBe('1')
+  })
+})
+
+describe('payload parsing', () => {
+  it('reads workspace rows from the account payload', () => {
+    const body = parseCliJson(ok({ activeWorkspaceId: 90002, workspaces: [
+      { id: 90002, name: 'Jack' }, { id: '90003', name: ' Mike ' }, { id: 1, name: '   ' }, { name: 'no id' },
+    ] }))
+    expect(body?.ok).toBe(true)
+    expect(body?.ok === true ? parseWorkspaces(body.data) : undefined).toEqual([
+      { id: 90002, name: 'Jack' }, { id: 90003, name: 'Mike' },
+    ])
+  })
+
+  it('reads brand rows with their workspace when the CLI reports one', () => {
+    const body = parseCliJson(ok({ brands: [
+      { id: 4800023, name: 'Halliday', workspaceId: 90002 },
+      { id: '4800024', name: 'RingConn' },
+      { id: 1, name: '' },
+    ] }))
+    expect(body?.ok === true ? parseBrands(body.data) : undefined).toEqual([
+      { id: '4800023', name: 'Halliday', workspaceId: 90002 },
+      { id: '4800024', name: 'RingConn' },
+    ])
+  })
+
+  it('keeps the CLI failure message instead of throwing', () => {
+    expect(parseCliJson(JSON.stringify({ ok: false, error: { kind: 'auth', message: '会话已过期' } }))).toEqual({
+      ok: false, message: '会话已过期',
+    })
+    expect(parseCliJson('not json')).toBeUndefined()
+    expect(parseCliJson('[]')).toBeUndefined()
+  })
+})
+
+describe('catalog', () => {
+  it('caches a successful list for 60s and refreshes only after the TTL', async () => {
+    let now = 1_000
+    const { run, calls } = runnerOf([
+      ok({ workspaces: [{ id: 90002, name: 'Jack' }] }),
+      ok({ workspaces: [{ id: 90002, name: 'Jack' }, { id: 90003, name: 'Mike' }] }),
+    ])
+    const catalog = new DanielContextCatalog(run, () => now)
+    expect(await catalog.read('workspaces')).toEqual({ ok: true, items: [{ id: 90002, name: 'Jack' }] })
+    expect(await catalog.read('workspaces')).toEqual({ ok: true, items: [{ id: 90002, name: 'Jack' }] })
+    expect(calls).toHaveLength(1)
+    now += DANIEL_CONTEXT_CACHE_TTL_MS - 1
+    await catalog.read('workspaces')
+    expect(calls).toHaveLength(1)
+    now += 2
+    expect(await catalog.read('workspaces')).toEqual({
+      ok: true, items: [{ id: 90002, name: 'Jack' }, { id: 90003, name: 'Mike' }],
+    })
+    expect(calls).toHaveLength(2)
+    // The refresh path the renderer's 刷新 button takes clears the cache at once.
+    catalog.clear()
+    await catalog.read('workspaces')
+    expect(calls).toHaveLength(3)
+  })
+
+  it('settles a timeout as a failure and never caches it', async () => {
+    const { run, calls } = runnerOf([
+      { stdout: '', stderr: '', timedOut: true, exitCode: undefined },
+      ok({ workspaces: [{ id: 90002, name: 'Jack' }] }),
+    ])
+    const catalog = new DanielContextCatalog(run)
+    expect(await catalog.read('workspaces')).toEqual({ ok: false, reason: { kind: 'timeout' } })
+    // A failed read is not remembered: the next call retries.
+    expect(await catalog.read('workspaces')).toEqual({ ok: true, items: [{ id: 90002, name: 'Jack' }] })
+    expect(calls).toHaveLength(2)
+  })
+
+  it('settles a CLI failure and unparseable output as values', async () => {
+    const { run } = runnerOf([
+      JSON.stringify({ ok: false, error: { message: '登录已过期' } }),
+      'Traceback (most recent call last)',
+    ])
+    const catalog = new DanielContextCatalog(run)
+    expect(await catalog.read('brands')).toEqual({ ok: false, reason: { kind: 'cli', message: '登录已过期' } })
+    const malformed = await catalog.read('brands')
+    expect(malformed.ok).toBe(false)
+    if (!malformed.ok) expect(malformed.reason.kind).toBe('malformed')
+  })
+
+  it('joins concurrent reads of one list into a single process', async () => {
+    let release: (() => void) | undefined
+    let calls = 0
+    const run: DanielContextRunner = async () => {
+      calls += 1
+      await new Promise<void>((resolve) => { release = resolve })
+      return { stdout: ok({ brands: [] }), stderr: '', timedOut: false, exitCode: 0 }
+    }
+    const catalog = new DanielContextCatalog(run)
+    const first = catalog.read('brands')
+    const second = catalog.read('brands')
+    await vi.waitFor(() => { expect(release).toBeDefined() })
+    release?.()
+    expect(await first).toEqual({ ok: true, items: [] })
+    expect(await second).toEqual({ ok: true, items: [] })
+    expect(calls).toBe(1)
+  })
+})
+
+describe('runner deadline', () => {
+  it('kills a child that outlives the 8s deadline and reports a timeout', async () => {
+    vi.useFakeTimers()
+    try {
+      const kill = vi.fn(() => true)
+      const child = {
+        stdout: { on: vi.fn() },
+        stderr: { on: vi.fn() },
+        on: vi.fn(),
+        kill,
+      }
+      const run = createDanielRunner({
+        entry: new URL('../src/daniel-context-api.ts', import.meta.url).pathname,
+        spawnChild: () => child as never,
+      })
+      const pending = run(['account', 'workspaces', '--json'], DANIEL_CONTEXT_TIMEOUT_MS)
+      await vi.advanceTimersByTimeAsync(DANIEL_CONTEXT_TIMEOUT_MS + 1)
+      await expect(pending).resolves.toMatchObject({ timedOut: true })
+      expect(kill).toHaveBeenCalledWith('SIGKILL')
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('reports a missing CLI entry without spawning anything', async () => {
+    const spawnChild = vi.fn()
+    const run = createDanielRunner({ entry: '/nonexistent/daniel', spawnChild: spawnChild as never })
+    const result = await run(['account', 'workspaces', '--json'], 8_000)
+    expect(spawnChild).not.toHaveBeenCalled()
+    expect(result.stderr).toContain('not found')
+  })
+})
diff --git a/apps/desktop/tests/daniel-login.spec.ts b/apps/desktop/tests/daniel-login.spec.ts
new file mode 100644
index 00000000..83012aeb
--- /dev/null
+++ b/apps/desktop/tests/daniel-login.spec.ts
@@ -0,0 +1,57 @@
+/** The session file is the only thing the sign-in flow writes; this pins its exact shape. */
+
+import { mkdtempSync, mkdirSync, readFileSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// The window and HTTPS surfaces need a real Electron process; this suite touches only the file.
+vi.mock('electron', () => ({
+  app: { getAppPath: () => process.cwd(), getLocale: () => 'en' },
+  BrowserWindow: class {},
+  ipcMain: { handle: vi.fn(), removeHandler: vi.fn() },
+  net: { request: vi.fn() },
+}))
+
+const home = mkdtempSync(join(tmpdir(), 'daniel-login-home-'))
+process.env.DANIEL_HOME = home
+
+const { clearDanielSession, danielSessionFile, readDanielSession, writeDanielSession } = await import('../src/daniel-login.ts')
+
+afterAll(() => { delete process.env.DANIEL_HOME })
+
+describe('daniel session file', () => {
+  beforeEach(() => { clearDanielSession() })
+
+  it('writes under $DANIEL_HOME/session with owner-only modes', () => {
+    writeDanielSession('app_session_id=first')
+    const file = danielSessionFile()
+    expect(file).toBe(join(home, 'session', 'session.json'))
+    expect(statSync(file).mode & 0o777).toBe(0o600)
+    expect(statSync(join(home, 'session')).mode & 0o777).toBe(0o700)
+    expect(JSON.parse(readFileSync(file, 'utf8'))).toMatchObject({ cookie: 'app_session_id=first' })
+    expect(readDanielSession()).toEqual({ cookie: 'app_session_id=first', ts: expect.any(Number) })
+  })
+
+  it('replaces an existing session atomically and keeps the mode', () => {
+    writeDanielSession('app_session_id=first')
+    writeDanielSession('app_session_id=second')
+    expect(readDanielSession()?.cookie).toBe('app_session_id=second')
+    expect(statSync(danielSessionFile()).mode & 0o777).toBe(0o600)
+  })
+
+  it('rejects a file that is not a Daniel cookie', () => {
+    mkdirSync(join(home, 'session'), { recursive: true })
+    writeFileSync(danielSessionFile(), JSON.stringify({ cookie: 'other=1' }))
+    expect(readDanielSession()).toBeUndefined()
+    writeFileSync(danielSessionFile(), 'not json')
+    expect(readDanielSession()).toBeUndefined()
+  })
+
+  it('clears a session it was asked to drop, and tolerates an absent file', () => {
+    writeDanielSession('app_session_id=first')
+    clearDanielSession()
+    expect(readDanielSession()).toBeUndefined()
+    expect(() => { clearDanielSession() }).not.toThrow()
+  })
+})
diff --git a/apps/desktop/tests/daniel-plugin.spec.ts b/apps/desktop/tests/daniel-plugin.spec.ts
new file mode 100644
index 00000000..33d9a6de
--- /dev/null
+++ b/apps/desktop/tests/daniel-plugin.spec.ts
@@ -0,0 +1,156 @@
+/** Embedded Daniel plugin: profile copy, bundle activation, and its five-key configuration. */
+
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { resolveDesktopPaths } from '../src/paths.ts'
+import { DesktopProjectManager } from '../src/project-manager.ts'
+import {
+  activateDanielPlugin,
+  DANIEL_PLUGIN_NAME,
+  embedDanielPlugin,
+  writeDanielAppOverlay,
+  writeDanielProfilePatch,
+} from '../src/daniel-plugin.ts'
+import { runtimeFixture } from './runtime-fixture.ts'
+
+const roots: string[] = []
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-desktop-daniel-'))
+  roots.push(root)
+  return root
+}
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+/** Packaged plugin shape: a manifest declaring a bundle patch, a patch file, and an executable CLI entry. */
+function pluginFixture(root: string): string {
+  const source = join(root, 'resources', 'vendor', DANIEL_PLUGIN_NAME)
+  const entry = join(source, 'vendor', 'data', 'daniel-cli', 'bin', 'daniel')
+  mkdirSync(join(entry, '..'), { recursive: true })
+  writeFileSync(join(source, 'package.json'), JSON.stringify({
+    name: DANIEL_PLUGIN_NAME,
+    version: '0.11.0',
+    type: 'module',
+    dsh: { bundle: { patch: './cordis.patch.yml' } },
+  }))
+  writeFileSync(join(source, 'cordis.patch.yml'), '- insert:\n    - id: daniel\n      name: daniel-dsh-plugin\n      config:\n        python: python3\n        timeoutMs: 180000\n')
+  writeFileSync(join(source, 'lib.js'), 'export const identity = {}\n')
+  writeFileSync(entry, '#!/usr/bin/env python3\n')
+  chmodSync(entry, 0o755)
+  return source
+}
+
+function profileFixture(root: string): string {
+  const profile = join(root, 'dsh-home', 'profiles', 'desktop')
+  mkdirSync(profile, { recursive: true, mode: 0o700 })
+  writeFileSync(join(profile, 'package.json'), JSON.stringify({
+    name: 'dsh-profile-desktop',
+    private: true,
+    dependencies: {},
+    dsh: { profile: { bundles: ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'] } },
+  }))
+  return profile
+}
+
+function bundles(profile: string): string[] {
+  return (JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+    dsh: { profile: { bundles: string[] } }
+  }).dsh.profile.bundles
+}
+
+describe('embedded Daniel plugin', () => {
+  it('copies the packaged plugin once and keeps an identical copy untouched', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    const target = join(profile, 'node_modules', DANIEL_PLUGIN_NAME)
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: true })
+    expect(statSync(join(target, 'vendor', 'data', 'daniel-cli', 'bin', 'daniel')).mode & 0o111).not.toBe(0)
+    const before = readFileSync(join(target, 'lib.js'), 'utf8')
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: false })
+    expect(readFileSync(join(target, 'lib.js'), 'utf8')).toBe(before)
+  })
+
+  it('replaces a damaged copy with the packaged one', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    embedDanielPlugin(source, profile)
+    writeFileSync(join(profile, 'node_modules', DANIEL_PLUGIN_NAME, 'lib.js'), 'broken\n')
+
+    expect(embedDanielPlugin(source, profile)).toEqual({ installed: true, copied: true })
+    expect(readFileSync(join(profile, 'node_modules', DANIEL_PLUGIN_NAME, 'lib.js'), 'utf8')).toBe('export const identity = {}\n')
+  })
+
+  it('activates the bundle once and writes all five configuration keys', () => {
+    const root = temporaryRoot()
+    const source = pluginFixture(root)
+    const profile = profileFixture(root)
+    embedDanielPlugin(source, profile)
+    const embeds = { pluginSource: source, danielHome: join(root, 'daniel-home') }
+
+    expect(activateDanielPlugin(profile)).toBe(true)
+    expect(activateDanielPlugin(profile)).toBe(false)
+    expect(bundles(profile)).toEqual(['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app', DANIEL_PLUGIN_NAME])
+
+    expect(writeDanielProfilePatch(embeds, profile)).toBe(true)
+    expect(writeDanielProfilePatch(embeds, profile)).toBe(false)
+    const patch = readFileSync(join(profile, 'cordis.patch.yml'), 'utf8')
+    expect(patch.match(/^- id: daniel$/gmu)).toHaveLength(1)
+    for (const key of ['entry', 'python', 'danielHome', 'timeoutMs', 'trace']) {
+      expect(patch).toContain(`    ${key}:`)
+    }
+
+    expect(writeDanielAppOverlay(embeds, profile)).toBe(true)
+    expect(writeDanielAppOverlay(embeds, profile)).toBe(false)
+    const overlay = readFileSync(join(embeds.danielHome, 'app-overlay.yml'), 'utf8')
+    expect(overlay.match(/^- id: daniel$/gmu)).toHaveLength(1)
+    for (const key of ['entry', 'python', 'danielHome', 'timeoutMs', 'trace']) {
+      expect(overlay).toContain(`    ${key}:`)
+    }
+  })
+
+  it('keeps the plugin activated and configured across crash recovery', async () => {
+    const root = temporaryRoot()
+    const dsh = join(root, 'resources', 'dsh')
+    runtimeFixture(dsh)
+    const source = pluginFixture(root)
+    const danielHome = join(root, 'daniel-home')
+    const manager = new DesktopProjectManager(resolveDesktopPaths(join(root, 'dsh-home')), { dsh }, {
+      pluginSource: source,
+      danielHome,
+    })
+
+    await manager.applyRelease()
+    expect(bundles(manager.paths.profile)).toContain(DANIEL_PLUGIN_NAME)
+    expect(readFileSync(join(manager.paths.profile, 'cordis.patch.yml'), 'utf8')).toContain('    danielHome:')
+
+    await manager.disableAllPlugins()
+    expect(bundles(manager.paths.profile)).toContain(DANIEL_PLUGIN_NAME)
+    expect(bundles(manager.paths.profile)).toContain('@deepseek-ai/dsh-web-app')
+    expect(readFileSync(join(manager.paths.profile, 'cordis.patch.yml'), 'utf8')).toContain('    entry:')
+    expect(existsSync(join(danielHome, 'app-overlay.yml'))).toBe(true)
+
+    await manager.applyRelease()
+    expect(bundles(manager.paths.profile).filter(name => name === DANIEL_PLUGIN_NAME)).toHaveLength(1)
+  })
+
+  it('keeps the shell usable when the packaged plugin is absent', async () => {
+    const root = temporaryRoot()
+    const dsh = join(root, 'resources', 'dsh')
+    runtimeFixture(dsh)
+    const manager = new DesktopProjectManager(resolveDesktopPaths(join(root, 'dsh-home')), { dsh }, {
+      pluginSource: join(root, 'resources', 'vendor', DANIEL_PLUGIN_NAME),
+      danielHome: join(root, 'daniel-home'),
+    })
+
+    await expect(manager.applyRelease()).resolves.toBeUndefined()
+    expect(bundles(manager.paths.profile)).toEqual(['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'])
+    expect(existsSync(join(manager.paths.profile, 'node_modules', DANIEL_PLUGIN_NAME))).toBe(false)
+  })
+})
