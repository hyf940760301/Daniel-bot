diff --git a/packages/client/ui-conversation/src/client/contract/request-context.ts b/packages/client/ui-conversation/src/client/contract/request-context.ts
new file mode 100644
index 00000000..63abc641
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/contract/request-context.ts
@@ -0,0 +1,63 @@
+/**
+ * The composer's send-time request context: plugin-owned facts that ride one
+ * prompt to the Host without becoming part of the visible message.
+ *
+ * Why this seam exists: the composer cannot import the business plugin that
+ * owns the current selection (that dependency would point the wrong way, and
+ * the plugin's own bundle is a separate client module). So the business side
+ * registers a source on the Conversation service and the composer reads it
+ * once per submission, exactly like {@link ComposerSendGuards} reads the send
+ * gate. The value is metadata on the prompt RPC; nothing is rendered into the
+ * draft or the transcript.
+ *
+ * Reading is deliberately total: a source that is disposed, throws, or answers
+ * `undefined` leaves the request without context and never blocks the send.
+ */
+
+import type { ClientSelection } from '@deepseek-ai/dsh-api-session-controller/types'
+
+/** One plugin's current contribution to the next prompt. */
+export interface ComposerRequestContextSource {
+  /**
+   * @returns the pair to attach to this submission, or undefined when the
+   * plugin has nothing to say for it.
+   */
+  selection(): ClientSelection | undefined
+}
+
+/** The registry face plugins reach through `ctx.conversation.requestContext`. */
+export interface ComposerRequestContexts {
+  /**
+   * Register one source.
+   * @param source - the provider read on every human submission.
+   * @returns the unregister function.
+   */
+  register(source: ComposerRequestContextSource): () => void
+  /** @returns the first selection any registered source reports, in registration order. */
+  selection(): ClientSelection | undefined
+}
+
+/** The registry the Conversation service owns; plugins only see the interface above. */
+export class ComposerRequestContextRegistry implements ComposerRequestContexts {
+  private readonly sources = new Set<ComposerRequestContextSource>()
+
+  /** @inheritdoc */
+  register(source: ComposerRequestContextSource): () => void {
+    this.sources.add(source)
+    return () => { this.sources.delete(source) }
+  }
+
+  /** @inheritdoc */
+  selection(): ClientSelection | undefined {
+    for (const source of this.sources) {
+      // A disposed plugin's stale source must not fail an unrelated send.
+      try {
+        const selection = source.selection()
+        if (selection !== undefined) return selection
+      } catch {
+        continue
+      }
+    }
+    return undefined
+  }
+}
diff --git a/packages/client/ui-conversation/src/client/contract/send-guard.ts b/packages/client/ui-conversation/src/client/contract/send-guard.ts
new file mode 100644
index 00000000..69a838e0
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/contract/send-guard.ts
@@ -0,0 +1,42 @@
+/**
+ * The composer's send-time gate: a business prerequisite that must hold before
+ * a human submission leaves the input.
+ *
+ * Why this seam exists: the composer cannot import the business plugin that
+ * knows whether its prerequisites are met (the dependency would point the wrong
+ * way). So the business side registers a guard on the Conversation service and
+ * pushes the copy it wants shown; the composer only asks "may this send?" and,
+ * when the answer is no, does nothing — the draft stays, nothing is dispatched,
+ * and the plugin's own inline notice explains what to pick.
+ *
+ * The gate is an affordance, not enforcement: it always fails closed for a
+ * human submission, and the Host remains the authority for what it accepts.
+ */
+
+/** Why a send is refused right now, with the one action that clears it. */
+export interface ComposerSendBlock {
+  /** Sentence shown above the composer by the plugin that raised the block. */
+  readonly message: string
+  /** Label of the single action that opens the missing choice. */
+  readonly actionLabel: string
+  /** Runs when that action is clicked; it must not send by itself. */
+  readonly action: () => void
+}
+
+/** One plugin's local check, readable on every submit. */
+export interface ComposerSendGuard {
+  /** @returns a block when the submission must not leave the composer. */
+  check(): ComposerSendBlock | undefined
+}
+
+/** The registry face plugins reach through `ctx.conversation.sendGuard`. */
+export interface ComposerSendGuards {
+  /**
+   * Register one guard.
+   * @param guard - the check to consult on every human submission.
+   * @returns the unregister function.
+   */
+  register(guard: ComposerSendGuard): () => void
+  /** @returns the first block any registered guard raises, in registration order. */
+  blocked(): ComposerSendBlock | undefined
+}
