diff --git a/apps/desktop/renderer/daniel-login.css b/apps/desktop/renderer/daniel-login.css
new file mode 100644
index 00000000..94f30e99
--- /dev/null
+++ b/apps/desktop/renderer/daniel-login.css
@@ -0,0 +1,243 @@
+/*
+ * Daniel Bot sign-in window.
+ *
+ * Same material and type scale as the native welcome surface (translucent tint over
+ * the platform's own window material, Montserrat brand face, 12 px inputs, 10 px
+ * buttons). Values are local copies of the shell's design tokens so this document
+ * renders correctly even before the Host exists.
+ */
+
+:root {
+  color-scheme: light dark;
+  --dl-label: #0f1115;
+  --dl-label-secondary: #61666b;
+  --dl-label-caption: #adb2b8;
+  --dl-border: #00000029;
+  --dl-border-strong: #0f1115;
+  --dl-button: #0f1115;
+  --dl-button-hover: #43454a;
+  --dl-button-label: #ffffff;
+  --dl-error: rgb(236, 19, 19);
+  --dl-error-tint: rgb(236 19 19 / 8%);
+  --dl-tint: color-mix(in srgb, rgb(255, 255, 255) 40%, transparent);
+  --dl-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  --dl-font-brand: 'Montserrat', var(--dl-font);
+  --dl-transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+body[data-ds-dark-theme] {
+  --dl-label: #f9fafb;
+  --dl-label-secondary: #cfd3d6;
+  --dl-label-caption: #81858c;
+  --dl-border: #ffffff33;
+  --dl-border-strong: #f9fafb;
+  --dl-button: #f9fafb;
+  --dl-button-hover: #ebeef2;
+  --dl-button-label: #353638;
+  --dl-error: rgb(242, 90, 90);
+  --dl-error-tint: rgb(242 90 90 / 12%);
+  --dl-tint: color-mix(in srgb, rgb(24, 25, 28) 50%, transparent);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html,
+body {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  overflow: hidden;
+  background: transparent;
+}
+
+body {
+  display: flex;
+  flex-direction: column;
+  background: var(--dl-tint);
+  color: var(--dl-label);
+  font-family: var(--dl-font-brand);
+  font-weight: 400;
+  user-select: none;
+  -webkit-font-smoothing: antialiased;
+}
+
+.titlebar {
+  flex: 0 0 36px;
+  app-region: drag;
+}
+
+.signin {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  flex-direction: column;
+  padding: 2px 40px 24px;
+  overflow: auto;
+}
+
+.wordmark {
+  margin: 0;
+  color: var(--dl-label);
+  font-family: var(--dl-font-brand);
+  font-size: 26px;
+  font-weight: 500;
+  line-height: 34px;
+  letter-spacing: 0.01em;
+}
+
+h1 {
+  margin: 18px 0 6px;
+  font-family: var(--dl-font-brand);
+  font-size: 20px;
+  font-weight: 400;
+  line-height: 30px;
+}
+
+.subtitle {
+  margin: 0;
+  color: var(--dl-label-secondary);
+  font-size: 14px;
+  font-weight: 300;
+  line-height: 22px;
+}
+
+#form {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 24px;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.label {
+  color: var(--dl-label-secondary);
+  font-family: var(--dl-font);
+  font-size: 13px;
+  line-height: 18px;
+}
+
+.field input {
+  display: block;
+  width: 100%;
+  height: 48px;
+  padding: 7px 14px;
+  border: 1px solid var(--dl-border);
+  border-radius: 12px;
+  outline: none;
+  background: transparent;
+  color: var(--dl-label);
+  font-family: var(--dl-font);
+  font-size: 14px;
+  line-height: 24px;
+  user-select: text;
+  transition: border-color var(--dl-transition);
+}
+
+.field input:focus {
+  border-color: var(--dl-border-strong);
+}
+
+.field input::placeholder {
+  color: var(--dl-label-caption);
+  opacity: 1;
+}
+
+.field input[disabled] {
+  opacity: 0.5;
+}
+
+.error {
+  margin: 0;
+  padding: 10px 12px;
+  border-radius: 10px;
+  background: var(--dl-error-tint);
+  color: var(--dl-error);
+  font-family: var(--dl-font);
+  font-size: 13px;
+  line-height: 20px;
+  user-select: text;
+}
+
+button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 44px;
+  padding: 8px 16px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  cursor: pointer;
+  font-family: var(--dl-font);
+  font-size: 14px;
+  font-weight: 500;
+  line-height: 22px;
+  app-region: no-drag;
+  transition:
+    background-color var(--dl-transition),
+    border-color var(--dl-transition),
+    opacity var(--dl-transition);
+}
+
+button:disabled {
+  cursor: not-allowed;
+  opacity: 0.45;
+}
+
+button:focus-visible {
+  outline: 2px solid var(--dl-label);
+  outline-offset: 3px;
+}
+
+.primary {
+  background: var(--dl-button);
+  color: var(--dl-button-label);
+}
+
+.primary:hover:not(:disabled) {
+  background: var(--dl-button-hover);
+}
+
+.secondary {
+  height: 40px;
+  border-color: var(--dl-border);
+  background: transparent;
+  color: var(--dl-label-secondary);
+  font-weight: 400;
+}
+
+.secondary:hover:not(:disabled) {
+  border-color: var(--dl-label-caption);
+  color: var(--dl-label);
+}
+
+.footnote {
+  margin: 24px 0 0;
+  padding-top: 14px;
+  border-top: 1px solid var(--dl-border);
+  color: var(--dl-label-caption);
+  font-family: var(--dl-font);
+  font-size: 11.5px;
+  line-height: 18px;
+}
+
+/* The note sits at the bottom; the form owns the vertical rhythm above it. */
+.footnote {
+  margin-top: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none;
+  }
+}
diff --git a/apps/desktop/renderer/daniel-login.html b/apps/desktop/renderer/daniel-login.html
new file mode 100644
index 00000000..25bbedaa
--- /dev/null
+++ b/apps/desktop/renderer/daniel-login.html
@@ -0,0 +1,37 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'">
+    <title>Daniel Bot</title>
+    <link rel="stylesheet" href="../lib/welcome/brand-font.css">
+    <link rel="stylesheet" href="daniel-login.css">
+  </head>
+  <body>
+    <script src="shell-theme.js"></script>
+    <div class="titlebar"></div>
+    <main class="signin">
+      <p class="wordmark">Daniel</p>
+      <h1 data-copy="title">Sign in to Daniel</h1>
+      <p class="subtitle" data-copy="subtitle"></p>
+      <form id="form" novalidate>
+        <label class="field">
+          <span class="label" data-copy="email"></span>
+          <input id="email" type="email" autocomplete="username" spellcheck="false"
+                 data-placeholder="emailPlaceholder" autofocus>
+        </label>
+        <label class="field">
+          <span class="label" data-copy="password"></span>
+          <input id="password" type="password" autocomplete="current-password"
+                 data-placeholder="passwordPlaceholder">
+        </label>
+        <p id="error" class="error" role="alert" hidden></p>
+        <button id="submit" class="primary" type="submit" data-copy="signIn">Sign in</button>
+        <button id="retry" class="secondary" type="button" data-copy="retryStored" hidden></button>
+      </form>
+      <p class="footnote" data-copy="footnote"></p>
+    </main>
+    <script src="daniel-login.js"></script>
+  </body>
+</html>
diff --git a/apps/desktop/renderer/daniel-login.js b/apps/desktop/renderer/daniel-login.js
new file mode 100644
index 00000000..1228047e
--- /dev/null
+++ b/apps/desktop/renderer/daniel-login.js
@@ -0,0 +1,145 @@
+'use strict'
+
+/**
+ * Daniel sign-in page.
+ *
+ * Copy, validation text, and every operation come from the preload bridge, so this
+ * document holds no account logic and never keeps the password after a submit.
+ * The password field is cleared as soon as an attempt settles, whichever way it
+ * went, and again on page hide.
+ */
+
+/** @type {import('./daniel-login-api').DanielLoginApi | undefined} */
+const api = window.danielLogin
+
+const form = document.getElementById('form')
+const emailEl = document.getElementById('email')
+const passwordEl = document.getElementById('password')
+const submitEl = document.getElementById('submit')
+const retryEl = document.getElementById('retry')
+const errorEl = document.getElementById('error')
+
+let busy = false
+
+/** @param {string} key @returns {string} */
+function text(key) {
+  const copy = api && api.copy
+  return copy && typeof copy[key] === 'string' ? copy[key] : ''
+}
+
+function applyCopy() {
+  if (!api) return
+  document.documentElement.lang = api.copy.lang
+  for (const node of document.querySelectorAll('[data-copy]')) {
+    const value = text(node.dataset.copy)
+    if (value !== '') node.textContent = value
+  }
+  for (const node of document.querySelectorAll('[data-placeholder]')) {
+    const value = text(node.dataset.placeholder)
+    if (value !== '') node.setAttribute('placeholder', value)
+  }
+  if (api.unverified) {
+    showError(api.copy.unverified)
+    retryEl.hidden = false
+  }
+}
+
+/** @param {string} message */
+function showError(message) {
+  errorEl.textContent = message
+  errorEl.hidden = false
+}
+
+function clearError() {
+  errorEl.textContent = ''
+  errorEl.hidden = true
+}
+
+/** @param {boolean} next */
+function setBusy(next) {
+  busy = next
+  submitEl.disabled = next
+  emailEl.disabled = next
+  passwordEl.disabled = next
+  retryEl.disabled = next
+  submitEl.textContent = text(next ? 'signingIn' : 'signIn')
+  if (next) clearError()
+}
+
+/**
+ * Turn one attempt's result into on-screen state.
+ * A transport fault always shows the network copy, never the credential copy.
+ * @param {import('./daniel-login-api').DanielLoginSubmitResult} result
+ * @returns {boolean} whether the window will close on its own
+ */
+function handle(result) {
+  if (result && result.ok === true) {
+    clearError()
+    submitEl.textContent = text('entering')
+    // The main process closes this window once the session file is stored.
+    return true
+  }
+  const failure = result && result.failure
+  const serverMessage = result && typeof result.message === 'string' ? result.message : ''
+  if (failure === 'network') showError(text('networkError'))
+  else if (failure === 'invalid') {
+    // The stored session is gone, so the retry entry has nothing left to verify.
+    showError(serverMessage || text('expired'))
+    retryEl.hidden = true
+  } else showError(serverMessage || text('serverError'))
+  setBusy(false)
+  return false
+}
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault()
+  if (busy) return
+  if (!api) {
+    showError('Page is not connected to the application process.')
+    return
+  }
+  const email = emailEl.value.trim()
+  const password = passwordEl.value
+  if (email === '' || password === '') {
+    showError(api.copy.emptyFields)
+    return
+  }
+
+  setBusy(true)
+  let result
+  try {
+    result = await api.submit(email, password)
+  } catch (error) {
+    result = { ok: false, failure: 'server', message: error && error.message ? String(error.message) : '' }
+  }
+  // The password is spent: drop it whether the attempt succeeded or not.
+  passwordEl.value = ''
+  handle(result)
+})
+
+retryEl.addEventListener('click', async () => {
+  if (busy || !api) return
+  setBusy(true)
+  let result
+  try {
+    result = await api.retryStored()
+  } catch (error) {
+    result = { ok: false, failure: 'server', message: error && error.message ? String(error.message) : '' }
+  }
+  handle(result)
+})
+
+if (api) {
+  api.onSucceeded(() => {
+    clearError()
+    setBusy(true)
+    submitEl.textContent = text('entering')
+  })
+}
+
+emailEl.addEventListener('input', clearError)
+passwordEl.addEventListener('input', clearError)
+window.addEventListener('pagehide', () => { passwordEl.value = '' })
+
+applyCopy()
+emailEl.focus()
