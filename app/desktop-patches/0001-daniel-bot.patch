+  /** Whether a write can be sealed at all; a refused write is louder than a plaintext one. */
+  get available(): boolean {
+    return this.ciphers.length > 0
+  }
+
+  /** Scheme new values are sealed under, or `undefined` when none is available. */
+  get scheme(): SealedScheme | undefined {
+    return this.ciphers[0]?.scheme
+  }
+
+  /**
+   * Refuse a write before any state is touched when no cipher resolved. The
+   * error is the actionable text a settings surface shows.
+   * @throws CredentialEncryptionUnavailableError when no cipher resolved.
+   */
+  assertWritable(): void {
+    if (!this.available) throw new CredentialEncryptionUnavailableError(this.unavailableReason)
+  }
+
+  /**
+   * Seal one plaintext into `v1:<base64>`.
+   * @param plain - the value to protect.
+   * @returns the stored envelope.
+   * @throws CredentialEncryptionUnavailableError when no cipher resolved.
+   */
+  seal(plain: string): string {
+    this.assertWritable()
+    // `assertWritable` guarantees a writer.
+    const cipher = this.ciphers[0]!
+    const tag = cipher.scheme === 'safe-storage' ? SCHEME_SAFE_STORAGE : SCHEME_AES_GCM
+    const payload = cipher.seal(plain)
+    const envelope = Buffer.concat([Buffer.from([tag]), Buffer.from(payload)])
+    return SEALED_PREFIX + envelope.toString('base64')
+  }
+
+  /**
+   * Open one stored envelope.
+   * @param token - the stored `v1:` value.
+   * @returns the plaintext it seals.
+   * @throws CredentialDecryptionError when the envelope is damaged, unauthentic, or uses an absent scheme.
+   */
+  open(token: string): string {
+    if (!isSealed(token)) throw new CredentialDecryptionError('不是加密格式')
+    const decoded = decodeEnvelope(token)
+    if (decoded.length < SCHEME_BYTES) throw new CredentialDecryptionError('密文长度不足')
+    const cipher = cipherFor(decoded[0]!, this.byTag)
+    try {
+      return cipher.open(decoded.subarray(SCHEME_BYTES))
+    } catch (error) {
+      // The cipher's own failure (an authentication-tag mismatch, a keychain
+      // refusal) never reaches the caller: its message could quote bytes.
+      throw new CredentialDecryptionError(error instanceof Error ? '解密失败（密钥不匹配或密文损坏）' : '解密失败')
+    }
+  }
+}
+
+/**
+ * Wrap Electron's `safeStorage` as a cipher. Availability is the caller's
+ * precondition: this adapter never decides whether the OS keychain works.
+ * @param safe - the `safeStorage` slice of the Electron module.
+ * @returns the cipher.
+ */
+export function safeStorageCipher(safe: SafeStorageLike): CredentialCipher {
+  return {
+    scheme: 'safe-storage',
+    seal: plain => safe.encryptString(plain),
+    open: payload => safe.decryptString(Buffer.from(payload)),
+  }
+}
+
+/**
+ * Build the AES-256-GCM cipher over a provisioned 32-byte key. Every sealed
+ * value carries a fresh random nonce; the tag makes a tampered value fail
+ * rather than decrypt into garbage.
+ * @param key - 32 random bytes.
