+    expect(store.getSnapshot().missing).toBe('workspace')
+    await ready(store)
+    store.chooseWorkspace(90002)
+    expect(store.getSnapshot().missing).toBeUndefined()
+    shell.submit()
+    expect(store.getSnapshot().missing).toBe('brand')
+    expect(sink).not.toHaveBeenCalled()
+    store.chooseBrand('4800023')
+    expect(store.getSnapshot().missing).toBeUndefined()
