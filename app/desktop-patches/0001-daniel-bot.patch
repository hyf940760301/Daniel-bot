@@ -0,0 +1,153 @@
+import { describe, expect, it, onTestFinished } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage, LlmAdapter } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies, mountAgentLoopTestHarness } from '@deepseek-ai/dsh-agent-loop-testkit'
+import type { ClientSelection } from '@deepseek-ai/dsh-api-session-controller/types'
+import * as selectionContext from '../src/index.ts'
+import { renderSelection, SELECTION_CONTEXT_NAME } from '../src/index.ts'
+
+const JACK: ClientSelection = { workspace: { id: 90002, name: 'jack' }, brand: { id: '4800023', name: 'Halliday' } }
+const MIKE: ClientSelection = { workspace: { id: 90003, name: 'mike' }, brand: { id: '4800044', name: 'Acme' } }
+
+/** Minimal one-answer adapter that records every request body. */
+class RecordingAdapter extends LlmAdapter {
+  readonly requests: GenerateOptions[] = []
+
+  override async * stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(options)
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'text-delta', index: 0, text: 'ok' }
+    yield { type: 'block-end', index: 0, block: { type: 'text', text: 'ok' } }
+    yield { type: 'usage', usage: { inputTokens: 1, outputTokens: 1 } }
+    yield { type: 'finish', reason: { kind: 'stop' } }
+  }
+}
+
+/** Full user-visible text of one recorded model request. */
+function textsOf(request: GenerateOptions | undefined): string[] {
+  return (request?.messages ?? []).flatMap(message =>
+    message.content.flatMap(block => block.type === 'text' ? [block.text] : []))
+}
+
+async function harness(): Promise<{ ctx: Context; adapter: RecordingAdapter }> {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(selectionContext)
+  const adapter = new RecordingAdapter()
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return { ctx, adapter }
+}
+
+/** Wait for the agent's next transition to idle after a waking send. */
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => {
+    const dispose = ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject !== agent || status !== 'idle') return
+      dispose()
+      resolve()
+    })
+  })
+}
+
+let requestSequence = 0
+function send(agent: Agent, text: string, selection: ClientSelection | undefined): void {
+  agent.followup(createUserMessage({
+    content: [{ type: 'text', text }],
+    source: {
+      kind: 'user',
+      rpcId: `selection-${String(++requestSequence)}` as never,
+      ...(selection === undefined ? {} : { clientSelection: selection }),
+    },
+  }))
+}
+
+describe('client selection context rendering', () => {
+  it('renders both ids and names without prompt-variable interpolation', () => {
+    const text = renderSelection(JACK)
+    expect(text).toContain('- Workspace: "jack" (id 90002)')
+    expect(text).toContain('- Brand: "Halliday" (id 4800023)')
+    expect(text).toContain('A newer snapshot supersedes these values.')
+    expect(SELECTION_CONTEXT_NAME).toBe('app:client-selection')
+  })
+
+  it('keeps a name that contains a newline on its own line', () => {
+    const text = renderSelection({ workspace: { id: 1, name: 'a\nb' }, brand: { id: '2', name: 'c' } })
+    const lines = text.split('\n')
+    expect(lines).toHaveLength(4)
+    expect(lines[1]).toBe('- Workspace: "a\\nb" (id 1)')
+  })
+})
+
+describe('client selection context injection', () => {
+  it('states the selected pair in the first request of the first turn', async () => {
+    const { ctx, adapter } = await harness()
+    const loop = await mountAgentLoopTestHarness(ctx)
+    const agent = await loop.create(SessionId('selection-first-turn'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'which workspace and brand am I using?', JACK)
+    await waitForIdle(ctx, agent)
+
+    expect(adapter.requests).toHaveLength(1)
+    const text = textsOf(adapter.requests[0]).join('\n')
+    expect(text).toContain('Current workspace and brand selected in the app\'s top bar')
+    expect(text).toContain('- Workspace: "jack" (id 90002)')
+    expect(text).toContain('- Brand: "Halliday" (id 4800023)')
+    // The user never typed the pair; their prompt stays one verbatim message,
+    // and the pair arrives as a separate context paragraph.
+    expect(textsOf(adapter.requests[0])).toContain('which workspace and brand am I using?')
+  })
+
+  it('replaces the stated pair after the user switches the selection', async () => {
+    const { ctx, adapter } = await harness()
+    const loop = await mountAgentLoopTestHarness(ctx)
+    const agent = await loop.create(SessionId('selection-switch'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'first question', JACK)
+    await waitForIdle(ctx, agent)
+    send(agent, 'second question', MIKE)
+    await waitForIdle(ctx, agent)
+
+    expect(adapter.requests).toHaveLength(2)
+    const first = textsOf(adapter.requests[0]).join('\n')
+    const second = textsOf(adapter.requests[1]).join('\n')
+    expect(first).toContain('"jack" (id 90002)')
+    expect(first).not.toContain('"mike"')
+    expect(second).toContain('"mike" (id 90003)')
+    expect(second).toContain('"Acme" (id 4800044)')
+    // The newest snapshot is the last context paragraph in the second request,
+    // and it explicitly supersedes the earlier one.
+    const latest = textsOf(adapter.requests[1]).findLast(block => block.includes('selected in the app\'s top bar'))
+    expect(latest).toContain('"mike" (id 90003)')
+    expect(latest).toContain('supersedes')
+  })
+
+  it('contributes nothing for a session whose prompts never carried a pair', async () => {
+    const { ctx, adapter } = await harness()
+    const loop = await mountAgentLoopTestHarness(ctx)
+    const agent = await loop.create(SessionId('selection-absent'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'plain question', undefined)
+    await waitForIdle(ctx, agent)
+
+    expect(adapter.requests).toHaveLength(1)
+    expect(textsOf(adapter.requests[0]).join('\n')).not.toContain('selected in the app\'s top bar')
+  })
+
+  it('leaves the pair in place on continuation steps that claim no new prompt', async () => {
+    const { ctx, adapter } = await harness()
+    const loop = await mountAgentLoopTestHarness(ctx)
+    const agent = await loop.create(SessionId('selection-continuation'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'first question', JACK)
+    await waitForIdle(ctx, agent)
+    send(agent, 'follow-up without a new selection', undefined)
+    await waitForIdle(ctx, agent)
+
+    expect(adapter.requests).toHaveLength(2)
+    expect(textsOf(adapter.requests[1]).join('\n')).toContain('"jack" (id 90002)')
+  })
+})
