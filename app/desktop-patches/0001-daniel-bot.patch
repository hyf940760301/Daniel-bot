+    expect(selectorCss).toMatch(/\.option\s*\{[^}]*\bheight:\s*36px/u)
+    expect(selectorCss).toMatch(/@media \(max-width: 480px\)[\s\S]*?\.value\s*\{[^}]*\bmax-width:\s*8em/u)
+  })
+})
+
+/* ── bilingual module names ──────────────────────────────────────────────── */
+
+describe('bilingual modules', () => {
+  it('ships Daniel\'s nine modules with both a Chinese and an English name', () => {
+    expect(MODULE_MAP.modules.map(module => [module.name, module.nameEn])).toEqual([
+      ['账号与盘点', 'Account'],
+      ['品牌档案', 'Brand Profile'],
+      ['红人检索', 'Creator Search'],
+      ['红人名单', 'Saved Lists'],
+      ['真实性核验', 'Authenticity'],
+      ['合作追踪', 'Campaigns'],
+      ['品牌提及', 'Brand Mentions'],
+      ['内容情报', 'Intelligence'],
+      ['声量份额', 'Share of Voice'],
+    ])
+    for (const module of MODULE_MAP.modules) {
+      expect(module.nameEn.trim()).not.toBe('')
+      expect(module.nameEn).toMatch(/^[A-Z][A-Za-z ]*$/u)
+      expect(moduleNameEn(module.name)).toBe(module.nameEn)
+      expect(moduleNameEnById(module.id)).toBe(module.nameEn)
+    }
+    // Unknown names never leak a prototype value.
+    expect(moduleNameEn('不存在的模块')).toBeUndefined()
+    expect(moduleNameEnById('constructor')).toBeUndefined()
+  })
+
+  it('publishes the same nine bilingual names in the guide dialog', () => {
+    expect(GUIDE.modules.map(module => [module.name, module.nameEn]))
+      .toEqual(MODULE_MAP.modules.map(module => [module.name, module.nameEn]))
+    // The dialog's local filter understands the English name too.
+    expect(filterGuide('Brand Profile')).toHaveLength(1)
+    expect(filterGuide('Brand Profile')[0]?.module.name).toBe('品牌档案')
+    expect(filterGuide('账号与盘点')).toHaveLength(1)
+  })
+
+  it('renders the English half beside the Chinese name on module rows and step tags', () => {
+    const rail = readFileSync(RAIL_CSS, 'utf8')
+    expect(rail).toContain('.moduleNameEn')
+    expect(rail).toContain('.stepTagEn')
+    // 10px, muted, single line, ellipsized — the English half never wraps.
+    expect(rail).toMatch(/\.moduleNameEn\s*\{[^}]*font-size:\s*10px/u)
+    expect(rail).toMatch(/\.moduleNameEn\s*\{[^}]*text-overflow:\s*ellipsis/u)
+    expect(rail).toMatch(/\.stepTagEn\s*\{[^}]*text-overflow:\s*ellipsis/u)
+  })
+
+  it('drops the English half and ellipsizes the Chinese one in the 48px strip', () => {
+    const rail = readFileSync(RAIL_CSS, 'utf8')
+    expect(rail).toContain(".dock[data-rail-width='48'] .moduleNameEn")
+    expect(rail).toContain(".dock[data-rail-width='48'] .stepTagZh")
+    expect(rail).toMatch(/\.dock\[data-rail-width='48'\] \.moduleNameEn,[\s\S]*?display:\s*none/u)
+  })
+
+  it('mounts no module row at all in the collapsed 48px strip', () => {
+    const props = {
+      t: (key: string): string => (zh as Record<string, string>)[key] ?? key,
+      open: false,
+      onToggle: () => {},
+      useTrace: (() => { throw new Error('the collapsed strip reads no trace') }) as never,
+      prefill: () => 'unavailable',
+      focusChat: () => true,
+      usePanelInfo: () => undefined,
+      useSessions: () => undefined,
+      useSessionStatus: () => undefined,
+      useSessionRetainInfo: () => undefined,
+      useWorkspaces: () => undefined,
+      useResource: () => undefined,
+      useContextMenu: () => ({ getTriggerProps: () => ({}) }),
+      useRemoteAccess: () => true,
+      useAccess: () => true,
+      useSessionAccess: () => true,
+      useWorkspaceAccess: () => true,
+    } as unknown as CapabilityMapProps
+    const view = render(<CapabilityMap {...props} />)
+    const strip = view.container.querySelector('[data-capability-map="collapsed"]')
+    expect(strip).not.toBeNull()
+    expect(strip?.getAttribute('data-rail-width')).toBe('48')
+    expect((strip?.textContent ?? '').includes('账号与盘点')).toBe(false)
+    expect((strip?.textContent ?? '').includes('Account')).toBe(false)
