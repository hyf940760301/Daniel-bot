index 00000000..6c486311
--- /dev/null
+++ b/apps/desktop/src/daniel-auth-api.ts
@@ -0,0 +1,36 @@
+/**
+ * Renderer contract of the in-app Daniel account bridge: channel names and the
+ * shape of every operation the account surfaces may call.
+ *
+ * The identity is the desktop sign-in gate's own session, never a DeepSeek
+ * Platform account: nothing here can start the upstream OAuth flow, and no
+ * operation returns a URL a renderer could navigate to.
+ */
+
+/** Private channels of the Daniel account bridge, installed once per application run. */
+export const DANIEL_AUTH_IPC = {
+  status: 'dsh-daniel-auth:status',
+  signIn: 'dsh-daniel-auth:sign-in',
+  signOut: 'dsh-daniel-auth:sign-out',
+} as const
+
+/**
+ * One signed-in Daniel account. `email` is empty only when a session is stored but
+ * the account service could not be reached to name it; the session is still valid.
+ */
+export interface DanielAccount {
+  readonly email: string
+}
+
+/** Result of a status read or an explicit sign-in; `null` means no stored session. */
+export type DanielAuthAccount = DanielAccount | null
+
+/** Operations the preload exposes as `window.danielAuth`. */
+export interface DanielAuthApi {
+  /** @returns the signed-in account, or `null` when no session is stored. Never opens a window. */
+  status(): Promise<DanielAuthAccount>
+  /** Open the native Daniel sign-in window. @returns the account, or `null` when it was closed without signing in. */
+  signIn(): Promise<DanielAuthAccount>
+  /** Delete the stored Daniel session and its cached identity. */
+  signOut(): Promise<void>
+}
diff --git a/apps/desktop/src/daniel-auth.ts b/apps/desktop/src/daniel-auth.ts
new file mode 100644
index 00000000..4f22e82d
--- /dev/null
+++ b/apps/desktop/src/daniel-auth.ts
@@ -0,0 +1,114 @@
+/**
+ * In-app Daniel account bridge: the account surfaces of the desktop window read,
+ * sign in, and sign out through the same session the startup gate owns.
+ *
+ * Sign-in reuses {@link requireDanielSession}, so the native window, its credential
+ * exchange, and the session file are the ones the gate already implements; this
+ * module only adds identity resolution and the renderer-facing IPC.
+ *
+ * 🔴 No operation here opens, links to, or returns a `platform.deepseek.com` URL.
+ */
+
+import { ipcMain, type IpcMainInvokeEvent } from 'electron'
+import { DANIEL_AUTH_IPC, type DanielAuthAccount } from './daniel-auth-api.ts'
+import {
+  clearDanielSession, fetchDanielAccountEmail, readDanielAccountEmail, readDanielSession,
+  requireDanielSession, verifyDanielSession, writeDanielAccountEmail,
+} from './daniel-login.ts'
+
+/** Main-process side of one installed bridge. */
+export interface DanielAuthHostOptions {
+  /** Reject a call from any frame that is not the owning product window. */
+  readonly assertSender: (event: IpcMainInvokeEvent) => unknown
+  /** Shell locale id for the sign-in window copy, read when the window opens. */
+  readonly localeId: () => string
+}
+
+/**
+ * Resolve the identity behind the stored session.
+ * The session file holds only a cookie, so the email is cached beside it; a cache
+ * miss is answered by the account service and then cached, and an unreachable
+ * service leaves the signed-in state intact with an empty email.
+ * @returns the account, or null when no session is stored.
+ */
+export async function readDanielAccountStatus(): Promise<DanielAuthAccount> {
+  const stored = readDanielSession()
+  if (stored === undefined) return null
+  const cached = readDanielAccountEmail()
+  if (cached !== undefined) return { email: cached }
+  const verification = await verifyDanielSession(stored.cookie)
+  if (verification.state === 'invalid') {
+    clearDanielSession()
+    return null
+  }
+  if (verification.state === 'valid' && verification.email !== undefined) {
+    writeDanielAccountEmail(verification.email)
+    return { email: verification.email }
+  }
+  return { email: '' }
+}
+
+let pendingSignIn: Promise<DanielAuthAccount> | undefined
+
+/**
+ * Open the native Daniel sign-in window and settle with the account it stored.
+ * A second caller joins the attempt already in flight, so two clicks cannot open
+ * two login windows.
+ * @param localeId - Shell locale id for the window copy.
+ * @returns the account, or null when the window was closed without signing in.
+ */
+export function signInDanielAccount(localeId: string): Promise<DanielAuthAccount> {
+  if (pendingSignIn === undefined) {
+    pendingSignIn = runDanielSignIn(localeId).finally(() => { pendingSignIn = undefined })
+  }
+  return pendingSignIn
+}
+
+/** @param localeId - Shell locale id for the window copy. @returns the signed-in account, if any. */
+async function runDanielSignIn(localeId: string): Promise<DanielAuthAccount> {
+  const gate = await requireDanielSession({ localeId })
+  // The operator closed the window: the account state did not change.
+  if (gate === undefined) return null
+  if (gate.email !== undefined) {
+    writeDanielAccountEmail(gate.email)
+    return { email: gate.email }
+  }
+  // An already-valid session answers `{}` without opening a window; name it from
+  // the cache, or ask the account service once when only the CLI has written it.
+  const cached = readDanielAccountEmail()
+  if (cached !== undefined) return { email: cached }
+  const stored = readDanielSession()
+  if (stored === undefined) return { email: '' }
+  const email = await fetchDanielAccountEmail(stored.cookie)
+  if (email === undefined) return { email: '' }
+  writeDanielAccountEmail(email)
+  return { email }
+}
+
+/** Delete the stored Daniel session and its cached identity. */
+export function signOutDanielAccount(): void {
+  clearDanielSession()
+}
+
+/**
+ * Install the bridge's IPC handlers.
+ * @param options - Owning-window guard and the locale source for the login window.
+ * @returns a disposer that removes every handler it installed.
+ */
+export function installDanielAuthIpc(options: DanielAuthHostOptions): () => void {
+  ipcMain.handle(DANIEL_AUTH_IPC.status, async (event): Promise<DanielAuthAccount> => {
+    options.assertSender(event)
+    return await readDanielAccountStatus()
+  })
+  ipcMain.handle(DANIEL_AUTH_IPC.signIn, async (event): Promise<DanielAuthAccount> => {
+    options.assertSender(event)
+    return await signInDanielAccount(options.localeId())
+  })
+  ipcMain.handle(DANIEL_AUTH_IPC.signOut, async (event): Promise<void> => {
+    options.assertSender(event)
+    signOutDanielAccount()
+  })
+  return () => {
+    for (const channel of Object.values(DANIEL_AUTH_IPC)) ipcMain.removeHandler(channel)
+  }
+}
diff --git a/apps/desktop/src/daniel-context-api.ts b/apps/desktop/src/daniel-context-api.ts
new file mode 100644
index 00000000..00fabb5e
--- /dev/null
+++ b/apps/desktop/src/daniel-context-api.ts
@@ -0,0 +1,57 @@
+/**
+ * Renderer contract of the Directory/context bridge: the read-only lists the
+ * top-bar workspace and brand selectors are built from.
+ *
+ * Two channels, both fixed-argument and read-only (`account workspaces`,
+ * `brands list`). The renderer cannot pass an argv, a workspace id, or a flag:
+ * a channel name is the whole request, so this surface cannot be talked into a
+ * write. A failure is an ordinary value (`{ ok: false, reason }`), never a
+ * thrown error across IPC.
+ */
+
+/** Channels of the context bridge, installed once per application run. */
+export const DANIEL_CONTEXT_IPC = {
+  workspaces: 'daniel:workspaces',
+  brands: 'daniel:brands',
+} as const
+
+/** One workspace row the account can see. */
+export interface DanielWorkspaceRow {
+  readonly id: number
+  readonly name: string
+}
+
+/** One brand row, with the workspace that owns it when the CLI reports one. */
+export interface DanielBrandRow {
+  readonly id: string
+  readonly name: string
+  readonly workspaceId?: number
+}
+
+/**
+ * Why a list could not be read. `timeout` and `cli` are the two failure shapes
+ * the selectors render differently (retry later vs. report the CLI message).
+ */
+export type DanielContextFailureReason =
+  | { readonly kind: 'timeout' }
+  | { readonly kind: 'cli'; readonly message: string }
+  | { readonly kind: 'malformed'; readonly message: string }
+
+/** Settled result of one list read. */
+export type DanielContextResult<T> =
+  | { readonly ok: true; readonly items: readonly T[] }
+  | { readonly ok: false; readonly reason: DanielContextFailureReason }
+
+/** Operations the preload exposes as `window.__dshDesktop`. */
+export interface DanielContextApi {
+  /**
+   * @param refresh - true bypasses the 60s memory cache (the selectors' 刷新).
+   * @returns the account's workspaces; never throws.
+   */
+  danielWorkspaces(refresh?: boolean): Promise<DanielContextResult<DanielWorkspaceRow>>
+  /**
+   * @param refresh - true bypasses the 60s memory cache (the selectors' 刷新).
+   * @returns the brands the index lists (up to 200, newest build); never throws.
+   */
+  danielBrands(refresh?: boolean): Promise<DanielContextResult<DanielBrandRow>>
+}
diff --git a/apps/desktop/src/daniel-context-ipc.ts b/apps/desktop/src/daniel-context-ipc.ts
new file mode 100644
index 00000000..2509a490
--- /dev/null
+++ b/apps/desktop/src/daniel-context-ipc.ts
@@ -0,0 +1,42 @@
+/**
+ * IPC half of the read-only Daniel directory bridge.
+ *
+ * Installed once per application run. Each channel answers from the shared
+ * catalog (`daniel-context.ts`), which owns the 8s deadline and the 60s
+ * memory cache; this file only guards the caller and maps the channel to a
+ * list kind. Renderer arguments are ignored except for one boolean refresh
+ * request, which cannot change which command runs.
+ */
+
+import { ipcMain, type IpcMainInvokeEvent } from 'electron'
+import { DANIEL_CONTEXT_IPC } from './daniel-context-api.ts'
+import type { DanielContextCatalog } from './daniel-context.ts'
+
+/** Main-process side of one installed bridge. */
+export interface DanielContextIpcOptions {
+  /** Reject a call from any frame that is not the owning product window. */
+  readonly assertSender: (event: IpcMainInvokeEvent) => unknown
+  /** The two lists' shared reader and cache. */
+  readonly catalog: DanielContextCatalog
+}
+
+/**
+ * Install the bridge's handlers.
+ * @param options - owning-window guard and the catalog to read.
+ * @returns a disposer that removes every handler it installed.
+ */
+export function installDanielContextIpc(options: DanielContextIpcOptions): () => void {
+  ipcMain.handle(DANIEL_CONTEXT_IPC.workspaces, async (event, refresh: unknown) => {
+    options.assertSender(event)
+    if (refresh === true) options.catalog.clear()
+    return await options.catalog.read('workspaces')
+  })
+  ipcMain.handle(DANIEL_CONTEXT_IPC.brands, async (event, refresh: unknown) => {
+    options.assertSender(event)
+    if (refresh === true) options.catalog.clear()
+    return await options.catalog.read('brands')
+  })
+  return () => {
+    for (const channel of Object.values(DANIEL_CONTEXT_IPC)) ipcMain.removeHandler(channel)
+  }
+}
diff --git a/apps/desktop/src/daniel-context.ts b/apps/desktop/src/daniel-context.ts
new file mode 100644
index 00000000..a30e6119
--- /dev/null
+++ b/apps/desktop/src/daniel-context.ts
@@ -0,0 +1,370 @@
+/**
+ * Read-only Daniel directory reads for the desktop shell.
+ *
+ * The top bar's workspace and brand selectors need the account's real lists.
+ * The renderer cannot read them itself (the Daniel CLI is a local Python
+ * entry), so the main process runs two fixed commands and hands back plain
+ * rows:
+ *
+ *   daniel account workspaces --json
+ *   daniel brands list --json --limit 200
+ *
+ * Discipline (design §9, approved plan A):
+ * - **read-only**: the channel name is the whole request. There is no argv,
+ *   workspace id, or flag from the renderer, and neither constant below can
+ *   carry a write verb.
+ * - **bounded**: one call may take 8s; a child that outlives it is killed and
+ *   reported as `{ ok: false, reason: { kind: 'timeout' } }`.
+ * - **never throws**: every failure — missing entry, non-zero exit, malformed
+ *   stdout, timeout — settles as a value.
+ * - **cached 60s in memory**: the lists change rarely and the dropdown can
+ *   reopen many times; the cache dies with the main process. Nothing is
+ *   written to disk here.
+ *
+ * The CLI is resolved exactly the way the embedded plugin resolves it
+ * (`daniel-plugin.ts`): `$DANIEL_BIN`, else `<profile>/node_modules/
+ * daniel-dsh-plugin/vendor/data/daniel-cli/bin/daniel`. No absolute path is
+ * baked into this file.
+ */
+
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { resolveDanielHome } from './daniel-home.ts'
+import { DANIEL_PLUGIN_NAME } from './daniel-plugin.ts'
+import {
+  DANIEL_CONTEXT_IPC,
+  type DanielBrandRow,
+  type DanielContextFailureReason,
+  type DanielContextResult,
+  type DanielWorkspaceRow,
+} from './daniel-context-api.ts'
+
+/** One bounded call. Eight seconds is enough for a warm CLI and short enough that a selector does not hang. */
+export const DANIEL_CONTEXT_TIMEOUT_MS = 8_000
+
+/** How long a successful list is reused. The cache is memory-only. */
+export const DANIEL_CONTEXT_CACHE_TTL_MS = 60_000
+
+/** The two commands this module may run, by channel. */
+export const DANIEL_CONTEXT_ARGV = Object.freeze({
+  workspaces: Object.freeze(['account', 'workspaces', '--json']),
+  brands: Object.freeze(['brands', 'list', '--json', '--limit', '200']),
+}) as Readonly<Record<keyof typeof DANIEL_CONTEXT_IPC, readonly string[]>>
+
+/** Which list a caller asks for. */
+export type DanielContextKind = keyof typeof DANIEL_CONTEXT_IPC
+
+/** Interpreter that runs the vendored Daniel CLI, same default as the plugin. */
+function danielPython(env: NodeJS.ProcessEnv = process.env): string {
+  const configured = env['DANIEL_PYTHON']?.trim()
+  return configured === undefined || configured === '' ? 'python3' : configured
+}
+
+/**
+ * Resolve the Daniel CLI entry the embedded plugin already installed.
+ * @param profileDir - Desktop profile directory holding `node_modules`.
+ * @param env - Environment supplying `$DANIEL_BIN`; defaults to this process's.
+ * @returns Absolute CLI entry path (whether or not it exists yet).
+ */
+export function danielCliEntry(profileDir: string, env: NodeJS.ProcessEnv = process.env): string {
+  const configured = env['DANIEL_BIN']?.trim()
+  if (configured !== undefined && configured !== '') return configured
+  return join(profileDir, 'node_modules', DANIEL_PLUGIN_NAME, 'vendor', 'data', 'daniel-cli', 'bin', 'daniel')
+}
+
+/** Child-process environment: the CLI reads local data only, so model keys stay out. */
+const SECRET_ENV = Object.freeze([
+  'DEEPSEEK_API_KEY', 'DEEPSEEK_KEY', 'DEEPSEEK_TOKEN',
+  'DSH_API_KEY', 'DSH_DEEPSEEK_API_KEY', 'DSH_MODEL_KEY', 'DSH_LLM_KEY',
+  'OPENAI_API_KEY', 'OPENAI_KEY', 'ANTHROPIC_API_KEY', 'ANTHROPIC_KEY',
+  'GOOGLE_API_KEY', 'GEMINI_API_KEY', 'DASHSCOPE_API_KEY', 'MOONSHOT_API_KEY',
+  'SILICONFLOW_API_KEY', 'ARK_API_KEY', 'ZHIPU_API_KEY', 'MINIMAX_API_KEY', 'XAI_API_KEY',
+])
+
+/**
+ * Build the child environment for one read.
+ * @param danielHome - Daniel data home the CLI reads (sessions, index, audit).
+ * @param base - Parent environment; defaults to this process's.
+ * @returns a copy without model credentials, with the CLI's non-interactive flags.
+ */
+export function danielContextEnv(danielHome: string, base: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = { ...base }
+  for (const name of SECRET_ENV) delete env[name]
+  env['DANIEL_HOME'] = danielHome
+  // The plugin never opens a browser; a directory read must not either.
+  env['DANIEL_NO_OPEN'] = '1'
+  return env
+}
+
+/** What one CLI run settled to. */
+export interface DanielCliRun {
+  /** Parsed stdout, or undefined when the body was not JSON. */
+  readonly stdout: string
+  readonly stderr: string
+  readonly timedOut: boolean
+  readonly exitCode: number | undefined
+}
+
+/** Injectable process surface, so the timeout path is testable without spawning. */
+export interface DanielContextRunner {
+  /**
+   * Run one command with a hard deadline.
+   * @param argv - the fixed argument vector.
+   * @param timeoutMs - deadline after which the child is killed.
+   * @returns the settled run; never throws.
+   */
+  (argv: readonly string[], timeoutMs: number): Promise<DanielCliRun>
+}
+
+/** Runner dependencies. */
+export interface DanielRunnerOptions {
+  readonly entry: string
+  readonly python?: string
+  readonly env?: NodeJS.ProcessEnv
+  /** Spawn implementation; defaults to `node:child_process`. */
+  readonly spawnChild?: (command: string, args: readonly string[], env: NodeJS.ProcessEnv) => ChildProcessWithoutNullStreamsLike
+}
+
+/** The slice of a spawned child this module uses. */
+export interface ChildProcessWithoutNullStreamsLike {
+  readonly stdout: { on(event: 'data', listener: (chunk: unknown) => void): unknown }
+  readonly stderr: { on(event: 'data', listener: (chunk: unknown) => void): unknown }
+  on(event: 'error', listener: (error: Error) => void): unknown
+  on(event: 'close', listener: (code: number | null) => void): unknown
+  kill(signal?: NodeJS.Signals): boolean
+}
+
+/**
+ * Build the default runner over a real child process.
+ * @param options - entry, interpreter, environment, and (tests only) a spawn stand-in.
+ * @returns a runner that never rejects.
+ */
+export function createDanielRunner(options: DanielRunnerOptions): DanielContextRunner {
+  const python = options.python ?? danielPython()
+  const env = options.env ?? process.env
+  const spawnChild = options.spawnChild ?? ((command, args, childEnv) =>
+    spawn(command, [...args], { env: childEnv, stdio: ['ignore', 'pipe', 'pipe'] }) as unknown as ChildProcessWithoutNullStreamsLike)
+  return async (argv, timeoutMs) => {
+    if (!existsSync(options.entry)) {
+      return {
+        stdout: '', stderr: `Daniel CLI entry not found: ${options.entry}`, timedOut: false, exitCode: undefined,
+      }
+    }
+    return await new Promise<DanielCliRun>((resolve) => {
+      let stdout = ''
+      let stderr = ''
+      let settled = false
+      let timedOut = false
+      let child: ChildProcessWithoutNullStreamsLike
+      const finish = (exitCode: number | undefined): void => {
+        if (settled) return
+        settled = true
+        clearTimeout(timer)
+        resolve({ stdout, stderr, timedOut, exitCode })
+      }
+      const timer = setTimeout(() => {
+        timedOut = true
+        try { child.kill('SIGKILL') } catch { /* already gone */ }
+        // A child that ignores SIGKILL cannot hold the renderer: settle now.
+        finish(undefined)
+      }, timeoutMs)
+      try {
+        child = spawnChild(python, [options.entry, ...argv], env)
+      } catch (error) {
+        clearTimeout(timer)
+        resolve({ stdout: '', stderr: String((error as Error).message ?? error), timedOut: false, exitCode: undefined })
+        return
+      }
+      child.stdout.on('data', (chunk) => { stdout += String(chunk) })
+      child.stderr.on('data', (chunk) => { stderr += String(chunk) })
+      child.on('error', (error) => { stderr += `\n${error.message}` })
+      child.on('close', (code) => { finish(typeof code === 'number' ? code : undefined) })
+    })
+  }
+}
+
+/** Records one value against the clock; the entry expires. */
+interface CacheEntry<T> {
+  readonly at: number
+  readonly value: T
+}
+
+/**
+ * One list's memory cache and in-flight join.
+ * A second caller during the same read joins the first instead of spawning a
+ * second CLI process.
+ */
+export class DanielContextCatalog {
+  private readonly cache = new Map<DanielContextKind, CacheEntry<DanielContextResult<unknown>>>()
+  private readonly pending = new Map<DanielContextKind, Promise<DanielContextResult<unknown>>>()
+
+  /**
+   * @param run - command runner (see {@link createDanielRunner}).
+   * @param now - clock, injectable for tests.
+   */
+  constructor(
+    private readonly run: DanielContextRunner,
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  /**
+   * Read one list, from cache when fresh.
+   * @param kind - which list to read.
+   * @returns the rows, or a typed failure; never throws.
+   */
+  async read(kind: DanielContextKind): Promise<DanielContextResult<DanielWorkspaceRow> | DanielContextResult<DanielBrandRow>> {
+    const cached = this.cache.get(kind)
+    if (cached !== undefined && this.now() - cached.at < DANIEL_CONTEXT_CACHE_TTL_MS) {
+      return cached.value as DanielContextResult<DanielWorkspaceRow> | DanielContextResult<DanielBrandRow>
+    }
+    const joined = this.pending.get(kind)
+    if (joined !== undefined) {
+      return await joined as DanielContextResult<DanielWorkspaceRow> | DanielContextResult<DanielBrandRow>
+    }
+    const reading = this.load(kind).finally(() => { this.pending.delete(kind) })
+    this.pending.set(kind, reading as Promise<DanielContextResult<unknown>>)
+    return await reading as DanielContextResult<DanielWorkspaceRow> | DanielContextResult<DanielBrandRow>
+  }
+
+  /** Drop every cached list (the "刷新" button). */
+  clear(): void {
+    this.cache.clear()
+  }
+
+  /** Load one list past the cache and remember a success. */
+  private async load(kind: DanielContextKind): Promise<DanielContextResult<unknown>> {
+    const run = await this.run(DANIEL_CONTEXT_ARGV[kind], DANIEL_CONTEXT_TIMEOUT_MS)
+    if (run.timedOut) return failure({ kind: 'timeout' })
+    const parsed = parseCliJson(run.stdout)
+    if (parsed === undefined) {
+      // A runner-level failure (missing entry, spawn error) has no exit code and
+      // explains itself on stderr; that is a CLI failure, not a broken payload.
+      if (run.exitCode === undefined && run.stderr.trim() !== '') {
+        return failure({ kind: 'cli', message: run.stderr.trim().slice(-400) })
+      }
+      return failure({ kind: 'malformed', message: run.stderr.trim().slice(-400) || 'unparseable CLI output' })
+    }
+    if (!parsed.ok) {
+      return failure({ kind: 'cli', message: parsed.message })
+    }
+    const items = kind === 'workspaces' ? parseWorkspaces(parsed.data) : parseBrands(parsed.data)
+    if (items === undefined) return failure({ kind: 'malformed', message: 'missing row list in CLI payload' })
+    const value: DanielContextResult<unknown> = { ok: true, items }
+    this.cache.set(kind, { at: this.now(), value })
+    return value
+  }
+}
+
+/**
+ * Wrap one failure reason.
+ * @param reason - typed cause.
+ * @returns the failure envelope.
+ */
+function failure<T>(reason: DanielContextFailureReason): DanielContextResult<T> {
+  return { ok: false, reason }
+}
+
+/** Parsed JSON envelope of one CLI call. */
+type CliEnvelope =
+  | { readonly ok: true; readonly data: unknown }
+  | { readonly ok: false; readonly message: string }
+
+/**
+ * Parse the CLI's stdout envelope (`{ ok, data }` or `{ ok: false, error:{message} }`).
+ * @param stdout - raw stdout.
+ * @returns the envelope, or undefined when the body is not the expected JSON.
+ */
+export function parseCliJson(stdout: string): CliEnvelope | undefined {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(stdout)
+  } catch {
+    return undefined
+  }
+  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return undefined
+  const record = parsed as Record<string, unknown>
+  if (record['ok'] === true) return { ok: true, data: record['data'] }
+  if (record['ok'] === false) {
+    const error = record['error']
+    const message = typeof error === 'object' && error !== null
+      ? (error as Record<string, unknown>)['message']
+      : undefined
+    return { ok: false, message: typeof message === 'string' && message.trim() !== '' ? message.trim() : 'Daniel CLI reported a failure' }
+  }
+  return undefined
+}
+
+/**
+ * Read the workspace rows out of an `account workspaces` payload.
+ * @param data - the envelope's `data`.
+ * @returns the rows, or undefined when the payload carries no `workspaces` array.
+ */
+export function parseWorkspaces(data: unknown): readonly DanielWorkspaceRow[] | undefined {
+  if (typeof data !== 'object' || data === null) return undefined
+  const rows = (data as Record<string, unknown>)['workspaces']
+  if (!Array.isArray(rows)) return undefined
+  const parsed: DanielWorkspaceRow[] = []
+  for (const row of rows) {
+    if (typeof row !== 'object' || row === null) continue
+    const record = row as Record<string, unknown>
+    const id = typeof record['id'] === 'number' ? record['id'] : Number(record['id'])
+    const name = record['name']
+    if (!Number.isFinite(id)) continue
+    if (typeof name !== 'string' || name.trim() === '') continue
+    parsed.push({ id, name: name.trim() })
+  }
+  return parsed
+}
+
+/**
+ * Read the brand rows out of a `brands list` payload.
+ * @param data - the envelope's `data`.
+ * @returns the rows, or undefined when the payload carries no `brands` array.
+ */
+export function parseBrands(data: unknown): readonly DanielBrandRow[] | undefined {
+  if (typeof data !== 'object' || data === null) return undefined
+  const rows = (data as Record<string, unknown>)['brands']
+  if (!Array.isArray(rows)) return undefined
+  const parsed: DanielBrandRow[] = []
+  for (const row of rows) {
+    if (typeof row !== 'object' || row === null) continue
+    const record = row as Record<string, unknown>
+    const raw = record['id']
+    const name = record['name']
+    if (typeof raw !== 'number' && typeof raw !== 'string') continue
+    if (typeof name !== 'string' || name.trim() === '') continue
+    const workspace = record['workspaceId']
+    const workspaceId = typeof workspace === 'number' && Number.isFinite(workspace) ? workspace : undefined
+    parsed.push({
+      id: String(raw),
+      name: name.trim(),
+      ...workspaceId === undefined ? {} : { workspaceId },
+    })
+  }
+  return parsed
+}
+
+/** Options of one installed bridge. */
+export interface DanielContextInstallOptions {
+  /** Reject a call from any frame that is not the owning product window. */
+  readonly assertSender: () => void
+  /** Desktop profile directory, the anchor the CLI entry is resolved from. */
+  readonly profileDir: string
+  /** Clock override for tests. */
+  readonly now?: () => number
+  /** Runner override for tests. */
+  readonly runner?: DanielContextRunner
+}
+
+/**
+ * Build the catalog used by one application run.
+ * @param profileDir - desktop profile directory.
+ * @returns the catalog (shared by both channels).
+ */
+export function createDanielContextCatalog(profileDir: string): DanielContextCatalog {
+  return new DanielContextCatalog(createDanielRunner({
+    entry: danielCliEntry(profileDir),
+    env: danielContextEnv(resolveDanielHome()),
+  }))
+}
diff --git a/apps/desktop/src/daniel-home.ts b/apps/desktop/src/daniel-home.ts
new file mode 100644
index 00000000..44c09580
--- /dev/null
+++ b/apps/desktop/src/daniel-home.ts
@@ -0,0 +1,116 @@
+/** Daniel Bot's private data roots, separated from the shared `~/.dsh` installation. */
+
+import { chmodSync, mkdirSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+
+/** Data-root directory name that owns every Daniel Bot file on this machine. */
+export const DANIEL_BOT_DIRECTORY = 'Daniel Bot'
+
+/** Harness home override; unset resolves to `~/Library/Application Support/Daniel Bot/dsh-home`. */
+export const DSH_HOME_ENV = 'DSH_HOME'
+
+/** Daniel data home override; unset resolves to `~/Library/Application Support/Daniel Bot/daniel-home`. */
+export const DANIEL_HOME_ENV = 'DANIEL_HOME'
+
+/** The two roots one Daniel Bot launch owns. */
+export interface DanielHomes {
+  /** Harness home holding `profiles/desktop` and the Host's runtime state. */
+  readonly dshHome: string
+  /** Daniel data home holding sessions, the app overlay, and audit records. */
+  readonly danielHome: string
+}
+
+function configured(env: NodeJS.ProcessEnv, name: string): string | undefined {
+  const value = env[name]?.trim()
+  return value === undefined || value === '' ? undefined : value
+}
+
+/**
+ * Resolve the platform data root that holds Daniel Bot's own directories.
+ * The default never depends on `$DSH_HOME`, so an inherited environment cannot
+ * move the product's directory tree.
+ * @param platform - Operating system naming the data root; defaults to this process's.
+ * @param home - OS home directory; defaults to {@link homedir}.
+ * @param env - Environment supplying `APPDATA` and `XDG_DATA_HOME`; defaults to this process's.
+ * @returns Absolute directory, whether or not it exists.
+ */
+export function danielDataRoot(
+  platform: NodeJS.Platform = process.platform,
+  home: string = homedir(),
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  if (platform === 'darwin') return join(home, 'Library', 'Application Support', DANIEL_BOT_DIRECTORY)
+  if (platform === 'win32') return join(env.APPDATA ?? join(home, 'AppData', 'Roaming'), DANIEL_BOT_DIRECTORY)
+  return join(env.XDG_DATA_HOME ?? join(home, '.local', 'share'), DANIEL_BOT_DIRECTORY)
+}
+
+/**
+ * Resolve the Harness home: `$DSH_HOME`, else Daniel Bot's private `dsh-home`.
+ * A blank or whitespace-only override counts as unset, as in `@deepseek-ai/dsh-home-paths`.
+ * @param env - Environment supplying `$DSH_HOME`; defaults to this process's.
+ * @param platform - Operating system naming the default root; defaults to this process's.
+ * @param home - OS home directory; defaults to {@link homedir}.
+ * @returns Absolute Harness home path.
+ */
+export function resolveDanielDshHome(
+  env: NodeJS.ProcessEnv = process.env,
+  platform: NodeJS.Platform = process.platform,
+  home: string = homedir(),
+): string {
+  return configured(env, DSH_HOME_ENV) ?? join(danielDataRoot(platform, home, env), 'dsh-home')
+}
+
+/**
+ * Resolve Daniel's data home: `$DANIEL_HOME`, else Daniel Bot's private `daniel-home`.
+ * @param env - Environment supplying `$DANIEL_HOME`; defaults to this process's.
+ * @param platform - Operating system naming the default root; defaults to this process's.
+ * @param home - OS home directory; defaults to {@link homedir}.
+ * @returns Absolute Daniel data home path.
+ */
+export function resolveDanielHome(
+  env: NodeJS.ProcessEnv = process.env,
+  platform: NodeJS.Platform = process.platform,
+  home: string = homedir(),
+): string {
+  return configured(env, DANIEL_HOME_ENV) ?? join(danielDataRoot(platform, home, env), 'daniel-home')
+}
+
+/**
+ * Create one product-owned directory and enforce owner-only access.
+ * The recursive mode applies to new directories only, so the final directory is
+ * also chmod'ed to 0700 when an earlier launch (or a restore) left it wider.
+ * @param directory - Absolute directory to create.
+ * @throws When the directory cannot be created or its mode cannot be set.
+ */
+export function ensurePrivateDirectory(directory: string): void {
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  chmodSync(directory, 0o700)
+}
+
+/**
+ * Create both data roots and publish them to the process environment, so the
+ * Host child process and every later resolution in this launch agree.
+ * Must run before the first `resolveDesktopPaths()` and before the Host spawns.
+ * Existing `~/.dsh` content is deliberately left alone: this product starts from
+ * a fresh profile and imports nothing (D-019).
+ * @param env - Environment to write `$DSH_HOME` and `$DANIEL_HOME` into; defaults to this process's.
+ * @param platform - Operating system naming the default roots; defaults to this process's.
+ * @param home - OS home directory; defaults to {@link homedir}.
+ * @returns The resolved absolute roots.
+ */
+export function installDanielHomes(
+  env: NodeJS.ProcessEnv = process.env,
+  platform: NodeJS.Platform = process.platform,
+  home: string = homedir(),
+): DanielHomes {
+  const homes: DanielHomes = {
+    dshHome: resolveDanielDshHome(env, platform, home),
+    danielHome: resolveDanielHome(env, platform, home),
+  }
+  ensurePrivateDirectory(homes.dshHome)
+  ensurePrivateDirectory(homes.danielHome)
+  env[DSH_HOME_ENV] = homes.dshHome
+  env[DANIEL_HOME_ENV] = homes.danielHome
+  return homes
+}
