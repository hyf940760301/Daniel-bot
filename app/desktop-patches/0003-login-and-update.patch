index 00000000..55be483e
--- /dev/null
+++ b/apps/desktop/src/daniel-login.ts
@@ -0,0 +1,526 @@
+/**
+ * Daniel account sign-in for the native shell, and the session file it guards.
+ *
+ * This runs before the Harness Host exists: the sign-in window is a plain local
+ * document from `renderer/`, and the account protocol is the one the Daniel CLI
+ * already uses (`daniel-bot/app/src/lib/auth.js`):
+ *
+ *   POST /api/trpc/auth.login   {"json":{"email","password"}}
+ *   GET  /api/trpc/auth.me      {"json":null}
+ *
+ * 🔴 The server answers HTTP 500 for a wrong password, so the reason must be read
+ *    from the tRPC error envelope; a status code alone reports "wrong password" as
+ *    "server failure". A transport fault is reported as a network problem instead.
+ *
+ * Secrets: the password lives only in this module's call stack for the duration of
+ * one request. The session cookie is written to `$DANIEL_HOME/session/session.json`
+ * with mode 0600 inside a 0700 directory (the layout the Daniel CLI shares), and
+ * neither the password nor the cookie value is ever logged.
+ */
+
+import { chmodSync, mkdirSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { app, BrowserWindow, ipcMain, net, type BrowserWindowConstructorOptions, type IpcMainInvokeEvent } from 'electron'
+import { DANIEL_LOGIN_IPC, type DanielLoginFailure, type DanielLoginSubmitResult } from './daniel-login-api.ts'
+import { resolveDanielHome } from './daniel-home.ts'
+
+/** Account service; a local Daniel deployment overrides it through `DANIEL_BASE_URL`. */
+const BASE = (process.env.DANIEL_BASE_URL?.trim() || 'https://daniel-agent.com').replace(/\/+$/, '')
+
+/** Bounds of one credential exchange and of a silent session check on launch. */
+const LOGIN_TIMEOUT_MS = 30_000
+const VERIFY_TIMEOUT_MS = 8_000
+
+/** Session file layout shared with the Daniel CLI: owner-only file inside an owner-only directory. */
+const SESSION_COOKIE_PREFIX = 'app_session_id='
+const SESSION_DIRECTORY_MODE = 0o700
+const SESSION_FILE_MODE = 0o600
+
+/** Test/automation escape hatch; unset in every shipped launch. */
+const SKIP_LOGIN_ENV = 'DANIEL_BOT_SKIP_LOGIN'
+
+/** One stored session; `ts` is epoch seconds, matching the CLI's own file. */
+export interface DanielSession {
+  readonly cookie: string
+  readonly ts: number
+}
+
+/** Startup gate result; `email` is present when the server reported the account. */
+export interface DanielSessionGate {
+  readonly email?: string
+}
+
+/** Options for the sign-in window. */
+export interface DanielLoginOptions {
+  /** Shell locale id (`zh-CN`, `en`, …) selecting the window copy. */
+  readonly localeId?: string
+}
+
+/** Why a credential exchange failed; carried to the page so a network fault reads as one. */
+export class DanielAuthError extends Error {
+  readonly failure: DanielLoginFailure
+  readonly status: number
+
+  constructor(message: string, failure: DanielLoginFailure, status = 0) {
+    super(message)
+    this.name = 'DanielAuthError'
+    this.failure = failure
+    this.status = status
+  }
+}
+
+interface HttpResponse {
+  readonly status: number
+  readonly headers: Record<string, string | string[] | undefined>
+  readonly body: string
+}
+
+interface RequestOptions {
+  readonly method: 'GET' | 'POST'
+  readonly url: string
+  readonly headers?: Record<string, string>
+  readonly body?: string
+  readonly timeoutMs: number
+}
+
+type SessionVerification = 'valid' | 'invalid' | 'unreachable'
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
+}
+
+/** @returns the absolute session file path under `$DANIEL_HOME`. */
+export function danielSessionFile(): string {
+  return join(resolveDanielHome(), 'session', 'session.json')
+}
+
+/**
+ * Read the stored session without trusting its contents.
+ * @param file - Session path; defaults to {@link danielSessionFile}.
+ * @returns the session, or undefined when absent, unreadable, or not a Daniel cookie.
+ */
+export function readDanielSession(file: string = danielSessionFile()): DanielSession | undefined {
+  try {
+    const data = record(JSON.parse(readFileSync(file, 'utf8')))
+    const cookie = data?.['cookie']
+    if (typeof cookie !== 'string' || !cookie.startsWith(SESSION_COOKIE_PREFIX)) return undefined
+    const ts = data?.['ts']
+    return { cookie, ts: typeof ts === 'number' && Number.isFinite(ts) ? ts : 0 }
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Store a session atomically and verify what landed on disk.
+ * The file is written through a temporary sibling in the same directory and then
+ * renamed, so an interrupted write cannot leave a truncated credential behind.
+ * @param cookie - `app_session_id=<value>` exactly as the server set it.
+ * @param file - Session path; defaults to {@link danielSessionFile}.
+ */
+export function writeDanielSession(cookie: string, file: string = danielSessionFile()): void {
+  const directory = dirname(file)
+  mkdirSync(directory, { recursive: true, mode: SESSION_DIRECTORY_MODE })
+  try { chmodSync(directory, SESSION_DIRECTORY_MODE) } catch { /* an existing directory may already be tightened */ }
+
+  const temporary = `${file}.tmp-${String(process.pid)}`
+  writeFileSync(temporary, `${JSON.stringify({ cookie, ts: Date.now() / 1000 }, null, 1)}\n`, { mode: SESSION_FILE_MODE })
+  chmodSync(temporary, SESSION_FILE_MODE)
+  renameSync(temporary, file)
+  chmodSync(file, SESSION_FILE_MODE)
+
+  // Read back: a write this process cannot read is not a stored session.
+  const stored = readDanielSession(file)
+  if (stored === undefined || stored.cookie !== cookie) throw new Error('daniel login: the session file did not read back')
+  // Windows keeps ACLs rather than POSIX mode bits, so the mode is only meaningful elsewhere.
+  if (process.platform !== 'win32') {
+    const mode = statSync(file).mode & 0o777
+    if (mode !== SESSION_FILE_MODE) {
+      throw new Error(`daniel login: the session file kept mode ${mode.toString(8)}, expected 600`)
+    }
+  }
+}
+
+/** Remove a session the server rejected so the next launch starts from a known state. */
+export function clearDanielSession(file: string = danielSessionFile()): void {
+  try {
+    unlinkSync(file)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+  }
+}
+
+/**
+ * One HTTP exchange over Electron's network stack (requests go through the same
+ * proxy and TLS configuration as the rest of the application).
+ * @param options - Method, absolute URL, optional headers and body, and a hard timeout.
+ * @returns the status, headers, and decoded body.
+ */
+function request(options: RequestOptions): Promise<HttpResponse> {
+  return new Promise<HttpResponse>((resolve, reject) => {
+    let settled = false
+    let req: ReturnType<typeof net.request> | undefined
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const finish = (settle: () => void): void => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      settle()
+    }
+    timer = setTimeout(() => {
+      try { req?.abort() } catch { /* the request may already be closed */ }
+      const error = new Error('request timed out') as Error & { code: string }
+      error.code = 'ETIMEDOUT'
+      finish(() => { reject(error) })
+    }, options.timeoutMs)
+
+    try {
+      req = net.request({ method: options.method, url: options.url, redirect: 'manual' })
+    } catch (error) {
+      finish(() => { reject(error as Error) })
+      return
+    }
+    for (const [name, value] of Object.entries(options.headers ?? {})) {
+      try { req.setHeader(name, value) } catch { /* Electron refuses a few header names; they are optional */ }
+    }
+    req.on('response', (response) => {
+      const chunks: Buffer[] = []
+      response.on('data', (chunk: Buffer) => { chunks.push(Buffer.from(chunk)) })
+      response.on('error', (error: Error) => { finish(() => { reject(error) }) })
+      response.on('end', () => {
+        finish(() => {
+          resolve({
+            status: response.statusCode,
+            headers: response.headers as Record<string, string | string[] | undefined>,
+            body: Buffer.concat(chunks).toString('utf8'),
+          })
+        })
+      })
+    })
+    req.on('error', (error: Error) => { finish(() => { reject(error) }) })
+    if (options.body !== undefined) req.write(options.body)
+    req.end()
+  })
+}
+
+/** @returns the `app_session_id` cookie from a login response, or an empty string. */
+function sessionCookie(headers: HttpResponse['headers']): string {
+  const raw = headers['set-cookie']
+  const lines = raw === undefined ? [] : Array.isArray(raw) ? raw : [raw]
+  for (const line of lines) {
+    for (const part of String(line).split(';')) {
+      const token = part.trim()
+      if (token.startsWith(SESSION_COOKIE_PREFIX) && token.length > SESSION_COOKIE_PREFIX.length) return token
+    }
+  }
+  return ''
+}
+
+/** @returns the server's own message from a tRPC error envelope (batch or single). */
+function trpcMessage(body: string): string {
+  try {
+    let data: unknown = JSON.parse(body)
+    if (Array.isArray(data)) data = data[0]
+    const error = record(record(data)?.['error'])
+    const detail = record(error?.['json']) ?? error
+    const message = detail?.['message']
+    return typeof message === 'string' ? message.trim() : ''
+  } catch {
+    return ''
+  }
+}
+
+/** @returns the tRPC error code name, such as `UNAUTHORIZED`, or an empty string. */
+function trpcErrorCode(body: string): string {
+  try {
+    let data: unknown = JSON.parse(body)
+    if (Array.isArray(data)) data = data[0]
+    const detail = record(record(record(data)?.['error'])?.['json'])
+    const code = record(detail?.['data'])?.['code']
+    if (typeof code === 'string') return code
+    const numeric = detail?.['code']
+    return typeof numeric === 'number' ? String(numeric) : ''
+  } catch {
+    return ''
+  }
+}
+
+/** @returns the payload of a successful tRPC result, unwrapping `data.json` when present. */
+function trpcResult(body: string): Record<string, unknown> | undefined {
+  try {
+    let data: unknown = JSON.parse(body)
+    if (Array.isArray(data)) data = data[0]
+    const payload = record(record(record(data)?.['result'])?.['data'])
+    return record(payload?.['json']) ?? payload
+  } catch {
+    return undefined
+  }
+}
+
+/** @returns true when a server message describes rejected credentials. */
+function isCredentialMessage(message: string): boolean {
+  return /invalid email or password|incorrect password|invalid credentials|wrong password|邮箱或密码|密码不正确/i.test(message)
+}
+
+/**
+ * Exchange an email and password for a Daniel session.
+ *
+ * The account is read back after the cookie is issued so a session that belongs to
+ * a different account can never be stored under this one.
+ * @param credentials - Email as typed and the password for this attempt only.
+ * @returns the issued cookie and the confirmed account email.
+ * @throws {DanielAuthError} classified as credential, network, server, or mismatch.
+ */
+async function loginDanielAccount(credentials: { readonly email: string; readonly password: string }): Promise<{ cookie: string; email: string }> {
+  const payload = JSON.stringify({ json: { email: credentials.email, password: credentials.password } })
+  let response: HttpResponse
+  try {
+    response = await request({
+      method: 'POST',
+      url: `${BASE}/api/trpc/auth.login`,
+      headers: { 'Content-Type': 'application/json', Origin: BASE, Referer: `${BASE}/auth` },
+      body: payload,
+      timeoutMs: LOGIN_TIMEOUT_MS,
+    })
+  } catch (error) {
+    const timedOut = (error as NodeJS.ErrnoException).code === 'ETIMEDOUT'
+    // The page replaces this with localized copy; the kind is what must be right.
+    throw new DanielAuthError(
+      timedOut ? '连接 Daniel 超时' : '连不上 Daniel（网络不可达）',
+      'network',
+    )
+  }
+
+  const accepted = response.status >= 200 && response.status < 300
+  const cookie = accepted ? sessionCookie(response.headers) : ''
+  if (!accepted || cookie === '') {
+    const message = trpcMessage(response.body)
+    if (message !== '') throw new DanielAuthError(message, isCredentialMessage(message) ? 'credential' : 'server', response.status)
+    if (accepted) throw new DanielAuthError('the server returned no session', 'server', response.status)
+    throw new DanielAuthError(`the server returned HTTP ${String(response.status)}`, 'server', response.status)
+  }
+
+  const input = encodeURIComponent(JSON.stringify({ 0: { json: null } }))
+  let account: Record<string, unknown> | undefined
+  try {
+    const check = await request({
+      method: 'GET',
+      url: `${BASE}/api/trpc/auth.me?batch=1&input=${input}`,
+      headers: { Cookie: cookie, Origin: BASE, Referer: `${BASE}/` },
+      timeoutMs: VERIFY_TIMEOUT_MS,
+    })
+    if (check.status < 200 || check.status >= 300) {
+      throw new DanielAuthError(`the account could not be read back (HTTP ${String(check.status)})`, 'server', check.status)
+    }
+    account = trpcResult(check.body)
+  } catch (error) {
+    if (error instanceof DanielAuthError) throw error
+    throw new DanielAuthError('the account could not be read back', 'network')
+  }
+
+  const email = account?.['email']
+  if (typeof email !== 'string' || email === '') throw new DanielAuthError('the server reported no account', 'mismatch')
+  if (email.trim().toLowerCase() !== credentials.email.trim().toLowerCase()) {
+    throw new DanielAuthError('the session belongs to a different account', 'mismatch')
+  }
+  return { cookie, email: email.trim() }
+}
+
+/**
+ * Ask the server whether a stored session is still good.
+ * @param cookie - Stored `app_session_id` cookie.
+ * @returns `valid`, `invalid` when the server rejected it, or `unreachable` when it could not answer.
+ */
+async function verifyDanielSession(cookie: string): Promise<SessionVerification> {
+  const input = encodeURIComponent(JSON.stringify({ 0: { json: null } }))
+  let response: HttpResponse
+  try {
+    response = await request({
+      method: 'GET',
+      url: `${BASE}/api/trpc/auth.me?batch=1&input=${input}`,
+      headers: { Cookie: cookie, Origin: BASE, Referer: `${BASE}/` },
+      timeoutMs: VERIFY_TIMEOUT_MS,
+    })
+  } catch {
+    return 'unreachable'
+  }
+  if (response.status === 401 || response.status === 403) return 'invalid'
+  if (trpcErrorCode(response.body) === 'UNAUTHORIZED') return 'invalid'
+  if (response.status < 200 || response.status >= 300) return 'unreachable'
+  const account = trpcResult(response.body)
+  const email = account?.['email']
+  return typeof email === 'string' && email !== '' ? 'valid' : 'invalid'
+}
+
+/**
+ * Native sign-in window options; the shell's own material and palette, no Host.
+ * @param localeId - Shell locale id selecting the copy.
+ * @param unverified - Whether a stored session exists that the server could not confirm.
+ * @returns sandboxed window options with a locale-only preload.
+ */
+export function danielLoginWindowOptions(localeId: string, unverified: boolean): BrowserWindowConstructorOptions {
+  return {
+    width: 440,
+    height: 560,
+    useContentSize: true,
+    center: true,
+    resizable: false,
+    maximizable: false,
+    fullscreenable: false,
+    show: false,
+    autoHideMenuBar: true,
+    title: 'Daniel Bot',
+    backgroundColor: process.platform === 'darwin' ? '#00000000' : '#FFFFFF',
+    ...(process.platform === 'darwin' ? {
+      titleBarStyle: 'hidden',
+      trafficLightPosition: { x: 18, y: 18 },
+      vibrancy: 'menu',
+      visualEffectState: 'active',
+    } as const : {}),
+    ...(process.platform === 'win32' ? {
+      titleBarStyle: 'hidden',
+      titleBarOverlay: { color: '#00000000', symbolColor: '#0F1115', height: 42 },
+      backgroundMaterial: 'acrylic',
+    } as const : {}),
+    webPreferences: {
+      preload: fileURLToPath(new URL('./preload-daniel-login.cjs', import.meta.url)),
+      additionalArguments: [
+        `--daniel-login-locale=${localeId}`,
+        `--daniel-login-unverified=${unverified ? '1' : '0'}`,
+      ],
+      nodeIntegration: false,
+      contextIsolation: true,
+      sandbox: true,
+      webSecurity: true,
+    },
+  }
+}
+
+let disposeActiveHandlers: (() => void) | undefined
+
+/**
+ * Open the process's sole sign-in window and wait for it to settle.
+ * @param options - Locale and whether a stored session is awaiting verification.
+ * @returns the gate result, or undefined when the window was closed without a session.
+ */
+export async function openDanielLoginWindow(options: DanielLoginOptions & { readonly unverified: boolean }): Promise<DanielSessionGate | undefined> {
+  const window = new BrowserWindow(danielLoginWindowOptions(options.localeId ?? app.getLocale(), options.unverified))
+  disposeActiveHandlers?.()
+  let active = true
+  let gate: DanielSessionGate | undefined
+
+  const disposeHandlers = (): void => {
+    if (!active) return
+    active = false
+    for (const channel of [DANIEL_LOGIN_IPC.submit, DANIEL_LOGIN_IPC.retryStored, DANIEL_LOGIN_IPC.cancel]) {
+      ipcMain.removeHandler(channel)
+    }
+    disposeActiveHandlers = undefined
+  }
+  disposeActiveHandlers = disposeHandlers
+
+  const assertSender = (event: IpcMainInvokeEvent): void => {
+    if (!active || window.isDestroyed() || event.sender !== window.webContents
+      || event.senderFrame !== window.webContents.mainFrame) {
+      throw new Error('daniel login: rejected action from an unowned frame')
+    }
+  }
+
+  /** Publish the stored session, let the page render its final status, then close. */
+  const succeed = (result: DanielSessionGate): DanielLoginSubmitResult => {
+    gate = result
+    if (!window.isDestroyed()) window.webContents.send(DANIEL_LOGIN_IPC.succeeded)
+    setTimeout(() => {
+      if (!window.isDestroyed()) window.close()
+    }, 400)
+    return { ok: true }
+  }
+
+  const closed = new Promise<void>((resolve) => { window.once('closed', () => { resolve() }) })
+
+  ipcMain.handle(DANIEL_LOGIN_IPC.submit, async (event, email: unknown, password: unknown): Promise<DanielLoginSubmitResult> => {
+    assertSender(event)
+    if (typeof email !== 'string' || typeof password !== 'string' || email.trim() === '' || password === '') {
+      return { ok: false, failure: 'credential', message: '' }
+    }
+    try {
+      const account = await loginDanielAccount({ email: email.trim(), password })
+      // The window may have been closed while the request was in flight.
+      if (!active) return { ok: false, failure: 'invalid', message: '' }
+      writeDanielSession(account.cookie)
+      return succeed({ email: account.email })
+    } catch (error) {
+      if (error instanceof DanielAuthError) return { ok: false, failure: error.failure, message: error.message }
+      console.error('daniel login: unexpected failure', error instanceof Error ? error.message : String(error))
+      return { ok: false, failure: 'server', message: '' }
+    }
+  })
+
+  ipcMain.handle(DANIEL_LOGIN_IPC.retryStored, async (event): Promise<DanielLoginSubmitResult> => {
+    assertSender(event)
+    const stored = readDanielSession()
+    if (stored === undefined) return { ok: false, failure: 'invalid', message: '' }
+    const verification = await verifyDanielSession(stored.cookie)
+    if (!active) return { ok: false, failure: 'invalid', message: '' }
+    if (verification === 'valid') return succeed({})
+    if (verification === 'invalid') clearDanielSession()
+    return { ok: false, failure: verification === 'invalid' ? 'invalid' : 'network', message: '' }
+  })
+
+  ipcMain.handle(DANIEL_LOGIN_IPC.cancel, async (event) => {
+    assertSender(event)
+    window.close()
+  })
+
+  window.once('closed', disposeHandlers)
+  window.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+  window.webContents.on('will-navigate', (event) => { event.preventDefault() })
+  try {
+    await window.loadFile(join(app.getAppPath(), 'renderer', 'daniel-login.html'))
+  } catch (error) {
+    disposeHandlers()
+    if (!window.isDestroyed()) window.destroy()
+    throw error
+  }
+  // eslint-disable-next-line @typescript-eslint/no-unnecessary-condition -- the window can be destroyed while loading.
+  if (active && !window.isDestroyed()) {
+    // A menu bar belongs to the window only on Windows and Linux; macOS keeps the app menu.
+    if (process.platform !== 'darwin') window.removeMenu()
+    window.show()
+  }
+  await closed
+  return gate
+}
+
+/**
+ * Startup gate: continue only with a session the server accepts.
+ *
+ * An absent session, or one the server rejects, opens the sign-in window. A stored
+ * session that cannot be verified because the server is unreachable is *not*
+ * treated as invalid: the window explains the network condition and offers to
+ * verify again without asking for a password.
+ * @param options - Locale for the window copy.
+ * @returns the gate result, or undefined when the operator closed the window.
+ */
+export async function requireDanielSession(options: DanielLoginOptions = {}): Promise<DanielSessionGate | undefined> {
+  if (process.env[SKIP_LOGIN_ENV]?.trim() === '1') {
+    console.info('daniel login: skipped by DANIEL_BOT_SKIP_LOGIN=1')
+    return {}
+  }
+
+  const stored = readDanielSession()
+  let unverified = false
+  if (stored !== undefined) {
+    const verification = await verifyDanielSession(stored.cookie)
+    if (verification === 'valid') return {}
+    if (verification === 'invalid') {
+      clearDanielSession()
+      console.info('daniel login: the stored session was rejected; asking for a password')
+    } else {
+      unverified = true
+      console.warn('daniel login: the stored session could not be verified (network unreachable)')
+    }
+  }
+  return await openDanielLoginWindow({ ...options, unverified })
+}
