@@ -0,0 +1,243 @@
+/*
+ * Daniel Bot sign-in window.
+ *
+ * Same material and type scale as the native welcome surface (translucent tint over
+ * the platform's own window material, Montserrat brand face, 12 px inputs, 10 px
+ * buttons). Values are local copies of the shell's design tokens so this document
+ * renders correctly even before the Host exists.
+ */
+
+:root {
+  color-scheme: light dark;
+  --dl-label: #0f1115;
+  --dl-label-secondary: #61666b;
+  --dl-label-caption: #adb2b8;
+  --dl-border: #00000029;
+  --dl-border-strong: #0f1115;
+  --dl-button: #0f1115;
+  --dl-button-hover: #43454a;
+  --dl-button-label: #ffffff;
+  --dl-error: rgb(236, 19, 19);
+  --dl-error-tint: rgb(236 19 19 / 8%);
+  --dl-tint: color-mix(in srgb, rgb(255, 255, 255) 40%, transparent);
+  --dl-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  --dl-font-brand: 'Montserrat', var(--dl-font);
+  --dl-transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+body[data-ds-dark-theme] {
+  --dl-label: #f9fafb;
+  --dl-label-secondary: #cfd3d6;
+  --dl-label-caption: #81858c;
+  --dl-border: #ffffff33;
+  --dl-border-strong: #f9fafb;
+  --dl-button: #f9fafb;
+  --dl-button-hover: #ebeef2;
+  --dl-button-label: #353638;
+  --dl-error: rgb(242, 90, 90);
+  --dl-error-tint: rgb(242 90 90 / 12%);
+  --dl-tint: color-mix(in srgb, rgb(24, 25, 28) 50%, transparent);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html,
+body {
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  overflow: hidden;
+  background: transparent;
+}
+
+body {
+  display: flex;
+  flex-direction: column;
+  background: var(--dl-tint);
+  color: var(--dl-label);
+  font-family: var(--dl-font-brand);
+  font-weight: 400;
+  user-select: none;
+  -webkit-font-smoothing: antialiased;
+}
+
+.titlebar {
+  flex: 0 0 36px;
+  app-region: drag;
+}
+
+.signin {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  flex-direction: column;
+  padding: 2px 40px 24px;
+  overflow: auto;
+}
+
+.wordmark {
+  margin: 0;
+  color: var(--dl-label);
+  font-family: var(--dl-font-brand);
+  font-size: 26px;
+  font-weight: 500;
+  line-height: 34px;
+  letter-spacing: 0.01em;
+}
+
+h1 {
+  margin: 18px 0 6px;
+  font-family: var(--dl-font-brand);
+  font-size: 20px;
+  font-weight: 400;
+  line-height: 30px;
+}
+
+.subtitle {
+  margin: 0;
+  color: var(--dl-label-secondary);
+  font-size: 14px;
+  font-weight: 300;
+  line-height: 22px;
+}
+
+#form {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 24px;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.label {
+  color: var(--dl-label-secondary);
+  font-family: var(--dl-font);
+  font-size: 13px;
+  line-height: 18px;
+}
+
+.field input {
+  display: block;
+  width: 100%;
+  height: 48px;
+  padding: 7px 14px;
+  border: 1px solid var(--dl-border);
+  border-radius: 12px;
+  outline: none;
+  background: transparent;
+  color: var(--dl-label);
+  font-family: var(--dl-font);
+  font-size: 14px;
+  line-height: 24px;
+  user-select: text;
+  transition: border-color var(--dl-transition);
+}
+
+.field input:focus {
+  border-color: var(--dl-border-strong);
+}
+
+.field input::placeholder {
+  color: var(--dl-label-caption);
+  opacity: 1;
+}
+
+.field input[disabled] {
+  opacity: 0.5;
+}
+
+.error {
+  margin: 0;
+  padding: 10px 12px;
+  border-radius: 10px;
+  background: var(--dl-error-tint);
+  color: var(--dl-error);
+  font-family: var(--dl-font);
+  font-size: 13px;
+  line-height: 20px;
+  user-select: text;
+}
+
+button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 44px;
+  padding: 8px 16px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  cursor: pointer;
+  font-family: var(--dl-font);
+  font-size: 14px;
+  font-weight: 500;
+  line-height: 22px;
+  app-region: no-drag;
+  transition:
+    background-color var(--dl-transition),
+    border-color var(--dl-transition),
+    opacity var(--dl-transition);
+}
+
+button:disabled {
+  cursor: not-allowed;
+  opacity: 0.45;
+}
+
+button:focus-visible {
+  outline: 2px solid var(--dl-label);
+  outline-offset: 3px;
+}
+
+.primary {
+  background: var(--dl-button);
+  color: var(--dl-button-label);
+}
+
+.primary:hover:not(:disabled) {
+  background: var(--dl-button-hover);
+}
+
+.secondary {
+  height: 40px;
+  border-color: var(--dl-border);
+  background: transparent;
+  color: var(--dl-label-secondary);
+  font-weight: 400;
+}
+
+.secondary:hover:not(:disabled) {
+  border-color: var(--dl-label-caption);
+  color: var(--dl-label);
+}
+
+.footnote {
+  margin: 24px 0 0;
+  padding-top: 14px;
+  border-top: 1px solid var(--dl-border);
+  color: var(--dl-label-caption);
+  font-family: var(--dl-font);
+  font-size: 11.5px;
+  line-height: 18px;
+}
+
+/* The note sits at the bottom; the form owns the vertical rhythm above it. */
+.footnote {
+  margin-top: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none;
+  }
+}
