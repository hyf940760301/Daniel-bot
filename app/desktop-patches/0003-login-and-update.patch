diff --git a/apps/desktop/src/update-gate.ts b/apps/desktop/src/update-gate.ts
new file mode 100644
index 00000000..ab339148
--- /dev/null
+++ b/apps/desktop/src/update-gate.ts
@@ -0,0 +1,21 @@
+/**
+ * The single switch that decides whether this build may contact a release feed.
+ *
+ * Daniel Bot is distributed without an official update feed of its own, so every
+ * path that could reach one — periodic checks, the menu entry, the mandatory
+ * policy query, downloads, and installation — stays compiled in but off unless an
+ * operator opts in. That keeps the upstream code intact (and testable) while
+ * guaranteeing a stock launch makes no release-feed request.
+ */
+
+/** Opt-in environment flag; every value except `1` keeps release traffic off. */
+export const DANIEL_ALLOW_UPDATE_ENV = 'DANIEL_BOT_ALLOW_UPDATE'
+
+/**
+ * Whether Desktop may query, download, or install a release.
+ * @param env - Desktop process environment; defaults to this process's.
+ * @returns true only for the explicit `DANIEL_BOT_ALLOW_UPDATE=1` opt-in.
+ */
+export function desktopUpdatesAllowed(env: NodeJS.ProcessEnv = process.env): boolean {
+  return env[DANIEL_ALLOW_UPDATE_ENV]?.trim() === '1'
+}
diff --git a/apps/desktop/tests/daniel-login.spec.ts b/apps/desktop/tests/daniel-login.spec.ts
new file mode 100644
index 00000000..83012aeb
--- /dev/null
+++ b/apps/desktop/tests/daniel-login.spec.ts
@@ -0,0 +1,57 @@
+/** The session file is the only thing the sign-in flow writes; this pins its exact shape. */
+
+import { mkdtempSync, mkdirSync, readFileSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// The window and HTTPS surfaces need a real Electron process; this suite touches only the file.
+vi.mock('electron', () => ({
+  app: { getAppPath: () => process.cwd(), getLocale: () => 'en' },
+  BrowserWindow: class {},
+  ipcMain: { handle: vi.fn(), removeHandler: vi.fn() },
+  net: { request: vi.fn() },
+}))
+
+const home = mkdtempSync(join(tmpdir(), 'daniel-login-home-'))
+process.env.DANIEL_HOME = home
+
+const { clearDanielSession, danielSessionFile, readDanielSession, writeDanielSession } = await import('../src/daniel-login.ts')
+
+afterAll(() => { delete process.env.DANIEL_HOME })
+
+describe('daniel session file', () => {
+  beforeEach(() => { clearDanielSession() })
+
+  it('writes under $DANIEL_HOME/session with owner-only modes', () => {
+    writeDanielSession('app_session_id=first')
+    const file = danielSessionFile()
+    expect(file).toBe(join(home, 'session', 'session.json'))
+    expect(statSync(file).mode & 0o777).toBe(0o600)
+    expect(statSync(join(home, 'session')).mode & 0o777).toBe(0o700)
+    expect(JSON.parse(readFileSync(file, 'utf8'))).toMatchObject({ cookie: 'app_session_id=first' })
+    expect(readDanielSession()).toEqual({ cookie: 'app_session_id=first', ts: expect.any(Number) })
+  })
+
+  it('replaces an existing session atomically and keeps the mode', () => {
+    writeDanielSession('app_session_id=first')
+    writeDanielSession('app_session_id=second')
+    expect(readDanielSession()?.cookie).toBe('app_session_id=second')
+    expect(statSync(danielSessionFile()).mode & 0o777).toBe(0o600)
+  })
+
+  it('rejects a file that is not a Daniel cookie', () => {
+    mkdirSync(join(home, 'session'), { recursive: true })
+    writeFileSync(danielSessionFile(), JSON.stringify({ cookie: 'other=1' }))
+    expect(readDanielSession()).toBeUndefined()
+    writeFileSync(danielSessionFile(), 'not json')
+    expect(readDanielSession()).toBeUndefined()
+  })
+
+  it('clears a session it was asked to drop, and tolerates an absent file', () => {
+    writeDanielSession('app_session_id=first')
+    clearDanielSession()
+    expect(readDanielSession()).toBeUndefined()
+    expect(() => { clearDanielSession() }).not.toThrow()
+  })
+})
