diff --git a/apps/desktop/src/daniel-login-api.ts b/apps/desktop/src/daniel-login-api.ts
new file mode 100644
index 00000000..87352dfd
--- /dev/null
+++ b/apps/desktop/src/daniel-login-api.ts
@@ -0,0 +1,116 @@
+/**
+ * Renderer contract of the native Daniel sign-in window: channel names, the copy
+ * dictionary, and the shape of every operation the page may call.
+ *
+ * The page itself is a plain local document, so this module is the one place that
+ * both the sandboxed preload and the main process agree on.
+ */
+
+/** Private native sign-in channels, installed only while its window exists. */
+export const DANIEL_LOGIN_IPC = {
+  submit: 'dsh-daniel-login:submit',
+  retryStored: 'dsh-daniel-login:retry-stored',
+  cancel: 'dsh-daniel-login:cancel',
+  /** Main -> page: the session file is written and the workspace is about to open. */
+  succeeded: 'dsh-daniel-login:succeeded',
+} as const
+
+/**
+ * Why a sign-in attempt failed. A transport fault is reported as `network` so a
+ * missing connection never reads as a wrong password.
+ */
+export type DanielLoginFailure = 'credential' | 'network' | 'server' | 'mismatch' | 'invalid'
+
+/** Result of one attempt; `message` is already user-facing copy. */
+export type DanielLoginSubmitResult =
+  | { readonly ok: true }
+  | { readonly ok: false; readonly failure: DanielLoginFailure; readonly message: string }
+
+/** Localized copy the page renders through `data-copy` attributes. */
+export interface DanielLoginCopy {
+  readonly lang: string
+  readonly title: string
+  readonly subtitle: string
+  readonly email: string
+  readonly password: string
+  readonly emailPlaceholder: string
+  readonly passwordPlaceholder: string
+  readonly signIn: string
+  readonly signingIn: string
+  readonly footnote: string
+  readonly emptyFields: string
+  readonly bridgeMissing: string
+  /** Transport fault: never presented as a rejected password. */
+  readonly networkError: string
+  /** A server fault with no message of its own. */
+  readonly serverError: string
+  /** The saved sign-in is no longer accepted. */
+  readonly expired: string
+  /** A stored session exists, but the server could not be reached to verify it. */
+  readonly unverified: string
+  readonly retryStored: string
+  readonly entering: string
+}
+
+const zh: DanielLoginCopy = {
+  lang: 'zh-CN',
+  title: '登录 Daniel',
+  subtitle: '使用你的 Daniel 账号。登录成功后才会进入工作区。',
+  email: '邮箱',
+  password: '密码',
+  emailPlaceholder: 'you@example.com',
+  passwordPlaceholder: '••••••••',
+  signIn: '登录',
+  signingIn: '正在登录…',
+  footnote: '密码只用于本次换取会话：不写入磁盘、不进日志、不传给任何子进程。本机只保存 Daniel 会话凭据（文件权限 0600）。',
+  emptyFields: '请输入邮箱和密码。',
+  bridgeMissing: '页面没有连上应用主进程，请重启 Daniel Bot。',
+  networkError: '连不上 Daniel（网络不可达或连接超时），请检查网络后重试。',
+  serverError: '登录失败：服务端返回了错误，请稍后重试。',
+  expired: '本机保存的登录已失效，请用账户密码重新登录。',
+  unverified: '连不上 Daniel（网络不可达），本机已保存的登录状态暂无法校验。请重试，或输入密码重新登录。',
+  retryStored: '重新校验已保存的登录',
+  entering: '登录成功，正在进入工作区…',
+}
+
+const en: DanielLoginCopy = {
+  lang: 'en',
+  title: 'Sign in to Daniel',
+  subtitle: 'Use your Daniel account. The workspace opens only after a successful sign-in.',
+  email: 'Email',
+  password: 'Password',
+  emailPlaceholder: 'you@example.com',
+  passwordPlaceholder: '••••••••',
+  signIn: 'Sign in',
+  signingIn: 'Signing in…',
+  footnote: 'The password is used once, to exchange for a session: it is never written to disk, logged, or passed to a child process. Only the Daniel session credential is stored locally (file mode 0600).',
+  emptyFields: 'Enter your email and password.',
+  bridgeMissing: 'This page is not connected to the application process. Restart Daniel Bot.',
+  networkError: 'Daniel is unreachable (no network or the connection timed out). Check your connection and try again.',
+  serverError: 'Sign-in failed: the server returned an error. Try again later.',
+  expired: 'The saved sign-in is no longer accepted. Sign in with your password.',
+  unverified: 'Daniel is unreachable (network unavailable), so the saved sign-in could not be verified. Retry, or sign in with your password.',
+  retryStored: 'Verify the saved sign-in',
+  entering: 'Signed in. Opening the workspace…',
+}
+
+/**
+ * @param localeId - Shell locale id, such as `zh-CN` or `en`.
+ * @returns copy for the closest supported language.
+ */
+export function danielLoginCopy(localeId: string): DanielLoginCopy {
+  return localeId.toLowerCase().startsWith('zh') ? zh : en
+}
+
+/** Operations the sign-in page may call; the password never leaves `submit`. */
+export interface DanielLoginApi {
+  readonly copy: DanielLoginCopy
+  /** True when a session file exists but its verification could not reach the server. */
+  readonly unverified: boolean
+  submit(email: string, password: string): Promise<DanielLoginSubmitResult>
+  /** Verify the session file again instead of asking for a password. */
+  retryStored(): Promise<DanielLoginSubmitResult>
+  cancel(): Promise<void>
+  /** @param listener - called once the session is stored. @returns subscription disposer. */
+  onSucceeded(listener: () => void): () => void
+}
diff --git a/apps/desktop/src/daniel-login.ts b/apps/desktop/src/daniel-login.ts
