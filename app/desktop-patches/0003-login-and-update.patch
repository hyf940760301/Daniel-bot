diff --git a/apps/desktop/renderer/daniel-login.js b/apps/desktop/renderer/daniel-login.js
new file mode 100644
index 00000000..1228047e
--- /dev/null
+++ b/apps/desktop/renderer/daniel-login.js
@@ -0,0 +1,145 @@
+'use strict'
+
+/**
+ * Daniel sign-in page.
+ *
+ * Copy, validation text, and every operation come from the preload bridge, so this
+ * document holds no account logic and never keeps the password after a submit.
+ * The password field is cleared as soon as an attempt settles, whichever way it
+ * went, and again on page hide.
+ */
+
+/** @type {import('./daniel-login-api').DanielLoginApi | undefined} */
+const api = window.danielLogin
+
+const form = document.getElementById('form')
+const emailEl = document.getElementById('email')
+const passwordEl = document.getElementById('password')
+const submitEl = document.getElementById('submit')
+const retryEl = document.getElementById('retry')
+const errorEl = document.getElementById('error')
+
+let busy = false
+
+/** @param {string} key @returns {string} */
+function text(key) {
+  const copy = api && api.copy
+  return copy && typeof copy[key] === 'string' ? copy[key] : ''
+}
+
+function applyCopy() {
+  if (!api) return
+  document.documentElement.lang = api.copy.lang
+  for (const node of document.querySelectorAll('[data-copy]')) {
+    const value = text(node.dataset.copy)
+    if (value !== '') node.textContent = value
+  }
+  for (const node of document.querySelectorAll('[data-placeholder]')) {
+    const value = text(node.dataset.placeholder)
+    if (value !== '') node.setAttribute('placeholder', value)
+  }
+  if (api.unverified) {
+    showError(api.copy.unverified)
+    retryEl.hidden = false
+  }
+}
+
+/** @param {string} message */
+function showError(message) {
+  errorEl.textContent = message
+  errorEl.hidden = false
+}
+
+function clearError() {
+  errorEl.textContent = ''
+  errorEl.hidden = true
+}
+
+/** @param {boolean} next */
+function setBusy(next) {
+  busy = next
+  submitEl.disabled = next
+  emailEl.disabled = next
+  passwordEl.disabled = next
+  retryEl.disabled = next
+  submitEl.textContent = text(next ? 'signingIn' : 'signIn')
+  if (next) clearError()
+}
+
+/**
+ * Turn one attempt's result into on-screen state.
+ * A transport fault always shows the network copy, never the credential copy.
+ * @param {import('./daniel-login-api').DanielLoginSubmitResult} result
+ * @returns {boolean} whether the window will close on its own
+ */
+function handle(result) {
+  if (result && result.ok === true) {
+    clearError()
+    submitEl.textContent = text('entering')
+    // The main process closes this window once the session file is stored.
+    return true
+  }
+  const failure = result && result.failure
+  const serverMessage = result && typeof result.message === 'string' ? result.message : ''
+  if (failure === 'network') showError(text('networkError'))
+  else if (failure === 'invalid') {
+    // The stored session is gone, so the retry entry has nothing left to verify.
+    showError(serverMessage || text('expired'))
+    retryEl.hidden = true
+  } else showError(serverMessage || text('serverError'))
+  setBusy(false)
+  return false
+}
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault()
+  if (busy) return
+  if (!api) {
+    showError('Page is not connected to the application process.')
+    return
+  }
+  const email = emailEl.value.trim()
+  const password = passwordEl.value
+  if (email === '' || password === '') {
+    showError(api.copy.emptyFields)
+    return
+  }
+
+  setBusy(true)
+  let result
+  try {
+    result = await api.submit(email, password)
+  } catch (error) {
+    result = { ok: false, failure: 'server', message: error && error.message ? String(error.message) : '' }
+  }
+  // The password is spent: drop it whether the attempt succeeded or not.
+  passwordEl.value = ''
+  handle(result)
+})
+
+retryEl.addEventListener('click', async () => {
+  if (busy || !api) return
+  setBusy(true)
+  let result
+  try {
+    result = await api.retryStored()
+  } catch (error) {
+    result = { ok: false, failure: 'server', message: error && error.message ? String(error.message) : '' }
+  }
+  handle(result)
+})
+
+if (api) {
+  api.onSucceeded(() => {
+    clearError()
+    setBusy(true)
+    submitEl.textContent = text('entering')
+  })
+}
+
+emailEl.addEventListener('input', clearError)
+passwordEl.addEventListener('input', clearError)
+window.addEventListener('pagehide', () => { passwordEl.value = '' })
+
+applyCopy()
+emailEl.focus()
