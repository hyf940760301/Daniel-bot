@@ -0,0 +1,28 @@
+/**
+ * Isolated bridge for the Daniel sign-in window.
+ *
+ * The page never sees the password after the call returns: `submit` hands it to the
+ * main process, which is the only place that talks to the account service.
+ */
+
+import { contextBridge, ipcRenderer } from 'electron'
+import { DANIEL_LOGIN_IPC, danielLoginCopy, type DanielLoginApi, type DanielLoginSubmitResult } from './daniel-login-api.ts'
+
+function argument(prefix: string): string | undefined {
+  return process.argv.find(candidate => candidate.startsWith(prefix))?.slice(prefix.length)
+}
+
+const copy = danielLoginCopy(argument('--daniel-login-locale=') ?? 'en')
+const api: DanielLoginApi = {
+  copy,
+  unverified: argument('--daniel-login-unverified=') === '1',
+  submit: (email, password) => ipcRenderer.invoke(DANIEL_LOGIN_IPC.submit, email, password) as Promise<DanielLoginSubmitResult>,
+  retryStored: () => ipcRenderer.invoke(DANIEL_LOGIN_IPC.retryStored) as Promise<DanielLoginSubmitResult>,
+  cancel: () => ipcRenderer.invoke(DANIEL_LOGIN_IPC.cancel) as Promise<void>,
+  onSucceeded: (listener) => {
+    const receive = (): void => { listener() }
+    ipcRenderer.on(DANIEL_LOGIN_IPC.succeeded, receive)
+    return () => { ipcRenderer.removeListener(DANIEL_LOGIN_IPC.succeeded, receive) }
+  },
+}
